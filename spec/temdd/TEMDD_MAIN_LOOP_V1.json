{
  "schema": "qikvrt_temdd_main_loop_v1",
  "version": "1.0.0",
  "owner": "Ingolf Lohmann",
  "status": "NORMATIVE_CANDIDATE",
  "canonical_chain": [
    "COMPILE",
    "BIND",
    "RESOLVE",
    "EXECUTE",
    "TEST",
    "OBSERVE",
    "READBACK",
    "ACCEPT",
    "EFFECT_ACK_DONE"
  ],
  "stage_semantics": {
    "COMPILE": "model_to_executable_plan",
    "BIND": "bind_subject_artifacts_and_identity",
    "RESOLVE": "resolve_runtime_capabilities_and_authority",
    "EXECUTE": "perform_intended_effect",
    "TEST": "evaluate_assertions_and_failure_paths",
    "OBSERVE": "capture_actual_successor_state",
    "READBACK": "fresh_independent_effect_readback",
    "ACCEPT": "apply_acceptance_criteria_to_bound_evidence",
    "EFFECT_ACK_DONE": "terminal_effect_acknowledgement_for_the_declared_subject"
  },
  "terminal_predicate": {
    "required_all_of": [
      "COMPILE",
      "BIND",
      "RESOLVE",
      "EXECUTE",
      "TEST",
      "OBSERVE",
      "READBACK",
      "ACCEPT"
    ],
    "formula": "EFFECT_ACK_DONE iff COMPILE and BIND and RESOLVE and EXECUTE and TEST and OBSERVE and READBACK and ACCEPT",
    "single_stage_success_is_done": false
  },
  "outer_main": {
    "potentially_unbounded": true,
    "effect_ack_done_terminates_subject_not_runtime": true,
    "accepted_successor_becomes_next_bound_input": true,
    "predecessor_evidence_transfer": false,
    "test_harness_must_be_bounded": true,
    "fail_closed_implies_global_idle": false
  },
  "mandatory_non_equivalences": [
    "EXECUTE != DONE",
    "TEST != DONE",
    "OBSERVE != DONE",
    "TRANSPORT_ACK != EFFECT_ACK",
    "EFFECT_ACK_DONE(subject_n) != PROGRAM_DONE",
    "LOCAL_EFFECT_ACK != REPOSITORY_EFFECT_ACK_DONE"
  ],
  "carriers": {
    "python": "runtime/temdd/main_loop.py",
    "rust": "next/crates/qikvrt/src/temdd_main_loop.rs",
    "smalltalk": "runtime/temdd/TEMDDMainLoop.st",
    "m68000": "runtime/m68000/temdd_main_loop.s",
    "ada_spark": "next/reference/full-core-draft03/ada/temdd_main_loop.ads",
    "lean": "next/reference/full-core-draft03/TEMDDMainLoop.lean",
    "vhdl": "hardware/vhdl/qikvrt_temdd_main_loop.vhd"
  },
  "boundary": "Carrier conformance proves the control relation only. Native review, protected merge, physical FPGA execution, external deployment and repository-wide EFFECT_ACK_DONE remain separate subjects."
}
