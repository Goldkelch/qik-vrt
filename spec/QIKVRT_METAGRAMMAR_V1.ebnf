protocol        = header, message ;
header          = "QMV/1.0" ;
message         = "{", kind, authority, subject, [binding], [materialization], gates, inward, outward, blocker, next_action, completion, "}" ;
kind            = "TYPE", ":", message_type ;
message_type    = "DIRECTIVE" | "OBSERVATION" | "VALIDATION" | "AUTHORIZATION" | "EFFECT_REQUEST" | "EFFECT_RECEIPT" | "HOLD" | "COMPLETION" ;
authority       = "AUTHORITY", object ;
subject         = "SUBJECT", object ;
binding         = "SUCCESSOR_BINDING", object ;
materialization = "MATERIALIZATION", object ;
gates           = "EXACT_HEAD_GATES", object ;
inward          = "INWARD_REFLEXIVITY", object ;
outward         = "OUTWARD_REFLECTION", object ;
blocker         = "FIRST_DETERMINISTIC_BLOCKER", ":", identifier ;
next_action     = "NEXT_ACTION", ":", identifier ;
completion      = "COMPLETION", "{", "PASS", ":", truth, "FINAL_PASS", ":", truth, "EFFECT_ACK_DONE", ":", truth, "}" ;
object          = "{", { field }, "}" ;
field           = identifier, ":", value ;
value           = string | number | truth | identifier | object | array ;
array           = "[", [ value, { ",", value } ], "]" ;
truth           = "TRUE" | "FALSE" | "UNDETERMINED" ;
identifier      = letter, { letter | digit | "_" | "-" | "." | "/" } ;
string          = '"', { character }, '"' ;
number          = digit, { digit } ;
letter          = "A"…"Z" | "a"…"z" ;
digit           = "0"…"9" ;
character       = ? any Unicode scalar except unescaped quote ? ;
