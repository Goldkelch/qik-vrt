  "schema": "qikvrt_abnan_mvp_public_carrier_contract_v1",
  "contract_id": "ABNAN_MVP_PUBLIC_CARRIER_V1",
  "purpose": "Turn the AbNan MVP boundary into a machine-readable, repository-addressable contract rather than leaving it only in discussion.",
  "scope": {
    "phase": "bounded_scoping_and_reference_mvp",
    "live_case": false,
    "regulatory_approval_claim": false,
    "endorsement_claim": false,
    "payment_service": false,
    "sensitive_beneficiary_data_public": false
  },
  "roundtrip": [
    "NEED",
    "VERIFY",
    "COMPLIANCE",
    "MATCH",
    "ACCEPT",
    "LAWFUL_LOCAL_ACTION",
    "READBACK",
    "CLOSE"
  ],
  "fail_closed": {
    "request_is_execution": false,
    "execution_is_success": false,
    "success_is_effect": false,
    "predecessor_evidence_transfer": false,
    "unresolved_condition": "HOLD_UNVERIFIED"
  },
  "responsibility": {
    "abnan": "humanitarian case coordination and accountable workflow",
    "independent_professionals": [
      "legal",
      "sanctions",
      "AML",
      "nonprofit",
      "privacy",
      "security"
    ],
    "qik_vrt": "evidence-bound state transitions, readback, auditability, monitor projections and fail-closed semantics",
    "implementation_partner": "components delivered against explicit acceptance criteria"
  },
  "public_carrier": {
    "repository": "Goldkelch/qik-vrt",
    "human_witness_path": "docs/abnan/witness-v1/index.html",
    "machine_contract_path": "contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json",
    "required_terminal_chain": [
      "PERSISTED_EXACT_SUBJECT",
      "FRESH_VALIDATION",
      "NATIVE_REVIEW",
      "MAIN",
      "PUBLIC_HTTP_READBACK",
      "EFFECT_ACK_DONE"
    ],
    "current_non_claims": [
      "MAIN",
      "PUBLIC_PAGES_DEPLOYMENT",
      "PUBLIC_HTTP_READBACK",
      "EFFECT_ACK_DONE"
    ]
  },
  "accessibility": {
    "human": "docs/abnan/witness-v1/index.html",
    "machine": "contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json",
    "design_goal": "same boundary is discoverable by people, automation and evidence routers"
  }
}
