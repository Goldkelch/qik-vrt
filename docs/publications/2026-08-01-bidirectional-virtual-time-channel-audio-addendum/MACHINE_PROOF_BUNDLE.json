  "claims": [
    {
      "claim_id": "VTI-ADD-001",
      "statement": "A realization ladder shall distinguish an articulated idea, a consistent software model, an executable virtual witness, a device deployment, a qualified observation system, a physical finding, a causally attributed effect and an authorized external effect.",
      "classification": "NORMATIVE",
      "status": "DECLARED",
      "publication_wording": "NORMATIVE_DECLARATION",
      "scope": "Methodological separation for this addendum; it does not assert that every project must use the same labels.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-01-bidirectional-virtual-time-channel-audio-addendum/SCIENTIFIC_ADDENDUM_DE.md#3-die-realisierungsleiter"
      ]
    },
    {
      "claim_id": "VTI-ADD-002",
      "statement": "The existence or execution of a software model does not by itself establish the physical phenomenon represented by that model.",
      "classification": "NORMATIVE",
      "status": "DECLARED",
      "publication_wording": "NORMATIVE_DECLARATION",
      "scope": "Scientific inference boundary; a physical conclusion requires separately stated bridge premises and evidence.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-01-bidirectional-virtual-time-channel-audio-addendum/SCIENTIFIC_ADDENDUM_DE.md#3-die-realisierungsleiter"
      ]
    },
    {
      "claim_id": "VTI-ADD-003",
      "statement": "Within this addendum a system qualifies as an observation system only when acquisition, calibration, temporal binding, source provenance, integrity, falsifiability and governance are all satisfied in the declared scope.",
      "classification": "NORMATIVE",
      "status": "DECLARED",
      "publication_wording": "NORMATIVE_DECLARATION",
      "scope": "Operational predicate OBS(X) for the addendum; no particular game or deployed system is certified by this definition alone.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-01-bidirectional-virtual-time-channel-audio-addendum/SCIENTIFIC_ADDENDUM_DE.md#4-wann-wird-ein-computerspiel-zum-beobachtungssystem"
      ]
    },
    {
      "claim_id": "VTI-ADD-004",
      "statement": "Imagination can be treated as a generator of counterfactual implementation candidates, but an imagined candidate is not thereby an observation or a verified fact.",
