  "claims": [
    {
      "claim_id": "VTI-001",
      "classification": "EMPIRICALLY_EVIDENCED",
      "evidence_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/WITNESS_RUN.txt#VTI-001-WITNESS"],
      "proof_refs": [],
      "publication_wording": "EMPIRICALLY_SUPPORTED",
      "scope": "Only the exact finite ISO C90 execution with virtual endpoints 30 and 15; no physical backward signalling.",
      "source_refs": [],
      "statement": "The strict C90 witness executes a byte-exact 257-byte request from virtual address 30 to 15 and a deterministic 258-byte response from 15 to 30 while host events increase from 1 through 9.",
      "status": "EVIDENCED"
    },
    {
      "claim_id": "VTI-002",
      "classification": "EMPIRICALLY_EVIDENCED",
      "evidence_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/WITNESS_RUN.txt#VTI-002-WITNESS"],
      "proof_refs": [],
      "publication_wording": "EMPIRICALLY_SUPPORTED",
      "scope": "Finite boundary evidence for the listed lengths through 4096 bytes; not a universal execution proof.",
      "source_refs": [],
      "statement": "The witness passes both directions for payload lengths 0, 1, 16, 17, 18, 31, 255, 256, 257 and 4096 and rejects an intentionally missing chunk.",
      "status": "EVIDENCED"
    },
    {
      "claim_id": "VTI-003",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "Conditional paper proof under append-only source, branch-only replay and absence of mutating side paths; fresh Lean transfer is pending.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-003-PAPER"],
      "statement": "Append-only source history combined with branch-only replay preserves every existing source prefix.",
      "status": "OPEN"
    },
    {
      "claim_id": "VTI-004",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "Conditional paper proof for the monotone host semantics defined in the manuscript; it excludes rather than establishes physical backward effects.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-004-PAPER"],
      "statement": "Under monotone host semantics every generated effect occurs at a larger host index than its send event even when the virtual target address is smaller.",
      "status": "OPEN"
    },
    {
      "claim_id": "VTI-005",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "For each individual finite bit string under integrity, eventual delivery, a complete manifest and sufficient finite resources; fresh Lean transfer is pending.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-005-PAPER"],
      "statement": "Every individual finite bit string can be transported losslessly by finite segmentation, manifest validation and ordered reassembly under the stated delivery and resource assumptions.",
      "status": "OPEN"
    },
    {
      "claim_id": "VTI-006",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "Conditional on VTI-005 in each direction, terminating replay and response, distinct identities and complete gates; virtual bidirectionality only.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-006-PAPER"],
      "statement": "Two finite virtual channels plus a terminating response function compose into a bidirectional virtual dialogue while all generating host events remain forward ordered.",
      "status": "OPEN"
    },
    {
      "claim_id": "VTI-007",
      "classification": "SOURCE_BOUND",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "Source attribution to the exact prior finite CTM receipt; it is not a fresh kernel proof of VTI-003 through VTI-009.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/PRIOR_KERNEL_RECEIPT_BINDING.json#VTI-007-CTM-RECEIPT"],
      "statement": "The prior Canonical Temporal Memory receipt records nine Lean-kernel-verified theorems concerning release gates, counterfactual future relevance, source non-overwrite, identifier binding and reciprocal closure in its finite model.",
      "status": "BOUND"
    },
    {
      "claim_id": "VTI-008",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "Conditional paper proof whose complete-mediation premise is a deployment obligation; a bypass violates the premise.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-008-PAPER"],
      "statement": "If every executor path is completely mediated and ordinary release requires a valid EFFECT_ACK_DONE record, no non-DONE record can trigger ordinary release.",
      "status": "OPEN"
    },
    {
      "claim_id": "VTI-009",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "Conditional systems statement under an explicit failure model; EFFECT_ACK alone does not establish exactly-once.",
      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-009-PAPER"],
      "statement": "Exactly-once requires atomic deduplication and effect coupling or an idempotent executor, plus eventual delivery and availability; EFFECT_ACK by itself is insufficient.",
