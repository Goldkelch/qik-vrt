{
  "manifest_version": 3,
  "name": "QIK-VRT Repository Terminal",
  "version": "1.0.0",
  "description": "Read-only QIK-VRT self-heal and watchdog terminal for Firefox.",
  "action": {
    "default_title": "QIK-VRT Terminal",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://api.github.com/repos/Goldkelch/qik-vrt/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qikvrt-terminal@goldkelch.github.io",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
