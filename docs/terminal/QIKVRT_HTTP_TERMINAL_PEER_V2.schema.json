{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldkelch.github.io/qik-vrt/terminal/QIKVRT_HTTP_TERMINAL_PEER_V2.schema.json",
  "title": "QIKVRT HTTP Terminal Peer V2 Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "source_node_id",
    "target_node_id",
    "target_endpoint_id",
    "effective_method",
    "effective_target",
    "policy_id",
    "policy_sha256",
    "responsibility_owner",
    "terminal_input"
  ],
  "properties": {
    "schema": {"const": "qikvrt_terminal_peer_request_v2"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"},
    "source_node_id": {"$ref": "#/$defs/identifier"},
    "target_node_id": {"$ref": "#/$defs/identifier"},
    "target_endpoint_id": {"$ref": "#/$defs/identifier"},
    "effective_method": {"const": "POST"},
    "effective_target": {"enum": ["/terminal/prepare", "/terminal/commit"]},
    "policy_id": {"const": "QIKVRT_HTTP_TERMINAL_PEER_V2"},
    "policy_sha256": {"const": "sha256:4a0d59cc17ccc5750b17cb66a9be3e83f36631e739f9974e27b44252655b8af4"},
    "responsibility_owner": {"type": "string", "minLength": 1, "maxLength": 256},
    "terminal_input": {"$ref": "#/$defs/terminal_input"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "terminal_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "submitted_at", "page", "text", "audio", "video"],
      "properties": {
        "schema": {"const": "qikvrt_terminal_input_v2"},
        "submitted_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$", "maxLength": 24},
        "page": {"type": "string", "minLength": 1, "maxLength": 2048},
        "text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "audio": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/audio_descriptor"}]},
        "video": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/video_descriptor"}]}
      }
    },
    "media_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "content_type", "byte_length", "sha256", "base64"],
      "properties": {
        "schema": {"const": "qikvrt_terminal_media_descriptor_v1"},
        "kind": {"type": "string"},
        "content_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 524288},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    },
    "audio_descriptor": {
      "allOf": [
        {"$ref": "#/$defs/media_descriptor"},
        {"properties": {"kind": {"const": "audio"}, "content_type": {"pattern": "^audio/"}}}
      ]
    },
    "video_descriptor": {
      "allOf": [
        {"$ref": "#/$defs/media_descriptor"},
        {"properties": {"kind": {"const": "video_snapshot"}, "content_type": {"pattern": "^(?:image|video)/"}}}
      ]
    }
  },
  "x-required-http-headers": {
    "Idempotency-Key": "$request_id",
    "X-QIKVRT-Source-Node": "$source_node_id",
    "X-QIKVRT-Target-Node": "$target_node_id",
    "X-QIKVRT-Target-Endpoint": "$target_endpoint_id"
  },
  "x-runtime-canonicalization": {
    "profile": "QIKVRT_CLOSED_JSON_V2",
    "sort_object_keys": "UNICODE_SCALAR_VALUE_LEXICOGRAPHIC_ASCENDING",
    "encoding": "UTF-8",
    "separators": [",", ":"],
    "string_escaping": "QUOTE_BACKSLASH_B_F_N_R_T_AND_U0000_TO_U001F_ONLY_LOWERCASE_U_ESCAPE",
    "floating_point": "FORBIDDEN",
    "arrays": "FORBIDDEN_IN_TERMINAL_INPUT",
    "untyped_objects": "FORBIDDEN_IN_TERMINAL_INPUT",
    "base64": "STANDARD_PADDED_CANONICAL_SPELLING_REQUIRED"
  }
}
