temdd 0.1;
authority owner = "Goldkelch/qik-vrt";
subject epistemic_spiral {
  repository = "Goldkelch/qik-vrt";
  binding = exact;
}
request materialize_spiral { target = QIKVRT_DOD; }
on event {
  follow exact;
  classify causal;
}
on blocker {
  learn smallest_sound_successor;
  execute successor;
}
until {
  EXACT_SUBJECT_BOUND
  && SERIALIZE_DESERIALIZE_IDENTITY
  && ALL_TARGET_LOCALES_PRESENT
  && UNIVERSAL_TERMINAL_CARRIER_OBSERVED
  && FIREFOX_SURFACE_REOBSERVED
  && FRESH_EFFECT_READBACK;
}
