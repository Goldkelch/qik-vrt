[Unit]
Description=QIK-VRT Mesh Firefox appliance
After=network.target

[Service]
Type=simple
User=qikvrt
Group=qikvrt
Environment=HOME=/home/qikvrt
Environment=QIKVRT_HOME=/var/lib/qikvrt
ExecStart=/usr/local/bin/qikvrt-appliance serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qikvrt /home/qikvrt

[Install]
WantedBy=multi-user.target
