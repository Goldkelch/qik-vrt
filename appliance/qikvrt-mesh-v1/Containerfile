# syntax=docker/dockerfile:1
ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG DEBIAN_SNAPSHOT=20260701T000000Z
ARG SOURCE_COMMIT=UNBOUND
ARG SOURCE_TREE=UNBOUND
ARG SOURCE_DATE_EPOCH=0
ENV DEBIAN_FRONTEND=noninteractive \
    QIKVRT_HOME=/var/lib/qikvrt \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
LABEL org.opencontainers.image.title="QIK-VRT Mesh Appliance" \
      org.opencontainers.image.description="Debian-based Firefox and bounded QIK-VRT Effect-Ack appliance" \
      org.opencontainers.image.source="https://github.com/Goldkelch/qik-vrt" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.qikvrt.source.tree="${SOURCE_TREE}" \
      org.qikvrt.effect.scope="BOUNDED_LOOPBACK_TERMINAL_INPUT_ONLY"
RUN set -eux; \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99qikvrt-snapshot; \
    printf 'deb http://snapshot.debian.org/archive/debian/%s/ bookworm main\ndeb http://snapshot.debian.org/archive/debian-security/%s/ bookworm-security main\n' "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list; \
    case "$TARGETARCH" in \
      amd64|'') boot_packages='linux-image-amd64 grub-pc-bin grub-efi-amd64-bin' ;; \
      arm64) boot_packages='linux-image-arm64 grub-efi-arm64-bin' ;; \
      *) echo "unsupported target architecture: $TARGETARCH" >&2; exit 2 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl dbus-x11 firefox-esr fonts-dejavu-core initramfs-tools jq \
      novnc openbox procps python3 qemu-guest-agent sudo systemd-sysv tini websockify \
      x11vnc xvfb $boot_packages; \
    rm -rf /var/lib/apt/lists/*; \
    useradd --create-home --shell /bin/bash qikvrt; \
    passwd -l qikvrt; \
    mkdir -p /opt/qikvrt/src /opt/qikvrt/include/qikvrt /opt/qikvrt/browser/qikvrt-terminal \
      /opt/qikvrt/appliance /opt/qikvrt/ietf /var/lib/qikvrt /usr/lib/firefox-esr/distribution; \
    chown -R qikvrt:qikvrt /var/lib/qikvrt /home/qikvrt
COPY src/qikvrt_effect_ack.py src/qikvrt_effect_ack_http_terminal.py src/effect_ack_core.c /opt/qikvrt/src/
COPY include/qikvrt/effect_ack.h /opt/qikvrt/include/qikvrt/effect_ack.h
COPY browser/firefox/qikvrt-terminal/ /opt/qikvrt/browser/qikvrt-terminal/
COPY external/ietf/ /opt/qikvrt/ietf/
COPY appliance/qikvrt-mesh-v1/ /opt/qikvrt/appliance/
RUN set -eux; \
    chmod 0755 /opt/qikvrt/appliance/*.py /opt/qikvrt/appliance/*.sh; \
    python3 /opt/qikvrt/appliance/build_extension.py \
      --source /opt/qikvrt/browser/qikvrt-terminal \
      --bootstrap /opt/qikvrt/appliance/appliance_bootstrap.js \
      --output /opt/qikvrt/qikvrt-terminal.xpi \
      --sha256-file /opt/qikvrt/qikvrt-terminal.xpi.sha256; \
    install -m 0755 /opt/qikvrt/appliance/entrypoint.sh /usr/local/bin/qikvrt-appliance; \
    install -m 0644 /opt/qikvrt/appliance/qikvrt-browser.service /etc/systemd/system/qikvrt-browser.service; \
    mkdir -p /etc/systemd/system/multi-user.target.wants; \
    ln -sf ../qikvrt-browser.service /etc/systemd/system/multi-user.target.wants/qikvrt-browser.service; \
    printf '%s\n' '[Match]' 'Name=en* eth* ens*' '' '[Network]' 'DHCP=yes' > /etc/systemd/network/20-wired.network; \
    ln -sf /lib/systemd/system/systemd-networkd.service /etc/systemd/system/multi-user.target.wants/systemd-networkd.service; \
    printf '%s\n' '{"policies":{"DisableAppUpdate":true,"DisableTelemetry":true,"ExtensionSettings":{"qikvrt-ai-terminal@goldkelch.local":{"installation_mode":"force_installed","install_url":"file:///opt/qikvrt/qikvrt-terminal.xpi"}},"Preferences":{"xpinstall.signatures.required":{"Value":false,"Status":"locked"}}}}' \
      > /usr/lib/firefox-esr/distribution/policies.json; \
    chown -R qikvrt:qikvrt /opt/qikvrt /var/lib/qikvrt
USER qikvrt
WORKDIR /opt/qikvrt
EXPOSE 6080
VOLUME ["/var/lib/qikvrt"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD ["python3", "/opt/qikvrt/appliance/protocol_probe.py", "--health-only"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/qikvrt-appliance"]
CMD ["serve"]
