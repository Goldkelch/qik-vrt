+  "claims": [
+    {
+      "claim_id": "OPD-001",
+      "statement": "Determinate reality, as defined by Nonempty (Distinction α), entails the existence of two unequal values.",
+      "classification": "FORMAL_PROVED",
+      "status": "PROVED",
+      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
+      "scope": "Exact Lean definition of DeterminateReality and Distinction only.",
+      "proof_refs": [
+        "release/ontological-priority-of-difference-zenodo-v1/KERNEL_RECEIPT.json#QIKVRT.UniversalOntology.determinateReality_requires_difference"
+      ],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-002",
+      "statement": "If every pair of values is equal, determinate reality is impossible.",
+      "classification": "FORMAL_PROVED",
+      "status": "PROVED",
+      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
+      "scope": "NoDifference α := ∀ left right : α, left = right.",
+      "proof_refs": [
+        "release/ontological-priority-of-difference-zenodo-v1/KERNEL_RECEIPT.json#QIKVRT.UniversalOntology.noDifference_excludes_determinateReality"
+      ],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-003",
+      "statement": "If every pair of values is equal, no InformationWitness sourced by a Distinction can exist.",
+      "classification": "FORMAL_PROVED",
+      "status": "PROVED",
+      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
+      "scope": "InformationWitness is the exact source-bound structure in UniversalOntology/Core.lean.",
+      "proof_refs": [
+        "release/ontological-priority-of-difference-zenodo-v1/KERNEL_RECEIPT.json#QIKVRT.UniversalOntology.noDifference_excludes_information"
+      ],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-004",
+      "statement": "Am Anfang muss ein Unterschied gewesen sein, denn sonst wäre alles nichts.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "publication_wording": "INTERPRETATIVE_DECLARATION",
+      "scope": "Beginning means ontological priority; nothing means absence of determinate difference.",
+      "proof_refs": [],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-005",
+      "statement": "The theorem proves a first physical instant or empirical cosmogenesis.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "publication_wording": "INTERPRETATIVE_DECLARATION",
+      "scope": "Explicit negative boundary: no first-time, cosmogenesis, quantum-vacuum, or creation-from-nothing conclusion follows from the Lean theorems.",
+      "proof_refs": [],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-006",
+      "statement": "The physical universe instantiates the complete QIK-VRT Universal Ontology.",
+      "classification": "OPEN",
+      "status": "OPEN",
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "Requires independent reference binding, operationalization, evidence, known-limit recovery, prediction and validation.",
+      "proof_refs": [],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-007",
+      "statement": "The formal theorem is identical to Leibniz's Principle of the Identity of Indiscernibles.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "publication_wording": "INTERPRETATIVE_DECLARATION",
+      "scope": "Leibniz is a historical and conceptual reference; the QIK-VRT theorem is a distinct and weaker formal statement.",
+      "proof_refs": [],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-008",
+      "statement": "Zenodo publication by itself establishes scientific consensus or physical truth.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "publication_wording": "INTERPRETATIVE_DECLARATION",
+      "scope": "Explicit boundary: Zenodo establishes persistence/identity/availability of deposited bytes, not scientific consensus or physical truth.",
+      "proof_refs": [],
+      "evidence_refs": [],
+      "source_refs": []
+    },
+    {
+      "claim_id": "OPD-009",
+      "statement": "The public prose article traces a historical/conceptual line from the ontology of difference through Leibniz and later formal/technical developments to QIK-VRT.",
+      "classification": "SOURCE_BOUND",
+      "status": "BOUND",
+      "publication_wording": "SOURCE_ATTRIBUTED",
+      "scope": "Explanatory historical synthesis; it is not a claim that every cited predecessor already contained QIK-VRT.",
+      "proof_refs": [],
+      "evidence_refs": [],
+      "source_refs": [
+        "release/ontological-priority-of-difference-zenodo-v1/SOURCE_EVIDENCE_BINDINGS_V2.json#SRC-LEIBNIZ-PROSE"
+      ]
+    },
+    {
+      "claim_id": "OPD-010",
+      "statement": "The Leibniz/QIK-VRT scientific PDF records a scholarly comparison and the dimensions in which QIK-VRT adds machine-checkable scope, provenance, successor semantics and effect evidence.",
+      "classification": "SOURCE_BOUND",
+      "status": "BOUND",
+      "publication_wording": "SOURCE_ATTRIBUTED",
+      "scope": "Scholarly comparison artifact; the PDF itself does not establish empirical physical correspondence or scientific consensus.",
+      "proof_refs": [],
