diff --git a/release/ontological-priority-of-difference-zenodo-v1/CHANGE_NOTICE.md b/release/ontological-priority-of-difference-zenodo-v1/CHANGE_NOTICE.md
new file mode 100644
index 0000000000000000000000000000000000000000..59336af14d830aef76b27965daab5cc41a9d5d17
--- /dev/null
+++ b/release/ontological-priority-of-difference-zenodo-v1/CHANGE_NOTICE.md
@@ -0,0 +1,22 @@
+# Change notice
+
+This Zenodo candidate is a new scholarly object.
+
+It does **not** overwrite DOI `10.5281/zenodo.21582781`.
+
+The new contribution is the explicit formalization and scientific analysis of:
+
+> Am Anfang muss ein Unterschied gewesen sein, denn sonst wäre alles nichts.
+
+The candidate adds:
+
+- a dedicated scientific article;
+- three Lean theorems formalizing the bounded claim;
+- explicit distinction from Leibniz's Identity of Indiscernibles;
+- an information-theoretic interpretation boundary;
+- a formal/physical/empirical scope separation;
+- machine-readable claim and source/evidence bindings;
+- exact Zenodo publication gates.
+
+Historical artifacts remain historical. The new candidate requires fresh
+exact-head kernel evidence.
diff --git a/release/ontological-priority-of-difference-zenodo-v1/CLAIM_MATRIX_V2.json b/release/ontological-priority-of-difference-zenodo-v1/CLAIM_MATRIX_V2.json
new file mode 100644
index 0000000000000000000000000000000000000000..65d5171441d79a6740a8724e4f7b90eb23371e03
--- /dev/null
+++ b/release/ontological-priority-of-difference-zenodo-v1/CLAIM_MATRIX_V2.json
@@ -0,0 +1,107 @@
+{
+  "schema": "qikvrt_ontological_priority_claim_matrix_v2",
+  "publication_id": "qikvrt-ontological-priority-of-difference-2026-v1",
+  "claim_count": 10,
+  "claims": [
+    {
+      "claim_id": "OPD-001",
+      "statement": "Determinate reality, as defined by Nonempty (Distinction α), entails the existence of two unequal values.",
+      "classification": "FORMAL_PROVED",
+      "status": "PROVED",
+      "boundary": "Exact Lean definition of DeterminateReality and Distinction only.",
+      "proof_refs": [
+        "QIKVRT.UniversalOntology.determinateReality_requires_difference"
+      ],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-002",
+      "statement": "If every pair of values is equal, determinate reality is impossible.",
+      "classification": "FORMAL_PROVED",
+      "status": "PROVED",
+      "boundary": "NoDifference α := ∀ left right : α, left = right.",
+      "proof_refs": [
+        "QIKVRT.UniversalOntology.noDifference_excludes_determinateReality"
+      ],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-003",
+      "statement": "If every pair of values is equal, no InformationWitness sourced by a Distinction can exist.",
+      "classification": "FORMAL_PROVED",
+      "status": "PROVED",
+      "boundary": "InformationWitness is the exact source-bound structure in UniversalOntology/Core.lean.",
+      "proof_refs": [
+        "QIKVRT.UniversalOntology.noDifference_excludes_information"
+      ],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-004",
+      "statement": "Am Anfang muss ein Unterschied gewesen sein, denn sonst wäre alles nichts.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "boundary": "Beginning means ontological priority; nothing means absence of determinate difference.",
+      "proof_refs": [],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-005",
+      "statement": "The theorem proves a first physical instant or empirical cosmogenesis.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "boundary": "Explicit negative boundary: no first-time, cosmogenesis, quantum-vacuum, or creation-from-nothing conclusion follows from the Lean theorems.",
+      "proof_refs": [],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-006",
+      "statement": "The physical universe instantiates the complete QIK-VRT Universal Ontology.",
+      "classification": "OPEN",
+      "status": "OPEN",
+      "boundary": "Requires independent reference binding, operationalization, evidence, known-limit recovery, prediction and validation.",
+      "proof_refs": [],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-007",
+      "statement": "The formal theorem is identical to Leibniz's Principle of the Identity of Indiscernibles.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "boundary": "Leibniz is a historical and conceptual reference; the QIK-VRT theorem is a distinct and weaker formal statement.",
+      "proof_refs": [],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-008",
+      "statement": "Zenodo publication by itself establishes scientific consensus or physical truth.",
+      "classification": "INTERPRETATIVE",
+      "status": "DECLARED",
+      "boundary": "Explicit boundary: Zenodo establishes persistence/identity/availability of deposited bytes, not scientific consensus or physical truth.",
+      "proof_refs": [],
+      "sources": []
+    },
+    {
+      "claim_id": "OPD-009",
+      "statement": "The public prose article traces a historical/conceptual line from the ontology of difference through Leibniz and later formal/technical developments to QIK-VRT.",
+      "classification": "SOURCE_BOUND",
+      "status": "BOUND",
+      "boundary": "Explanatory historical synthesis; it is not a claim that every cited predecessor already contained QIK-VRT.",
+      "proof_refs": [],
+      "sources": [
+        "SRC-LEIBNIZ-PROSE"
+      ]
+    },
+    {
+      "claim_id": "OPD-010",
+      "statement": "The Leibniz/QIK-VRT scientific PDF records a scholarly comparison and the dimensions in which QIK-VRT adds machine-checkable scope, provenance, successor semantics and effect evidence.",
+      "classification": "SOURCE_BOUND",
+      "status": "BOUND",
+      "boundary": "Scholarly comparison artifact; the PDF itself does not establish empirical physical correspondence or scientific consensus.",
+      "proof_refs": [],
+      "sources": [
+        "SRC-LEIBNIZ-PDF"
+      ]
+    }
+  ]
+}
