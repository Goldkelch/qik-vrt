+    "language": "deu",
+    "keywords": [
+      "QIK-VRT",
+      "Ontologie des Unterschieds",
+      "Unterschied",
+      "Bestimmbarkeit",
+      "Information",
+      "Kausalität",
+      "Lean 4",
+      "formaler Beweis",
+      "Geltungsbereich",
+      "epistemische Spirale",
+      "Leibniz",
+      "Monadologie",
+      "Monaden",
+      "prästabilierte Harmonie",
+      "Provenienz",
+      "Effect Acknowledgement"
+    ],
+    "related_identifiers": [
+      {
