diff --git a/.github/workflows/qikvrt_ci.yml b/.github/workflows/qikvrt_ci.yml
index 652929632e179fb443279d90b43c24af3e866aa5..481130d103d7943534a042924a7ed6f8d6fa3599 100644
--- a/.github/workflows/qikvrt_ci.yml
+++ b/.github/workflows/qikvrt_ci.yml
@@ -184,3 +184,103 @@ jobs:
           path: ${{ env.EVIDENCE_ROOT }}
           retention-days: 30
           if-no-files-found: error
+
+  journey-reading-preview:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    env:
+      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+      # runner context does not exist at job-level env evaluation time.
+      PREVIEW_ROOT: /tmp/qikvrt-journey-preview
+    steps:
+      - name: Check out literal journey candidate without persisted credentials
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ env.EXPECTED_HEAD }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Detect complete journey source surface
+        id: detect
+        shell: bash
+        run: |
+          set -euo pipefail
+          if test -f docs/reise/REQUEST.json; then
+            test -f docs/reise/source.de.txt
+            test -f tools/qikvrt_journey_site.py
+            test -f tests/test_qikvrt_journey_site.py
+            echo 'present=true' >> "$GITHUB_OUTPUT"
+          else
+            echo 'present=false' >> "$GITHUB_OUTPUT"
+          fi
+      - name: Set up declared Python runtime
+        if: steps.detect.outputs.present == 'true'
+        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12'
+      - name: Verify tool cache contract
+        if: steps.detect.outputs.present == 'true'
+        run: python3 -B tools/qikvrt_tool_cache.py verify
+      - name: Test source binding and render available complete editions
+        if: steps.detect.outputs.present == 'true'
+        shell: bash
+        run: |
+          set -euo pipefail
+          test "$(git rev-parse --verify HEAD^{commit})" = "$EXPECTED_HEAD"
+          mkdir -p "$PREVIEW_ROOT"
+          python3 -B -m unittest discover -s tests -p test_qikvrt_journey_site.py -v \
+            2>&1 | tee "$PREVIEW_ROOT/tests.log"
+          python3 -B tools/qikvrt_journey_site.py preview \
+            --output "$PREVIEW_ROOT/index.html" \
+            | tee "$PREVIEW_ROOT/validation.json"
+          cp -R docs/reise "$PREVIEW_ROOT/source"
+      - name: Export canonical integrity proposal without mutating the checkout
+        if: steps.detect.outputs.present == 'true'
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B - <<'PY'
+          import hashlib, json, os, pathlib, subprocess
+          from tools import qikvrt_integrity as integrity
+          root = pathlib.Path(os.environ['PREVIEW_ROOT'])
+          root.mkdir(parents=True, exist_ok=True)
+          head = subprocess.check_output(['git','rev-parse','HEAD'], text=True).strip()
+          tree = subprocess.check_output(['git','rev-parse','HEAD^{tree}'], text=True).strip()
+          if head != os.environ['EXPECTED_HEAD']:
+              raise SystemExit('HOLD_UNVERIFIED: source head drift')
+          manifest, index, detached, _ = integrity.build_outputs()
+          hashes = {}
+          for name, data in ((integrity.MANIFEST_NAME,manifest),
+                             (integrity.INDEX_NAME,index),
+                             (integrity.DETACHED_NAME,detached)):
+              (root/name).write_bytes(data)
+              hashes[name] = {'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}
+          (root/'INTEGRITY_PROPOSAL.json').write_text(json.dumps({
+              'schema':'qikvrt_journey_integrity_proposal_v1',
+              'repository':os.environ['GITHUB_REPOSITORY'],
+              'source_head':head,'source_tree':tree,'files':hashes,
+              'mutation':'NONE','native_review':False,'public_delivery':False,
+              'EFFECT_ACK_DONE':False},indent=2)+'\n',encoding='utf-8')
+          PY
+          test -z "$(git status --porcelain=v1 --untracked-files=all)"
+      - name: Check all 47 editions without hiding missing translations
+        id: coverage
+        if: steps.detect.outputs.present == 'true'
+        continue-on-error: true
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B tools/qikvrt_journey_site.py coverage-check \
+            | tee "$PREVIEW_ROOT/coverage.json"
+      - name: Preserve exact-source reading preview and diagnostics
+        if: always() && steps.detect.outputs.present == 'true'
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: qikvrt-journey-preview-${{ env.EXPECTED_HEAD }}
+          path: ${{ env.PREVIEW_ROOT }}
+          retention-days: 30
+          if-no-files-found: error
+      - name: Enforce complete 47-edition coverage
+        if: steps.detect.outputs.present == 'true' && steps.coverage.outcome != 'success'
+        run: |
+          echo 'HOLD_UNVERIFIED: complete 47-edition coverage is not established.' >&2
+          exit 2
diff --git a/.github/workflows/qikvrt_journey_translation.yml b/.github/workflows/qikvrt_journey_translation.yml
new file mode 100644
index 0000000000000000000000000000000000000000..93c5a297f1673ed803462340f5aeaf6d8e340954
--- /dev/null
+++ b/.github/workflows/qikvrt_journey_translation.yml
@@ -0,0 +1,257 @@
+# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+# Copyright 2026 Ingolf Lohmann.
+name: QIKVRT finite journey translation materialization
+on:
+  push:
+    branches:
+      - publication/self-explanation-47-homepage-v1
+    paths:
+      - .github/workflows/qikvrt_journey_translation.yml
+      - tools/qikvrt_journey_translation.py
+      - tools/qikvrt_journey_recovery.py
+      - tests/test_qikvrt_journey_translation.py
+      - tests/test_qikvrt_journey_recovery.py
+      - docs/reise/TRANSLATION_RUNTIME.json
+      - runtime/toolchains/TOOLCHAIN.lock.tsv
+      - runtime/toolchains/CACHE_REGISTRY.json
+      - runtime/toolchains/CACHE_COVERAGE.json
+permissions:
+  contents: read
+jobs:
+  contract:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.13'
+      - name: Run deterministic transport and subject-boundary regressions
+        run: python3 -B -m unittest discover -s tests -p 'test_qikvrt_journey*.py' -v
+  recover:
+    needs: contract
+    if: >-
+      github.repository == 'Goldkelch/qik-vrt' &&
+      github.ref == 'refs/heads/publication/self-explanation-47-homepage-v1' &&
+      github.run_attempt == 1 &&
+      startsWith(github.event.head_commit.message, 'i18n(journey): recover prepared drafts and freeze translation runtime')
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.13'
+      - name: Verify current declared runtime before bounded preparation
+        run: python3 -B tools/qikvrt_tool_cache.py verify
+      - name: Rebind recovered drafts and generate optional runtime declarations
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: python3 -B tools/qikvrt_journey_translation.py prepare
+      - name: Preserve exact-head recovered content without ref mutation
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: journey-recover-bundle-${{ github.sha }}
+          # Only proposal data belongs in the bounded writer envelope. The
+          # optional whole-repository diagnostic ZIP is not a mutation input.
+          path: |
+            /tmp/qikvrt-journey-generation/files
+            /tmp/qikvrt-journey-generation/FILESET.json
+            /tmp/qikvrt-journey-generation/PUBLIC_BASELINE.json
+            /tmp/qikvrt-journey-generation/FAILURE.json
+          retention-days: 30
+          if-no-files-found: error
+  model:
+    needs: contract
+    if: >-
+      github.repository == 'Goldkelch/qik-vrt' &&
+      github.ref == 'refs/heads/publication/self-explanation-47-homepage-v1' &&
+      github.run_attempt == 1 &&
+      startsWith(github.event.head_commit.message, 'i18n(journey): translate 34 missing editions with pinned local model')
+    runs-on: ubuntu-24.04
+    timeout-minutes: 25
+    outputs:
+      manifest_sha256: ${{ steps.payload.outputs.manifest_sha256 }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.13'
+      - name: Verify persisted optional runtime declaration
+        run: python3 -B tools/qikvrt_tool_cache.py verify
+      - name: Provision exactly versioned optional CPU translation tools
+        run: |
+          set -euo pipefail
+          python3 -m venv "$RUNNER_TEMP/journey-venv"
+          "$RUNNER_TEMP/journey-venv/bin/python" -m pip install --disable-pip-version-check 'torch==2.8.0+cpu' --index-url https://download.pytorch.org/whl/cpu
+          "$RUNNER_TEMP/journey-venv/bin/python" -m pip install --disable-pip-version-check 'transformers==4.57.6' 'sentencepiece==0.2.1'
+      - name: Download and hash the pinned model payload
+        id: payload
+        env:
+          GH_TOKEN: ${{ github.token }}
+          HF_HUB_DISABLE_TELEMETRY: '1'
+          HF_HUB_DISABLE_IMPLICIT_TOKEN: '1'
+        run: '"$RUNNER_TEMP/journey-venv/bin/python" -B tools/qikvrt_journey_translation.py warm-model --model-root "$RUNNER_TEMP/qikvrt-nllb-payload"'
+      - name: Save only the verified model payload under this execution-head key
+        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830
+        with:
+          path: ${{ runner.temp }}/qikvrt-nllb-payload
+          key: qikvrt-journey-nllb-v1-${{ github.sha }}
+      - name: Preserve model provenance without publishing the model as a service
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: journey-model-${{ github.sha }}
+          path: /tmp/qikvrt-journey-generation
+          retention-days: 30
+          if-no-files-found: warn
+  translate:
+    needs: model
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      max-parallel: 8
+      matrix:
+        language: [ar, ast, bg, bn, ca, cs, el, eo, et, eu, fa, fi, gl, he, hr, hu, id, is, ja, kk, ko, lv, pl, ro, ru, sk, sl, sr, th, tr, uk, vi, zh-yue, zh]
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.13'
+      - name: Verify declared runtime
+        run: python3 -B tools/qikvrt_tool_cache.py verify
+      - uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830
+        with:
+          path: ${{ runner.temp }}/qikvrt-nllb-payload
+          key: qikvrt-journey-nllb-v1-${{ github.sha }}
+          fail-on-cache-miss: true
+      - name: Provision exactly versioned optional CPU tools
+        run: |
+          set -euo pipefail
+          python3 -m venv "$RUNNER_TEMP/journey-venv"
+          "$RUNNER_TEMP/journey-venv/bin/python" -m pip install --disable-pip-version-check 'torch==2.8.0+cpu' --index-url https://download.pytorch.org/whl/cpu
+          "$RUNNER_TEMP/journey-venv/bin/python" -m pip install --disable-pip-version-check 'transformers==4.57.6' 'sentencepiece==0.2.1'
+      - name: Translate every unprotected source block without truncation or fallback
+        env:
+          MODEL_MANIFEST_SHA256: ${{ needs.model.outputs.manifest_sha256 }}
+          TARGET_LANGUAGE: ${{ matrix.language }}
+          HF_HUB_OFFLINE: '1'
+          TRANSFORMERS_OFFLINE: '1'
+          HF_HUB_DISABLE_TELEMETRY: '1'
+          HF_HUB_DISABLE_IMPLICIT_TOKEN: '1'
+          TOKENIZERS_PARALLELISM: 'false'
+        run: '"$RUNNER_TEMP/journey-venv/bin/python" -B tools/qikvrt_journey_translation.py translate --language "$TARGET_LANGUAGE" --model-root "$RUNNER_TEMP/qikvrt-nllb-payload"'
+      - name: Preserve exact-source full-text draft
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: journey-translate-${{ matrix.language }}-${{ github.sha }}
+          path: /tmp/qikvrt-journey-generation
+          retention-days: 30
+          if-no-files-found: error
+  recover-successful-translation-objects:
+    needs: contract
+    if: >-
+      github.repository == 'Goldkelch/qik-vrt' &&
+      github.ref == 'refs/heads/publication/self-explanation-47-homepage-v1' &&
+      github.run_attempt == 1 &&
+      github.event.before == '968482b55b99aace753b43eb0e219eea45111d0c' &&
+      startsWith(github.event.head_commit.message, 'i18n(journey): recover successful exact-run drafts')
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: write
+      actions: read
+    concurrency:
+      group: qikvrt-repository-evidence-${{ github.ref_name }}
+      cancel-in-progress: false
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.13'
+      - name: Verify runtime before exact prior-run recovery
+        run: python3 -B tools/qikvrt_tool_cache.py verify
+      - name: Recover only independently successful exact-run drafts as content-addressed blobs
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: >-
+          python3 -B tools/qikvrt_journey_recovery.py
+          --input-run 34660991113
+          --input-head 968482b55b99aace753b43eb0e219eea45111d0c
+      - name: Preserve exact recovery receipt without ref mutation
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: journey-recovered-object-receipt-${{ github.sha }}
+          path: /tmp/qikvrt-journey-generation
+          retention-days: 30
+          if-no-files-found: error
+  record-objects:
+    needs: [contract, recover, translate]
+    if: >-
+      always() && needs.contract.result == 'success' &&
+      github.repository == 'Goldkelch/qik-vrt' &&
+      github.ref == 'refs/heads/publication/self-explanation-47-homepage-v1' &&
+      github.run_attempt == 1 &&
+      (needs.recover.result == 'success' || needs.translate.result != 'skipped')
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: write
+      actions: read
+    concurrency:
+      group: qikvrt-repository-evidence-${{ github.head_ref || github.ref_name }}
+      cancel-in-progress: false
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.13'
+      - name: Verify runtime and exact generated files before content-addressed writes
+        run: python3 -B tools/qikvrt_tool_cache.py verify
+      - name: Store and independently read back allowlisted Git blobs only
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PHASE: ${{ needs.recover.result == 'success' && 'recover' || 'translate' }}
+        run: |
+          set -euo pipefail
+          if [ "$PHASE" = recover ]; then
+            python3 -B tools/qikvrt_journey_translation.py objects --phase recover
+          else
+            python3 -B tools/qikvrt_journey_recovery.py
+          fi
+      - name: Preserve immutable object receipt for the connected branch writer
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: journey-object-receipt-${{ github.sha }}
+          path: /tmp/qikvrt-journey-generation
+          retention-days: 30
+          if-no-files-found: error
diff --git a/docs/reise/README.md b/docs/reise/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..2025cf32c8e5641b50cb16707de2d5141e1e2dcd
--- /dev/null
+++ b/docs/reise/README.md
@@ -0,0 +1,62 @@
+<!-- SPDX-License-Identifier: CC-BY-NC-ND-4.0 -->
+# Ich bin von dieser Reise zurückgekehrt
+
+Author and publication direction: **Ingolf Lohmann**.
+
+This is the candidate source surface for the requested 47-edition reading page.
+It preserves the complete owner-supplied German essay, including **Der Rückweg**,
+and the later supplied opening Spotify link. It is not a Wikipedia article or
+an assertion of an independently confirmed physical theory.
+
+## Exact source and scope
+
+- German source: `source.de.txt`, UTF-8/LF, 39,745 bytes.
+- Source SHA-256: `181314375effc68933baec365e7973a14ad3981605bb192f93a62c37a321f487`.
+- Source Git blob: `45c1f23cdf842ef5d92bfbef1d17da536b47f069`.
+- 540 source blocks; 20 separator blocks. The source file, not a prose summary,
+  is the authoritative translation input.
+- `WIKIPEDIA_47_LANGUAGE_SOURCE.json` supplies only the historical edition set.
+  Its old translation status does not apply to this new essay. The 47 include
+  the German original and Simple English; they are Wikipedia editions, not a
+  claim that Wikipedia has only 47 languages.
+- Translations are complete-text **ChatGPT drafts without independent language
+  review**, with immutable source and translation byte bindings.
+
+## Reproduce the reading preview
+
+From the repository root, using the declared Python runtime:
+
+```sh
+python3 -B tools/qikvrt_tool_cache.py verify
+python3 -B -m unittest discover -s tests -p test_qikvrt_journey_site.py -v
+python3 -B tools/qikvrt_journey_site.py check
+python3 -B tools/qikvrt_journey_site.py preview --output /tmp/qikvrt-journey/index.html
+python3 -B tools/qikvrt_journey_site.py coverage-check
+```
+
+The preview is explicitly incomplete until all 47 full texts are present.
+The initial candidate contains the German original and the English draft;
+45 editions remain unimplemented. Missing editions are disabled, not replaced
+by a different language or a link to an unarchived translation service.
+The coverage command must return a nonzero result while any edition is absent.
+Structural equality of block counts is not a proof of linguistic equivalence.
+
+The read-only preview job extends the existing QIKVRT CI workflow. It uploads
+an exact-head preview, coverage report and canonical integrity proposal without
+writing the checkout, changing a Git ref, merging, or deploying the website.
+The proposal must be independently checked and legitimately persisted before
+fresh exact-successor validation can be claimed.
+
+## Remaining delivery conditions
+
+Complete the remaining source-bound translations, validate their coverage and
+language quality, then follow the required exact-head validation, native review,
+post-review readback, legitimate Main promotion and exact-Main readback path.
+Public delivery requires a separate actual deployment and HTTP/content readback
+of the landing page and every available language route. The planned `/reise/`
+URL is not a delivered homepage until those observations exist.
+
+No native review, merge, deployment, Wikipedia/Zenodo/arXiv publication,
+independent empirical confirmation, PASS, FINAL_PASS or EFFECT_ACK_DONE is
+claimed here. The introduction email to Joachim remains deferred until the
+requested homepage is delivered.
diff --git a/docs/reise/RECOVERY.md b/docs/reise/RECOVERY.md
new file mode 100644
index 0000000000000000000000000000000000000000..b7fbfc0e3fab38928656a9cf388cc08c98639fac
--- /dev/null
+++ b/docs/reise/RECOVERY.md
@@ -0,0 +1,12 @@
+<!-- SPDX-License-Identifier: CC-BY-NC-ND-4.0 -->
+# Journey homepage: recovery of unattached implementation objects
+
+Fresh readback of `c3d0aa032803b1d985898f1791ddab9e37463142` established that only the German source, request, language registry and this recovery note were present under `docs/reise`. The previous sentence claiming the English translation already lived on that branch was incorrect. It is corrected here without rewriting history.
+
+The valid previously created tree `275bc64041d27d06075625e2ffd9c3de8c79fb52` contains the prepared full English draft, source-bound sidecar, reading-site generator, tests, read-only CI extension and README. Its existence was read back through the Git data API before this integration. This change attaches those objects to the existing branch history and preserves this corrected recovery note. It does not count orphan blobs as previously committed translations.
+
+German source: `source.de.txt`, blob `45c1f23cdf842ef5d92bfbef1d17da536b47f069`, including the opening Spotify link and both essay parts. English: `translations/en.txt`, blob `c027a649d472d16b816f487e0c1a479308a39916`, an unreviewed AI draft. All claims of coverage and source binding remain subject to actual execution of the candidate tests. No predecessor validation is transferred.
+
+The target remains `https://goldkelch.github.io/qik-vrt/reise/`. It is not yet a delivered homepage. Full coverage, exact-head validation, required native review, legitimate Main promotion and actual public HTTP/content readback are still required. No external publication or general completion is claimed.
+
+Attribution: source and direction supplied by Ingolf Lohmann; translation, integration, implementation and tests are ChatGPT assistance. Independent linguistic review is not claimed.
diff --git a/docs/reise/REQUEST.json b/docs/reise/REQUEST.json
new file mode 100644
index 0000000000000000000000000000000000000000..e529c9dd85ff3fef890db4ccaa1455f935732db8
--- /dev/null
+++ b/docs/reise/REQUEST.json
@@ -0,0 +1,68 @@
+{
+  "_license": {"copyright": "Copyright 2026 Ingolf Lohmann", "license": "CC-BY-NC-ND-4.0", "license_text_ref": "LICENSES/CC-BY-NC-ND-4.0.txt"},
+  "schema": "qikvrt_journey_47_request_v1",
+  "request_date": "2026-09-11",
+  "requesting_owner": "Ingolf Lohmann",
+  "publication_id": "qikvrt-returned-from-journey-47-v1",
+  "source": {
+    "path": "docs/reise/source.de.txt",
+    "language": "de",
+    "title": "Ich bin von dieser Reise zurückgekehrt",
+    "includes_second_part": "Der Rückweg",
+    "attributed_author": "Ingolf Lohmann",
