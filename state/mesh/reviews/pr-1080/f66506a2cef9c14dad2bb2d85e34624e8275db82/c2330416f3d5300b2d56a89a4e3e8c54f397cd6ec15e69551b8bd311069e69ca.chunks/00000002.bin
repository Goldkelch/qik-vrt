 aria-pressed="false"><span lang="kk" dir="auto">Қазақша</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="ko" aria-pressed="false"><span lang="ko" dir="auto">한국어</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="lv" aria-pressed="false"><span lang="lv" dir="auto">Latviešu</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="nl" aria-pressed="false"><span lang="nl" dir="auto">Nederlands</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="no" aria-pressed="false"><span lang="no" dir="auto">Norsk bokmål</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="pl" aria-pressed="false"><span lang="pl" dir="auto">Polski</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="pt" aria-pressed="false"><span lang="pt" dir="auto">Português</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="ro" aria-pressed="false"><span lang="ro" dir="auto">Română</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="ru" aria-pressed="false"><span lang="ru" dir="auto">Русский</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="sh" aria-pressed="false"><span lang="sh" dir="auto">Srpskohrvatski</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="simple" aria-pressed="false"><span lang="simple" dir="auto">Simple English</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="sk" aria-pressed="false"><span lang="sk" dir="auto">Slovenčina</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="sl" aria-pressed="false"><span lang="sl" dir="auto">Slovenščina</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="sr" aria-pressed="false"><span lang="sr" dir="auto">Српски</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="sv" aria-pressed="false"><span lang="sv" dir="auto">Svenska</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="th" aria-pressed="false"><span lang="th" dir="auto">ไทย</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="tr" aria-pressed="false"><span lang="tr" dir="auto">Türkçe</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="uk" aria-pressed="false"><span lang="uk" dir="auto">Українська</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="vi" aria-pressed="false"><span lang="vi" dir="auto">Tiếng Việt</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="wuu" aria-pressed="false"><span lang="wuu" dir="auto">吴语</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="zh-yue" aria-pressed="false"><span lang="zh-yue" dir="auto">粵語</span><small>Volltext · KI-Entwurf</small></button><button type="button" data-lang="zh" aria-pressed="false"><span lang="zh" dir="auto">中文</span><small>Volltext · KI-Entwurf</small></button></div></details>
