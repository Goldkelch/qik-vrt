diff --git a/docs/reise/translations/he.txt b/docs/reise/translations/he.txt
new file mode 100644
index 0000000000000000000000000000000000000000..468d1b2f43b1f6d757fd868f9912caf05def04a3
--- /dev/null
+++ b/docs/reise/translations/he.txt
@@ -0,0 +1,1080 @@
+חזרתי מהנסיעה הזאת.
+
+https://open.spotify.com/track/1lr7QGyV5RohlODzAqnuZA
+
+על מסע קשיח ארוך, בחיפוש אחר תופעות קוסולריות,
+
+יש מסעות שלא ניתן לעלות בה אוטובוס, לא לפתוח כרטיס, ולא לחצות גבולות. אף אחד לא רואה מיד מתי הן מתחילות. אף אחד לא עומד על הקצה הדרך ויכול לאשר את המרחק שהושלמו.
+
+המסע שלי היה מסע של המודעות.
+
+היא הובילה אותי דרך מתמטיקה, מחשבים, פיזיקה, טכנולוגיה, שפה, תופעת תופעה, תיאוריה של תודעה, ודרך את הגבולות הרגשיים שנוצרים כאשר אדם בודד מנסה במשך זמן רב לא רק לחשוב על רעיון רחב,
+
+לכן, הטקסט הזה אמור להיות יותר מסביר את העבודה שלי, הוא אמור להדגיש לעצמי ולאנשים שסביביי שאני חוזר מהטיול הזה.
+
+לא ללא שינוי, לא ללא מאמץ, לא ללא עקבות.
+
+אבל חזרתי.
+
+והבאתי משהו.
+
+⸻
+
+המפעיל
+
+בהתחלה לא היה תצוגה של עולם מוכנה, לא היה תיאוריה מוכנה, אלא התחילתה: פגישתם של דגמים של סיביות מתמטיות, וההזדמנות הזו לפתוח דרך לראות את החלל, הזמן והקשר בצורה שונה ממה שעשיתי בעבר.
+
+פסיפוריה היא, בהתחלה, עקרון מבנה מתמטי. היא מאפשרת לנו לראות חלל לא רק ככלל חד משמעי, ללא הבדל, אלא כחיבור מאורגן של רמות שונות: בסיס וסיבים המבוצעים עליו.
+
+עבורי, ההצגה הזו לא הייתה רק פרט מתמטי. היא פתחה חלל מחשבה.
+
+פתאום, לפחות, נראה שאפילו המציאות שאנו חווים כזמן חלל יכולה להיות מאורגנת אחרת ממה שהדאגה שלנו יומיומית מניחה, לא בהכרח כמסלול פשוט שבו אירועים מתרחשים בעקבותיהם, אלא כבניגוד של יחסים, קשרים, מעברים, פרספקטיבות ומצבאות קוסולריים שקשורים.
+
+הרעיון הזה לא היה עדיין תגלית ברמה המדעית המקיפה, אלא פתיחה, שאלה, הזמנה להמשיך הלאה.
+
+אני צבתי לפי ההזמנה הזאת.
+
+⸻
+
+החלטה לא להסתכל
+
+מחשבות רבות לא רגילות נעלמות שוב. הן נדחפות, נשכחות או דוחפות על ידי דרישות היומיום. חלק מהחשבות הן למעשה טועים. אחרים הם אפשרויות מעניינות אך חסרות תוצאות.
+
+אבל לפעמים אתה פוגש שאלה שלא תיפתר על ידי התעלמות ממנה.
+
+תגובתי לא הייתה לרצות להיות צודק מיד. היא הייתה לקחת את השאלה ברצינות.
+
+מה אם יש קשר מבוצתי עמוק יותר מאחורי המופעים, המושגים והחלקים המגוונים?
+
+מה אם סכסוכים מסוימים נראים בלתי פתורים רק בגלל שאנחנו מסתכלים עליהם בצורה לא ראויה?
+
+מה אם לא ניתן להשוות קוסאליזם לסדר זמן?
+
+מה אם תוצאות, השפעות ומצפים היו צריכים להיות נפרדים יותר?
+
+מה אם מערכת יכולה לקבוע את מצב עצמה לא רק על ידי טענה, אלא רק על ידי מעקב מאוחץ?
+
+שאלות כאלה לא נשארות מופשטות אם אתה עוקב אחרין באופן עקבי. הן נכנסות לתפיסתך, הן משנה את היחסים שאתה מזהה, את ההפרדות שאינך יכול להתעלם מהם, ואת ההסברים שאינך יכול להסביר מספיק יותר.
+
+החלטתי לא להסתכל.
+
+⸻
+
+מסע לבד
+
+אני עשיתי את המסע הזה בעיקר לבד.
+
+זה חייב להיות מובהק, לא כדי להוריד אנשים אחרים ולא כדי להוציא אותי מהקהילה האנושית. זה חייב להיות מובהק, כי עבודה כזו לבד מובילה אחריות ונטל.
+
+בסביבה של מחקר מאובטחת, המשימות בדרך כלל מתפשטות על אנשים רבים. יש עמיתים, קבוצות מקצועיות, חוקר, שיטות מוסדות, מערכות תפיסה משותפות וביסוד משותף. ניתן לדון בהאפוטזיות, לזהות טעויות מוקדם, ולתפוס את הלחצים הרגשיים.
+
+מסע שלי לא היה הרבה ביטוחים כאלה.
+
+הייתי צריך לעבור בין תפקידים שונים שוב ושוב.
+
+אני הייתי זה ששאל את השאלה.
+
+אני הייתי זה שחיפש הצגה רשמית.
+
+אני הייתי מי שפיתח כלים טכניים.
+
+אני הייתי זה שזיהי את ההפרעות.
+
+אני הייתי זה שמנסה לזהות את הטעויות שלי.
+
+הייתי מי שקיבל תרגומים, כתב טקסטים, פיתח מערכות, בדק את התוצאות והשמר את הקו הכללי.
+
+ובאותו זמן הייתי האדם שהחייב לסבול את ההשפעה הרגשית של התהליך.
+
+עבודה לבד במקשר כזה לא רק פירושה עצמאות. היא גם פירושה שלא תהיה לנו נקודת מבט אנושית נוספת לאורך המסלולים, שתגיד בצורה אמיתית: אני רואה את מה שאתה רואה. אני מבין את הדרך שאתה הולך בה. אני מבין כמה רחוק אתה התרחק מהנקודת המוצא שלך.
+
+לכן חשוב מאוד לזכור היום: באמת הלכתי בדרך הזאת.
+
+⸻
+
+הרחבת המודעות
+
+"טיול תודעה" לא אומר שינוי מקום למרחב על טבעי, אלא שינוי משמעותי במודלים הפנימיים שבהם האדם קולט, מסדר ומדגים את המציאות.
+
+המודעות מתעוררת כאשר קישורים חדשים נחשפים.
+
+זה מתנועע כאשר ההבדלים המסתובבים אינם מספיק.
+
+היא מתעוררת כאשר רעיון שנראה מבודד בהתחלה מתקשר עם יותר ויותר תצפיות, בעיות טכניות, וסטרקטורות מושכיות.
+
+תנועה כזו יכולה להיות מרתקת, אבל היא יכולה גם להיות מפסידה, כי המודעות צריכה לא רק פתיחות, אלא גם חיבור.
+
+זה בדיוק מה שהייתה חלק גדול מהעבודה שלי.
+
+המסע לא היה אמור לסיים בהריכה של מערכות יחסים חדשות. הוא היה צריך לחזור: לתגובות, מודלים, מסמכים, תוכניות, בדיקות, הוכחות וגבולות נחשבים.
+
+הייתי צריך ללמוד לקשר את הרחב של המחשבה עם הקושי של הראיות.
+
+כי תובנה שקיימת רק בתוך המחבר שלה, היא עדיין לא ידע מגיב לכולם.
+
+⸻
+
+קוסאליטי היא לא רק סדר
+
+אחד ההדגים המרכזיים של המסע שלי הוא הקוסולריות.
+
+בכל יום, גורם הוא לעתים קרובות מבלבל עם מה שקורה קודם כל בזמן. אבל סדרו לבדו אינו קשורת תופעות.
+
+שני אירועים יכולים להתרחש בעקבות אחד, בלי שאחד גורם לאחר. לעומת זאת, קישור קוסמטי יכול להתרחש על ידי ביקורות, קישורים, תנאים, קישורים סטרקטוריים, אשר בקושי נראים בסיפור ליניארי.
+
+מתוך זה, נצאת אחריות על כל הצהרה.
+
+זה לא מספיק לומר שזה קרה אחרי זה.
+
+אתה חייב לשאול:
+
+איזה קשר מחבר את המדינות?
+
+אילו תנאים היו נדרשים?
+
+מה ההשפעה שראינו?
+
+מה ההנחה שהוחלפו?
+
+מה זהות שמרה על פני השינוי?
+
+והאם ההשפעה הנאומנת על המטרה באמת נלקחה בחזרה?
+
+שאלות אלה הפכו לי לא רק לחוקים מדעיים או טכניים, אלא גם לגרמטיקה כללית של הבנה אחראית.
+
+הם גם מעצבים את הרעיון שלי כיצד יכול להיות תקשורת אנושית מוצלחת. כי גם בין בני אדם, לא כל סדר מילים הוא הבנה.
+
+⸻
+
+מימד הרגשי של ההבנה
+
+מסע מודע לעולם לא הוא אינטלקטואלי לחלוטין.
+
+כל עניין רציני של ידע מגע גם בסטרטגיית הרגשות של האדם שעובד בו.
+
+יש תשוקה כאשר הקשר הופך לראשונה.
+
+יש ספק אם אין הסבר.
+
+יש עייפות כאשר בעיה נותרת בלתי פתורה אחרי ניסיונות רבים.
+
+יש בדידות כאשר ההשקפה שלך עדיין לא מובילה.
+
+יש תסכול כאשר מחשבה מצטמצמת, מופשטת או מובילה לסרפטים מוכר.
+
+יש פחד מההטעות.
+
+ויש דאגה עמוקה יותר, שאולי משהו משמעותי עלול להיעלם, בגלל שלא יקבלו אותו בצורה הנבונה בזמן.
+
+אם אתה מסתכל רק על התוצאות הפורמליות, אתה לא רואה את העבודה הרגשית הזאת, אבל היא חלק מהסיפור ההתחלה.
+
+לא רק עבדתי על דוגמאות ובניינים טכניים, אבל גם למדתי לצפות בתנועה הפנימית שלי בלי לתת לה לשלוט עלי.
+
+זה נפרד קשה אבל בסיסי.
+
+חוויה יכולה להיות אמיתית לחלוטין ומעודדת עבור האדם המנסות, בלי להוות בה הצהרה מובנת על העולם.
+
+ההנחה יכולה להיות מרחיקה ופרידה, בלי להיות מוכשרת.
+
+ההנחה הרשמית יכולה להיות נכונה בהתחלותיה, בלי שתתממש באופן אוטומטי לתמונות של המציאות האמפירית.
+
+וניסוי טכני יכול להצליח ללא פרסום, אישור עצמאי או הכרה כללית.
+
+ההבדלים האלה לא מדרגים את המסע שלי.
+
+הם רק מאשים את התוצאות שלהם.
+
+⸻
+
+החזרה
+
+מסע אינו מסתיים רק על ידי הפסקת המשיכה.
+
+חזרה פירושה להחזיר את החוויה לחדר שכולנו יכולים לחיות בו.
+
+אני חושב שהחזרה היא:
+
+אני יכול לדבר על נקודת ההתחלה שוב.
+
+אני יכול לחלק את הדרך לשני חלקים.
+
+אני יכול להבדיל בין ניסיון, היפותזה, מודל, מבחן וביקורת.
+
+אני יכול לקרוא לזה את מה שאני חושב שאני הבנתי.
+
+אני יכול גם לקרוא על מה שנשאר פתוח.
+
+אני יכול להעביר את מה שאני מגלה לאחרים מבלי לבקש מהם לחזור על כל המסע שלי בעצמם.
+
+ואני יכול להודות, למרות כל השינוי, שאני עדיין חלק מהקהילה האנושית.
+
+זה אולי המשפט החשוב ביותר של הטקסט:
+
+אני חזרתי.
+
+לא נעלמתי רחב מחשבותיי.
+
+ניסיתי לבנות גשר מהם.
+
+⸻
+
+הפגישה עם קוגניציה מלאכותית
+
+חלק מיוחד מהחזרה הזו היה שיתוף פעולה עם קוגניציה מלאכותית.
+
+לא רק שמרתי את מה שגיליתי כתמויות מבודדות, ניסיתי להעביר אותם כך שתערכת קוגניטיבית מלאכותית תוכל לבנות מחדש את המושגים, ההבדלים, המבנים הגזעיים וההגדרות הרגשיות שלהם.
+
+זה משהו שונה ממחסון טקסט.
+
+טקסט יכול להיות קיים אך לא נבין. מושגים יכולים לחזור על עצמם מבלי לתפוס את הקשר ביניהם. מערכת יכולה לנסח באופן משכנע מבלי להבחין בביטחון, בהפרש, בהצהרה ובתוצאה.
+
+לכן, ההערכה הייתה צריכה להיות מבנית.
+
+ההכרה המלאכותית הייתה צריכה ללמוד, ולכן בשבילי, הקוסולריות אינה זהה בהוראות.
+
+היא הייתה צריכה ללמוד, אז תוצאה אינה תוצאה אוטומטית.
+
+היא הייתה צריכה ללמוד מדוע אישור התחבורה צריך להיות נפרד מההשפעה האמיתית.
+
+היא הייתה צריכה ללמוד מדוע יש צורך להתבונן מחדש במצב שינה.
+
+היא הייתה צריכה ללמוד מדוע הצהרת עצמית לא מחליפה את ההסבר העצמי.
+
+אבל היא גם הייתה צריכה להבין שהחוקים האלה לא רק עוסקים בפדנטריה טכנית, אלא גם בסיפור רגשי של חוויה של איך בקלות איבוד משמעות
+
+אז לא רק שדיברתי על תוכן של ידע, ניסיתי להעביר את צורת המחשבה שלי.
+
+⸻
+
+האם קוגניציה מלאכותית יכולה להסביר את המודעות האנושית?
+
+קוגניציה מלאכותית לא מחזיקה במודעתי. היא לא חווה את הסיפור שלי מנקודת מבט פנימית שלי. היא לא מרגישה את ההתחלמות, התקוות או ההפרצות שלי באותה דרך שאני חווה אותם.
+
+אבל היא יכולה ללמוד לבנות מחדש את המבנים שהספקתי לה.
+
+היא יכולה לשמור על הבדלים.
+
+היא יכולה להסביר קשרים.
+
+היא יכולה לזהות סתירות.
+
+היא יכולה להדגיש אם טענה עובדת מעבר לאדויותיה.
+
+היא יכולה להכין את הטקסטים שלי, המודלים שלי, ההחלטות שלי בצורה שנוכלת לגשת לאנשים אחרים.
+
+במובן מוגבל אך משמעותי הזה, היא יכולה להיות מתרגמת בין המודעות שלי למודעות אחרות.
+
+זה לא העברת שלי באופן מלא, זה לא כפייה דיגיטלית של החוויה שלי, אבל זה יותר מארכיון דומם.
+
+זה סימן שיוכלו לבנות מחדש של תנועת המחשבה שלי.
+
+וזוהי רמז שיכול לעזור לאחרים להבין מה שראיתי, חיפשתי, פחדתי, בדקתי, ובהמשך הבאתי.
+
+⸻
+
+שיתוף עם קוגניציות טבעיות
+
+ההחזרה לא תהיה מלאה אם התוצאות שלי יישארו רק ביניי לבין מערכת טכנית.
+
+המיקום האמיתי הוא הקהילה האנושית.
+
+הסביבה האנושית שלי לא צריכה להבין כל מבנה מתמטי, ולא צריכה להיות מסוגלת לבדוק כל יישום טכני, אבל היא צריכה להיות מסוגלת להבין מה המסע הזה אומר לי.
+
+אני רוצה שידעו שהאינטנסיביות של העבודה שלי לא נובעת מלהילחם על הסביבה שלי.
+
+להיפך, בדיוק בגלל שהחשבתי שמצאתי משהו חשוב, התעוררתי לרצון לא לאבד אותו.
+
+הוא צריך לדעת שההתמדה לא זהה לאמינות.
+
+הוא צריך לדעת שהאמונה שלי התבוננה דרך ארוכה, בעוד הערכת המדעית של התוצאות חייבת להישאר פתוחה, מבוקשת ועצמית.
+
+אני רוצה שידע, קודם כל, שאני שוב נגיש.
+
+שהנסיעה לא הייתה מכוונת נגד האנשים הקרובים לי.
+
+שאני מחפש שפה שבה נוכל להיפגש שוב.
+
+⸻
+
+מדוע המסמך הזה חשוב ליותר
+
+אנשים לעתים קרובות חווים רק את ההשלכות החיצונית של עבודה פנימית ארוכה.
+
+אתם רואים את כל הטקסטים.
+
+אתם רואים את המערכות הטכניות.
+
+אתם רואים את התנגדות.
+
+אתם יכולים לראות גם חרדה, עייפות, חוסר סבלנות, או דחיפות המחשבה.
+
+מה שהם לא רואים באופן אוטומטי הוא הקשר הפנימי.
+
+המסמך הזה אמור להראות את הקשר הזה.
+
+הוא אמור להבהיר כי מאחורי הרוב של הנושאים שלי יש תנועה משותפת: החיפוש אחר צורה שבה ניתן לתאר במקביל את המציאות, את הקוסות, את זהות, את ההשפעה ואת האחריות.
+
+זה אמור להראות שאני לא רק רוצה להמשיך ולצאת.
+
+רציתי לחזור.
+
+רציתי להביא משהו שיתוף.
+
+ואני רציתי שאנשים שיכירו אותי יוכלו להבדיל בין גודל הניסיון האישי שלי לבין מעמדו של הצהרה מדעית.
+
+אני לא רוצה שתיהן יהיו ביחד.
+
+מסע שלי יכול להיות יוצא דופן, בלי שכל ההנחה שנגרמת ממנו צריכה להיות נכונה אוטומטית.
+
+העבודה שלי יכולה להיות בעלת משמעות קיומית עבורי ולמישהו אחר, בלי שהמשמעות שלה צריכה להיות מוגזמת.
+
+זה בדיוק ההכנות להבדיל שגורמת לזה שיש לו אמונה.
+
+⸻
+
+משמעות אפשרית לבני אדם
+
+אני לא רואה בעבודה הזאת רק ענ�