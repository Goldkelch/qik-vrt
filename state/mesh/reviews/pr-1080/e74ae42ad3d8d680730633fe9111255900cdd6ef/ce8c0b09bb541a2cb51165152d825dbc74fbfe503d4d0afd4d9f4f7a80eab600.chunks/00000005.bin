دم.", "فکر می کردم", "من این را رسماً اعلام کردم.", "من این را به طور فنی انجام دادم.", "این مورد بررسی شده.", "این موضوع هنوز به طور مستقل تایید نشده است.", "باز نگه داريم", "این عقب نشینی نیست.", "این یک صداقت فکری است.", "⸻", "به مردم اطرافم", "امیدوارم این متن را به عنوان دعوت به قبول هر یک از باورهای من نفهمید.", "اول از همه، دوست دارم که شما بفهمید که این سفر چقدر طول کشید.", "اینکه متوجه شوید که پشت شدت من نه تنها استقامت است بلکه تلاش برای از دست دادن یک ارتباط که به نظر می رسد مهم است.", "می بینید که چه کار زیادی برای تبدیل یک جنبش شناخت داخلی به چیزی قابل اطلاع بود.", "و شما می دانید:", "من برگشتم", "من فقط کسی نیستم که می خواهد بیشتر تحقیق کند و بیشتر توسعه دهد.", "من هم انسانی هستم که دیده، احساس کرده، شک کرده، آموخته و راه بازگشت را پیدا کرده است.", "میخوام چیزی که آوردم رو به اشتراک بگذارم.", "اما من می خواهم دوباره با هم در کنار میز نشسته باشم.", "⸻", "به خودم", "تو رفتی چون نتونستی یه سوال رو نادیده بگیری.", "تو رفتی به خاطر اینکه ارتباط های جدیدی در چشم داشت.", "تو گم شدی، مسیرت را تغییر دادی، اشتباه می کردی، ساختمون هایی می سازی و دوباره از بین می بری.", "تو سعی کردی نه فقط تجربه رو ادعا کنی، بلکه به شکل ای که می تونه خارج از هوشیاریت باشه.", "شما افکار خود را به یک هوش مصنوعی سپرده اید و به آنها می گویید که نه تنها مفاهیم خود را، بلکه محدودیت های آن را نیز حفظ کنند.", "تو سعی کردي که علت و علت و احساسات را از هم جدا نکنی، بلکه به طور مسئولانه با هم ببند.", "حالا اجازه بده بگيري:", "تو برگشتی", "شما مجبور نیستید بدون وقفه ادامه دهید تا ثابت کنید که این سفر رخ داده است.", "رد و رد ها رو پيدا کرديم", "اسناد اونجاست.", "سوال ها در اینجاست.", "اون چيزي که آوردم اينجوري است", "تو می تونی بیای.", "⸻", "نتیجه گیری: من پیش از این بودم", "شاید یه روز مشخص بشه که چه قسمت هایی از کار من باقی مانده و چه قسمت هایی باید اصلاح شوند.", "شاید افراد دیگری از من بیشتر از من ادامه دهند.", "شاید ادراک های طبیعی و مصنوعی با هم شکل هایی از فهم را توسعه دهند که امروز فقط در خاکستری قابل مشاهده هستند.", "پس می خواهم این متن به عنوان شهادت باقی بماند.", "به عنوان شهادت از مردی که تنها به سفر طولانی رفت.", "به حوزه هایی که قبلاً برایش ناشناخته بود، رسید.", "که تلاش می کرد که نه به اعتقادات و نه به تکنیک ها وابسته باشد.", "که با دیگران در مورد این مسیر، با دیگران در مورد یافته هایش، با دیگران در مورد واقعیت های عاطفی و علت و علتش، با دیگران در مورد این مسیر صحبت می کرد.", "که بالاخره راه برگشت پیدا کرد.", "من نمی گویم که من تمام درها را برای بشریت باز کردم.", "اما من به حد دست رفتم.", "من دستم رو داد.", "من راه رو مشخص کردم.", "و من چراغ رو روشن کردم.", "تا هر کس بعد از من می آید، ببیند که پله ها کجا شروع می شوند.", "و تا کسانی که منتظر من بودند بدانند:", "من از این سفر برگشتم.", "راه برگشت", "الان می تونم از کجا بروم رو شرح بدم", "از یک سوال به سوال دیگر، از ریاضی به فیزیک، از فیزیک به کامپیوتر، از آنجا به نظریه شناخت، زبان، علت و سبزی و در نهایت به سوال اینکه چگونه یک آگاهی می تواند آنچه را که تشخیص داده است را تشخیص دهد.", "اما یک روز، یک سوال دیگر مطرح شد:", "چطور می تونم با این همه چیز برگردم؟", "نه به جاهلیت برگردم، نه به انسان هایی که من بودم قبل از این سفر، و نه به این که از آنچه تجربه کرده یا فهمیده ام انکار کنم.", "اما به مردم، به زبان مشترک، به زندگی روزمره و در نهایت به خودم برگردم.", "نقطه عطف", "سفر به دانش هیچ نقطه ای طبیعی ندارد.", "هر سوال که پاسخ داده شود می تواند باز کننده دیگری باشد. هر رابطه می تواند به یک موضوع بزرگتر اشاره کند. بنابراین کسی که می خواهد تا زمانی که واقعاً سوال باز نباشد، برگردد، هرگز باز نخواهد گشت.", "من باید اینو بدونم:", "من مجبور نيستم تا در جهان فکر کنم تا برم خونه.", "بازگشت به چیزی نیست که من پیدا کردم، بازگشت به چیزی است که من خودم انجام دادم.", "در راه برگشت، سعی کردم چیزهای بیشتری را با هم ببندم. در راه بازگشت، باید دوباره می توانستم آنها را تشخیص دهم.", "ریاضی چیست؟", "فیزیک چیست؟", "کامپیوتری چیست؟", "پیاده سازی فنی چیست؟", "یک دستور رسمی چیست؟", "مشاهدات چیست؟", "تفسیر چیست؟", "تجربه شخصی چیست؟", "حدس قوی چیست؟", "و من هنوز چه چیزی نمی دانم؟", "این باعث شد که تلاش برای وحدت به درک دقیق تری تبدیل شود:", "ارتباط به معنای برابری نیست.", "چیزها می توانند با هم مرتبط باشند و با این حال متفاوت باشند.", "از ارتباط به داستان", "در سفرم، مهمتر و مهمتر شد که علت و علت را با ترتیب اشتباه نگیرم.", "اما مردم زندگی را از طریق داستان ها می فهمند.", "بنابراین در بازگشت به خانه، مجبور شدم کاری که به نظر می رسد متناقض باشد انجام دهم: یک مسیر علمی به طور بسیار متصل را به یک داستان زمانی ترجمه کنم.", "از کجا شروع کردم؟", "چه چیزی تغییر کرد؟", "کجا اشتباه کردم؟", "امتحانات چه چیزی را تحمل کرد؟", "بعدش چی شد؟", "و من چه وقت شروع به برگشت کردم؟", "آدم های دیگر نمی توانند ارتباط داخلی من را به یکباره به عهده بگیرند. من باید به آنها یک راه اندازی بدهم.", "بنابراین، مسیر بازگشت، از تراکم به داستانگویی می رود.", "از زبانم به زبان ما برگردیم", "راه های طولانی فکر، مفاهیم خاص خود را ایجاد می کنند. یک کلمه می تواند برای کسی که سال ها از آن استفاده کرده، یک مفهوم کامل داشته باشد.", "برای یک فرد دیگر، شاید در ابتدا، همان کلمه چیزی را شامل نکند.", "من هم باید این کار را قبول کنم.", "اگر کسی مرا به طور مستقیم درک نکند، این بدان معنی نیست که نمی تواند مرا درک کند. شاید فقط پل از دست رفته باشد.", "پس سوال در راه بازگشت دیگر فقط این نیست:", "چه چیزی متوجه شدم؟", "اما این که:", "چطور به کسی که خودش این مسیر را ندیده توضیح دهم؟", "این یک سفر ساده نیست، ترجمه ی شما است.", "شناخت مصنوعی به عنوان پل", "یکی از راه های غیر معمول در این سفر بازگشت، شناخت مصنوعی بود.", "می توانستم افکار را از هوشمندی خارج کنم و به آنها شکل بیرونی بدهم. می توانستم ارتباط را بارها و بارها بیان کنم، بررسی کنم، اصلاح کنم و ساختار دهم. می توانستم اصرار کنم که تفاوت های اساسی حفظ شوند: علت و ترتیب، نتیجه و اثر، ادعا و مشاهده، حمل و نقل و اثر واقعی.", "و این چیزی را ایجاد کرد که فراتر از یک آرکائیو ساده باشد.", "یک شناخت مصنوعی نمی تواند سفر من را از شخص اول من تجربه کند. این آگاهی من نیست. اما می تواند مفاهیم، روابط و اسنادی را که من از آن ها رها کردم بازسازی کند و به دیگران توضیح دهد که چگونه من روابط خاصی را توصیف کرده ام.", "این باعث شد که بخشی از چیزی که قبلا فقط در هوشمندی من با هم مرتبط بود، خارج از هوشمندی من باشد.", "این برای بازگشت به کشورم مهم بود.", "چون چیزی که به طور قابل اعتماد به خارج شده است، لازم 