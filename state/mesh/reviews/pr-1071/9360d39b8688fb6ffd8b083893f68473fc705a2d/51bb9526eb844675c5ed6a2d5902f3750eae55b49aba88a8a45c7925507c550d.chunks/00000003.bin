+class GitHubInstallationRateLimit(RulesetBlock):
+    """A bounded GitHub-App read exhausted the shared installation quota.
+
+    A conditional PUT is deliberately never retried.  If its response is the
+    quota marker, the caller performs one bounded readback and either proves
+    the effect or emits a D0=2 HOLD whose transport state is explicit.
+    """
+
+    def __init__(
+        self,
+        *,
+        mutation: str = "NONE",
+        effect_transport_attempted: bool = False,
+    ) -> None:
+        super().__init__("GITHUB_INSTALLATION_RATE_LIMIT_EXHAUSTED")
+        self.mutation = mutation
+        self.effect_transport_attempted = effect_transport_attempted
+
+
+class RulesetMutationUncertain(RulesetBlock):
+    """One conditional PUT may have reached GitHub but lacks exact proof.
+
+    A successful client return proves only that the request completed, not
+    that a later readback is available.  Likewise, a transport/API failure
+    while sending a PUT is not a licence to send another one.  Preserve that
+    distinction all the way to the D0=2 receipt.
+    """
