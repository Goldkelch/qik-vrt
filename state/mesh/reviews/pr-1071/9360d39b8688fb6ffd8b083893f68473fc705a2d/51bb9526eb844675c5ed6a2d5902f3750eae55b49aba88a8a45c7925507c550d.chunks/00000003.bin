+def reobserve(token: str, policy: Mapping[str, Any]) -> dict[str, Any]:
+    """Read and evaluate the exact ruleset without admitting a mutation.
+
+    This is the only recovery operation allowed after a previous conditional
+    PUT may have reached GitHub but its readback was unavailable.  A later
+    carrier may choose an ordinary reconcile only after this isolated
+    observation proves the current server state is still DRIFT.
+    """
+
+    repository = policy["repository"]
+    ruleset_id = policy["ruleset_id"]
+    url = f"https://api.github.com/repos/{repository}/rulesets/{ruleset_id}"
+    observed, _etag = _request("GET", url, token)
+    return evaluate(observed, policy)
+
