+            "REOBSERVE_EXACT_EVENT_TARGET",
+            source="NATIVE_REVIEW_EVENT",
+            first_blocker="NATIVE_REVIEW_EVENT_HEAD_MISSING_OR_INVALID",
+            pr_numbers=[number],
+        )
+    return _selection(
+        "CANDIDATE",
+        source="NATIVE_REVIEW_EVENT",
+        pr_numbers=[number],
+        expected_head=head,
+    )
+
