     def test_exact_head_qce_verification_cannot_mutate_frozen_package_inventory(self) -> None:
         self.assertIn('qce_tmpdir="$(mktemp -d "${RUNNER_TEMP}/qikvrt-qce-exact-head.XXXXXX")"', self.exact_head_text)
