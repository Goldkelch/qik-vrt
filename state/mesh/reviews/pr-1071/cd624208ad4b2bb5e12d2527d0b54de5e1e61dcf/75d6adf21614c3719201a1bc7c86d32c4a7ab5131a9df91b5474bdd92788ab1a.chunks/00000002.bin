+            "action": "submitted",
+            "repository": {"full_name": "example/qik-vrt"},
+            "sender": {"login": "Goldkelch", "type": "User"},
+            "pull_request": self.selector_pr(
+                base={"ref": "main", "repo": {"full_name": "example/qik-vrt"}},
+                user={"login": "ingolf-lohmann", "type": "User"},
