+            (WORKFLOW, "content_disposition_evidence"),
+        ):
+            workflow = workflow_path.read_text(encoding="utf-8")
+            self.assertIn(f"steps.{upload_id}.outcome == 'success'", workflow)
+            self.assertIn("outputs.exit_code != ''", workflow)
+
