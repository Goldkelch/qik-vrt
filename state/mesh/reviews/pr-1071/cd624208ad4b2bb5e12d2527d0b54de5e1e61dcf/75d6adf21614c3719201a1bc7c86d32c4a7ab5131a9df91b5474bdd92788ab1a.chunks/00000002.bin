+def _exact_execution_fence_blocker(
+    snapshot: Mapping[str, Any], expected_head: str
+) -> tuple[str, str] | None:
+    """Validate the non-authoritative technical fence carried by a snapshot."""
+    fence = snapshot.get("mesh_review_execution_fence")
