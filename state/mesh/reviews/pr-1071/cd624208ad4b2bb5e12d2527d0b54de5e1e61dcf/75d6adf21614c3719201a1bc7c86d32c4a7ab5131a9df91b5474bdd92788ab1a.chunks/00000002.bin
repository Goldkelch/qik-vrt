+            "review": {
+                "user": {"login": "Goldkelch", "type": "User"},
+                "state": "APPROVED",
+                "commit_id": HEAD_SHA,
+                "body": (
+                    f"<!-- {MODULE.DELEGATED_ACCOUNT_REVIEW_MARKER} "
+                    f"fingerprint={'e' * 64} head={HEAD_SHA} tree={HEAD_TREE_SHA} "
