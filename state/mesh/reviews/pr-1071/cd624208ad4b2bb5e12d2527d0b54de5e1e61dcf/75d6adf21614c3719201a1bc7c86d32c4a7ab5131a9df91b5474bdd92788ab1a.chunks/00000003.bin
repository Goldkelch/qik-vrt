+def reobserve(token: str, policy: Mapping[str, Any]) -> dict[str, Any]:
+    """Read and evaluate the exact ruleset without admitting a mutation.
+
+    This is the only recovery operation allowed after a previous conditional
+    PUT may have reached GitHub but its readback was unavailable.  A later
+    carrier may choose an ordinary reconcile only after this isolated
+    observation proves the current server state is still DRIFT.
+    """
+
+    repository = policy["repository"]
+    ruleset_id = policy["ruleset_id"]
+    url = f"https://api.github.com/repos/{repository}/rulesets/{ruleset_id}"
+    observed, _etag = _request("GET", url, token)
+    return evaluate(observed, policy)
+
+
+def authority_override() -> None:
+    """Classify workflow-level App provisioning before an API call is attempted."""
+    state = os.environ.get("QIKVRT_RULESET_AUTHORITY_STATE", "")
+    if not state:
+        return
+    blocker = os.environ.get("QIKVRT_RULESET_AUTHORITY_BLOCKER", "")
+    if not blocker:
+        raise RulesetBlock("ruleset authority override omitted its exact blocker")
+    if state == "REQUEST_AUTHORITY":
+        raise RulesetAuthorityRequired(blocker)
+    if state == "HOLD":
+        raise RulesetBlock(blocker)
+    raise RulesetBlock(f"unknown ruleset authority override state: {state}")
+
+
+def _hold_reason(
+    *,
+    repository: str,
+    ruleset_id: int,
+    blocker: str,
+    detail: str,
+    retry_predicate: str,
+    next_action: str = "REOBSERVE_EXACT_RULESET_API_AND_READBACK_EVIDENCE",
+) -> dict[str, Any]:
+    """Produce the repository-wide D0=2 contract for failed rule observation."""
+
+    return {
+        "reason_code": blocker,
+        "reason": detail,
+        "subject": {
+            "repository": repository,
+            "kind": "repository",
+            "identifier": f"ruleset:{ruleset_id}",
+            "head_sha": None,
+        },
+        "evidence_refs": [f"ruleset:{ruleset_id}", "ruleset-reconcile:api-readback"],
+        "owner": {
+            "role": "EXACT_SUBJECT_OBSERVER",
+            "actor": "qikvrt-autonomous-ruleset-effect-loop",
+        },
+        "retry_condition": {
+            "event": "NONSELF_REPOSITORY_INTERRUPT",
+            "predicate": retry_predicate,
+        },
+        "next_action": next_action,
+        "d0": 2,
+    }
+
+
