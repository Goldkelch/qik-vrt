+    def test_bridge_recovery_provenance_handles_normal_apply_and_get_only_reobserve(self):
+        self.assertIn('recovery_mode=APPLY', self.text)
+        self.assertIn('recovery_mode="$(jq -r .next_recovery_mode', self.text)
