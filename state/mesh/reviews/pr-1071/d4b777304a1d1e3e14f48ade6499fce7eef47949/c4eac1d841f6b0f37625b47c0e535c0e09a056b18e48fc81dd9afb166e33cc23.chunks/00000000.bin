+                    kind: "workflow_run",
+                    identifier: $run_id,
+                    head_sha: $head
+                  },
+                  evidence_refs: [
+                    ("endpoint:" + $endpoint),
+                    ("workflow-run:" + $run_id)
+                  ],
+                  owner: {
