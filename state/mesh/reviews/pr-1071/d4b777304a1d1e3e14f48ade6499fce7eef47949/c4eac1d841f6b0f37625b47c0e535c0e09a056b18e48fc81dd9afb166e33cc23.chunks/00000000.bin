+          fi
           git commit -m "ci: materialize repository evidence"
-          remote_head_after_commit="$(
-            git ls-remote --heads origin "refs/heads/$TARGET_REF" |
-              awk 'NR == 1 { print $1 }'
-          )"
+          remote_head_after_commit="$(git ls-remote --heads origin "refs/heads/$TARGET_REF" | awk 'NR == 1 { print $1 }')"
           if [ "$remote_head_after_commit" != "$source_head" ]; then
             echo "BLOCK: target ref advanced while repository evidence was materialized" >&2
             echo "source_head=$source_head" >&2
             echo "remote_head_after_commit=$remote_head_after_commit" >&2
             exit 2
           fi
-          git push origin "HEAD:$TARGET_REF"
+          if [ "$TARGET_REF" = main ]; then
+            candidate_head="$(git rev-parse --verify HEAD^{commit})"
+            git push origin "HEAD:refs/heads/$candidate_branch"
+            remote_main_before_pr="$(git ls-remote --heads origin refs/heads/main | awk 'NR == 1 { print $1 }')"
+            test "$remote_main_before_pr" = "$source_head" || {
+              echo "HOLD_UNVERIFIED main advanced before repository-evidence candidate pull request" >&2
+              exit 2
+            }
+            pr_body="$RUNNER_TEMP/qikvrt-repository-evidence-pr.md"
+            {
+              printf '%s\n' '<!-- qikvrt-expected-head-promotion:enabled external_effect=NONE -->' ''
+              printf '%s\n' 'Exact trusted-main repository-evidence candidate.' ''
+              printf '%s`%s`\n' '- observed main base: ' "$source_head"
+              printf '%s`%s`\n' '- candidate head: ' "$candidate_head"
+              printf '%s\n' '' "This workflow did not write protected \`main\`. The candidate requires its own exact-head checks and the protected pull-request route. No review, merge, release, publication, PASS, FINAL_PASS, or EFFECT_ACK_DONE is implied."
+            } > "$pr_body"
+            gh pr create \
+              --draft \
+              --base main \
+              --head "$candidate_branch" \
+              --title "ci: materialize repository evidence ${source_head:0:16}" \
+              --body-file "$pr_body"
+            pr_readback="$RUNNER_TEMP/qikvrt-repository-evidence-pr-readback.json"
+            gh pr view "$candidate_branch" \
+              --repo "$GITHUB_REPOSITORY" \
+              --json number,url,isDraft,baseRefName,baseRefOid,headRefName,headRefOid > "$pr_readback"
+            receipt="$RUNNER_TEMP/qikvrt-repository-evidence-pr-receipt.json"
+            python3 -B tools/qikvrt_candidate_pr_receipt.py \
+              --readback "$pr_readback" \
+              --expected-base "$source_head" \
+              --expected-head "$candidate_head" \
+              --expected-branch "$candidate_branch" \
+              --expected-tree "$expected_tree" \
+              --repository . \
+              --receipt "$receipt"
+            remote_main_after_pr="$(git ls-remote --heads origin refs/heads/main | awk 'NR == 1 { print $1 }')"
+            test "$remote_main_after_pr" = "$source_head" || {
+              echo "HOLD_UNVERIFIED main advanced during repository-evidence candidate pull-request creation" >&2
+              exit 2
+            }
+            {
+              echo '### Exact repository-evidence draft candidate receipt'
+              echo
+              cat "$receipt"
+            } >> "$GITHUB_STEP_SUMMARY"
+          else
+            git push origin "HEAD:$TARGET_REF"
+          fi
diff --git a/.github/workflows/qikvrt_ci.yml b/.github/workflows/qikvrt_ci.yml
index 652929632e179fb443279d90b43c24af3e866aa5..9bc0b9f6c94a1a645ce32d58511e736f8cd0738e 100644
--- a/.github/workflows/qikvrt_ci.yml
+++ b/.github/workflows/qikvrt_ci.yml
@@ -125,8 +125,67 @@ jobs:
         run: |
           set -euo pipefail
           mkdir -p "$EVIDENCE_ROOT"
+          provision_attempts=0
+          last_apt_update_exit_code=null
+          write_provision_receipt() {
+            local state="$1" blocker="$2" workflow_exit_code="$3"
+            jq -n \
+              --arg state "$state" \
+              --arg blocker "$blocker" \
+              --arg run "$GITHUB_RUN_ID" \
+              --argjson attempts "$provision_attempts" \
+              --argjson apt_update_last_exit_code "$last_apt_update_exit_code" \
+              --argjson workflow_exit_code "$workflow_exit_code" \
+              '{
+                schema:"qikvrt_ghdl_provision_receipt_v1",
+                state:$state,
+                first_blocker:(if $blocker == "" then null else $blocker end),
+                workflow_run_id:($run|tonumber),
+                apt_update_attempts:$attempts,
+                apt_update_last_exit_code:$apt_update_last_exit_code,
+                workflow_exit_code:$workflow_exit_code,
+                retry_policy:{delays_seconds:[0,15,45],apt_acquire_retries:3},
+                external_effect:false,
+                completion_claims:{PASS:false,FINAL_PASS:false,EFFECT_ACK_DONE:false}
+              }' > "$EVIDENCE_ROOT/ghdl-provision-receipt.json"
+          }
+          provision_error_trap() {
+            local status=$?
+            trap - ERR
+            write_provision_receipt HOLD GHDL_PROVISION_EXECUTION_FAILED "$status"
+            exit "$status"
+          }
+          trap provision_error_trap ERR
+          write_provision_receipt PENDING GHDL_PROVISION_PENDING 0
           if ! command -v ghdl >/dev/null 2>&1; then
-            sudo apt-get update
+            apt_updated=false
+            for delay in 0 15 45; do
+              if [ "$delay" -gt 0 ]; then
+                sleep "$delay"
+              fi
+              provision_attempts=$((provision_attempts + 1))
+              update_log="$EVIDENCE_ROOT/apt-update-attempt-${provision_attempts}.log"
+              if sudo apt-get update -o Acquire::Retries=3 > "$update_log" 2>&1; then
+                apt_updated=true
+                last_apt_update_exit_code=0
+                break
+              else
+                last_apt_update_exit_code=$?
+              fi
+              # An interrupted mirror response may leave only partial index
+              # bytes.  Clear that exact ephemeral partial-list directory
+              # before the bounded next attempt; never classify it as a
+              # candidate or VHDL failure.
+              sudo rm -rf /var/lib/apt/lists/partial
+              sudo install -d -m 0755 /var/lib/apt/lists/partial
+            done
+            if [ "$apt_updated" != true ]; then
+              # Preserve both the last apt transport failure above and the
+              # deliberately nonzero workflow HOLD below in the receipt.
+              write_provision_receipt HOLD GHDL_APT_UPDATE_UNCONFIRMED 2
+              cat "$EVIDENCE_ROOT"/apt-update-attempt-*.log >&2 || true
+              exit 2
+            fi
             candidate="$(apt-cache policy ghdl | awk '/Candidate:/ {print $2}')"
             test -n "$candidate"
             test "$candidate" != '(none)'
@@ -137,6 +196,8 @@ jobs:
           fi
           command -v ghdl | tee -a "$EVIDENCE_ROOT/ghdl-package.txt"
           ghdl --version | tee "$EVIDENCE_ROOT/ghdl-version.txt"
+          write_provision_receipt CURRENT "" 0
+          trap - ERR
       - name: Validate analyze elaborate and execute inside-out VHDL
         if: steps.detect.outputs.present == 'true'
         shell: bash
