@@ -53,7 +53,18 @@ concurrency:
 
 jobs:
   review-one:
-    if: github.ref == 'refs/heads/main'
+    # Technical projections emitted by github-actions[bot] are repository-owned
+    # receipts, not new review work units.  Stop both the exact review COMMENT
+    # and every bot-authored issue-comment edge before selection or any GitHub
+    # API observation. Human review and issue-comment events stay eligible.
+    if: >-
+      github.ref == 'refs/heads/main' &&
+      !(github.event_name == 'pull_request_review' &&
+        github.event.review.user.login == 'github-actions[bot]' &&
+        github.event.review.state == 'commented' &&
+        startsWith(github.event.review.body, '<!-- qikvrt-mesh-review:v1 ')) &&
+      !(github.event_name == 'issue_comment' &&
+        github.event.comment.user.login == 'github-actions[bot]')
     runs-on: ubuntu-24.04
     timeout-minutes: 12
     env:
@@ -68,7 +79,7 @@ jobs:
       REQUIRED_GATE_PATHS_JSON: >-
         {"QIKVRT CI":".github/workflows/qikvrt_ci.yml","QIKVRT repository evidence materialization":".github/workflows/qikvrt_batch04_integrity.yml","QIKVRT Collective Proposal Review":".github/workflows/qikvrt_collective_review.yml"}
