+                    "as resolved for the same repository"
+                ),
+            ),
+            "d0": 2,
+            "next_action": "REOBSERVE_EXACT_RULESET_API_AND_READBACK_EVIDENCE",
+            "continuation_required": True,
+            "mutation": "NONE",
+            "effect_transport_attempted": False,
+            "effect_observed": False,
+        }
+        exit_code = 2
     else:
         exit_code = 0 if result["state"] == "CURRENT" else 10
     raw = canonical_bytes(result)
