+                    continue
+                raise GitHubInstallationRateLimit(
+                    mutation=("PUT_UNCONFIRMED_RATE_LIMIT" if normalized_method == "PUT" else "NONE"),
+                    effect_transport_attempted=(normalized_method == "PUT"),
+                ) from exc
+            raise RulesetBlock(f"GitHub ruleset API HTTP {exc.code}: {detail}") from exc
+        except (urllib.error.URLError, OSError, ValueError) as exc:
+            raise RulesetBlock(
+                f"GitHub ruleset API {normalized_method} transport or response failure: {exc}"
+            ) from exc
+        if not isinstance(value, dict):
+            raise RulesetBlock("GitHub ruleset API returned a non-object")
+        return value, response_etag
+    raise AssertionError("bounded ruleset read retry loop exhausted without a result")
