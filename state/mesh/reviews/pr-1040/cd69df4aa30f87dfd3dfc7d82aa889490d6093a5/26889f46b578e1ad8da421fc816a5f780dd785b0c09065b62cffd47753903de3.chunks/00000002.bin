+      - "127.0.0.1:${QIKVRT_DNS_HOST_PORT:-5353}:5353/tcp"
+    read_only: true
     cap_drop:
       - ALL
+    security_opt:
+      - no-new-privileges:true
+    tmpfs:
+      - /tmp:size=16m,mode=1777
+      - /run:size=8m,mode=755
+    healthcheck:
+      disable: true
+    restart: unless-stopped
+
+  qikvrt-sshd:
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
+    environment:
