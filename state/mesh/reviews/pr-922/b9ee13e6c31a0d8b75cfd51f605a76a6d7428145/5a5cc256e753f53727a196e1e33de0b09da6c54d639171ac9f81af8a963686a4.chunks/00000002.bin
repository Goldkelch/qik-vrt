DIDATES.json","sha256":"c8ab70bb506b8673b55fad618cc7453e672e9cf1b8e6e8fa70a41598843d548d"},{"bytes":1925,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/OWNER_REVIEW_CORRECTED_CANDIDATE_FOR_BATCH_002.json","sha256":"9e056cbab979e528f251a2f418b9e252323f580875462ca1a73c23fc1318f50d"},{"bytes":4801,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/QIKVRT_VIRTUAL_PAST_RECEPTION_INTEGRATION_V1.json","sha256":"ed18aa8177d237ed0270911aeb63c218fa6bdeb856b7f37818c8b848ad21bef8"},{"bytes":3025,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/RCP_001_IMPLEMENT_CAPABILITY_MATERIALIZER.json","sha256":"9db293df4140c78f676052b8ff712598f04cefb284fbeb423566aea45d34c546"},{"bytes":4649,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/RECOVER_13_RECORD_RECONCILIATION_RECEIPT.json","sha256":"7419b076e6f0e8891d38865fc4ed1c850417c7068a9838c1e2a7b6ecf6e57e9c"},{"bytes":2644,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/RECOVER_EXACT_PUBLIC_INDEX_BYTES_AND_EXTRACT_CLASSIFY_BATCH_003_SUBJECT_2581811B342E505D.json","sha256":"7bd4e6791aa0d071812620f73776e7ef70ce312d20bfa8ce6a3b483b8a07ef1a"},{"bytes":3296,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/REFRESH_CONTENT_DISPOSITION_STATUS_PROJECTION_AFTER_BATCH002_ACCEPTANCE.json","sha256":"e2fec4c0d867270a069e9c1bc0f7c861614ef6d49aa99c6e7a87b46b90ecfca1"},{"bytes":3039,"classification":"repository_content","excluded_from_sha256_index":false,"file_type":"regular","immutable":true,"path":"work-units/REQUEST_EXACT_ZENODO_AUTHORIZATION_SELF_HEALING_REPOSITORY_V