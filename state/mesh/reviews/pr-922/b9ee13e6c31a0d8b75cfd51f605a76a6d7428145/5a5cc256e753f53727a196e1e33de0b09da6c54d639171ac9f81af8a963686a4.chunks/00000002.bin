@@ -0,0 +1,176 @@
+{
+  "schema": "qikvrt_retrocausal_scientific_claim_matrix_v1",
+  "title": "Die wissenschaftliche Realität zeitübergreifender Quantenkorrelationen und ihre informatische Skalierung",
+  "author": "Ingolf Lohmann",
+  "version": "1.1",
+  "date": "2026-09-02",
+  "pdf_sha256": "5e852934e0def64a930d50ebafb455eb35d87fbe1953f624cb27a9002c79ae99",
+  "prosa_article_sha256": "df9c6bedd20ed08055a4ee6e05f8cb9ab2d297c9edd45126291f552553986773",
+  "prosa_article_pdf_sha256": "4a65df0200c1134fe80105b475e484f8a99c4d9b545fcd0030411a7eae8a83f0",
+  "classes": [
+    "EXPERIMENTAL",
+    "SOURCE_BOUND",
+    "FORMAL_PROVED",
+    "REPOSITORY_EVIDENCE",
+    "INTERPRETATIVE",
+    "OPEN"
+  ],
+  "claims": [
+    {
+      "id": "RETRO-001",
+      "statement": "Delayed-choice quantum eraser experiments report delayed determination of particlelike or wavelike behavior through entanglement and later-conditioned coincidence subsets.",
+      "class": "EXPERIMENTAL",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1103/PhysRevLett.84.1",
+      "boundary": "The original apparatus uses passive optics and random detector outcomes; it does not establish a freely controllable later sender bit or a classical message in the earlier unsorted marginal."
+    },
+    {
+      "id": "RETRO-002",
+      "statement": "For a bipartite quantum state and a complete local POVM on the later subsystem, summing over later outcomes leaves the earlier local marginal independent of the later measurement setting.",
+      "class": "FORMAL_PROVED",
+      "status": "PROVED_IN_MANUSCRIPT",
+      "source": "SCIENTIFIC_MANUSCRIPT.md, Section 2.2",
+      "boundary": "Conditional and joint distributions may still depend on the later setting and outcome."
+    },
+    {
+      "id": "RETRO-003",
+      "statement": "Delayed-choice entanglement swapping has experimentally projected already registered photons into entangled or separable correlated subensembles.",
+      "class": "EXPERIMENTAL",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1038/nphys2294",
+      "boundary": "The authors' steering-into-the-past language does not itself prove controllable backward signalling."
+    },
+    {
+      "id": "RETRO-004",
+      "statement": "Entanglement has been demonstrated between photons that never coexisted, including a photon detected before the other photon was created.",
+      "class": "EXPERIMENTAL",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1103/PhysRevLett.110.210403",
+      "boundary": "Timelike entanglement is not equivalent to a classical message channel into the past."
+    },
+    {
+      "id": "RETRO-005",
+      "statement": "A delayed-choice quantum eraser has been implemented with entangled surface acoustic phonons in a superconducting system.",
+      "class": "EXPERIMENTAL",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1103/PhysRevX.10.021055",
+      "boundary": "Conditional recovery of interference is distinct from backward communication capacity."
+    },
+    {
+      "id": "RETRO-006",
+      "statement": "Time-symmetric and retrocausal formulations are established research model classes in quantum foundations.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "sources": [
+        "https://doi.org/10.1103/PhysRev.134.B1410",
+        "https://doi.org/10.1103/RevModPhys.92.021002",
+        "https://doi.org/10.1103/PhysRevResearch.2.033266"
+      ],
+      "boundary": "Scientific legitimacy of a model class does not establish uniqueness or empirical confirmation of one ontology."
+    },
+    {
+      "id": "RETRO-007",
+      "statement": "QIK-VRT separates host-causal order, virtual order, local event time and evidential order.",
+      "class": "FORMAL_PROVED",
+      "status": "SOURCE_BOUND_FORMAL_MODEL",
+      "source": "Relationale Zeit, virtuelle Retrokausalität und die monoton wachsende Evidenzkugel, Section 4",
+      "boundary": "These model coordinates are not automatically physical proper time or spacetime coordinates."
+    },
+    {
+      "id": "RETRO-008",
+      "statement": "Under an irreflexive transitive host order and send-before-deliver axiom, no delivery can be a host-cause of its own send event.",
+      "class": "FORMAL_PROVED",
+      "status": "PROVED",
+      "source": "Relationale Zeit, virtuelle Retrokausalität und die monoton wachsende Evidenzkugel, Theorem 4.9",
+      "boundary": "This theorem protects the host boundary and does not deny virtual or semantic retrograde order."
+    },
+    {
+      "id": "RETRO-009",
+      "statement": "A complete immutable receipt that includes predecessor, input and successor uniquely reconstructs the predecessor even when the transition function is not injective.",
+      "class": "FORMAL_PROVED",
+      "status": "PROVED",
+      "source": "Relationale Zeit, virtuelle Retrokausalität und die monoton wachsende Evidenzkugel, Theorem 5.4",
+      "boundary": "Reconstruction uses stored provenance; it does not physically rewrite the past."
+    },
+    {
+      "id": "RETRO-010",
+      "statement": "A fully logged finite trace can be replayed in reverse label order while every physical read remains later than the writes on which it depends.",
+      "class": "FORMAL_PROVED",
+      "status": "PROVED",
+      "source": "Relationale Zeit, virtuelle Retrokausalität und die monoton wachsende Evidenzkugel, Theorem 5.5",
+      "boundary": "Reverse replay is not a host-time reversal."
+    },
+    {
+      "id": "RETRO-011",
+      "statement": "Large data corpora can be future-indexed, later conditioned and provenance-bound for reverse reconstruction in a physically forward-running system.",
+      "class": "REPOSITORY_EVIDENCE",
+      "status": "ARCHITECTURE_AND_IMPLEMENTATION_CLAIM",
+      "source": "Goldkelch/qik-vrt exact repository artifacts and receipts",
+      "boundary": "Concrete scale, throughput and energy claims require exact-head benchmarks."
+    },
+    {
+      "id": "RETRO-012",
+      "statement": "The structural correspondence between delayed-choice conditioning and later classification of immutable earlier data is algorithmically realizable.",
+      "class": "INTERPRETATIVE",
+      "status": "PHYSICALLY_CONNECTABLE",
+      "source": "SCIENTIFIC_MANUSCRIPT.md, Sections 5 and 8",
+      "boundary": "Algorithmic correspondence is not a second physical photon experiment."
+    },
+    {
+      "id": "RETRO-013",
+      "statement": "A temporal communication service requires a pre-bound temporal address, codebook, authentication, decoding, error and reobservation contract before the later message choice.",
+      "class": "FORMAL_PROVED",
+      "status": "DEFINITIONAL_NECESSITY",
+      "source": "SCIENTIFIC_MANUSCRIPT.md, Section 6",
+      "boundary": "Such infrastructure is necessary for identifiable messaging but does not create a physical carrier."
+    },
+    {
+      "id": "RETRO-014",
+      "statement": "An operational future-to-past channel requires interventionally different earlier bound marginal distributions for independently randomized later settings, a preregistered decoder without later-outcome postselection, and positive independently replicated channel capacity.",
+      "class": "FORMAL_PROVED",
+      "status": "TEST_CRITERION",
+      "source": "SCIENTIFIC_MANUSCRIPT.md, Section 7",
+      "boundary": "The criterion is specified; a positive natural-channel result is not reported here."
+    },
+    {
+      "id": "RETRO-015",
+      "statement": "No positive independently replicated natural future-to-past channel capacity is established by the present manuscript.",
+      "class": "OPEN",
+      "status": "NOT_CLAIMED",
+      "source": "This publication generation",
+      "boundary": "Requires preregistered multi-laboratory intervention and leakage controls."
+    },
+    {
+      "id": "RETRO-016",
+      "statement": "The QIK-VRT Effect Acknowledgement Internet-Draft publicly specifies a five-state application-layer control record that separates receipt from downstream effect authorization.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://datatracker.ietf.org/doc/html/draft-lohmann-qikvrt-effect-ack-03",
+      "boundary": "Active individual Internet-Draft; not an RFC or IETF consensus, and it does not prove physical retrocausality."
+    },
+    {
+      "id": "RETRO-017",
+      "statement": "Ingolf Lohmann is the conceptual originator of the relation-first, TEMDD, event-time, proof-ring, evidence-sphere and virtual-retrocausality combination documented in the source preprint.",
+      "class": "SOURCE_BOUND",
+      "status": "ATTRIBUTED",
+      "source": "Relationale Zeit, virtuelle Retrokausalität und die monoton wachsende Evidenzkugel, Section 1.2",
+      "boundary": "Attribution within the cited work is distinct from independent priority adjudication by the scientific community."
+    },
+    {
+      "id": "RETRO-018",
