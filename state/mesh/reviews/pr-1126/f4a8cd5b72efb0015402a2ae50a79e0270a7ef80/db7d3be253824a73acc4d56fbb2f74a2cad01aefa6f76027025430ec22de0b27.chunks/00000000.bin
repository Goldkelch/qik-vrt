diff --git a/.github/workflows/qikvrt_seed_dashboard_publish.yml b/.github/workflows/qikvrt_seed_dashboard_publish.yml
index 0121c8eba6470f77c04ded990d147d81b4ee8009..39ff5397deb54b0c8fe338b2c850368bfb7d4b80 100644
--- a/.github/workflows/qikvrt_seed_dashboard_publish.yml
+++ b/.github/workflows/qikvrt_seed_dashboard_publish.yml
@@ -65,16 +65,59 @@ jobs:
               encoding="utf-8",
           )
           PY
-      - name: Refresh, revalidate, and build dashboard
+      - name: Refresh and revalidate mesh
+        id: revalidate
         shell: bash
         run: |
           set -euo pipefail
           mkdir -p .qikvrt/seed-workflow
-          {
-            sh tools/qikvrt_seed_mesh_maintenance.sh
-            sh tools/qikvrt_seed_node_revalidation.sh
-            sh tools/qikvrt_seed_dashboard_publish.sh
-          } 2>&1 | tee .qikvrt/seed-workflow/dashboard.log
+          sh tools/qikvrt_seed_mesh_maintenance.sh 2>&1 | tee .qikvrt/seed-workflow/dashboard.log
+          set +e
+          sh tools/qikvrt_seed_node_revalidation.sh 2>&1 | tee -a .qikvrt/seed-workflow/dashboard.log
+          rc=${PIPESTATUS[0]}
+          set -e
+          case "$rc" in
+            0)
+              echo "dashboard_execution=ADMITTED" >> "$GITHUB_OUTPUT"
+              ;;
+            10)
+              echo "dashboard_execution=NOT_EXECUTED" >> "$GITHUB_OUTPUT"
+              echo "current_dashboard_evidence=NOT_ESTABLISHED" >> "$GITHUB_OUTPUT"
+              ;;
+            *)
+              exit "$rc"
+              ;;
+          esac
+      - name: Build dashboard only from PASS revalidation
+        if: steps.revalidate.outputs.dashboard_execution == 'ADMITTED'
+        shell: bash
+        run: |
+          set -euo pipefail
+          sh tools/qikvrt_seed_dashboard_publish.sh 2>&1 | tee -a .qikvrt/seed-workflow/dashboard.log
+      - name: Record non-executed dashboard provenance
+        if: steps.revalidate.outputs.dashboard_execution == 'NOT_EXECUTED'
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B - <<'PY'
+          import json
+          import os
+          import pathlib
+          revalidation = json.loads(pathlib.Path("registry/NODEMESH_REVALIDATION.json").read_text(encoding="utf-8"))
+          payload = {
+              "schema": "qikvrt_seed_dashboard_execution_v1",
+              "run_id": os.environ["QIKVRT_RUN_ID"],
+              "dashboard_execution": "NOT_EXECUTED",
+              "current_dashboard_evidence": "NOT_ESTABLISHED",
+              "reason": "NODE_REVALIDATION_CONTINUE",
+              "revalidation_status": revalidation["status"],
+              "source_status_run_id": revalidation["source_status_run_id"],
+              "predecessor_evidence_transfer": False,
+          }
+          pathlib.Path(".qikvrt/seed-workflow/dashboard-execution.json").write_text(
+              json.dumps(payload, sort_keys=True, indent=2) + "\n", encoding="utf-8"
+          )
+          PY
       - name: Preserve local dashboard evidence without mutating the repository
         if: always()
         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
@@ -85,6 +128,7 @@ jobs:
           path: |
             .qikvrt/seed-workflow/dashboard.log
             .qikvrt/seed-workflow/dashboard-exact-head-binding.json
+            .qikvrt/seed-workflow/dashboard-execution.json
             docs/qikvrt_mesh_dashboard.html
             docs/QIKVRT_MESH_DASHBOARD.md
             registry/NODEMESH_INDEX.json
diff --git a/tests/test_seed_workflows.py b/tests/test_seed_workflows.py
index 25177e046b638891d0985d128d3d3400c8773a0c..65851a56f61028ba56e53eab73a82b7eb151100a 100644
--- a/tests/test_seed_workflows.py
+++ b/tests/test_seed_workflows.py
@@ -358,6 +358,18 @@ class SeedWorkflowTests(unittest.TestCase):
         self.assertIn('"source_tree": os.environ["ACTUAL_TREE"]', workflow)
         self.assertIn("qikvrt_seed_dashboard_exact_head_binding_v1", workflow)
 
+    def test_dashboard_continue_is_not_mislabelled_as_current_dashboard_evidence(self) -> None:
+        repository = Path(__file__).resolve().parents[1]
+        workflow = (
+            repository / ".github/workflows/qikvrt_seed_dashboard_publish.yml"
+        ).read_text(encoding="utf-8")
+        self.assertIn("dashboard_execution=NOT_EXECUTED", workflow)
+        self.assertIn("current_dashboard_evidence=NOT_ESTABLISHED", workflow)
+        self.assertIn("NODE_REVALIDATION_CONTINUE", workflow)
+        self.assertIn('"predecessor_evidence_transfer": False', workflow)
+        self.assertIn("Build dashboard only from PASS revalidation", workflow)
+        self.assertIn("steps.revalidate.outputs.dashboard_execution == 'ADMITTED'", workflow)
+
     def test_seed_workflows_are_pinned_read_only_and_do_not_push(self) -> None:
         repository = Path(__file__).resolve().parents[1]
         for workflow in sorted((repository / ".github/workflows").glob("qikvrt_seed_*.yml")):
