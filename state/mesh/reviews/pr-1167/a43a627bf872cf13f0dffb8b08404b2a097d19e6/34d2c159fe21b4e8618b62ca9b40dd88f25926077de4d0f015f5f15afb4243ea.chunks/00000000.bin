@@ -863,8 +977,20 @@ def run_maintenance(
         )
 
     counts = {state.lower() + "_count": 0 for state in EFFECTIVE_STATES}
+    rank_counts = {
+        "peer_count": 0,
+        "subordinate_count": 0,
+        "rank_not_applicable_count": 0,
