@@ -280,17 +285,156 @@ jobs:
           python3 -B "$script" --check --json
           python3 -B -m unittest -v tests.test_aphorism_corpus_v2
       - name: Regenerate and verify repository integrity
+        id: regenerated_integrity
         shell: bash
         run: |
           set -euo pipefail
           python3 tools/qikvrt_integrity.py generate
           python3 tools/qikvrt_integrity.py verify
       - name: Run complete repository gates before persistence
+        id: repository_gates
         shell: bash
         run: |
           set -euo pipefail
           make test
           python3 tools/qikvrt_integrity.py verify
+      - name: Freeze regenerated PR integrity bytes without a repository write
+        id: byte_carrier
+        if: ${{ always() && steps.regenerated_integrity.outcome == 'success' && (github.event_name == 'pull_request' || (github.event_name == 'push' && github.ref_name == 'mesh/effect-evidence-invariant-v1')) }}
+        env:
+          CARRIER_DIRECTORY: ${{ runner.temp }}/qikvrt-pr-integrity-carrier
+          CARRIER_REPOSITORY: ${{ github.repository }}
+          CARRIER_PR: ${{ github.event.pull_request.number || 1160 }}
+          CARRIER_RUN_ID: ${{ github.run_id }}
+          CARRIER_RUN_ATTEMPT: ${{ github.run_attempt }}
+          CARRIER_GATES: ${{ steps.repository_gates.outcome }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B - <<'PY_CARRIER'
+          import hashlib, json, os, re, stat, subprocess
+          from pathlib import Path
+
+          def git(*args):
+              return subprocess.check_output(['git', *args])
+
+          def blob(raw):
+              return hashlib.sha1(b'blob ' + str(len(raw)).encode() + b'\0' + raw).hexdigest()
+
+          def regular(path):
+              fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+              with os.fdopen(fd, 'rb') as handle:
+                  if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
+                      raise SystemExit('BLOCK: non-regular integrity file')
+                  raw = handle.read(64 * 1024 * 1024 + 1)
+              if len(raw) > 64 * 1024 * 1024:
+                  raise SystemExit('BLOCK: integrity file exceeds byte limit')
+              return raw
+
+          root = Path.cwd().resolve()
+          target = Path(os.environ['CARRIER_DIRECTORY']).resolve()
+          if target == root or root in target.parents:
+              raise SystemExit('BLOCK: carrier must be outside the checkout')
+          head = git('rev-parse', '--verify', 'HEAD^{commit}').decode().strip()
+          tree = git('rev-parse', '--verify', 'HEAD^{tree}').decode().strip()
+          if not re.fullmatch('[0-9a-f]{40}', os.environ['EXPECTED_HEAD']) or head != os.environ['EXPECTED_HEAD']:
+              raise SystemExit('BLOCK: exact source HEAD drift')
+          repository = os.environ['CARRIER_REPOSITORY']
+          if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repository):
+              raise SystemExit('BLOCK: invalid repository identity')
+          ids = {key: os.environ[key] for key in ('CARRIER_PR', 'CARRIER_RUN_ID', 'CARRIER_RUN_ATTEMPT')}
+          if any(not re.fullmatch('[1-9][0-9]*', value) for value in ids.values()):
+              raise SystemExit('BLOCK: invalid PR/run binding')
+          gates = os.environ['CARRIER_GATES']
+          if gates not in ('success', 'failure', 'cancelled', 'skipped'):
+              raise SystemExit('BLOCK: unknown gate outcome')
+          paths = ('REPOSITORY_FILE_MANIFEST.json', 'REPOSITORY_FILE_MANIFEST.json.sha256', 'SHA256SUMS.txt')
+          delta = git('diff', '--name-only', '--no-renames', '-z', 'HEAD', '--')
+          changed = sorted(path.decode('utf-8') for path in delta.split(b'\0') if path)
+          payload, entries = {}, []
+          for name in paths:
+              entry = git('ls-tree', '-z', 'HEAD', '--', name).split(b'\0')
+              if len(entry) != 2 or entry[-1] or b'\t' not in entry[0]:
+                  raise SystemExit('BLOCK: missing or ambiguous integrity source path')
+              metadata, returned_path = entry[0].split(b'\t', 1)
+              mode, kind, before = metadata.decode().split()
+              if returned_path.decode() != name or kind != 'blob' or mode != '100644':
+                  raise SystemExit('BLOCK: invalid integrity source tree entry')
+              raw = regular(root / name)
+              payload[name] = raw
+              entries.append({'path': name, 'mode': mode, 'source_blob_sha1': before,
+                              'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest(),
+                              'git_blob_sha1': blob(raw)})
+          other = sorted(set(changed) - set(paths))
+          manifest = {'schema': 'qikvrt_pr_integrity_byte_carrier_v1',
+                      'source': {'repository': repository, 'head_sha': head, 'tree_sha': tree,
+                                 'pull_request': int(ids['CARRIER_PR']), 'run_id': int(ids['CARRIER_RUN_ID']),
+                                 'run_attempt': int(ids['CARRIER_RUN_ATTEMPT'])},
+                      'repository_gates_outcome': gates, 'files': entries,
+                      'other_modified_paths': other, 'trio_covers_tracked_delta': not other,
+                      'claims': {'repository_successor_persisted': False,
+                                 'fresh_successor_gates_pass': False, 'effect_ack_done': False}}
+          if git('rev-parse', 'HEAD').decode().strip() != head or git('diff', '--name-only', '--no-renames', '-z', 'HEAD', '--') != delta:
+              raise SystemExit('BLOCK: source changed during byte capture')
+          if any(regular(root / name) != raw for name, raw in payload.items()):
+              raise SystemExit('BLOCK: integrity bytes changed during capture')
+          target.mkdir(parents=True, exist_ok=False)
+          for name, raw in payload.items():
+              (target / name).write_bytes(raw)
+              if regular(target / name) != raw:
+                  raise SystemExit('BLOCK: local carrier readback mismatch')
+          manifest_raw = (json.dumps(manifest, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
+          (target / 'CARRIER.json').write_bytes(manifest_raw)
+          if regular(target / 'CARRIER.json') != manifest_raw:
+              raise SystemExit('BLOCK: local manifest readback mismatch')
+          print('PR_INTEGRITY_CARRIER_HEAD=' + head)
+          print('PR_INTEGRITY_CARRIER_TREE=' + tree)
+          print('PR_INTEGRITY_CARRIER_SHA256=' + hashlib.sha256(manifest_raw).hexdigest())
+          print('BYTE_CARRIER_CREATED_NOT_REPOSITORY_SUCCESSOR')
+          PY_CARRIER
+      - name: Preserve regenerated PR integrity byte carrier
+        id: upload_byte_carrier
+        if: ${{ always() && steps.byte_carrier.outcome == 'success' }}
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: qikvrt-pr-integrity-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/qikvrt-pr-integrity-carrier/
+          if-no-files-found: error
+          overwrite: false
+          retention-days: 30
+      - name: Freshly read back persisted PR integrity bytes
+        if: ${{ always() && steps.upload_byte_carrier.outcome == 'success' }}
+        env:
+          GH_TOKEN: ${{ github.token }}
+          CARRIER_DIRECTORY: ${{ runner.temp }}/qikvrt-pr-integrity-carrier
+          CARRIER_ARCHIVE: ${{ runner.temp }}/qikvrt-pr-integrity-readback.zip
+          CARRIER_ARTIFACT_ID: ${{ steps.upload_byte_carrier.outputs.artifact-id }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -n "$CARRIER_ARTIFACT_ID"
+          gh api "repos/${GITHUB_REPOSITORY}/actions/artifacts/${CARRIER_ARTIFACT_ID}/zip" > "$CARRIER_ARCHIVE"
+          python3 -B - <<'PY_CARRIER_READBACK'
+          import hashlib, json, os, zipfile
+          from pathlib import Path
+          root = Path(os.environ['CARRIER_DIRECTORY'])
+          names = ('CARRIER.json', 'REPOSITORY_FILE_MANIFEST.json', 'REPOSITORY_FILE_MANIFEST.json.sha256', 'SHA256SUMS.txt')
+          with zipfile.ZipFile(os.environ['CARRIER_ARCHIVE']) as archive:
+              if sorted(archive.namelist()) != sorted(names):
+                  raise SystemExit('BLOCK: artifact entries differ or repeat')
+              for name in names:
+                  expected = (root / name).read_bytes()
+                  info = archive.getinfo(name)
+                  if info.file_size != len(expected) or archive.read(name) != expected:
+                      raise SystemExit('BLOCK: persisted artifact bytes differ: ' + name)
+          manifest_raw = (root / 'CARRIER.json').read_bytes()
+          manifest = json.loads(manifest_raw)
+          print(json.dumps({'state': 'BYTE_CARRIER_READBACK_VERIFIED',
+                            'artifact_id': os.environ['CARRIER_ARTIFACT_ID'],
+                            'carrier_sha256': hashlib.sha256(manifest_raw).hexdigest(),
+                            'source': manifest['source'], 'files': manifest['files'],
+                            'repository_successor_persisted': False, 'effect_ack_done': False}, sort_keys=True))
+          PY_CARRIER_READBACK
       - name: Commit materialized repository evidence
         if: github.event_name != 'pull_request'
         shell: bash
@@ -366,3 +510,87 @@ jobs:
             exit 2
           fi
           git push origin "HEAD:$TARGET_REF"
+
+      - name: Read back exact persisted integrity successor and request native verification
+        if: github.event_name == 'push' && github.ref_name == 'mesh/effect-evidence-invariant-v1'
+        env:
+          GH_TOKEN: ${{ github.token }}
+          CARRIER_DIRECTORY: ${{ runner.temp }}/qikvrt-pr-integrity-carrier
+          REPOSITORY_READBACK: ${{ runner.temp }}/qikvrt-integrity-repository-readback
+        shell: bash
+        run: |
+          set -euo pipefail
+          test "$GITHUB_REPOSITORY" = 'Goldkelch/qik-vrt'
+          persisted_head="$(git rev-parse --verify HEAD^{commit})"
+          persisted_tree="$(git rev-parse --verify HEAD^{tree})"
+          remote_head="$(git ls-remote --heads origin "refs/heads/$TARGET_REF" | awk 'NR == 1 {print $1}')"
+          test "$persisted_head" = "$remote_head"
+          export PERSISTED_HEAD="$persisted_head" PERSISTED_TREE="$persisted_tree"
+          mkdir "$REPOSITORY_READBACK"
+          for path in REPOSITORY_FILE_MANIFEST.json REPOSITORY_FILE_MANIFEST.json.sha256 SHA256SUMS.txt; do
+            blob="$(git rev-parse "$persisted_head:$path")"
+            gh api "repos/${GITHUB_REPOSITORY}/git/blobs/$blob" > "$REPOSITORY_READBACK/$path.json"
+          done
+          python3 -B - <<'PY_REPOSITORY_READBACK'
+          import base64, hashlib, json, os, subprocess
+          from pathlib import Path
+          carrier = Path(os.environ['CARRIER_DIRECTORY'])
+          remote = Path(os.environ['REPOSITORY_READBACK'])
+          manifest = json.loads((carrier / 'CARRIER.json').read_bytes())
+          source = manifest['source']
+          if source['repository'] != os.environ['GITHUB_REPOSITORY'] or source['head_sha'] != os.environ['EXPECTED_HEAD'] or source['run_id'] != int(os.environ['GITHUB_RUN_ID']) or source['run_attempt'] != int(os.environ['GITHUB_RUN_ATTEMPT']) or source['pull_request'] != 1160:
+              raise SystemExit('BLOCK: carrier source binding differs')
+          if manifest['repository_gates_outcome'] != 'success' or not manifest['trio_covers_tracked_delta'] or manifest['other_modified_paths']:
+              raise SystemExit('BLOCK: integrity-only successor preconditions not satisfied')
+          head, tree = os.environ['PERSISTED_HEAD'], os.environ['PERSISTED_TREE']
+          def git(*args):
+              return subprocess.check_output(['git', *args]).decode().strip()
+          if git('rev-parse', 'HEAD') != head or git('rev-parse', 'HEAD^{tree}') != tree:
+              raise SystemExit('BLOCK: persisted subject differs')
+          if head != source['head_sha'] and git('rev-parse', 'HEAD^') != source['head_sha']:
+              raise SystemExit('BLOCK: successor is not a direct source child')
+          paths = ('REPOSITORY_FILE_MANIFEST.json', 'REPOSITORY_FILE_MANIFEST.json.sha256', 'SHA256SUMS.txt')
+          if [entry['path'] for entry in manifest['files']] != list(paths):
+              raise SystemExit('BLOCK: carrier scope differs')
+          for entry in manifest['files']:
+              expected = (carrier / entry['path']).read_bytes()
+              response = json.loads((remote / (entry['path'] + '.json')).read_bytes())
+              if response.get('encoding') != 'base64' or response.get('sha') != entry['git_blob_sha1'] or response.get('size') != len(expected):
+                  raise SystemExit('BLOCK: remote blob metadata differs')
+              raw = base64.b64decode(''.join(response['content'].split()), validate=True)
+              blob = hashlib.sha1(b'blob ' + str(len(raw)).encode() + b'\0' + raw).hexdigest()
+              if raw != expected or len(raw) != entry['bytes'] or hashlib.sha256(raw).hexdigest() != entry['sha256'] or blob != entry['git_blob_sha1'] or git('rev-parse', head + ':' + entry['path']) != blob:
+                  raise SystemExit('BLOCK: repository byte readback differs')
+          result = {'state': 'REPOSITORY_INTEGRITY_SUCCESSOR_READBACK_VERIFIED',
+                    'source': source, 'successor_head': head, 'successor_tree': tree,
+                    'files': manifest['files'], 'fresh_successor_gates_pass': False,
+                    'effect_ack_done': False}
+          (remote / 'RECEIPT.json').write_text(json.dumps(result, sort_keys=True, indent=2) + '\n', encoding='utf-8')
+          print(json.dumps(result, sort_keys=True))
+          PY_REPOSITORY_READBACK
+          gh api "repos/${GITHUB_REPOSITORY}/pulls/1160" > "$REPOSITORY_READBACK/pr.json"
+          jq -e --arg head "$persisted_head" --arg ref "$TARGET_REF" --arg repo "$GITHUB_REPOSITORY" \
+            '.number == 1160 and .state == "open" and .head.sha == $head and .head.ref == $ref and .head.repo.full_name == $repo and .base.ref == "main"' \
+            "$REPOSITORY_READBACK/pr.json" >/dev/null
+          main_head="$(git ls-remote --heads origin refs/heads/main | awk 'NR == 1 {print $1}')"
+          test -n "$main_head"
+          test "$(jq -r '.base.sha' "$REPOSITORY_READBACK/pr.json")" = "$main_head"
+          common="$(gh api "repos/${GITHUB_REPOSITORY}/compare/${main_head}...${persisted_head}" --jq '.merge_base_commit.sha')"
+          test "$common" = "$main_head"
+          jq -n --arg repo "$GITHUB_REPOSITORY" --arg ref "$TARGET_REF" \
+            --arg head "$persisted_head" --arg base "$main_head" --arg source_run "$GITHUB_RUN_ID" \
+            '{event_type:"qikvrt_autonomous_exact_head_verify",client_payload:{repository:$repo,pull_request:1160,head_ref:$ref,head_sha:$head,base_sha:$base,source_materializer_run_id:$source_run}}' \
+            > "$REPOSITORY_READBACK/verification-request.json"
+          test "$(git ls-remote --heads origin "refs/heads/$TARGET_REF" | awk 'NR == 1 {print $1}')" = "$persisted_head"
+          test "$(git ls-remote --heads origin refs/heads/main | awk 'NR == 1 {print $1}')" = "$main_head"
+          gh api --method POST "repos/${GITHUB_REPOSITORY}/dispatches" --input "$REPOSITORY_READBACK/verification-request.json"
+          echo 'VERIFICATION_REQUESTED_NOT_VERIFICATION_OR_EFFECT_ACK_DONE'
+      - name: Preserve repository integrity readback receipt
+        if: ${{ always() && github.event_name == 'push' && github.ref_name == 'mesh/effect-evidence-invariant-v1' }}
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: qikvrt-integrity-repository-readback-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/qikvrt-integrity-repository-readback/RECEIPT.json
+          if-no-files-found: error
+          overwrite: false
+          retention-days: 30
diff --git a/AI b/AI
index 1780c4fc262933779f24c718cadd0bc32f5ed390..2967df2e87d93a561e2fc13fed92ebf0e914705f 100644
--- a/AI
+++ b/AI
@@ -260,3 +260,8 @@ Competitiveness loop: identical reproducible workload and conditions -> QIK-VRT
 Prioritize the first causal defect on the real end-user path over cosmetic CI activity or additional green infrastructure. The canonical end-user distribution path is public download -> exact bytes -> firmware/standard-platform boot -> Linux -> Mega-ST/MC68000 -> Metatransputer/Cloud Transputer -> Universal Terminal -> Firefox -> TEMDD -> Effect-Acknowledgement -> useful human task. Repair the first failing edge, create a successor subject, and restart fresh validation; never hide it behind unrelated successful lanes.
 
 Release acceptance remains finite and evidence-bound under canonical TEMDD T1-T16, including DONE only from Working Software AND publicly reachable URL AND fresh readback of that URL. Continuous improvement does not terminate when a release reaches DONE: Release_n = DONE does not imply Improvement = DONE.
+
+
+MESH EFFECT-EVIDENCE INHERITANCE
+
+Every current and future QIK-VRT Mesh node MUST satisfy state/autonomy/MESH_EFFECT_EVIDENCE_INHERITANCE_V1.md before admission. Missing or unresolved inheritance is fail-closed and the node MUST NOT claim Mesh conformance. This requirement recursively applies to every future node, split, clone, successor repository, and descendant Mesh repository.
diff --git a/state/autonomy/MESH_EFFECT_EVIDENCE_INHERITANCE_V1.md b/state/autonomy/MESH_EFFECT_EVIDENCE_INHERITANCE_V1.md
new file mode 100644
index 0000000000000000000000000000000000000000..de84c67c4f8a737818b85fcb78aebd207d131c02
--- /dev/null
+++ b/state/autonomy/MESH_EFFECT_EVIDENCE_INHERITANCE_V1.md
@@ -0,0 +1,60 @@
+# QIK-VRT Mesh: Effect-Evidence Invariant
+
+Status: normative mesh inheritance contract
+Authority repository: Goldkelch/qik-vrt
+
+Every current Mesh node and every future Mesh repository/node MUST inherit this contract before admission.
+
+## Core invariants
+
+- TRANSPORT_ACK != EFFECT_ACK
+- PROCESS_COMPLETION != GOAL_COMPLETION
+- FAILURE_REPORT != FAILURE_RECOVERY
+- UNKNOWN => FAIL_CLOSED
+- CLAIM_SCOPE <= EVIDENCE_SCOPE
+- PREDECESSOR_EVIDENCE_TRANSFER = FALSE
+- MUTATION => REBIND_EXACT_SUBJECT
+
+No UI, workflow, transport, queue, API, mail client, cloud service, agent, or node may represent a stronger success state than its evidence establishes.
+
+## Required evidence classification
+
+Every material claim MUST be classified as exactly one of:
+1. DOCUMENTED_FACT — directly supported by retained primary evidence.
+2. DERIVED_FINDING — follows directly from documented facts; derivation must be stated.
+3. INTERPRETATION — system/ethical analysis, explicitly marked as interpretation.
+4. UNKNOWN — not established by available evidence.
+
+UNKNOWN MUST NOT be promoted to success, fact, delivery, recovery, effect, or completion.
+
+## Communication-specific invariant
+
+SENT != DELIVERED.
+DELIVERED != HUMAN_READ.
+NDR_GENERATED != RECOVERY_SUCCESS.
+
+A delivery failure or NDR is a new recovery work unit. A message remains effect-open until the claimed communication postcondition is supported by evidence within the same claim scope.
+
+The documented September 2026 incident establishes only the evidence scope retained for that incident: a send attempt, NDR generation, recipient-specific delivery failures reported with 550 5.7.520 / AS(4810), and no established successful recovery in that evidence. It does NOT establish that the content was objectively spam, intent by any operator, universal cloud failure, or a legal violation.
+
+## Node admission and inheritance
+
+Every node registration, split, clone, successor repository, and future Mesh repository MUST:
+- contain this contract or a byte-identical canonical reference resolved from Authority;
+- validate it during admission;
+- fail closed if absent, altered without an Authority successor, or unresolved;
+- preserve the fact/derivation/interpretation/UNKNOWN separation in generated evidence and user-visible status;
+- propagate this requirement to its own descendants.
+
+A node that cannot prove inheritance is NOT admitted as a conforming QIK-VRT Mesh node.
+
+## Effect closure
+
+EFFECT_ACK_DONE may be asserted as machine evidence only when the claimed postcondition is freshly observed, subject-bound, provenance-bound, and within evidence scope. Authority declarations remain distinct from machine-effect witnesses.
+
+This contract is recursive: future Mesh creation MUST install and validate the same invariant before the new node may claim conformance.
+
+
+## QIK-VRT MVP inheritance
+
+Every conforming node MUST also inherit and enforce state/autonomy/QIKVRT_MVP_EXACT_SUBJECT_RECOVERY_V1.md (or an Authority-bound byte-identical canonical reference). MVP conformance is fail-closed when this recovery contract is absent or unresolved.
diff --git a/state/autonomy/QIKVRT_MVP_EXACT_SUBJECT_RECOVERY_V1.md b/state/autonomy/QIKVRT_MVP_EXACT_SUBJECT_RECOVERY_V1.md
