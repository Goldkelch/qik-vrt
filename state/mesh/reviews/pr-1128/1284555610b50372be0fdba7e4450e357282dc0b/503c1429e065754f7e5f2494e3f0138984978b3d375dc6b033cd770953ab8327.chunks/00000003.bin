t_blob_sha":"e58dfa8a23ac9274a728ed532c5d0ea9c0eda479","name":"PREPUBLICATION_RETURN_RECEIPT.json","path":"docs/publications/2026-09-19-truth-needs-no-conspiracy-theory/PREPUBLICATION_RETURN_RECEIPT.json"},{"git_blob_sha":"a1304fecae94e62eacda951fa2dcb0db4f38ba78","name":"CHANGE_NOTICE.md","path":"docs/publications/2026-09-19-truth-needs-no-conspiracy-theory/CHANGE_NOTICE.md"},{"git_blob_sha":"357408b001a8f721dea11ad1a3e14d9248df8bb6","name":"README.md","path":"docs/publications/2026-09-19-truth-needs-no-conspiracy-theory/README.md"},{"git_blob_sha":"9c0d0928b343382d2073862f07e74cca0b503a54","name":"ZENODO_METADATA.json","path":"docs/publications/2026-09-19-truth-needs-no-conspiracy-theory/ZENODO_METADATA.json"},{"git_blob_sha":"a8a1a48f7429002d1c1ee0ec30e8c6a383e97341","name":"MACHINE_PROOF_BUNDLE.json","path":"docs/publications/2026-09-19-truth-needs-no-conspiracy-theory/MACHINE_PROOF_BUNDLE.json"}],"machine_proof":{"git_blob_sha":"a8a1a48f7429002d1c1ee0ec30e8c6a383e97341","path":"docs/publications/2026-09-19-truth-needs-no-conspiracy-theory/MACHINE_PROOF_BUNDLE.json","policy_id":"qikvrt-zenodo-machine-proof-before-publication-v2"},"metadata":{"access_right":"open","creators":[{"name":"Lohmann, Ingolf"}],"description":"Deutschsprachiges Dossier von Ingolf Lohmann mit den Artikeln ‚Die Wahrheit braucht keine Verschwörungstheorie‘, ‚Wenn Erwartungen handelbar werden‘ und ‚Wenn aus einer Wette eine Tat wird‘. Der Autor erklärt die kombinierte Wett-/Einflussnahmehypothese unter seinen gegenwärtig erwogenen Möglichkeiten für die wahrscheinlichste Erklärung. Diese Einschätzung wird ausdrücklich zugeschrieben: Das Dossier weist keinen konkreten Markt, Wettenden, Zahlungsfluss, Auftraggeber, Ausführenden, keine geschlossene Kausalkette, keine universelle QIK-VRT-Prognoseüberlegenheit und keine individuelle Schuld nach. Claim-Matrix, Primärquellenbindungen und negative Grenztests sind beigefügt.","keywords":["QIK-VRT","Prognosemärkte","Evidenz","Kausalität","Menschenwürde","Recht"],"language":"deu","license":"cc-by-nc-nd-4.0","notes":"Autor: Ingolf Lohmann. KI-unterstützte redaktionelle Ausarbeitung und maschinenlesbare Evidenzgrenzen: OpenAI ChatGPT Codex. Autoreneinschätzung ist von unabhängiger Evidenz getrennt.","prereserve_doi":true,"publication_date":"2026-09-19","publication_type":"other","related_identifiers":[{"identifier":"https://zenodo.org/records/22840633","relation":"isNewVersionOf","scheme":"url"}],"title":"Erwartungen, Wetten, Wirkung und Recht","upload_type":"publication","version":"2.0.0"},"owner_authorization":{"bytes":6559,"git_blob_sha":"d06c9781f329b5a6bf373e8e063b03ed02f5e931","path":"release/pr1128-truth-expectations-law-zenodo-v2/OWNER_ZENODO_AUTHORIZATION.json","sha256":"4f1da7f68dad6284f10265f1b09ce7d087392322c0eee96517aa9031cd0b227f"},"repository":"Goldkelch/qik-vrt","schema":"qikvrt_zenodo_publication_manifest_v2","source_head":"eff0cdaef77de58ad69971b3f22172ef82267f20","state":"publish"}
