+        f"machine_proof_sha256={proof['sha256']}"
+    )
+    (D / "AUTHORIZE_EXACT_UPLOAD.txt").write_text(
+        "# PENDING: exact statement for a subsequent natural-person decision; not yet granted.\n" + required + "\n",
+        encoding="utf-8",
