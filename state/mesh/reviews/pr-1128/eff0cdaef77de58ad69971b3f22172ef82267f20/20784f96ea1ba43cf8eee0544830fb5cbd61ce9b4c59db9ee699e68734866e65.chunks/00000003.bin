+        "source_ref": "publication/truth-no-conspiracy-theory-2026-09-19",
+        "source_commit": "9e3d7950853f7e4e98cc8214074641dd4af0bb01",
+        "source_tree": "114e18d5466db484b9df8b88a8163b9e32453157",
