+{
+  "title": "Erkenntnis durch Präzisierung und Korrektur: Eine methodische Notiz zum Monolithen-Motiv in 2001",
+  "upload_type": "publication",
+  "publication_type": "workingpaper",
+  "description": "<p>Methodische und interpretative Notiz zum stufenweisen Erkenntnisprozess: Präzisierung, Prüfung und nachvollziehbare Korrektur. Der Monolithen-Vergleich wird als Interpretation Ingolf Lohmanns gekennzeichnet. Der Bericht der National Academies (2019) dient als wissenschaftsmethodischer Bezug.</p><p>Die Notiz enthält keine empirische Studie, keinen Beweis der Raumzeitentstehung und keinen Ausschluss des Superdeterminismus. Idee und Vergleich: Ingolf Lohmann. KI-gestützte Ausarbeitung, Quellenprüfung und Paketierung: OpenAI Codex. Claim-Matrix, Quellenbindungen und Geltungsgrenzen liegen bei.</p>",
+  "creators": [
+    {
+      "name": "Lohmann, Ingolf"
+    }
+  ],
+  "publication_date": "2026-09-20",
+  "access_right": "open",
+  "license": "cc-by-nc-nd-4.0",
+  "version": "1.0",
+  "language": "deu",
+  "keywords": [
+    "QIK-VRT",
+    "Erkenntnisprozess",
+    "wissenschaftliche Methodik",
+    "Revision",
+    "Monolithen-Metapher"
+  ],
+  "related_identifiers": [
+    {
+      "identifier": "10.17226/25303",
+      "relation": "references",
+      "scheme": "doi"
+    }
+  ],
+  "prereserve_doi": true
+}
