+++ b/docs/journal/wahrheit-oder-spam/claims.json
@@ -0,0 +1,138 @@
+{
+  "schema": "qikvrt-journal-claims/1.0",
+  "article_id": "wahrheit-oder-spam-2026-09-24",
+  "canonical_url": "https://goldkelch.github.io/qik-vrt/journal/wahrheit-oder-spam/",
+  "version": "2026-09-24-v1",
+  "claims": [
+    {
+      "id": "C01",
+      "kind": "FACT",
+      "status": "PRIMARY_SOURCE",
+      "statement": "Am 23. September 2026 befasste sich der UN-Sicherheitsrat mit Risiken fortgeschrittener KI; OpenAI und Anthropic waren Teil des Briefings.",
+      "evidence": [
+        "https://www.un.org/en/live-openai-and-anthropic-brief-security-council-amid-%E2%80%98real-and-imminent%E2%80%99-threat-posed-runaway-ai"
+      ]
+    },
+    {
+      "id": "C02",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "Der EU AI Act verlangt für einschlägige Hochrisiko-KI-Systeme unter anderem fortlaufendes Risikomanagement und wirksame menschliche Aufsicht.",
+      "evidence": [
+        "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32024R1689"
+      ]
+    },
+    {
+      "id": "C03",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "Pressefreiheit ist in Deutschland durch Artikel 5 Grundgesetz geschützt.",
+      "evidence": [
+        "https://www.gesetze-im-internet.de/gg/art_5.html"
+      ]
+    },
+    {
+      "id": "C04",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "PASS_BOUND_SCOPE",
+      "statement": "Der QIK-VRT Mesh Audit Run 29753095894 weist für seinen definierten Prüfbereich status PASS aus.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/audit/QIKVRT_MESH_AUDIT_SUMMARY.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/QIKVRT_AUDIT_EXPORT.md"
+      ]
+    },
+    {
+      "id": "C05",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "EXECUTABLE_CONFORMANCE_PASS",
+      "statement": "QIK-VRT besitzt einen providerneutralen Fremd-KI-Auditor, der gebundene Ausführungsspuren automatisch mit PASS/BLOCK bewertet; der Exact-Head-Conformance-Workflow akzeptiert den positiven Vektor und blockiert stille Folgeaktionsauslassung sowie nicht autorisierte Wirkung.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_external_ai_audit.py",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md",
+        "https://github.com/Goldkelch/qik-vrt/actions/runs/35978831303"
+      ]
+    },
+    {
+      "id": "C06",
+      "kind": "ANALYSIS",
+      "status": "SUPPORTED_ANALYSIS",
+      "statement": "Hoher Kapital-, Markt- und geopolitischer Wettbewerbsdruck kann Sicherheits- und Reifezyklen verkürzen; dies ist eine Systemanalyse und keine Charakterdiagnose einer Nation.",
+      "evidence": [
+        "https://www.reuters.com/business/media-telecom/ten-days-that-changed-course-ai-2026-09-19/"
+      ]
+    },
+    {
+      "id": "C07",
+      "kind": "OPINION",
+      "status": "AUTHOR_WARNING_METAPHOR",
+      "statement": "Die Formulierung 'funktional bankrott' bezeichnet eine Warnung vor rechtsstaatlichem Funktionsverlust und keinen juristischen Insolvenz- oder Statusbefund.",
+      "evidence": []
+    },
+    {
+      "id": "C08",
+      "kind": "FORMAL_MATHEMATICS",
+      "status": "FORMALLY_VERIFIED_BOUND_SCOPE",
+      "statement": "Die QIK-VRT Formalisierung v2.0 dokumentiert vollständige formale Abdeckung ihres ausgewiesenen Manuskript-Scope mit expliziten Grenzen.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/formalization/QIKVRT_Formalization_v2.0/VERIFICATION_REPORT.md"
+      ]
+    },
+    {
+      "id": "C09",
+      "kind": "PHYSICS",
+      "status": "OPEN_CANDIDATE",
+      "statement": "Die physikalischen QIK-VRT Modelle sind formalisierte Forschungskandidaten; mathematische Modellprüfung wird nicht als empirische Naturbestätigung ausgegeben.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/tree/main/docs/publications/2026-08-02-vrtcore-smg-h5"
+      ]
+    },
+    {
+      "id": "C10",
+      "kind": "ETHICS",
+      "status": "NORMATIVE_INTERPRETATION",
+      "statement": "Die evidenzhinreichende Entscheidungsmaxime ist eine normative Übersetzung, kein empirischer oder rechtlicher Beweis.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a015_evidence_sufficiency_imperative.md"
+      ]
+    },
+    {
+      "id": "C11",
+      "kind": "SPIRITUALITY",
+      "status": "PHILOSOPHICAL_INTERPRETATION",
+      "statement": "Spirituelle Aussagen werden als religionsphilosophische Deutung gekennzeichnet und nicht als mathematischer oder physikalischer Beweis ausgegeben.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a006_reincarnation_info.md"
+      ]
+    },
+    {
+      "id": "C12",
+      "kind": "PRIORITY",
+      "status": "NOT_ESTABLISHED",
+      "statement": "Eine absolute Weltneuheitsbehauptung 'erstes interaktives Nachrichtenportal der Menschheit' wird nicht als bewiesen ausgegeben. Frühere Standards für maschinenlesbare journalistische Selbstevaluation und Transparenz existieren.",
+      "evidence": [
+        "https://journalismtrustinitiative.org/jti-the-standard/",
+        "https://thetrustproject.org/",
+        "https://www.w3.org/TR/prov-overview/"
+      ]
+    },
+    {
+      "id": "C13",
+      "kind": "BOUNDARY",
+      "status": "EXPLICIT_LIMIT",
+      "statement": "Der Fremd-KI-Audit ist vollautomatisch für eine vorliegende evidenzgebundene Auditspur; er behauptet keinen privilegierten Zugriff auf verborgenen Providerzustand.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md"
+      ]
+    },
+    {
+      "id": "C14",
+      "kind": "MULTILINGUAL_INTEGRITY",
+      "status": "MACHINE_CHECKED_CONTRACT",
+      "statement": "Deutsch, Englisch, Französisch, Russisch, Persisch und Chinesisch teilen dieselbe Artikel-ID, Version, Abschnitts-IDs, Claim-IDs, Quellenmenge und Korrekturlinie; die strukturelle Gleichheit wird automatisiert geprüft.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/journal/wahrheit-oder-spam/i18n/manifest.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_journal_i18n_integrity.py"
+      ]
+    }
+  ]
+}
