index 0000000000000000000000000000000000000000..ba39bed006b4440ab8af3a26c57c85948363f90d
--- /dev/null
+++ b/docs/journal/wahrheit-oder-spam/i18n/claims.fr.json
@@ -0,0 +1,139 @@
+{
+  "schema": "qikvrt-journal-claims/1.0",
+  "article_id": "wahrheit-oder-spam-2026-09-24",
+  "canonical_url": "https://goldkelch.github.io/qik-vrt/journal/wahrheit-oder-spam/",
+  "version": "2026-09-24-v1",
+  "claims": [
+    {
+      "id": "C01",
+      "kind": "FACT",
+      "status": "PRIMARY_SOURCE",
+      "statement": "Le 23 septembre 2026, le Conseil de sécurité de l’ONU a examiné les risques liés à l’IA avancée ; OpenAI et Anthropic faisaient partie du briefing.",
+      "evidence": [
+        "https://www.un.org/en/live-openai-and-anthropic-brief-security-council-amid-%E2%80%98real-and-imminent%E2%80%99-threat-posed-runaway-ai"
+      ]
+    },
+    {
+      "id": "C02",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "L’AI Act de l’UE impose, pour les systèmes d’IA à haut risque concernés, notamment une gestion continue des risques et un contrôle humain effectif.",
+      "evidence": [
+        "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32024R1689"
+      ]
+    },
+    {
+      "id": "C03",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "En Allemagne, la liberté de la presse est protégée par l’article 5 de la Loi fondamentale.",
+      "evidence": [
+        "https://www.gesetze-im-internet.de/gg/art_5.html"
+      ]
+    },
+    {
+      "id": "C04",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "PASS_BOUND_SCOPE",
+      "statement": "L’exécution d’audit QIK-VRT Mesh 29753095894 indique PASS pour son périmètre d’audit explicitement défini.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/audit/QIKVRT_MESH_AUDIT_SUMMARY.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/QIKVRT_AUDIT_EXPORT.md"
+      ]
+    },
+    {
+      "id": "C05",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "EXECUTABLE_CONFORMANCE_PASS",
+      "statement": "QIK-VRT comprend un auditeur d’IA externe indépendant du fournisseur qui évalue automatiquement des traces d’exécution liées à des preuves par PASS/BLOCK ; son workflow de conformité accepte le vecteur positif et bloque l’omission silencieuse d’actions requises ainsi que les effets non autorisés.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_external_ai_audit.py",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md",
+        "https://github.com/Goldkelch/qik-vrt/actions/runs/35978831303"
+      ]
+    },
+    {
+      "id": "C06",
+      "kind": "ANALYSIS",
+      "status": "SUPPORTED_ANALYSIS",
+      "statement": "Une forte pression concurrentielle liée aux capitaux, au marché et à la géopolitique peut raccourcir les cycles de sécurité et de maturité ; il s’agit d’une analyse de système et non d’un jugement de caractère sur une nation.",
+      "evidence": [
+        "https://www.reuters.com/business/media-telecom/ten-days-that-changed-course-ai-2026-09-19/"
+      ]
+    },
+    {
+      "id": "C07",
+      "kind": "OPINION",
+      "status": "AUTHOR_WARNING_METAPHOR",
+      "statement": "L’expression « fonctionnellement insolvable » est une métaphore d’alerte de l’auteur concernant une perte de fonction de l’État de droit, et non un constat juridique d’insolvabilité ou de statut.",
+      "evidence": []
+    },
+    {
+      "id": "C08",
+      "kind": "FORMAL_MATHEMATICS",
+      "status": "FORMALLY_VERIFIED_BOUND_SCOPE",
+      "statement": "La formalisation QIK-VRT v2.0 documente une couverture formelle complète de son périmètre de manuscrit déclaré, avec des limites explicites.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/formalization/QIKVRT_Formalization_v2.0/VERIFICATION_REPORT.md"
+      ]
+    },
+    {
+      "id": "C09",
+      "kind": "PHYSICS",
+      "status": "OPEN_CANDIDATE",
+      "statement": "Les modèles physiques QIK-VRT sont des candidats de recherche formalisés ; la vérification mathématique du modèle n’est pas présentée comme une confirmation empirique de la nature.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/tree/main/docs/publications/2026-08-02-vrtcore-smg-h5"
+      ]
+    },
+    {
+      "id": "C10",
+      "kind": "ETHICS",
+      "status": "NORMATIVE_INTERPRETATION",
+      "statement": "La maxime de suffisance des preuves est une interprétation normative, et non une preuve empirique ou juridique.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a015_evidence_sufficiency_imperative.md"
+      ]
+    },
+    {
+      "id": "C11",
+      "kind": "SPIRITUALITY",
+      "status": "PHILOSOPHICAL_INTERPRETATION",
+      "statement": "Les affirmations spirituelles sont identifiées comme interprétation religieuse et philosophique et ne sont pas présentées comme preuve mathématique ou physique.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a006_reincarnation_info.md"
+      ]
+    },
+    {
+      "id": "C12",
+      "kind": "PRIORITY",
+      "status": "NOT_ESTABLISHED",
+      "statement": "Une priorité mondiale absolue telle que « premier portail d’actualités interactif de l’histoire de l’humanité » n’est pas présentée comme établie. Des normes antérieures de transparence et d’auto-évaluation journalistique lisible par machine existent.",
+      "evidence": [
+        "https://journalismtrustinitiative.org/jti-the-standard/",
+        "https://thetrustproject.org/",
+        "https://www.w3.org/TR/prov-overview/"
+      ]
+    },
+    {
+      "id": "C13",
+      "kind": "BOUNDARY",
+      "status": "EXPLICIT_LIMIT",
+      "statement": "L’audit d’IA externe est entièrement automatique pour une trace d’audit liée à des preuves déjà disponible ; il ne prétend pas accéder de manière privilégiée à l’état caché d’un fournisseur.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md"
+      ]
+    },
+    {
+      "id": "C14",
+      "kind": "MULTILINGUAL_INTEGRITY",
+      "status": "MACHINE_CHECKED_CONTRACT",
+      "statement": "L’allemand, l’anglais, le français, le russe, le persan et le chinois partagent le même identifiant d’article, la même version, les mêmes identifiants de segments et d’affirmations, le même ensemble de sources et la même lignée de corrections ; l’équivalence structurelle est vérifiée automatiquement.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/journal/wahrheit-oder-spam/i18n/manifest.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_journal_i18n_integrity.py"
+      ]
+    }
+  ],
+  "locale": "fr"
+}
