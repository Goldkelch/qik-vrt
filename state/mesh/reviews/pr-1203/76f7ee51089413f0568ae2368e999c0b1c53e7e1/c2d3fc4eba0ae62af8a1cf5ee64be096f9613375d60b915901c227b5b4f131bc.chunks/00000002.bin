+{
+  "schema": "qikvrt-journal-claims/1.0",
+  "article_id": "wahrheit-oder-spam-2026-09-24",
+  "canonical_url": "https://goldkelch.github.io/qik-vrt/journal/wahrheit-oder-spam/",
+  "version": "2026-09-24-v1",
+  "claims": [
+    {
+      "id": "C01",
+      "kind": "FACT",
+      "status": "PRIMARY_SOURCE",
+      "statement": "2026年9月23日，联合国安全理事会讨论了先进人工智能风险；OpenAI 和 Anthropic 参与了相关简报。",
+      "evidence": [
+        "https://www.un.org/en/live-openai-and-anthropic-brief-security-council-amid-%E2%80%98real-and-imminent%E2%80%99-threat-posed-runaway-ai"
+      ]
+    },
+    {
+      "id": "C02",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "欧盟《人工智能法案》要求适用的高风险人工智能系统采取包括持续风险管理和有效人类监督在内的措施。",
+      "evidence": [
+        "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32024R1689"
+      ]
+    },
+    {
+      "id": "C03",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "德国《基本法》第5条保护新闻自由。",
+      "evidence": [
+        "https://www.gesetze-im-internet.de/gg/art_5.html"
+      ]
+    },
+    {
+      "id": "C04",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "PASS_BOUND_SCOPE",
+      "statement": "QIK-VRT Mesh 审计运行 29753095894 在其明确界定的审计范围内报告 PASS。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/audit/QIKVRT_MESH_AUDIT_SUMMARY.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/QIKVRT_AUDIT_EXPORT.md"
+      ]
+    },
+    {
+      "id": "C05",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "EXECUTABLE_CONFORMANCE_PASS",
+      "statement": "QIK-VRT 包含与供应商无关的外部人工智能审计器，可自动将证据绑定的执行轨迹评定为 PASS/BLOCK；其一致性工作流接受正向向量，并阻止静默遗漏必要后续动作以及未经授权的效果。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_external_ai_audit.py",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md",
+        "https://github.com/Goldkelch/qik-vrt/actions/runs/35978831303"
+      ]
+    },
+    {
+      "id": "C06",
+      "kind": "ANALYSIS",
+      "status": "SUPPORTED_ANALYSIS",
+      "statement": "资本、市场和地缘政治竞争的强大压力可能压缩安全与成熟周期；这是系统分析，而不是对某个国家国民性格的判断。",
+      "evidence": [
+        "https://www.reuters.com/business/media-telecom/ten-days-that-changed-course-ai-2026-09-19/"
+      ]
+    },
+    {
+      "id": "C07",
+      "kind": "OPINION",
+      "status": "AUTHOR_WARNING_METAPHOR",
+      "statement": "“功能性破产”是作者对法治功能丧失的警示性比喻，并非关于某个国家法律破产或法律地位的结论。",
+      "evidence": []
+    },
+    {
+      "id": "C08",
+      "kind": "FORMAL_MATHEMATICS",
+      "status": "FORMALLY_VERIFIED_BOUND_SCOPE",
+      "statement": "QIK-VRT Formalization v2.0 记录了其明确声明的论文范围内完整的形式化覆盖，并清楚标注边界。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/formalization/QIKVRT_Formalization_v2.0/VERIFICATION_REPORT.md"
+      ]
+    },
+    {
+      "id": "C09",
+      "kind": "PHYSICS",
+      "status": "OPEN_CANDIDATE",
+      "statement": "QIK-VRT 物理模型是形式化的研究候选；数学模型验证不会被表述为对自然界的经验确认。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/tree/main/docs/publications/2026-08-02-vrtcore-smg-h5"
+      ]
+    },
+    {
+      "id": "C10",
+      "kind": "ETHICS",
+      "status": "NORMATIVE_INTERPRETATION",
+      "statement": "证据充分性决策准则是一种规范性解释，而不是经验或法律证明。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a015_evidence_sufficiency_imperative.md"
+      ]
+    },
+    {
+      "id": "C11",
+      "kind": "SPIRITUALITY",
+      "status": "PHILOSOPHICAL_INTERPRETATION",
+      "statement": "灵性主张被标记为宗教哲学解释，不会被表述为数学或物理证明。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a006_reincarnation_info.md"
+      ]
+    },
+    {
+      "id": "C12",
+      "kind": "PRIORITY",
+      "status": "NOT_ESTABLISHED",
+      "statement": "诸如“人类历史上第一个交互式新闻门户”这样的绝对全球首创主张不会被当作已经证明。此前已经存在机器可读的新闻自我评估和透明度标准。",
+      "evidence": [
+        "https://journalismtrustinitiative.org/jti-the-standard/",
+        "https://thetrustproject.org/",
+        "https://www.w3.org/TR/prov-overview/"
+      ]
+    },
+    {
+      "id": "C13",
+      "kind": "BOUNDARY",
+      "status": "EXPLICIT_LIMIT",
+      "statement": "对于已经提供的、证据绑定的审计轨迹，外部人工智能审计可以完全自动执行；它不声称拥有对供应商隐藏状态的特权访问。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md"
+      ]
+    },
+    {
+      "id": "C14",
+      "kind": "MULTILINGUAL_INTEGRITY",
+      "status": "MACHINE_CHECKED_CONTRACT",
+      "statement": "德语、英语、法语、俄语、波斯语和中文版本共享同一文章 ID、版本、段落 ID、主张 ID、来源集合和更正链；结构等价性由机器自动检查。",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/journal/wahrheit-oder-spam/i18n/manifest.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_journal_i18n_integrity.py"
+      ]
+    }
+  ],
+  "locale": "zh-Hans"
+}
diff --git a/docs/journal/wahrheit-oder-spam/i18n/content.de.json b/docs/journal/wahrheit-oder-spam/i18n/content.de.json
new file mode 100644
index 0000000000000000000000000000000000000000..5c205ddd012b30ac1cd51a7b709dcbabe4582776
--- /dev/null
+++ b/docs/journal/wahrheit-oder-spam/i18n/content.de.json
@@ -0,0 +1,107 @@
+{
+  "locale": "de",
+  "lang": "de",
+  "dir": "ltr",
+  "title": "Wahrheit oder Spam?",
+  "deck": "Wenn niemand mehr nachvollziehen kann, was wahr ist, was gilt, wer verantwortlich ist und worauf eine Entscheidung beruht, gerät nicht nur die digitale Kommunikation, sondern auch der Rechtsstaat an seine funktionale Grenze.",
+  "byline": "Von Ingolf Lohmann, Informatiker",
+  "sections": [
+    {
+      "id": "anlass",
+      "heading": "Der Anlass",
+      "p": [
+        "Am 23. September 2026 befasste sich der Sicherheitsrat der Vereinten Nationen mit Risiken fortgeschrittener künstlicher Intelligenz. Vertreter von OpenAI und Anthropic warnten dort vor schwerwiegenden Kontrollrisiken.",
+        "Ich halte diese Warnung für ernst. Aber das Grundproblem ist älter als künstliche Intelligenz: Wir bauen Systeme schneller, als wir lernen, ihre Wirkungen zuverlässig zu kontrollieren. Neu sind Geschwindigkeit, Reichweite und die Tatsache, dass künstliche Systeme inzwischen selbst handeln, kommunizieren und weitere Prozesse auslösen können."
+      ]
+    },
+    {
+      "id": "rechtsstaat",
+      "heading": "Wann ist ein Rechtsstaat funktional bankrott?",
+      "p": [
+        "„Bankrott“ ist hier kein juristischer Status, sondern eine Warnmetapher für Funktionsverlust.",
+        "Ein Rechtsstaat lebt davon, dass nachvollziehbar bleibt, welches Recht gilt, welche Tatsachen einer Entscheidung zugrunde liegen, wer zuständig war und wie eine Entscheidung überprüft werden kann. Wenn Herkunft, Version, Belege und Verantwortlichkeit systematisch nicht mehr rekonstruierbar sind, wird Kontrolle immer schwieriger und Recht droht praktisch durch bloße Macht ersetzt zu werden."
+      ]
+    },
+    {
+      "id": "spam",
+      "heading": "Die neue Frage lautet: Wahrheit oder Spam?",
+      "p": [
+        "Eine wichtige Nachricht kann technisch genauso aussehen wie unerwünschte Massenkommunikation. Sie kann wahr sein und im Filter verschwinden, zugestellt werden und niemandem zugeordnet sein oder gelesen werden und trotzdem in der Informationsflut ihre Bedeutung verlieren.",
+        "Deshalb müssen digitale Systeme wieder beantworten können: Woher stammt eine Aussage? Worauf bezieht sie sich? Welche Belege gibt es? Welche Grenzen haben sie? Wer trägt Verantwortung? Welche Handlung wurde tatsächlich ausgeführt? Und ist die behauptete Wirkung eingetreten?"
+      ]
+    },
+    {
+      "id": "wirtschaft",
+      "heading": "Der wirtschaftliche Widerspruch",
+      "p": [
+        "Führende KI-Unternehmen warnen vor Kontrollverlust und stehen gleichzeitig in einem außergewöhnlich intensiven technologischen und wirtschaftlichen Wettbewerb.",
+        "Das ist keine Charakterdiagnose einer Nation. Es ist eine globale Optimierungslogik, die im US-geprägten KI-Markt besonders sichtbar ist: Geschwindigkeit, Kapital, Marktanteil und technologische Führerschaft werden sofort belohnt; Sicherheit, Reproduzierbarkeit und unabhängige Prüfung brauchen Zeit. Das ist ein Systemproblem."
+      ]
+    },
+    {
+      "id": "qikvrt",
+      "heading": "Meine Antwort darauf heißt QIK-VRT",
+      "p": [
+        "Ich, Ingolf Lohmann, habe versucht, aus künstlicher Kognition etwas anderes zu machen: kein System, das möglichst überzeugend behauptet, richtig zu liegen, sondern eines, das Aussagen, Entscheidungen und Wirkungen an überprüfbare Nachweise bindet.",
+        "QIK-VRT besitzt einen veröffentlichten automatisierten Selbstaudit. Der Auditlauf 29753095894 weist für seinen definierten Prüfbereich ausdrücklich PASS aus. Bericht, Revalidierung und reproduzierbarer Prüfstand sind öffentlich einsehbar.",
+        "Zusätzlich besitzt QIK-VRT inzwischen einen providerneutralen Prüfer für gebundene Ausführungsspuren anderer KI-Systeme. Er entscheidet automatisch PASS oder BLOCK, sobald eine prüfbare Spur vorliegt. Das ist kein privilegierter Zugriff auf fremde Anbieter und keine Rechtszertifizierung; es ist ein reproduzierbares technisches Auditformat."
+      ]
+    },
+    {
+      "id": "eu",
+      "heading": "Warum Europa bereits die richtige Rechtsidee besitzt",
+      "p": [
+        "Der EU AI Act verlangt je nach Einsatz unter anderem Risikomanagement, Dokumentation, Protokollierung, technische Robustheit und wirksame menschliche Aufsicht.",
+        "Der entscheidende Gedanke lautet: Kontrolle muss wirksam sein. Ein Mensch im Ablauf genügt nicht, wenn er Grenzen nicht erkennen, Ergebnisse nicht hinterfragen oder nicht eingreifen kann. QIK-VRT setzt technisch dort an: Eine Handlung gilt nicht schon deshalb als erfolgreich, weil sie angekündigt oder gestartet wurde. Entscheidend ist die nachweisbare Wirkung."
+      ]
+    },
+    {
+      "id": "journalismus",
+      "heading": "Darum darf freier Journalismus nicht sterben",
+      "p": [
+        "Wenn Öffentlichkeit nicht mehr zuverlässig zwischen überprüfbarer Information, Werbung, automatisierter Masse, Manipulation und bloßer Behauptung unterscheiden kann, wird unabhängiger Journalismus wichtiger, nicht weniger wichtig.",
+        "Pressefreiheit ist Teil der demokratischen Kontrollarchitektur. In einer Welt künstlicher Kognition braucht Journalismus zusätzlich dauerhafte Quellen, sichtbare Versionen, dokumentierte Korrekturen und eine klare Trennung zwischen Nachricht, Kommentar, Hypothese, Beweis und weltanschaulicher Interpretation."
+      ]
+    },
+    {
+      "id": "portal",
+      "heading": "Darum entsteht das QIK-VRT Journal",
+      "p": [
+        "Eine veröffentlichte URL soll erreichbar bleiben. Eine veröffentlichte Fassung soll dauerhaft zitierbar sein. Eine Korrektur soll die Vergangenheit nicht löschen, sondern sichtbar ergänzen.",
+        "Jeder Artikel kann seine Claims, Quellen und Korrekturen maschinenlesbar mitführen. Historische Fassungen werden durch Repository-Regeln gegen stilles Überschreiben geschützt."
+      ]
+    },
+    {
+      "id": "sprachen",
+      "heading": "Eine Nachricht – sechs Sprachen – dieselben Belege",
+      "p": [
+        "Dieser Artikel wird inhaltsgleich auf Deutsch, Englisch, Französisch, Russisch, Persisch und Chinesisch veröffentlicht; weitere Sprachen können nach demselben Vertrag hinzukommen.",
+        "Das Alleinstellungsmerkmal ist nicht bloße Mehrsprachigkeit. Große Medien arbeiten seit Jahrzehnten mehrsprachig. Der QIK-VRT-Anspruch ist enger: Jede Sprachfassung trägt dieselbe Artikel-ID, dieselbe Version, dieselben Abschnitts-IDs, dieselben Claim-IDs, dieselben Quellen und dieselbe Korrekturhistorie. Ein CI-Check blockiert fehlende oder strukturell auseinanderlaufende Sprachfassungen."
+      ]
+    },
+    {
+      "id": "disziplinen",
+      "heading": "Das geht über Informatik hinaus",
+      "p": [
+        "Mathematik kann formale Aussagen beweisen. Physik muss Modelle an der Natur prüfen. Informatik kann Herkunft und Wirkung reproduzierbar machen. Recht entscheidet in legitimierten Verfahren. Ethik fragt, welche Handlungen verantwortbar sind. Journalismus macht Vorgänge öffentlich überprüfbar. Spiritualität darf Bedeutung und Transzendenz deuten, ohne als mathematischer oder physikalischer Beweis ausgegeben zu werden.",
+        "Gerade die saubere Trennung dieser Erkenntnisformen macht ihre Verbindung möglich."
+      ]
+    },
+    {
+      "id": "belege",
+      "heading": "Der Selbstaudit liegt offen",
+      "p": [
+        "Niemand muss diese Aussagen glauben. Die zentralen technischen Belege liegen öffentlich vor. Der Selbstaudit belegt seinen benannten Prüfbereich; er ersetzt weder Gericht noch Aufsichtsbehörde noch eine gesetzlich erforderliche externe Konformitätsbewertung.",
+        "Die Aufforderung lautet deshalb: Nicht glauben. Prüfen."
+      ]
+    },
+    {
+      "id": "schluss",
+      "heading": "Wahrheit oder Spam?",
+      "p": [
+        "Wahrheit wird nicht durch Software erzeugt. Aber wir können Systeme bauen, in denen nachvollziehbar bleibt, warum eine Behauptung Anspruch auf Vertrauen erhebt.",
+        "Wenn wir das verlieren, verlieren wir mehr als gute Software. Dann verlieren wir die gemeinsame Grundlage, auf der Wissenschaft, Recht, Demokratie und freie Öffentlichkeit überhaupt miteinander streiten können."
+      ]
+    }
+  ]
+}
diff --git a/docs/journal/wahrheit-oder-spam/i18n/content.en.json b/docs/journal/wahrheit-oder-spam/i18n/content.en.json
new file mode 100644
index 0000000000000000000000000000000000000000..b2ccec2924c05c9a043dcabe8eba76fe4c293ef1
--- /dev/null
+++ b/docs/journal/wahrheit-oder-spam/i18n/content.en.json
@@ -0,0 +1,107 @@
+{
+  "locale": "en",
+  "lang": "en",
+  "dir": "ltr",
+  "title": "Truth or Spam?",
+  "deck": "When no one can reliably reconstruct what is true, what rules apply, who is responsible and what a decision is based on, not only digital communication but the rule of law itself approaches a functional limit.",
+  "byline": "By Ingolf Lohmann, computer scientist",
+  "sections": [
+    {
+      "id": "anlass",
+      "heading": "The occasion",
+      "p": [
+        "On 23 September 2026, the United Nations Security Council addressed risks from advanced artificial intelligence. Representatives of OpenAI and Anthropic warned of serious control risks.",
+        "I take those warnings seriously. But the underlying problem is older than AI: we build systems faster than we learn to control their effects reliably. What is new is the speed, scale and the fact that artificial systems can now act, communicate and trigger further processes themselves."
+      ]
+    },
+    {
+      "id": "rechtsstaat",
+      "heading": "When does the rule of law become functionally bankrupt?",
+      "p": [
+        "“Bankrupt” is not a legal status here. It is a warning metaphor for loss of function.",
+        "The rule of law depends on the ability to determine which law applies, what facts a decision rests on, who had authority and how the decision can be reviewed. If origin, version, evidence and responsibility can no longer be reconstructed, accountability becomes harder and law risks being replaced in practice by mere power."
+      ]
+    },
+    {
+      "id": "spam",
+      "heading": "The new question is: truth or spam?",
+      "p": [
+        "An important message can look technically identical to unwanted bulk communication. It can be true and disappear in a filter, be delivered without reaching an accountable owner, or be read and still lose its meaning in the information flood.",
+        "Digital systems therefore need to answer again: Where did a claim come from? What does it refer to? What evidence supports it? What are the limits of that evidence? Who is responsible? What action was actually performed? And did the claimed effect really occur?"
+      ]
+    },
+    {
+      "id": "wirtschaft",
+      "heading": "The economic contradiction",
+      "p": [
+        "Leading AI companies warn about loss of control while simultaneously competing under extraordinary technological and economic pressure.",
+        "This is not a character judgment about a nation. It is a global optimization logic that is especially visible in the US-shaped AI market: speed, capital, market share and technological leadership are rewarded immediately; safety, reproducibility and independent verification take time. That is a systems problem."
+      ]
+    },
+    {
+      "id": "qikvrt",
+      "heading": "My response is called QIK-VRT",
+      "p": [
+        "I, Ingolf Lohmann, have tried to turn artificial cognition into something different: not a system that merely sounds convincing when it claims to be right, but one that binds claims, decisions and effects to verifiable evidence.",
+        "QIK-VRT has a published automated self-audit. Audit run 29753095894 explicitly reports PASS for its defined scope. The report, revalidation data and reproducible verification state are public.",
+        "QIK-VRT now also includes a provider-neutral auditor for evidence-bound execution traces from other AI systems. It automatically returns PASS or BLOCK once an auditable trace exists. This is neither privileged access to another provider nor legal certification; it is a reproducible technical audit format."
+      ]
+    },
+    {
+      "id": "eu",
+      "heading": "Why Europe already has the right legal idea",
+      "p": [
+        "Depending on the use case, the EU AI Act requires measures including risk management, documentation, logging, technical robustness and effective human oversight.",
+        "The key idea is simple: control must be effective. A human in the loop is not enough if that person cannot understand limits, challenge outputs or intervene. QIK-VRT addresses the same problem technically: an action is not successful merely because it was announced or started. What matters is the demonstrated effect."
+      ]
+    },
+    {
+      "id": "journalismus",
+      "heading": "Why free journalism must not die",
+      "p": [
+        "If the public can no longer distinguish reliably between verifiable information, advertising, automated mass content, manipulation and unsupported assertions, independent journalism becomes more important, not less.",
+        "Freedom of the press is part of democratic control. In a world of artificial cognition, journalism also needs durable sources, visible versions, documented corrections and a clear distinction between news, commentary, hypothesis, proof and philosophical interpretation."
+      ]
+    },
+    {
+      "id": "portal",
+      "heading": "Why the QIK-VRT Journal is being created",
+      "p": [
+        "A published URL should remain reachable. A published version should remain citable. A correction should not erase the past but visibly extend it.",
+        "Each article can carry its claims, sources and corrections in machine-readable form. Repository rules protect historical versions against silent rewriting."
+      ]
+    },
+    {
+      "id": "sprachen",
+      "heading": "One story – six languages – the same evidence",
+      "p": [
+        "This article is published with equivalent content in German, English, French, Russian, Persian and Chinese; additional languages can be added under the same contract.",
+        "The differentiator is not multilingual publishing by itself. Major media have done that for decades. QIK-VRT makes a narrower claim: every language version carries the same article ID, version, segment IDs, claim IDs, sources and correction history. CI blocks missing or structurally divergent language editions."
+      ]
+    },
+    {
+      "id": "disziplinen",
+      "heading": "This goes beyond computer science",
+      "p": [
+        "Mathematics can prove formal statements. Physics must test models against nature. Computer science can make provenance and effects reproducible. Law decides rights and duties through legitimate procedures. Ethics asks which actions are responsible. Journalism makes events publicly reviewable. Spirituality may interpret meaning and transcendence without being presented as mathematical or physical proof.",
+        "Precisely separating these kinds of knowledge is what makes meaningful connection between them possible."
+      ]
+    },
+    {
+      "id": "belege",
+      "heading": "The self-audit is public",
+      "p": [
+        "No one needs to believe these claims. The central technical evidence is public. The self-audit proves its stated scope; it does not replace a court, regulator or legally required external conformity assessment.",
+        "The invitation is therefore simple: do not believe it. Check it."
+      ]
+    },
+    {
+      "id": "schluss",
+      "heading": "Truth or spam?",
+      "p": [
+        "Software does not manufacture truth. But we can build systems in which it remains possible to understand why a claim deserves trust.",
+        "If we lose that, we lose more than good software. We lose the common ground on which science, law, democracy and a free public sphere can disagree at all."
+      ]
+    }
+  ]
+}
diff --git a/docs/journal/wahrheit-oder-spam/i18n/content.fa.json b/docs/journal/wahrheit-oder-spam/i18n/content.fa.json
new file mode 100644
index 0000000000000000000000000000000000000000..4218d6c3964aa046702f74acb35f321462df10de
--- /dev/null
+++ b/docs/journal/wahrheit-oder-spam/i18n/content.fa.json
@@ -0,0 +1,107 @@
+{
+  "locale": "fa",
+  "lang": "fa",
+  "dir": "rtl",
+  "title": "حقیقت یا هرزنامه؟",
+  "deck": "اگر دیگر نتوانیم با اطمینان بازسازی کنیم چه چیزی درست است، کدام قانون اعمال می‌شود، چه کسی مسئول است و یک تصمیم بر چه مبنایی گرفته شده، نه فقط ارتباطات دیجیتال بلکه خود حاکمیت قانون نیز به مرز ازکارافتادگی کارکردی نزدیک می‌شود.",
+  "byline": "اینگولف لومان، متخصص علوم کامپیوتر",
+  "sections": [
+    {
+      "id": "anlass",
+      "heading": "دلیل این نوشته",
+      "p": [
+        "در ۲۳ سپتامبر ۲۰۲۶ شورای امنیت سازمان ملل متحد به خطرهای هوش مصنوعی پیشرفته پرداخت. نمایندگان OpenAI و Anthropic درباره خطرهای جدیِ از دست رفتن کنترل هشدار دادند.",
+        "من این هشدارها را جدی می‌گیرم. اما مسئله بنیادی از هوش مصنوعی قدیمی‌تر است: ما سامانه‌ها را سریع‌تر از آن می‌سازیم که بیاموزیم آثارشان را به‌طور قابل اعتماد کنترل کنیم. چیز تازه، سرعت، مقیاس و این واقعیت است که سامانه‌های مصنوعی اکنون می‌توانند خودشان عمل کنند، ارتباط برقرار کنند و فرایندهای دیگری را به راه بیندازند."
+      ]
+    },
+    {
+      "id": "rechtsstaat",
+      "heading": "حاکمیت قانون چه زمانی از نظر کارکردی ورشکسته می‌شود؟",
+      "p": [
+        "«ورشکستگی» در اینجا یک وضعیت حقوقی نیست؛ استعاره‌ای هشداردهنده برای از دست رفتن کارکرد است.",
+        "حاکمیت قانون به این وابسته است که بتوان فهمید کدام قانون اعمال می‌شود، چه واقعیت‌هایی مبنای تصمیم بوده، چه کسی صلاحیت داشته و تصمیم چگونه قابل بازبینی است. اگر منشأ، نسخه، شواهد و مسئولیت دیگر قابل بازسازی نباشد، پاسخ‌گویی دشوار می‌شود و قانون در عمل ممکن است جای خود را به صرف قدرت بدهد."
+      ]
+    },
+    {
+      "id": "spam",
+      "heading": "پرسش تازه: حقیقت یا هرزنامه؟",
+      "p": [
+        "یک پیام مهم می‌تواند از نظر فنی دقیقاً شبیه یک پیام انبوه ناخواسته باشد. ممکن است درست باشد و در فیلتر ناپدید شود، تحویل داده شود اما به مسئول مشخصی نرسد، یا خوانده شود و با این حال در سیل اطلاعات معنای خود را از دست بدهد.",
+        "بنابراین سامانه‌های دیجیتال باید دوباره بتوانند پاسخ دهند: این ادعا از کجا آمده؟ به چه چیزی اشاره می‌کند؟ چه شواهدی دارد و مرز آن شواهد چیست؟ چه کسی مسئول است؟ چه عملی واقعاً انجام شده؟ و آیا اثر ادعاشده واقعاً رخ داده است؟"
+      ]
+    },
+    {
+      "id": "wirtschaft",
+      "heading": "تناقض اقتصادی",
+      "p": [
+        "شرکت‌های پیشرو در هوش مصنوعی درباره از دست رفتن کنترل هشدار می‌دهند و در عین حال در رقابتی بسیار شدیدِ فناورانه و اقتصادی فعالیت می‌کنند.",
+        "این داوری درباره شخصیت یک ملت نیست. این یک منطق جهانیِ بهینه‌سازی است که در بازار هوش مصنوعی شکل‌گرفته تحت نفوذ آمریکا به‌ویژه آشکار است: سرعت، سرمایه، سهم بازار و رهبری فناوری فوراً پاداش می‌گیرند؛ امنیت، بازتولیدپذیری و راستی‌آزمایی مستقل زمان می‌خواهند. این یک مسئله سامانه‌ای است."
+      ]
+    },
+    {
+      "id": "qikvrt",
+      "heading": "پاسخ من QIK-VRT است",
+      "p": [
+        "من، اینگولف لومان، تلاش کرده‌ام از شناخت مصنوعی چیزی متفاوت بسازم: نه سامانه‌ای که فقط قانع‌کننده ادعا کند حق با اوست، بلکه سامانه‌ای که ادعاها، تصمیم‌ها و آثار را به شواهد قابل راستی‌آزمایی پیوند دهد.",
+        "QIK-VRT یک خودممیزی خودکار و منتشرشده دارد. اجرای ممیزی 29753095894 برای دامنه تعریف‌شده خود صراحتاً وضعیت PASS را گزارش می‌کند. گزارش، اعتبارسنجی دوباره و وضعیت آزمون بازتولیدپذیر عمومی هستند.",
+        "QIK-VRT اکنون همچنین یک ممیز مستقل از ارائه‌دهنده برای ردپاهای اجراییِ مبتنی بر شواهد از سامانه‌های دیگر هوش مصنوعی دارد. هرگاه ردپای قابل ممیزی موجود باشد، سامانه به‌طور خودکار PASS یا BLOCK می‌دهد. این نه دسترسی ویژه به یک ارائه‌دهنده دیگر است و نه گواهی حقوقی؛ بلکه یک قالب ممیزی فنی و بازتولیدپذیر است."
+      ]
+    },
+    {
+      "id": "eu",
+      "heading": "چرا اروپا از پیش ایده حقوقی درستی دارد",
+      "p": [
+        "بسته به کاربرد، قانون هوش مصنوعی اتحادیه اروپا الزاماتی مانند مدیریت ریسک، مستندسازی، ثبت رویدادها، استحکام فنی و نظارت مؤثر انسانی را مقرر می‌کند.",
+        "ایده اصلی ساده است: کنترل باید مؤثر باشد. صرف حضور یک انسان کافی نیست اگر نتواند محدودیت‌ها را بفهمد، خروجی را به چالش بکشد یا مداخله کند. QIK-VRT همین مسئله را فنی می‌کند: یک عمل فقط به این دلیل موفق نیست که اعلام یا آغاز شده است. آنچه اهمیت دارد اثرِ اثبات‌شده است."
+      ]
+    },
+    {
+      "id": "journalismus",
+      "heading": "چرا روزنامه‌نگاری آزاد نباید بمیرد",
+      "p": [
+        "اگر جامعه دیگر نتواند میان اطلاعات قابل راستی‌آزمایی، تبلیغ، محتوای انبوه خودکار، دستکاری و ادعای بدون پشتوانه تمایز قابل اعتماد برقرار کند، روزنامه‌نگاری مستقل مهم‌تر می‌شود، نه کم‌اهمیت‌تر.",
+        "آزادی مطبوعات بخشی از معماری کنترل دموکراتیک است. در جهان شناخت مصنوعی، روزنامه‌نگاری همچنین به منابع پایدار، نسخه‌های قابل مشاهده، اصلاحات مستند و تفکیک روشن میان خبر، نظر، فرضیه، اثبات و تفسیر فلسفی نیاز دارد."
+      ]
+    },
+    {
+      "id": "portal",
+      "heading": "چرا QIK-VRT Journal ایجاد می‌شود",
+      "p": [
+        "یک URL منتشرشده باید در دسترس بماند. یک نسخه منتشرشده باید همواره قابل استناد باشد. اصلاح نباید گذشته را پاک کند؛ باید آن را به‌صورت آشکار تکمیل کند.",
+        "هر مقاله می‌تواند ادعاها، منابع و اصلاحات خود را به شکل ماشین‌خوان همراه داشته باشد. قواعد مخزن از بازنویسی پنهانی نسخه‌های تاریخی جلوگیری می‌کنند."
+      ]
+    },
+    {
+      "id": "sprachen",
+      "heading": "یک خبر — شش زبان — همان شواهد",
+      "p": [
+        "این مقاله با محتوای هم‌ارز به زبان‌های آلمانی، انگلیسی، فرانسوی، روسی، فارسی و چینی منتشر می‌شود و زبان‌های دیگر نیز می‌توانند با همین قرارداد افزوده شوند.",
+        "تمایز صرفاً چندزبانه بودن نیست. رسانه‌های بزرگ دهه‌هاست چندزبانه‌اند. ادعای QIK-VRT دقیق‌تر است: هر نسخه زبانی همان شناسه مقاله، همان نسخه، همان شناسه‌های بخش و ادعا، همان منابع و همان تاریخچه اصلاحات را دارد. CI نسخه‌های ناقص یا دارای واگرایی ساختاری را مسدود می‌کند."
+      ]
+    },
+    {
+      "id": "disziplinen",
+      "heading": "این موضوع فراتر از علوم کامپیوتر است",
+      "p": [
+        "ریاضیات می‌تواند گزاره‌های صوری را اثبات کند. فیزیک باید مدل‌ها را با طبیعت بیازماید. علوم کامپیوتر می‌تواند منشأ و اثر را بازتولیدپذیر کند. حقوق در روندهای مشروع درباره حقوق و تکالیف تصمیم می‌گیرد. اخلاق می‌پرسد کدام اعمال مسئولانه‌اند. روزنامه‌نگاری رویدادها را برای عموم قابل بررسی می‌کند. معنویت می‌تواند معنا و تعالی را تفسیر کند، بدون آنکه این تفسیر به‌عنوان اثبات ریاضی یا فیزیکی عرضه شود.",
+        "دقیقاً جداسازی روشن این شیوه‌های شناخت است که پیوند معنادار میان آن‌ها را ممکن می‌کند."
+      ]
+    },
+    {
+      "id": "belege",
+      "heading": "خودممیزی عمومی است",
+      "p": [
+        "هیچ‌کس مجبور نیست این ادعاها را باور کند. شواهد فنی اصلی عمومی هستند. خودممیزی فقط دامنه اعلام‌شده خود را اثبات می‌کند و جای دادگاه، نهاد ناظر یا ارزیابی خارجیِ انطباقِ لازم طبق قانون را نمی‌گیرد.",
+        "پس دعوت ساده است: باور نکنید. بررسی کنید."
+      ]
+    },
+    {
+      "id": "schluss",
+      "heading": "حقیقت یا هرزنامه؟",
+      "p": [
+        "نرم‌افزار حقیقت را تولید نمی‌کند. اما می‌توانیم سامانه‌هایی بسازیم که در آن‌ها روشن بماند چرا یک ادعا شایسته اعتماد است.",
+        "اگر این قابلیت را از دست بدهیم، چیزی بیش از نرم‌افزار خوب را از دست می‌دهیم. پایه مشترکی را از دست می‌دهیم که علم، حقوق، دموکراسی و فضای عمومی آزاد بر روی آن می‌توانند اصلاً با یکدیگر اختلاف نظر داشته باشند."
+      ]
+    }
+  ]
+}
diff --git a/docs/journal/wahrheit-oder-spam/i18n/content.fr.json b/docs/journal/wahrheit-oder-spam/i18n/content.fr.json
