+/* Public entrypoint: press, policy and executive clarity */
+.status-kicker{display:inline-block;margin-bottom:.35rem;color:var(--brand);font-weight:800;letter-spacing:.04em;text-transform:uppercase;font-size:.78rem}
+.hero-url{margin-top:1.2rem;color:var(--muted);font-size:.98rem}
+.hero-url a{font-weight:750;text-decoration-thickness:.08em;text-underline-offset:.2em}
+.proof-strip{padding-top:10px}
+.proof-card{min-height:190px}
+.proof-num{display:block;font:800 .82rem/1 var(--mono);letter-spacing:.1em;color:var(--brand);margin-bottom:1.1rem}
+.proof-card h3{font-size:1.28rem;margin-bottom:.45rem}
+.longform{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));box-shadow:var(--shadow);overflow:hidden}
+.longform summary{display:grid;gap:.7rem;padding:1.35rem 1.45rem;cursor:pointer;list-style:none}
+.longform summary::-webkit-details-marker{display:none}
+.longform summary strong{font-size:clamp(1.45rem,3vw,2.2rem);line-height:1.05;letter-spacing:-.025em}
+.longform summary>span:last-child{color:var(--muted);max-width:72ch}
+.longform[open] summary{border-bottom:1px solid var(--line)}
+.longform-body{max-width:76ch;margin:0 auto;padding:1.5rem 1.35rem 2rem;overflow-wrap:anywhere}
+.longform-body h1{font-size:clamp(2rem,5vw,3.7rem);line-height:1;margin:.8rem 0 1.2rem;letter-spacing:-.04em}
+.longform-body h2{margin-top:2.5rem}
+@media (max-width:760px){
+  .hero{padding-top:48px}
+  .hero h1{font-size:clamp(2.55rem,13vw,4.2rem)}
+  .proof-card{min-height:0}
+}
+
+.evidence-card{display:block;text-decoration:none;color:var(--text);transition:transform .18s ease,border-color .18s ease}
+.evidence-card:hover{transform:translateY(-3px);border-color:var(--brand)}
+.evidence-card p{color:var(--muted)}
+.evidence-tag{display:inline-block;font:800 .76rem/1 var(--mono);letter-spacing:.09em;color:var(--brand);margin-bottom:.85rem}
+.evidence-links{display:flex;gap:.7rem;flex-wrap:wrap;margin:1rem 0}
+.evidence-links a{border:1px solid var(--line);border-radius:999px;padding:.55rem .8rem;text-decoration:none;background:rgba(255,255,255,.03)}
+
+.claim-explorer-section{margin:3rem 0;padding-top:1rem;border-top:1px solid var(--line)}
+.claim-toolbar{display:flex;gap:.55rem;flex-wrap:wrap;margin:1rem 0}
+.claim-summary{color:var(--muted);font-size:.92rem;margin-bottom:.8rem}
+.claim-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}
+.claim-card{box-shadow:none}
+.claim-meta{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.7rem}
+.claim-meta span{font:750 .72rem/1 var(--mono);border:1px solid var(--line);border-radius:999px;padding:.35rem .5rem;color:var(--muted)}
+.journal-article>h1{font-size:clamp(2.7rem,7vw,5.5rem);line-height:.95;letter-spacing:-.05em}
+.journal-article>h2{margin-top:3rem}
+.journal-article li{margin:.35rem 0}
+@media(max-width:760px){.claim-grid{grid-template-columns:1fr}}
