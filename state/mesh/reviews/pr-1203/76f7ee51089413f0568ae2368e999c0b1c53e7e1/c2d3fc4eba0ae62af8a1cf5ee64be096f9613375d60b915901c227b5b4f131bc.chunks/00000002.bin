+{
+  "schema": "qikvrt-journal-claims/1.0",
+  "article_id": "wahrheit-oder-spam-2026-09-24",
+  "canonical_url": "https://goldkelch.github.io/qik-vrt/journal/wahrheit-oder-spam/",
+  "version": "2026-09-24-v1",
+  "claims": [
+    {
+      "id": "C01",
+      "kind": "FACT",
+      "status": "PRIMARY_SOURCE",
+      "statement": "On 23 September 2026 the UN Security Council addressed risks from advanced AI; OpenAI and Anthropic were part of the briefing.",
+      "evidence": [
+        "https://www.un.org/en/live-openai-and-anthropic-brief-security-council-amid-%E2%80%98real-and-imminent%E2%80%99-threat-posed-runaway-ai"
+      ]
+    },
+    {
+      "id": "C02",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "The EU AI Act requires, for applicable high-risk AI systems, measures including continuous risk management and effective human oversight.",
+      "evidence": [
+        "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32024R1689"
+      ]
+    },
+    {
+      "id": "C03",
+      "kind": "LAW",
+      "status": "PRIMARY_SOURCE",
+      "statement": "Freedom of the press is protected in Germany by Article 5 of the Basic Law.",
+      "evidence": [
+        "https://www.gesetze-im-internet.de/gg/art_5.html"
+      ]
+    },
+    {
+      "id": "C04",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "PASS_BOUND_SCOPE",
+      "statement": "QIK-VRT Mesh Audit run 29753095894 reports PASS for its explicitly defined audit scope.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/audit/QIKVRT_MESH_AUDIT_SUMMARY.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/QIKVRT_AUDIT_EXPORT.md"
+      ]
+    },
+    {
+      "id": "C05",
+      "kind": "REPOSITORY_EVIDENCE",
+      "status": "EXECUTABLE_CONFORMANCE_PASS",
+      "statement": "QIK-VRT includes a provider-neutral external-AI auditor that automatically evaluates evidence-bound execution traces with PASS/BLOCK; its conformance workflow accepts the positive vector and blocks silent omission of required follow-up and unauthorized effects.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_external_ai_audit.py",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md",
+        "https://github.com/Goldkelch/qik-vrt/actions/runs/35978831303"
+      ]
+    },
+    {
+      "id": "C06",
+      "kind": "ANALYSIS",
+      "status": "SUPPORTED_ANALYSIS",
+      "statement": "Strong capital, market and geopolitical competitive pressure can shorten safety and maturity cycles; this is a systems analysis, not a character judgment about a nation.",
+      "evidence": [
+        "https://www.reuters.com/business/media-telecom/ten-days-that-changed-course-ai-2026-09-19/"
+      ]
+    },
+    {
+      "id": "C07",
+      "kind": "OPINION",
+      "status": "AUTHOR_WARNING_METAPHOR",
+      "statement": "The phrase 'functionally bankrupt' is an author's warning metaphor for loss of rule-of-law function, not a legal insolvency or status finding.",
+      "evidence": []
+    },
+    {
+      "id": "C08",
+      "kind": "FORMAL_MATHEMATICS",
+      "status": "FORMALLY_VERIFIED_BOUND_SCOPE",
+      "statement": "QIK-VRT Formalization v2.0 documents complete formal coverage of its stated manuscript scope with explicit boundaries.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/formalization/QIKVRT_Formalization_v2.0/VERIFICATION_REPORT.md"
+      ]
+    },
+    {
+      "id": "C09",
+      "kind": "PHYSICS",
+      "status": "OPEN_CANDIDATE",
+      "statement": "QIK-VRT physics models are formalized research candidates; mathematical model verification is not presented as empirical confirmation of nature.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/tree/main/docs/publications/2026-08-02-vrtcore-smg-h5"
+      ]
+    },
+    {
+      "id": "C10",
+      "kind": "ETHICS",
+      "status": "NORMATIVE_INTERPRETATION",
+      "statement": "The evidence-sufficiency decision maxim is a normative interpretation, not empirical or legal proof.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a015_evidence_sufficiency_imperative.md"
+      ]
+    },
+    {
+      "id": "C11",
+      "kind": "SPIRITUALITY",
+      "status": "PHILOSOPHICAL_INTERPRETATION",
+      "statement": "Spiritual claims are labeled as religious-philosophical interpretation and are not presented as mathematical or physical proof.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/articles/a006_reincarnation_info.md"
+      ]
+    },
+    {
+      "id": "C12",
+      "kind": "PRIORITY",
+      "status": "NOT_ESTABLISHED",
+      "statement": "An absolute world-first claim such as 'the first interactive news portal in human history' is not presented as established. Earlier standards for machine-readable journalistic self-assessment and transparency exist.",
+      "evidence": [
+        "https://journalismtrustinitiative.org/jti-the-standard/",
+        "https://thetrustproject.org/",
+        "https://www.w3.org/TR/prov-overview/"
+      ]
+    },
+    {
+      "id": "C13",
+      "kind": "BOUNDARY",
+      "status": "EXPLICIT_LIMIT",
+      "statement": "The external-AI audit is fully automatic for a supplied evidence-bound audit trace; it does not claim privileged access to hidden provider state.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/spec/ai-audit/EXTERNAL_AI_AUDIT_TRACE_V1.md"
+      ]
+    },
+    {
+      "id": "C14",
+      "kind": "MULTILINGUAL_INTEGRITY",
+      "status": "MACHINE_CHECKED_CONTRACT",
+      "statement": "German, English, French, Russian, Persian and Chinese share the same article ID, version, segment IDs, claim IDs, source set and correction lineage; structural equivalence is checked automatically.",
+      "evidence": [
+        "https://github.com/Goldkelch/qik-vrt/blob/main/docs/journal/wahrheit-oder-spam/i18n/manifest.json",
+        "https://github.com/Goldkelch/qik-vrt/blob/main/tools/qikvrt_journal_i18n_integrity.py"
+      ]
+    }
+  ],
+  "locale": "en"
+}
