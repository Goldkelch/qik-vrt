+*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 20% 0%,rgba(132,230,200,.18),transparent 28%),radial-gradient(circle at 90% 10%,rgba(158,183,255,.19),transparent 30%),var(--bg);color:var(--text);font-family:var(--sans);line-height:1.55}.skip{position:absolute;left:-999px;top:auto}.skip:focus{left:1rem;top:1rem;background:var(--panel);padding:.7rem 1rem;border:1px solid var(--brand);border-radius:10px;z-index:99}a{color:var(--brand)}code,kbd{font-family:var(--mono)}.wrap{max-width:var(--max);margin:0 auto;padding:0 1.1rem}.topbar{position:sticky;top:0;z-index:50;background:rgba(7,9,20,.74);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}[data-theme="light"] .topbar{background:rgba(246,248,252,.78)}.nav{display:flex;gap:.8rem;align-items:center;justify-content:space-between;min-height:72px}.brand{display:flex;gap:.8rem;align-items:center;text-decoration:none;color:var(--text);font-weight:800}.logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--brand),var(--brand2));display:grid;place-items:center;color:#07101b;font-weight:900;box-shadow:var(--shadow)}.navlinks{display:flex;gap:.45rem;flex-wrap:wrap;justify-content:flex-end}.navlinks a,.chip,.btn{border:1px solid var(--line);background:rgba(255,255,255,.03);color:var(--text);text-decoration:none;border-radius:999px;padding:.55rem .78rem;font-size:.93rem}.navlinks a:hover,.btn:hover{border-color:var(--brand);transform:translateY(-1px)}.btn{display:inline-flex;gap:.5rem;align-items:center;cursor:pointer}.btn.primary{background:linear-gradient(135deg,var(--brand),var(--brand2));color:#08111d;border:0;font-weight:800}.hero{padding:80px 0 42px}.grid{display:grid;gap:1rem}.hero-grid{grid-template-columns:1.13fr .87fr;align-items:center}.eyebrow{display:inline-flex;gap:.5rem;align-items:center;border:1px solid var(--line);background:rgba(255,255,255,.04);border-radius:999px;padding:.45rem .75rem;color:var(--muted);font-size:.94rem}.hero h1{font-size:clamp(2.45rem,7vw,5.8rem);line-height:.95;margin:.9rem 0 1rem;letter-spacing:-.055em}.grad{background:linear-gradient(90deg,var(--brand),var(--brand2));-webkit-background-clip:text;background-clip:text;color:transparent}.lead{font-size:clamp(1.1rem,2.2vw,1.45rem);color:var(--muted);max-width:780px}.hero-actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.3rem}.card{background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.02));border:1px solid var(--line);border-radius:var(--radius);padding:1.25rem;box-shadow:var(--shadow)}.status-card{position:relative;overflow:hidden}.status-card:before{content:"";position:absolute;inset:-1px;background:radial-gradient(circle at 75% 8%,rgba(132,230,200,.28),transparent 35%);pointer-events:none}.kpi{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1rem}.kpi div{border:1px solid var(--line);border-radius:16px;padding:.9rem;background:rgba(0,0,0,.11)}.kpi strong{display:block;font-size:1.35rem;color:var(--brand)}.section{padding:44px 0}.section h2{font-size:clamp(1.9rem,4vw,3rem);line-height:1.05;margin:0 0 1rem;letter-spacing:-.03em}.section p{color:var(--muted)}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.two{grid-template-columns:repeat(2,minmax(0,1fr))}.feature h3,.card h3{margin-top:0}.plain{font-size:1.08rem}.steps{counter-reset:s;display:grid;gap:.85rem}.step{display:flex;gap:1rem;align-items:flex-start}.step:before{counter-increment:s;content:counter(s);width:34px;height:34px;border-radius:50%;background:var(--brand);color:#061119;display:grid;place-items:center;font-weight:900;flex:0 0 34px}.timeline{position:relative;padding-left:1rem}.timeline:before{content:"";position:absolute;left:13px;top:.25rem;bottom:.25rem;border-left:2px solid var(--line)}.tl{position:relative;margin:0 0 1rem 1.4rem}.tl:before{content:"";position:absolute;left:-2.05rem;top:.25rem;width:15px;height:15px;border-radius:50%;background:var(--brand);box-shadow:0 0 0 6px rgba(132,230,200,.1)}.tl h3{margin:.1rem 0}.console{display:grid;grid-template-columns:.85fr 1.15fr;gap:1rem}.console textarea{width:100%;min-height:210px;border:1px solid var(--line);background:rgba(0,0,0,.18);color:var(--text);border-radius:16px;padding:1rem;font:1rem/1.5 var(--sans);resize:vertical}.console input,.console select{width:100%;border:1px solid var(--line);background:rgba(0,0,0,.18);color:var(--text);border-radius:12px;padding:.75rem;margin:.35rem 0}.output{white-space:pre-wrap;background:rgba(0,0,0,.16);border:1px solid var(--line);border-radius:16px;padding:1rem;min-height:270px}.mini{font-size:.9rem;color:var(--muted)}.pillrow{display:flex;flex-wrap:wrap;gap:.5rem}.pill{border:1px solid var(--line);border-radius:999px;padding:.35rem .6rem;color:var(--muted);font-size:.88rem}.quote{font-size:1.35rem;color:var(--text);border-left:5px solid var(--brand);padding-left:1rem}.legal{border-color:rgba(255,210,122,.45);background:rgba(255,210,122,.06)}details{border:1px solid var(--line);border-radius:16px;padding:1rem;background:rgba(255,255,255,.025)}details+details{margin-top:.8rem}summary{cursor:pointer;font-weight:800}.footer{padding:44px 0;border-top:1px solid var(--line);color:var(--muted)}.notice{border:1px solid var(--line);border-radius:16px;padding:1rem;background:rgba(132,230,200,.07)}@media (max-width:860px){.hero-grid,.three,.two,.console{grid-template-columns:1fr}.nav{align-items:flex-start;flex-direction:column;padding:.8rem 0}.navlinks{justify-content:flex-start}.hero{padding-top:42px}.kpi{grid-template-columns:1fr}}@media print{.topbar,.hero-actions,.console,.btn{display:none}.card{box-shadow:none}body{background:white;color:black}.section{page-break-inside:avoid}}
