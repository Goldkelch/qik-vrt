diff --git a/docs/publications/2026-09-13-future-message-present-receiver/CLAIM_MATRIX.json b/docs/publications/2026-09-13-future-message-present-receiver/CLAIM_MATRIX.json
new file mode 100644
index 0000000000000000000000000000000000000000..d6e5cdbf36e0a246d660533b566a4cbfa23503b7
--- /dev/null
+++ b/docs/publications/2026-09-13-future-message-present-receiver/CLAIM_MATRIX.json
@@ -0,0 +1,80 @@
+{
+  "schema": "qikvrt_future_message_evidence_claim_matrix_v1",
+  "publication_id": "qikvrt-future-message-needs-present-receiver-v1",
+  "author": "Ingolf Lohmann",
+  "date": "2026-09-13",
+  "claims": [
+    {
+      "id": "C1",
+      "claim": "Delayed-choice quantum eraser experiments exhibit later-condition-dependent joint/conditional correlations while the earlier unsorted marginal does not by itself reveal a controllable later choice.",
+      "class": "EMPIRICALLY_EVIDENCED_EXTERNAL",
+      "evidence": ["doi:10.1103/PhysRevLett.84.1"],
+      "boundary": "Does not establish controllable backward classical signalling."
+    },
+    {
+      "id": "C2",
+      "claim": "Delayed-choice entanglement swapping can condition already registered photons into entangled or separable correlation classes based on a later measurement choice.",
+      "class": "EMPIRICALLY_EVIDENCED_EXTERNAL",
+      "evidence": ["doi:10.1038/nphys2294"],
+      "boundary": "Correlation/conditioning is not an operational backward message channel."
+    },
+    {
+      "id": "C3",
+      "claim": "Entanglement can be demonstrated between temporally separated photons that never coexisted.",
+      "class": "EMPIRICALLY_EVIDENCED_EXTERNAL",
+      "evidence": ["doi:10.1103/PhysRevLett.110.210403"],
+      "boundary": "Does not establish message transmission into the past."
+    },
+    {
+      "id": "C4",
+      "claim": "Time-symmetric quantum measurement formalisms using both initial and final selections are established in the literature.",
+      "class": "SOURCE_BOUND",
+      "evidence": ["doi:10.1103/PhysRev.134.B1410"],
+      "boundary": "Model class is not unique proof of retrocausal ontology."
+    },
+    {
+      "id": "C5",
+      "claim": "QIK-VRT separates host, virtual, semantic and evidence order and uses exact provenance/readback contracts to support later conditioning and backward reconstruction without rewriting historical bytes.",
+      "class": "REPOSITORY_BOUND",
+      "evidence": ["repository:Goldkelch/qik-vrt"],
+      "boundary": "Exact implementation/proof status is determined only by subject-bound repository receipts; this article is not a new kernel proof."
+    },
+    {
+      "id": "C6",
+      "claim": "A physical future-to-past communication channel requires an interventionally testable dependence of an earlier sealed variable Y on a later freely chosen X, e.g. P(Y|do(X=0)) != P(Y|do(X=1)), under preregistered leakage controls.",
+      "class": "FALSIFIABLE_PROPOSAL",
+      "evidence": ["article:section-9"],
+      "boundary": "Proposed criterion; positive channel capacity is not claimed as observed."
+    },
+    {
+      "id": "C7",
+      "claim": "A usable retrocausal communication service would require a receiver prepared earlier with addressing, code, authentication, error handling, replay protection, provenance and effect readback.",
+      "class": "ENGINEERING_THESIS",
+      "evidence": ["article:section-8"],
+      "boundary": "Infrastructure does not create or empirically prove the physical carrier."
+    },
+    {
+      "id": "C8",
+      "claim": "Ingolf Lohmann's QIK-VRT contribution is the specific integration of relational causal typing, virtual time addressing, later semantic conditioning, append-only provenance, backward reconstruction, scalable data processing, Effect Acknowledgement and a falsifiable channel test.",
+      "class": "AUTHORSHIP_PRIORITY_CLAIM",
+      "evidence": ["repository:Goldkelch/qik-vrt", "article:section-10"],
+      "boundary": "Publication establishes attributable claim/evidence, not independent scientific consensus or priority adjudication."
+    }
+  ],
+  "non_equivalences": [
+    "QUANTUM_CORRELATION != CONTROLLABLE_BACKWARD_SIGNAL",
+    "RETROCAUSAL_MODEL != OPERATIONAL_BACKWARD_CHANNEL",
+    "REPOSITORY_EVIDENCE != EMPIRICAL_PHYSICAL_CONFIRMATION",
+    "ZENODO_PUBLICATION != PEER_REVIEW",
+    "TRANSPORT_ACK != EFFECT_ACK",
+    "EFFECT_ACK_DONE != PHYSICAL_EFFECT_CONFIRMATION"
+  ],
+  "completion_claims": {
+    "physical_backward_channel_confirmed": false,
+    "peer_reviewed": false,
+    "scientific_consensus": false,
+    "PASS": false,
+    "FINAL_PASS": false,
+    "EFFECT_ACK_DONE": false
+  }
+}
