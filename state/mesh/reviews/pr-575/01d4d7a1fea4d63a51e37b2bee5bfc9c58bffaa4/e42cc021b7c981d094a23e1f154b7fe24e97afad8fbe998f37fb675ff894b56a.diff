+  "voice_sso": {
+    "primary_factor": "VOICE_BIOMETRIC_SSO",
+    "semantic": "A successful local biometric voice session is the Product Owner single-sign-on interaction key for all Product Owner commands. The remote repository verifies a signed, revocable local-verifier assertion; this is a transport-verifiability mechanism, not a second user interaction factor.",
+    "session_max_seconds": 900,
