@@ -0,0 +1,124 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/Goldkelch/qik-vrt/schemas/qikvrt_voice_sso_command.schema.json",
+  "title": "QIK-VRT Product Owner Voice SSO Command",
+  "$defs": {
+    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
+    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
+    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
+    "signature": {
+      "type": "object",
+      "required": ["algorithm", "value"],
+      "properties": {
+        "algorithm": {"const": "Ed25519"},
+        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
+      },
+      "additionalProperties": false
+    }
+  },
+  "oneOf": [
+    {
+      "title": "Voice SSO Session",
+      "type": "object",
+      "required": ["schema", "session_id", "issuer_key_id", "issued_at", "expires_at", "subject", "repositories", "scope", "biometric", "signature"],
+      "properties": {
+        "schema": {"const": "qikvrt-voice-sso-session/1.0"},
+        "session_id": {"$ref": "#/$defs/id"},
+        "issuer_key_id": {"$ref": "#/$defs/id"},
+        "issued_at": {"type": "string", "format": "date-time"},
+        "expires_at": {"type": "string", "format": "date-time"},
+        "subject": {
+          "type": "object",
+          "required": ["product_owner_id"],
+          "properties": {"product_owner_id": {"const": "Ingolf Lohmann"}},
+          "additionalProperties": false
+        },
+        "repositories": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 8,
+          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
+        },
+        "scope": {"const": "ALL_PRODUCT_OWNER_COMMANDS"},
+        "biometric": {
+          "type": "object",
+          "required": ["enrollment_id", "verifier_id", "verifier_version", "speaker_verdict", "liveness_verdict", "challenge_sha256", "audio_sha256"],
+          "properties": {
+            "enrollment_id": {"$ref": "#/$defs/id"},
+            "verifier_id": {"$ref": "#/$defs/id"},
+            "verifier_version": {"type": "string", "minLength": 1, "maxLength": 160},
+            "speaker_verdict": {"const": "MATCH"},
+            "liveness_verdict": {"const": "LIVE"},
+            "challenge_sha256": {"$ref": "#/$defs/sha256"},
+            "audio_sha256": {"$ref": "#/$defs/sha256"}
+          },
+          "additionalProperties": false
+        },
+        "signature": {"$ref": "#/$defs/signature"}
+      },
+      "additionalProperties": false
+    },
+    {
+      "title": "Voice SSO Command",
+      "type": "object",
+      "required": ["schema", "command_id", "session_id", "issuer_key_id", "repository", "target", "intent", "issued_at", "expires_at", "nonce_sha256", "session_sha256", "signature"],
+      "properties": {
+        "schema": {"const": "qikvrt-voice-sso-command/1.0"},
+        "command_id": {"$ref": "#/$defs/id"},
+        "session_id": {"$ref": "#/$defs/id"},
+        "issuer_key_id": {"$ref": "#/$defs/id"},
+        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
+        "target": {
+          "type": "object",
+          "required": ["ref", "head", "tree"],
+          "properties": {
+            "ref": {"type": "string", "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$"},
+            "head": {"$ref": "#/$defs/sha1"},
+            "tree": {"$ref": "#/$defs/sha1"}
+          },
+          "additionalProperties": false
+        },
+        "intent": {
+          "type": "object",
+          "required": ["operation", "parameters", "parameters_sha256", "effect_class", "artifact_sha256s"],
+          "properties": {
+            "operation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
+            "parameters": {"type": "object", "maxProperties": 256},
+            "parameters_sha256": {"$ref": "#/$defs/sha256"},
+            "effect_class": {"enum": ["READ_ONLY", "REPOSITORY_MUTATION", "EXTERNAL_EFFECT"]},
+            "artifact_sha256s": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/sha256"}},
+            "external_authorization": {
+              "type": "object",
+              "required": ["single_use_authorization_id", "exact_artifact_sha256s"],
+              "properties": {
+                "single_use_authorization_id": {"$ref": "#/$defs/id"},
+                "exact_artifact_sha256s": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/sha256"}}
+              },
+              "additionalProperties": false
+            }
+          },
+          "allOf": [
+            {
+              "if": {
+                "required": ["effect_class"],
+                "properties": {"effect_class": {"const": "EXTERNAL_EFFECT"}}
+              },
+              "then": {
+                "required": ["external_authorization"],
+                "properties": {"artifact_sha256s": {"minItems": 1}}
+              },
+              "else": {"not": {"required": ["external_authorization"]}}
+            }
+          ],
+          "additionalProperties": false
+        },
+        "issued_at": {"type": "string", "format": "date-time"},
+        "expires_at": {"type": "string", "format": "date-time"},
+        "nonce_sha256": {"$ref": "#/$defs/sha256"},
+        "session_sha256": {"$ref": "#/$defs/sha256"},
+        "signature": {"$ref": "#/$defs/signature"}
+      },
+      "additionalProperties": false
+    }
+  ]
+}
