+          echo "prior_publisher_artifact_digest=$prior_artifact_digest" >> "$GITHUB_OUTPUT"
+
+      - name: Revalidate producer attempt and binding before status effect
+        id: pre_status_binding
+        if: >-
+          always() &&
+          needs.bind-dispatch.result == 'success' &&
+          steps.binding_artifact_identity.outcome == 'success' &&
