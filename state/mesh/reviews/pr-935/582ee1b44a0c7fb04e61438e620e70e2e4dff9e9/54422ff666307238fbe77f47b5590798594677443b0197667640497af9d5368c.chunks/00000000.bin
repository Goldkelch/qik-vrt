index 49e6e92fe056c9ac7228715d674f1e24d88a9386..c0962b86a506f72ab3b0fbda6b999435b1999d54 100644
--- a/.github/workflows/qikvrt_requested_review_executor.yml
+++ b/.github/workflows/qikvrt_requested_review_executor.yml
@@ -1,13 +1,11 @@
 # SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
 # Copyright 2026 Ingolf Lohmann.
 name: QIKVRT requested review executor
-run-name: QIKVRT requested review pr=${{ inputs.pr || 'event' }} head=${{ inputs.head || 'event' }} fp=${{ inputs.fingerprint || 'event' }}
+run-name: qikvrt-rr-v3 e=${{ github.workflow_sha }} p=${{ inputs.pr || 'event' }} h=${{ inputs.head || 'event' }} f=${{ inputs.fingerprint || 'event' }} i=${{ inputs.transport_intent_sha256 || 'event' }} a=${{ inputs.transport_attempt || 'event' }}
 
 on:
   pull_request_target:
     types: [opened, edited, converted_to_draft, review_requested, review_request_removed, labeled, unlabeled, synchronize, ready_for_review, reopened]
-  pull_request_review:
-    types: [submitted]
   issue_comment:
     types: [created, edited, deleted]
   workflow_run:
@@ -17,7 +15,6 @@ on:
       - "QIKVRT Collective Proposal Review"
       - "QIK-VRT global claim completion"
       - "QIKVRT Batch-003 remaining subject disposition"
-      - "QIKVRT code-owner review observer"
     types: [completed]
   workflow_dispatch:
     inputs:
@@ -30,31 +27,54 @@ on:
         required: true
         type: string
       fingerprint:
-        description: "Exact predecessor-observed successor fingerprint"
-        required: false
+        description: "Exact predecessor fingerprint or canonical zero sentinel"
+        required: true
+        type: string
+      evaluator_sha:
+        description: "Exact trusted-main evaluator workflow SHA"
+        required: true
+        type: string
+      transport_intent_sha256:
+        description: "Exact durable transport-intent SHA-256"
+        required: true
+        type: string
+      transport_attempt:
+        description: "One-shot new-run transport attempt (must be 1)"
+        required: true
         type: string
 
-permissions:
-  # A progress-only successor is dispatched only after the predecessor receipt
-  # is durably present and its successor fingerprint is absent from the
-  # append-only ledger.  The exact work-unit identity makes duplicate
-  # predecessor runs converge while candidate drift still fails closed.
-  actions: write
-  # The only Git-content write is the append-only, non-force update of the
-  # dedicated role-local review ledger. Candidate and main are never updated.
-  contents: write
-  pull-requests: write
-  statuses: write
+permissions: {}
 
 concurrency:
   group: qikvrt-requested-review-executor-${{ github.repository }}
   cancel-in-progress: false
+  queue: max
 
 jobs:
-  review-one:
-    if: github.ref == 'refs/heads/main'
+  plan-review:
+    if: >-
+      github.ref == 'refs/heads/main' &&
+      github.workflow_sha == github.sha &&
+      (github.event_name != 'workflow_dispatch' ||
+       (inputs.evaluator_sha == github.workflow_sha &&
+        inputs.evaluator_sha == github.sha &&
+        inputs.transport_attempt == '1'))
     runs-on: ubuntu-24.04
     timeout-minutes: 12
+    permissions:
+      actions: read
+      contents: read
+      pull-requests: read
+      statuses: read
