+          except (ValueError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+              raise SystemExit(f'BLOCK: post-effect owner delegation is invalid: {exc}') from exc
+          (root/'post-delegation.json').write_bytes(data)
+          PY
+          GH_TOKEN="$TECHNICAL_TOKEN" gh api --paginate --slurp "repos/${REPOSITORY}/pulls/${pr}/reviews?per_page=100" > "$root/post-review-pages.json"
+          python3 -B - <<'PY'
+          import json, pathlib
+          from tools.qikvrt_native_account_review import flatten_review_pages
+          root=pathlib.Path('/tmp/qikvrt-native-account-review')
+          pages=json.loads((root/'post-review-pages.json').read_text(encoding='utf-8'))
+          out=flatten_review_pages(pages)
+          (root/'post-reviews.json').write_text(json.dumps(out,sort_keys=True)+'\n',encoding='utf-8')
+          PY
+          python3 -B - <<'PY'
+          import json, pathlib
+          from tools.qikvrt_native_account_review import (
+              build_signer_post_effect_authority_fence,
+          )
+          root=pathlib.Path('/tmp/qikvrt-native-account-review')
+          fence=build_signer_post_effect_authority_fence(
+              plan=json.loads((root/'plan.json').read_text(encoding='utf-8')),
+              evaluator_sha=json.loads(
+                  (root/'post-main.json').read_text(encoding='utf-8')
+              ).get('sha'),
+              current_main=json.loads((root/'post-main.json').read_text(encoding='utf-8')),
+              upstream_before=json.loads((root/'pre-review-post-upstream-attempt-verification.json').read_text(encoding='utf-8')),
+              upstream_after=json.loads((root/'post-review-effect-upstream-attempt-verification.json').read_text(encoding='utf-8')),
+              rules_before=json.loads((root/'current-rules.json').read_text(encoding='utf-8')),
+              rules_after=json.loads((root/'post-rules.json').read_text(encoding='utf-8')),
+              delegation_before=(root/'current-delegation.json').read_bytes(),
+              delegation_after=(root/'post-delegation.json').read_bytes(),
+              final_pr=json.loads((root/'post-pr.json').read_text(encoding='utf-8')),
+              final_commit=json.loads((root/'post-commit.json').read_text(encoding='utf-8')),
+          )
+          (root/'post-effect-authority-fence.json').write_text(
+              json.dumps(fence,sort_keys=True,indent=2)+'\n',encoding='utf-8'
+          )
+          PY
+          if [ "$action" = ADOPT_UNRECEIPTED ]; then
+            python3 -B tools/qikvrt_native_account_review.py verify-adoption-readback \
+              --plan "$plan" --review "$root/submitted-review.json" \
+              --expected-signer "$EXPECTED_SIGNER" \
+              --reviews-before "$root/current-reviews.json" \
+              --reviews-after "$root/post-reviews.json" \
+              --current-signer-run-id "$GITHUB_RUN_ID" \
+              --current-signer-run-attempt "$GITHUB_RUN_ATTEMPT" \
+              > "$root/readback.json"
+          else
+            python3 -B tools/qikvrt_native_account_review.py verify-readback \
+              --plan "$plan" --review "$root/submitted-review.json" \
+              --expected-signer "$EXPECTED_SIGNER" \
+              --reviews-before "$root/current-reviews.json" \
+              --reviews-after "$root/post-reviews.json" > "$root/readback.json"
+          fi
+          cat "$root/readback.json"
+          test "$(python3 -B -c 'import json; print(str(json.load(open("/tmp/qikvrt-native-account-review/readback.json"))["exact"]).lower())')" = true
+          python3 -B - <<'PY'
           import json
           root='/tmp/qikvrt-native-account-review/'
           plan=json.load(open(root+'plan.json',encoding='utf-8'))
@@ -807,3 +1701,28 @@ jobs:
           assert pr.get('head',{}).get('sha') == plan['head_sha']
           assert commit.get('tree',{}).get('sha') == plan['tree_sha']
           PY
+          mkdir -p /tmp/qikvrt-native-signer-receipt
+          python3 -B tools/qikvrt_native_account_review.py seal-signer-receipt \
+            --plan "$plan" --review "$root/submitted-review.json" \
+            --expected-signer "$EXPECTED_SIGNER" \
+            --reviews-before "$root/current-reviews.json" \
+            --reviews-after "$root/post-reviews.json" \
+            --readback "$root/readback.json" \
+            --final-pr "$root/post-pr.json" \
+            --final-commit "$root/post-commit.json" \
+            --authority-fence "$root/post-effect-authority-fence.json" \
+            --repository "$REPOSITORY" \
+            --evaluator-sha "$EXPECTED_EVALUATOR_SHA" \
+            --run-id "$GITHUB_RUN_ID" \
+            --run-attempt "$GITHUB_RUN_ATTEMPT" \
+            > /tmp/qikvrt-native-signer-receipt/signer-receipt.json
+          echo 'receipt_ready=true' >> "$GITHUB_OUTPUT"
+
+      - name: Preserve successful exact ingolf-lohmann signer receipt
+        if: steps.signer-effect.outputs.receipt_ready == 'true'
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: qikvrt-native-review-signer-receipt-ingolf-lohmann-pr-${{ needs.plan-native-account-review.outputs.pr }}-head-${{ needs.plan-native-account-review.outputs.head }}-run-${{ github.run_id }}-attempt-${{ github.run_attempt }}
+          if-no-files-found: error
+          retention-days: 90
+          path: /tmp/qikvrt-native-signer-receipt/signer-receipt.json
diff --git a/.github/workflows/qikvrt_review_admission_recovery.yml b/.github/workflows/qikvrt_review_admission_recovery.yml
new file mode 100644
index 0000000000000000000000000000000000000000..387e34653e7e345ec16a48d0076f842bd1e3cf19
--- /dev/null
+++ b/.github/workflows/qikvrt_review_admission_recovery.yml
@@ -0,0 +1,6546 @@
+# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+# Copyright 2026 Ingolf Lohmann.
+name: QIKVRT review admission recovery
+run-name: QIKVRT review admission recovery-v1 source=${{ github.event.workflow_run.id || 'scheduled' }}
+
+on:
+  workflow_run:
+    workflows:
+      - "QIKVRT requested review executor"
+      - "QIKVRT required code-owner review"
+    types: [completed]
+  schedule:
+    - cron: '11 * * * *'
+  workflow_dispatch:
+
+permissions: {}
+
+concurrency:
+  group: >-
+    qikvrt-review-admission-recovery-${{ github.repository }}-${{
+      github.event_name == 'workflow_run' && 'event-ingest' || 'scheduled-recovery'
+    }}
+  cancel-in-progress: false
+  queue: max
+
+jobs:
+  read-shared-review-core-sources:
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    environment: qikvrt-outbox-ledger-authority
+    permissions:
+      contents: read
+    outputs:
+      artifact_name: ${{ steps.locator.outputs.artifact_name }}
+    env:
+      GH_TOKEN: ${{ github.token }}
+      REPOSITORY: ${{ github.repository }}
+    steps:
+      - name: Check out the exact trusted shared-Core reader
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.workflow_sha }}
+          fetch-depth: 1
+          persist-credentials: false
+
+      - name: Select one exact content-addressed Core lookup
+        id: locator
+        shell: bash
+        run: |
+          set -euo pipefail
+          root=/tmp/qikvrt-shared-review-core-sources
+          mkdir -p "$root"
+          python3 -B - <<'PY' > "$root/locator.json"
+          import base64,json,os,pathlib,re,subprocess,urllib.parse
+          mode='NONE'
+          fingerprint=None
+          lane_hint=None
+          if os.environ['GITHUB_EVENT_NAME'] == 'workflow_run':
+              event=json.loads(pathlib.Path(os.environ['GITHUB_EVENT_PATH']).read_text())
+              run=event.get('workflow_run')
+              title=run.get('display_title') if isinstance(run,dict) else None
+              match=(re.fullmatch(
+                  r'qikvrt-rr-v3 e=[0-9a-f]{40} p=[1-9][0-9]* '
+                  r'h=[0-9a-f]{40} f=[0-9a-f]{64} '
+                  r'i=([0-9a-f]{64}) a=(?:1|2)',title
+              ) if isinstance(title,str) else None)
+              if match is not None:
+                  mode='LOOKUP_FINGERPRINT'
+                  fingerprint=match.group(1)
+          elif os.environ['GITHUB_EVENT_NAME'] in {'schedule','workflow_dispatch'}:
+              mode='NEXT'
+              def api(path):
+                  return json.loads(subprocess.check_output(
+                      ['gh','api',path],text=True
+                  ))
+              try:
+                  ref=api(
+                      f"repos/{os.environ['REPOSITORY']}/git/ref/heads/"
+                      'qikvrt/review-admission-inbox-v1'
+                  )['object']['sha']
+                  def shard(path):
+                      encoded=urllib.parse.quote(path,safe='/')
+                      content=api(
+                          f"repos/{os.environ['REPOSITORY']}/contents/"
+                          f"{encoded}?ref={urllib.parse.quote(ref,safe='')}"
+                      )
+                      return json.loads(base64.b64decode(content['content']))
+                  meta=shard(
+                      '.qikvrt/recovery/admission-source-rerun/meta.json'
+                  )
+                  if meta.get('drain_sequence',0) < meta.get('next_sequence',0):
+                      sequence=int(meta['drain_sequence'])
+                      slot=shard(
+                          '.qikvrt/recovery/admission-source-rerun/slots/'
+                          f'{sequence:020d}.json'
+                      )
+                      source=slot.get('source') if isinstance(slot,dict) else None
+                      kind=source.get('source_kind') if isinstance(source,dict) else None
+                      origin=(source.get('origin_authority')
+                          if isinstance(source,dict) else None)
+                      if kind in {
+                          'CORE_EXACT_REVIEW_CHILD_ZERO_JOB',
+                          'CORE_MESH_REVIEW_CHILD_ZERO_JOB',
+                      } and isinstance(origin,dict):
+                          fingerprint=origin.get('fingerprint')
+                          lane_hint=origin.get('lane')
+                          if (
+                              re.fullmatch(r'[0-9a-f]{64}',str(fingerprint))
+                              and lane_hint in {
+                                  'exact-review-dispatch',
+                                  'mesh-review-successor-dispatch',
+                              }
+                          ):
+                              mode='LOOKUP_FINGERPRINT'
+              except (KeyError,ValueError,subprocess.CalledProcessError):
+                  # The downstream ledger reader owns the authoritative HOLD
+                  # for a missing/malformed custom ref.  Never infer absence.
+                  pass
+          print(json.dumps({
+              'schema':'qikvrt_review_admission_core_locator_v1',
+              'mode':mode,'fingerprint':fingerprint,'lane_hint':lane_hint,
+          },sort_keys=True,indent=2))
+          PY
+          artifact="qikvrt-shared-review-core-sources-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
+          echo "artifact_name=$artifact" >> "$GITHUB_OUTPUT"
+
+      - name: Read exact shared-Core snapshot with Auditor only
+        if: >-
+          github.event_name == 'schedule' ||
+          github.event_name == 'workflow_dispatch' ||
+          github.event_name == 'workflow_run'
+        env:
+          LEDGER_AUDITOR_TOKEN: ${{ secrets.QIKVRT_ENV_OUTBOX_LEDGER_AUDITOR_TOKEN }}
+          LEDGER_WRITER_ACTOR_ID: ${{ vars.QIKVRT_OUTBOX_LEDGER_WRITER_ACTOR_ID }}
+        