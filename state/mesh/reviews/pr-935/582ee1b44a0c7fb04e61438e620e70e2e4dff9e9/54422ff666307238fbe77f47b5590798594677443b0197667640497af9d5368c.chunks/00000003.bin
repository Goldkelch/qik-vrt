 is an idempotent `D0=0 NOOP`, never a duplicate receipt.
 
 Review receipts and review-diff manifests/packets are never committed to the
@@ -149,7 +235,7 @@ their already bounded continuation; the feedback plane does not create a
 parallel action router. A status is only a projection: immediately before any
 promotion effect, the promotion controller must load the full-fingerprint
 receipt and diff from the role-local ledger and regenerate them through the
-same trusted-main observer. A stale same-head status never authorizes an
+same trusted-main executor. A stale same-head status never authorizes an
 action. Any eligibility, base, head, tree, scope, diff, discussion, gate,
 writer, fingerprint or receipt-payload mismatch remains `HOLD_UNVERIFIED`.
 The pull-request title and body digests are part of the fingerprint, so an
@@ -169,7 +255,9 @@ only `REQUEST_HISTORY_PRESERVING_READY_RECLASSIFICATION_AUTHORITY`, bound to
 the trusted `github-actions[bot]` self-heal PR-body marker, same-repository
 `automation/self-heal-*` head, unchanged marker-body digest and exact base/head.
 
-The causal review states are fixed:
+The causal review states are fixed. `TECHNICAL_CONTINUE` means only that the
+technical observation supports continuation to the separate authority gate;
+it is not GitHub's native `APPROVE` event:
 
 - `D0=0 NOOP`: the identical exact receipt is already persisted, or no new review action exists;
 - `D0=1 HOLD`: an applicable gate is active or adverse, a finding or unresolved thread remains, the receipt is invalid, or the ledger compare-and-swap conflicts;
@@ -199,6 +287,15 @@ deployment, `PASS`, `FINAL_PASS`, or `EFFECT_ACK_DONE` authority. The full
 provisioning and fail-closed checks are in
 `docs/DELEGATED_NATIVE_ACCOUNT_REVIEW_AUTOMATION.md`.
 
+The repository currently keeps both native-account signer effect jobs hard
+disabled (`if: false`) and references no account or activation secret. A
+checked-in activation receipt cannot prove that an absent Environment secret
+did not fall back to repository or organization scope. Until a dedicated
+settings reader supplies a fresh effect-local scope inventory, the exact state
+is `AUTHORITY_SECRET_ENVIRONMENT_NOT_VERIFIED` and no native-account review is
+posted. This does not affect the technical `github-actions[bot]` comment or the
+human-only required Code Owner gate.
+
 The platform-effective repository-reviewer set is `Goldkelch` and
 `ingolf-lohmann`.  The pull-request author is removed from the eligible set for
 that pull request, so the other configured account is the required counterpart.
diff --git a/docs/atari-terminal/index.html b/docs/atari-terminal/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..de6731d6eb43291367e4699e7992d79d1f09527a
--- /dev/null
+++ b/docs/atari-terminal/index.html
@@ -0,0 +1,146 @@
+<!doctype html>
+<html lang="de">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>QIK-VRT · Atari / Firefox Universal Terminal</title>
+<style>
+  :root{color-scheme:dark;--g:#77f59b}
+  body{margin:0;min-height:100vh;background:#05080b;color:#e8f3ec;font:16px ui-monospace,monospace}
+  main{max-width:1000px;margin:auto;padding:2rem 1rem}
+  header{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid #294151}
+  h1{font-size:1.2rem}.badge{color:var(--g);font-size:.8rem}.terminal{margin-top:1.25rem;border:1px solid #2e9561;background:#0d171e}
+  .bar{padding:.65rem .9rem;background:#12222c;color:var(--g);font-size:.82rem}
+  pre{margin:0;min-height:26rem;padding:1rem;white-space:pre-wrap;overflow:auto;line-height:1.48}
+  .controls{display:flex;gap:.7rem;padding:1rem;border-top:1px solid #294151}
+  button{border:1px solid #4dbb75;background:#143827;color:#e8f3ec;padding:.7rem 1rem;font:inherit;cursor:pointer}
+  button:disabled{opacity:.6;cursor:wait}.hint{color:#9cb0bf;font-size:.85rem}
+</style>
+<main>
+  <header>
+    <h1>QIK-VRT · ATARI / FIREFOX UNIVERSAL TERMINAL</h1>
+    <span id="state" class="badge">LOCAL_READY</span>
+  </header>
+  <section class="terminal" aria-label="Atari boot terminal">
+    <div class="bar">SOURCE_BOUND · FIREFOX_EXTENSION · APPEND_ONLY_REOBSERVATION</div>
+    <pre id="screen" aria-live="polite">$ terminal.open
+SOURCE  MLP.TOS/MLP.TOS
+SHA256  5a74c9645d6cdcb2d92770517e31eb7697e180b2ccc4b7fb777c9b558b84ae7e
+STATE   LOCAL_READY
+
+Warte auf explizites Einschalten.
+</pre>
+    <div class="controls">
+      <button id="boot" type="button">Atari einschalten</button>
+      <button id="clear" type="button">Ausgabe leeren</button>
+    </div>
+  </section>
+  <p class="hint">Die Seite kommuniziert nicht direkt mit Loopback. Eine installierte QIK-VRT-Firefox-Erweiterung vermittelt genau diese Seite mit <code>127.0.0.1:8771</code>. Prozessstart, spätere Reobservation und Effect Acknowledgement bleiben getrennt.</p>
+</main>
+<script>
+(() => {
+  const digest = "5a74c9645d6cdcb2d92770517e31eb7697e180b2ccc4b7fb777c9b558b84ae7e";
+  const screen = document.querySelector("#screen");
+  const state = document.querySelector("#state");
+  const bootButton = document.querySelector("#boot");
+  let logCursor = 0;
+
+  const write = line => {
+    screen.textContent += `${line}\n`;
+    screen.scrollTop = screen.scrollHeight;
+  };
+  const pause = milliseconds => new Promise(resolve => setTimeout(resolve, milliseconds));
+
+  function bridge(requestSchema, receiptSchema, payload) {
+    return new Promise((resolve, reject) => {
+      const requestId = `${Date.now()}-${crypto.getRandomValues(new Uint32Array(1))[0]}`;
+      const timeout = setTimeout(() => reject(new Error("FIREFOX_EXTENSION_BRIDGE_UNAVAILABLE")), 3000);
+      const receive = event => {
+        const value = event.data;
+        if (event.source !== window || event.origin !== location.origin || !value || value.schema !== receiptSchema || value.request_id !== requestId) return;
+        clearTimeout(timeout);
+        window.removeEventListener("message", receive);
+        resolve(value.result);
+      };
+      window.addEventListener("message", receive);
+      window.postMessage({...payload, schema: requestSchema, request_id: requestId}, location.origin);
+    });
+  }
+
+  async function boot(payload) {
+    return bridge("qikvrt.atari-terminal-boot.v1", "qikvrt.atari-terminal-boot-receipt.v1", payload);
+  }
+
+  async function statusFor(bootId) {
+    return bridge("qikvrt.atari-terminal-status.v1", "qikvrt.atari-terminal-status-receipt.v1", {boot_id: bootId});
+  }
+
+  function appendStatus(body) {
+    state.textContent = body.state || "HOLD";
+    if (!body || body.schema !== "qikvrt_atari_terminal_boot_status_v1") {
+      write("HOLD: malformed Atari status receipt");
+      return false;
+    }
+    const start = Number.isInteger(body.log_start) ? body.log_start : 0;
+    const lines = Array.isArray(body.log_tail) ? body.log_tail : [];
+    if (logCursor < start) logCursor = start;
+    const index = Math.max(0, logCursor - start);
+    for (const line of lines.slice(index)) write(`HATARI ${line}`);
+    logCursor = start + lines.length;
+    if (body.state !== "BOOTING") {
+      write(`STATE ${body.state}`);
+      write(`REASON ${body.reason || "UNSPECIFIED"}`);
+      if (body.request_frame_sha256) write(`MLP.OPEN sha256:${body.request_frame_sha256}`);
+      if (body.trace_sha256) write(`HATARI.LOG sha256:${body.trace_sha256}`);
+      write("EFFECT_ACK_DONE=false");
+      return false;
+    }
+    return true;
+  }
+
+  async function monitor(bootId) {
+    for (let attempt = 0; attempt < 150; attempt += 1) {
+      const receipt = await statusFor(bootId);
+      const body = receipt.body || receipt;
+      write(`BRIDGE_HTTP ${receipt.http_status || "HOLD"}`);
+      if (!appendStatus(body)) return;
+      await pause(400);
+    }
+    state.textContent = "HOLD";
+    write("HOLD: bounded Atari reobservation timed out");
+  }
+
+  document.querySelector("#clear").addEventListener("click", () => {
+    logCursor = 0;
+    state.textContent = "LOCAL_READY";
+    screen.textContent = "$ terminal.clear\nSTATE   LOCAL_READY\n";
+  });
+
+  bootButton.addEventListener("click", async event => {
+    event.currentTarget.disabled = true;
+    logCursor = 0;
+    state.textContent = "BOOT_REQUESTED";
+    write("$ atari.boot --firefox-extension");
+    write(`BINDING MLP.TOS sha256:${digest}`);
+    try {
+      const receipt = await boot({mlp_sha256: digest});
+      const body = receipt.body || receipt;
+      write(`BRIDGE_HTTP ${receipt.http_status || "HOLD"}`);
+      if (!body || body.state !== "BOOTING" || typeof body.boot_id !== "string") {
+        state.textContent = (body && body.state) || "HOLD";
+        write(`HOLD: ${JSON.stringify(body)}`);
+        return;
+      }
+      write(`ATARI_BOOT_ID ${body.boot_id}`);
+      appendStatus(body);
+      await monitor(body.boot_id);
+    } catch (error) {
+      state.textContent = "HOLD";
+      write("HOLD: FIREFOX_EXTENSION_BRIDGE_UNAVAILABLE");
+      write(String(error));
+    } finally {
+      event.currentTarget.disabled = false;
+    }
+  });
+})();
+</script>
+</html>
