+                "digest": f"sha256:{hashlib.sha256(archive).hexdigest()}",
+                "expired": False,
+                "workflow_run": {"id": 802},
+            },
+            artifact_zip=archive,
+            transport_attempt=1,
+            child_recovery=True,
+        )
+        outbox.record_completion(
+            backend,
+            lane="exact-review-dispatch",
+            sequence=1,
+            attempt=1,
+            child=result["child"],
