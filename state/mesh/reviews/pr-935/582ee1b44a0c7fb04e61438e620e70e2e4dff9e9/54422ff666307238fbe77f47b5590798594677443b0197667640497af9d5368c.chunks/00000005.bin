+            "OUTBOX_TARGET_WORKFLOW_SUPERSEDED",
+        }
+    ),
+}
+LANE_EXHAUSTION_BLOCKERS = {
+    "ruleset-dispatch": {
+        "CHILD_RESULT_ADVERSE": frozenset(
+            {
+                "RULESET_RECONCILER_ACTION_REQUIRED",
