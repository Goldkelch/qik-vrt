+        "FINAL_PASS": False,
+        "EFFECT_ACK_DONE": False,
+        "MERGE": False,
+    }:
+        raise NativeAccountReviewError("SIGNER_RECEIPT_COMPLETION_CLAIMS_INVALID")
+    return value
+
