+            "  enqueue-review-wakeup-core:\n", 1
+        )[1].split("  persist-review-wakeup-ack:\n", 1)[0]
+        ack_writer = workflow.split("  persist-review-wakeup-ack:\n", 1)[1]
+        self.assertIn("      actions: read", planner)
+        self.assertNotIn("actions: write", planner)
