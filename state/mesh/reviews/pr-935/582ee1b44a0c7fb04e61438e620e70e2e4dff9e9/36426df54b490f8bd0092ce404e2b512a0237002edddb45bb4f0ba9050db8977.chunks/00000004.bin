+    def executor_artifact(
+        self,
+        *,
+        artifact_id=9001,
+        run_id=7001,
+        run_attempt=2,
+        name=None,
+    ):
+        if name is None:
+            name = (
+                f"qikvrt-mesh-review-pr-884-{HEAD}-{FINGERPRINT}"
+                f"-run-{run_id}-attempt-{run_attempt}"
+            )
+        return {
+            "id": artifact_id,
+            "name": name,
+            "expired": False,
+            "digest": "sha256:" + "d" * 64,
+            "archive_download_url": (
+                f"https://api.github.com/repos/{REPOSITORY}/actions/artifacts/"
+                f"{artifact_id}/zip"
+            ),
+        }
+
+    def delegated_review(
