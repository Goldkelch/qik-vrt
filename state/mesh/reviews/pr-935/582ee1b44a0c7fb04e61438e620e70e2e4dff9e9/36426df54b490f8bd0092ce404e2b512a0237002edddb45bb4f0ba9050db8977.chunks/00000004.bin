+    def test_signer_preflight_requires_exact_user_permission_and_counterpart(self):
+        plan = self.plan()
+        good = module.signer_preflight(
+            plan=plan,
+            expected_signer="Goldkelch",
+            pr=self.pr(),
+            commit=self.commit(),
+            reviews=[],
+            delegation=self.delegation(),
