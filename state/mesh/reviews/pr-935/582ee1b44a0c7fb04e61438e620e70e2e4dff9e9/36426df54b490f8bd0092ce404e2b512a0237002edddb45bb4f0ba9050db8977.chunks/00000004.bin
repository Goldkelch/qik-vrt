+                "next_review_page"
+            ],
+            2,
+        )
+        self.assertEqual(resume["quantum_pages"], 1)
+        self.assertEqual(resume["ack_recheck_quantum"], 1)
+        self.assertEqual(
+            resume["last_ack_cursor"]["review_id"], fact["review_id"]
+        )
+        self.assertIn(
+            "pr-935.json", module.review_observation_subject_cursor_path(935)
+        )
