+        self.assertEqual(first["action"], "REPLAY_REQUESTED_REVIEW_ONCE")
+        self.assertEqual(first["d0"], 2)
+
+        # Recreate patches because unittest.mock patchers are single-use.
+        with mock.patch.object(
