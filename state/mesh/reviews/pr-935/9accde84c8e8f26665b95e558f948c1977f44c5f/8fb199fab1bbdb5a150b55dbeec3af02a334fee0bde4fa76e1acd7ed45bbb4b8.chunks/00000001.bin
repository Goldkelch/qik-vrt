diff --git a/MLP.TOS/Hatari b/MLP.TOS/Hatari
new file mode 100755
index 0000000000000000000000000000000000000000..fe0bd757420137bd1607f1e765adb9888f6d4a98
--- /dev/null
+++ b/MLP.TOS/Hatari
@@ -0,0 +1,175 @@
+#!/bin/sh
+# QIK-VRT MLP.TOS Hatari launcher: deterministic virtual Mega-ST observation.
+set -eu
+
+self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+repo_root=$(CDPATH= cd -- "$self_dir/.." && pwd)
+mlp_tos=${MLP_TOS:-"$self_dir/MLP.TOS"}
+checksum_file=${MLP_TOS_CHECKSUM:-"$self_dir/MLP.TOS.sha256"}
+hatari_bin=${HATARI_BIN:-hatari}
+rom=${EMUTOS_ROM:-}
+timeout_seconds=${QIKVRT_HATARI_TIMEOUT_SECONDS:-60}
+
+if [ -z "$rom" ]; then
+    echo "HOLD: set EMUTOS_ROM to the exact EmuTOS 1.4 etos512ca.img path" >&2
+    exit 2
+fi
+
+for required in "$mlp_tos" "$checksum_file" "$rom"; do
+    if [ ! -f "$required" ]; then
+        echo "HOLD: missing required file: $required" >&2
+        exit 2
+    fi
+done
+for command_name in "$hatari_bin" sha256sum awk cmp grep timeout; do
+    if ! command -v "$command_name" >/dev/null 2>&1; then
+        echo "HOLD: missing required command: $command_name" >&2
+        exit 2
+    fi
+done
+
+expected_tos=$(awk 'NR == 1 { print $1 }' "$checksum_file")
+actual_tos=$(sha256sum "$mlp_tos" | awk '{ print $1 }')
+if [ "$actual_tos" != "$expected_tos" ]; then
+    echo "HOLD: MLP.TOS digest mismatch" >&2
+    exit 2
+fi
+
+expected_rom=f810041373d8efe15d55ec049fd4dd9be9b0fc521bbe6416b99d833f7fd6805d
+actual_rom=$(sha256sum "$rom" | awk '{ print $1 }')
+if [ "$actual_rom" != "$expected_rom" ]; then
+    echo "HOLD: EmuTOS ROM digest mismatch" >&2
+    exit 2
+fi
+
+version=$($hatari_bin --version 2>&1 || true)
+printf '%s\n' "$version"
+printf '%s\n' "$version" | grep -F 'Hatari v2.4.1' >/dev/null
+
+remove_workdir=false
+if [ -n "${QIKVRT_MLP_WORKDIR:-}" ]; then
+    workdir=$QIKVRT_MLP_WORKDIR
+    mkdir -p "$workdir"
+else
+    workdir=$(mktemp -d)
+    remove_workdir=true
+fi
+cleanup() {
+    if [ "$remove_workdir" = true ]; then
+        rm -rf "$workdir"
+    fi
+}
+trap cleanup EXIT HUP INT TERM
+
+drive="$workdir/drive"
+trace="$workdir/hatari.log"
+expected_frame="$workdir/MLP.OPEN.expected"
+mkdir -p "$drive/C"
+cp "$mlp_tos" "$drive/C/MLP.TOS"
+rm -f "$drive/C/MLP.OPEN" "$drive/C/MLP.TMP"
+{
+    printf 'QIKMLP1\r\n'
+    printf 'PROGRAM MLP\r\n'
+    printf 'ACTION OPEN_FIREFOX\r\n'
+    printf 'STATE REQUESTED\r\n'
+    printf 'AUTHORITY MISSING\r\n'
+    printf 'EFFECT REQUESTED\r\n'
+    printf 'END\r\n'
+} >"$expected_frame"
+
+run_hatari() {
+    "$hatari_bin" \
+        --machine megast \
+        --cpulevel 0 \
+        --cpuclock 8 \
+        --compatible on \
+        --cpu-exact on \
+        --addr24 on \
+        --memsize 1 \
+        --tos "$rom" \
+        --harddrive "$drive" \
+        --auto 'C:\MLP.TOS' \
+        --fast-forward on \
+        --sound off \
+        --disable-video on \
+        --benchmark \
+        --run-vbls 600 \
+        --trace os_base
+}
+
+set +e
+if command -v xvfb-run >/dev/null 2>&1; then
+    timeout "${timeout_seconds}s" xvfb-run -a sh -c 'exec "$@"' sh \
+        "$hatari_bin" \
+        --machine megast \
+        --cpulevel 0 \
+        --cpuclock 8 \
+        --compatible on \
+        --cpu-exact on \
+        --addr24 on \
+        --memsize 1 \
+        --tos "$rom" \
+        --harddrive "$drive" \
+        --auto 'C:\MLP.TOS' \
+        --fast-forward on \
+        --sound off \
+        --disable-video on \
+        --benchmark \
+        --run-vbls 600 \
+        --trace os_base >"$trace" 2>&1
+    rc=$?
+else
+    timeout "${timeout_seconds}s" "$hatari_bin" \
+        --machine megast \
+        --cpulevel 0 \
+        --cpuclock 8 \
+        --compatible on \
+        --cpu-exact on \
+        --addr24 on \
+        --memsize 1 \
+        --tos "$rom" \
+        --harddrive "$drive" \
+        --auto 'C:\MLP.TOS' \
+        --fast-forward on \
+        --sound off \
+        --disable-video on \
+        --benchmark \
+        --run-vbls 600 \
+        --trace os_base >"$trace" 2>&1
+    rc=$?
+fi
+set -e
+cat "$trace"
+if [ "$rc" -ne 0 ]; then
+    echo "HOLD: Hatari execution failed with status $rc" >&2
+    exit "$rc"
+fi
+
+grep -F 'Tipus CPU:          M68000' "$trace" >/dev/null
+grep -F 'Maquina:            Atari Mega ST' "$trace" >/dev/null
+grep -F 'ST-RAM:             1 MB' "$trace" >/dev/null
+grep -F 'Pexec(0, "C:\MLP.TOS"' "$trace" >/dev/null
+grep -F 'Fcreate("C:\MLP.TMP", 0x0)' "$trace" >/dev/null
+grep -F 'Pterm(0)' "$trace" >/dev/null
+
+if [ ! -f "$drive/C/MLP.OPEN" ]; then
+    echo "HOLD: Hatari did not materialize C:\\MLP.OPEN" >&2
+    exit 3
+fi
+if [ -e "$drive/C/MLP.TMP" ]; then
+    echo "HOLD: temporary request file survived finalization" >&2
+    exit 3
+fi
+cmp "$expected_frame" "$drive/C/MLP.OPEN"
+
+open_sha=$(sha256sum "$drive/C/MLP.OPEN" | awk '{ print $1 }')
+trace_sha=$(sha256sum "$trace" | awk '{ print $1 }')
+cat >"$workdir/receipt.env" <<EOF
+MLP_TOS_SHA256=$actual_tos
+MLP_OPEN_SHA256=$open_sha
+HATARI_TRACE_SHA256=$trace_sha
+MEGAST_VIRTUAL_EXECUTION_OBSERVED=true
+PHYSICAL_MEGAST_EXECUTION=false
+EFFECT_ACK_DONE=false
+EOF
+cat "$workdir/receipt.env"
diff --git a/MLP.TOS/LIVE_STATUS_TCPIP.md b/MLP.TOS/LIVE_STATUS_TCPIP.md
new file mode 100644
index 0000000000000000000000000000000000000000..9f40e8695d80070ebc558b63c9100b6e9b4408e8
--- /dev/null
+++ b/MLP.TOS/LIVE_STATUS_TCPIP.md
@@ -0,0 +1,43 @@
+# QIK-VRT LIVE STATUS — Mega ST guest TCP/IP proof
+
+This file exists so the current proof state is visible directly in the repository tree and in PR #745 Files changed.
+
+## Exact current binding
+
+- PR: #745
+- Head before this visibility commit: `a85ff347abd144b97bc4d133b311fccc96fc1ed1`
+- Source MLP.TOS SHA-256: `5a74c9645d6cdcb2d92770517e31eb7697e180b2ccc4b7fb777c9b558b84ae7e`
+
+## What has actually been observed
+
+- Exact checkout verification: success
+- TCP/IP proof-contract tests: 4/4 success
+- Bound `MLP.TOS` digest check: success
+- QIKVRT CI: success
+- Collective Proposal Review workflow: success
+- Global claim completion workflow: success
+- Repository integrity materialization: success
+- Code-owner observer workflow: success
+
+## First real deterministic blocker
+
+The dedicated guest TCP/IP proof job reaches the guest-network capability probe and then fails closed with:
+
+`HOLD: no repository-bound guest TCP/IP stack/driver/probe is present yet.`
+
+This is intentional. Runner/host networking is not accepted as guest-network evidence.
+
+## What is not yet proven
+
+- guest-side TCP/IP stack initialized: no
+- guest IP address observed: no
+- guest-originated TCP connection observed: no
+- nonce-bearing payload observed at controlled endpoint: no
+- response observed again inside the guest: no
+- `GUEST_TCP_IP_ROUNDTRIP_OBSERVED`: no
+- `EFFECT_ACK_DONE`: no
+- physical Mega ST execution: no
+
+## Next implementation action
+
+Implement or bind a guest-side Atari networking component/probe, then execute the nonce-bound TCP roundtrip and persist an exact-head/tree receipt.
