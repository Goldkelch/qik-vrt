diff --git a/contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json b/contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..21b673cd4dd5191b3f02d159e61d548c10f3a1fd
--- /dev/null
+++ b/contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json
@@ -0,0 +1,71 @@
+{
+  "_license": {
+    "copyright": "2026 Ingolf Lohmann",
+    "license": "CC-BY-NC-ND-4.0"
+  },
+  "schema": "qikvrt_abnan_mvp_public_carrier_contract_v1",
+  "contract_id": "ABNAN_MVP_PUBLIC_CARRIER_V1",
+  "purpose": "Turn the AbNan MVP boundary into a machine-readable, repository-addressable contract rather than leaving it only in discussion.",
+  "scope": {
+    "phase": "bounded_scoping_and_reference_mvp",
+    "live_case": false,
+    "regulatory_approval_claim": false,
+    "endorsement_claim": false,
+    "payment_service": false,
+    "sensitive_beneficiary_data_public": false
+  },
+  "roundtrip": [
+    "NEED",
+    "VERIFY",
+    "COMPLIANCE",
+    "MATCH",
+    "ACCEPT",
+    "LAWFUL_LOCAL_ACTION",
+    "READBACK",
+    "CLOSE"
+  ],
+  "fail_closed": {
+    "request_is_execution": false,
+    "execution_is_success": false,
+    "success_is_effect": false,
+    "predecessor_evidence_transfer": false,
+    "unresolved_condition": "HOLD_UNVERIFIED"
+  },
+  "responsibility": {
+    "abnan": "humanitarian case coordination and accountable workflow",
+    "independent_professionals": [
+      "legal",
+      "sanctions",
+      "AML",
+      "nonprofit",
+      "privacy",
+      "security"
+    ],
+    "qik_vrt": "evidence-bound state transitions, readback, auditability, monitor projections and fail-closed semantics",
+    "implementation_partner": "components delivered against explicit acceptance criteria"
+  },
+  "public_carrier": {
+    "repository": "Goldkelch/qik-vrt",
+    "human_witness_path": "docs/abnan/witness-v1/index.html",
+    "machine_contract_path": "contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json",
+    "required_terminal_chain": [
+      "PERSISTED_EXACT_SUBJECT",
+      "FRESH_VALIDATION",
+      "NATIVE_REVIEW",
+      "MAIN",
+      "PUBLIC_HTTP_READBACK",
+      "EFFECT_ACK_DONE"
+    ],
+    "current_non_claims": [
+      "MAIN",
+      "PUBLIC_PAGES_DEPLOYMENT",
+      "PUBLIC_HTTP_READBACK",
+      "EFFECT_ACK_DONE"
+    ]
+  },
+  "accessibility": {
+    "human": "docs/abnan/witness-v1/index.html",
+    "machine": "contracts/QIKVRT_ABNAN_MVP_PUBLIC_CARRIER_V1.json",
+    "design_goal": "same boundary is discoverable by people, automation and evidence routers"
+  }
+}
diff --git a/docs/abnan/witness-v1/index.html b/docs/abnan/witness-v1/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..a87273084f2d1f29302a579b297333ca04a273e9
--- /dev/null
+++ b/docs/abnan/witness-v1/index.html
@@ -0,0 +1 @@
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AbNan × QIK-VRT — Closed Roundtrip Witness V1</title><style>body{font:16px system-ui;max-width:980px;margin:auto;padding:28px;background:#0b1020;color:#e8edf7}h1{font-size:2rem}.card{background:#151d33;border:1px solid #33415f;border-radius:14px;padding:18px;margin:14px 0}.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:8px}.step{padding:12px;background:#202b49;border-radius:10px}.ok{color:#7ee787}.hold{color:#ffd166}code{color:#9ecbff}small{color:#aab6cf}</style></head><body><h1>AbNan × QIK-VRT</h1><p>Privacy-safe <strong>Closed Roundtrip Witness V1</strong>. This is a technical reference model, not a live humanitarian case, regulatory approval, endorsement, or payment service.</p><div class="card"><h2>Purpose</h2><p>Demonstrate how one lawful, independently approved humanitarian-support case can be carried from a verified need to a freshly read-back effect while minimizing sensitive data and preserving accountable evidence.</p></div><div class="card"><h2>Roundtrip</h2><div class="flow"><div class="step">1. NEED<br><small>minimum case data</small></div><div class="step">2. VERIFY<br><small>eligibility / identity</small></div><div class="step">3. COMPLIANCE<br><small>independent gate</small></div><div class="step">4. MATCH<br><small>roles assigned</small></div><div class="step">5. ACCEPT<br><small>separate confirmations</small></div><div class="step">6. LOCAL ACTION<br><small>no AbNan cross-border transfer</small></div><div class="step">7. READBACK<br><small>effect evidence</small></div><div class="step">8. CLOSE<br><small>complaint path retained</small></div></div></div><div class="card"><h2>Fail-closed contract</h2><p><code>REQUEST ≠ EXECUTION ≠ SUCCESS ≠ EFFECT</code></p><p><code>historical evidence may remain; current validity must be freshly earned</code></p><p>Any unresolved legal, sanctions, AML, privacy, security, identity, partner or evidence condition produces <span class="hold">HOLD_UNVERIFIED</span>, never an implicit approval.</p></div><div class="card"><h2>Evidence envelope</h2><p>Each transition binds a pseudonymous case identifier, state, timestamp, actor role, minimum required evidence digest, decision provenance and validity status. Sensitive beneficiary data is not part of this public witness.</p></div><div class="card"><h2>Separation of responsibility</h2><p><strong>AbNan:</strong> humanitarian case coordination and accountable workflow. <strong>Independent professionals:</strong> legal, sanctions, AML, nonprofit, privacy and security approval. <strong>QIK-VRT:</strong> evidence-bound state transitions, readback, auditability, monitor projections and fail-closed semantics. <strong>Implementation partners:</strong> deliver components against explicit acceptance criteria.</p></div><div class="card"><h2>Technical interfaces</h2><p>The reference architecture can project privacy-filtered state through a read-only Monitorhook / Universal-Terminal interface. Clients may consume the same evidence graph without receiving unnecessary beneficiary data. Independent computational perspectives may flag counterevidence; disagreement is retained and cannot be voted away.</p></div><div class="card"><h2>Definition of witness completion</h2><p class="ok">A real pilot witness is complete only after independent approval for live operation, an authorized real case, lawful local action, separate confirmations, fresh effect readback, and documented closure on the same case subject.</p><p>This V1 page itself establishes only the executable/reference boundary. It deliberately makes no claim that those real-world conditions have already occurred.</p></div></body></html>
\ No newline at end of file
