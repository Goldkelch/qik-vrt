+  const names = {de:'Deutsch',en:'English',fr:'Français',es:'Español','pt-BR':'Português (Brasil)',it:'Italiano',tr:'Türkçe',ru:'Русский',ar:'العربية',hi:'हिन्दी',id:'Bahasa Indonesia',ja:'日本語',ko:'한국어','zh-CN':'简体中文'};
