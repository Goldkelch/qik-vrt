diff --git a/.github/workflows/qikvrt_pr_closure_engine.yml b/.github/workflows/qikvrt_pr_closure_engine.yml
new file mode 100644
index 0000000000000000000000000000000000000000..c186592297c7992dcc117167918324d66ad9c426
--- /dev/null
+++ b/.github/workflows/qikvrt_pr_closure_engine.yml
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+# Copyright 2026 Ingolf Lohmann.
+name: QIKVRT PR closure engine
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: "*/5 * * * *"
+  push:
+    branches: [main]
+  workflow_run:
+    workflows:
+      - "QIKVRT CI"
+      - "QIKVRT repository evidence materialization"
+      - "QIKVRT requested review executor"
+      - "QIKVRT required code-owner review"
+    types: [completed]
+  pull_request:
+    paths:
+      - ".github/workflows/qikvrt_pr_closure_engine.yml"
+      - "tools/qikvrt_pr_closure_engine.py"
+      - "tests/test_qikvrt_pr_closure_engine.py"
+      - "state/autonomy/AUTONOMOUS_PR_CLOSURE_POLICY_V1.json"
+      - "state/authorization/delegations/OWNER_AUTONOMOUS_REPOSITORY_CLOSURE_V1.json"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: qikvrt-pr-closure-${{ github.repository }}
+  cancel-in-progress: false
+
+jobs:
+  validate:
+    if: github.event_name == 'pull_request'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    steps:
+      - name: Check out exact pull-request head
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Set up Python
+        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: "3.12"
+      - name: Validate closure policy and decision core
+        shell: bash
+        run: |
+          set -euo pipefail
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B tools/qikvrt_pr_closure_engine.py validate-policy
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B -m unittest -v tests.test_qikvrt_pr_closure_engine
+
+  close-open-pr-queue:
+    if: github.event_name != 'pull_request'
+    permissions:
+      actions: read
+      checks: read
+      contents: write
+      issues: write
+      pull-requests: write
+      statuses: read
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    steps:
+      - name: Check out trusted current main
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: main
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Set up Python
+        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: "3.12"
+      - name: Validate trusted closure engine
+        shell: bash
+        run: |
+          set -euo pipefail
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B tools/qikvrt_pr_closure_engine.py validate-policy --repository "$GITHUB_REPOSITORY"
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B -m unittest -v tests.test_qikvrt_pr_closure_engine
+      - name: Execute one bounded closure mutation
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B tools/qikvrt_pr_closure_engine.py run \
+            --repository "$GITHUB_REPOSITORY" \
+            --apply \
+            --output /tmp/qikvrt-pr-closure-receipt.json
+      - name: Preserve closure receipt
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: qikvrt-pr-closure-receipt-${{ github.run_id }}-${{ github.run_attempt }}
+          path: /tmp/qikvrt-pr-closure-receipt.json
+          if-no-files-found: warn
+          retention-days: 30
diff --git a/state/authorization/delegations/OWNER_AUTONOMOUS_REPOSITORY_CLOSURE_V1.json b/state/authorization/delegations/OWNER_AUTONOMOUS_REPOSITORY_CLOSURE_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..652a18ada8ec3a44962d698e260fab4cc4bba3a7
--- /dev/null
+++ b/state/authorization/delegations/OWNER_AUTONOMOUS_REPOSITORY_CLOSURE_V1.json
@@ -0,0 +1,47 @@
+{
+  "schema": "qikvrt_owner_autonomous_repository_closure_v1",
+  "delegation_id": "OWNER-AUTONOMOUS-REPOSITORY-CLOSURE-V1",
+  "status": "ACTIVE",
+  "owner": {
+    "name": "Ingolf Lohmann",
+    "role": "Product Owner"
+  },
+  "effective_at": "2026-09-23T10:14:00+02:00",
+  "source_instruction": "Na dann ist jetzt der Zeitpunkt, genau das zu ändern Freigabe erteilt.",
+  "authorized_scope": [
+    "reobserve_current_main_and_open_pull_requests",
+    "close_open_pull_requests_only_when_their_diff_is_already_contained_in_current_main",
+    "mark_only_trusted_repository_generated_self_heal_drafts_ready_for_review",
+    "update_same_repository_pull_request_branches_to_current_main_without_force",
+    "request_the_configured_independent_reviewer_for_the_current_exact_head",
+    "merge_authority_pull_requests_only_after_current_exact_head_required_checks_current_technical_review_current_independent_approval_and_active_strict_native_ruleset_are_reobserved",
+    "promote_mirror_pull_requests_only_by_non_force_fast_forward_of_current_main_to_the_exact_approved_head",
+    "continue_scanning_when_a_pull_request_is_waiting_on_a_non_mutable_gate_or_requires_semantic_conflict_repair"
+  ],
+  "mandatory_invariants": [
+    "TRANSPORT_ACK_NE_EFFECT_ACK",
+    "PREDECESSOR_EVIDENCE_TRANSFER_FALSE",
+    "NO_SELF_REVIEW_AS_INDEPENDENT_REVIEW",
+    "NO_FORCE_PUSH_TO_MAIN",
+    "EXACT_HEAD_REOBSERVATION_BEFORE_MUTATION",
+    "CURRENT_MAIN_REOBSERVATION_BEFORE_PROMOTION",
+    "AT_MOST_ONE_REPOSITORY_MUTATION_PER_EXECUTOR_RUN",
+    "NO_EXTERNAL_EFFECT_FROM_CLOSURE_ENGINE"
+  ],
+  "not_authorized": [
+    "zenodo_publication",
+    "ietf_submission",
+    "doi_creation",
+    "public_release",
+    "credential_escalation",
+    "fabricated_review",
+    "force_push",
+    "scientific_confirmation",
+    "EFFECT_ACK_DONE_without_fresh_effect_readback"
+  ],
+  "completion_claims": {
+    "PASS": false,
+    "FINAL_PASS": false,
+    "EFFECT_ACK_DONE": false
+  }
+}
diff --git a/state/autonomy/AUTONOMOUS_PR_CLOSURE_POLICY_V1.json b/state/autonomy/AUTONOMOUS_PR_CLOSURE_POLICY_V1.json
