@@ -0,0 +1,61 @@
+{
+  "schema": "qikvrt_external_delivery_request_v1",
+  "id": "AI_PERSONAL_FIREFOX_V1",
+  "platform": "qikvrt_public_browser",
+  "authority": {
+    "product_owner": "Ingolf Lohmann",
+    "authorization": "OWNER_REQUESTED_PUBLIC_PERSONAL_FIREFOX_DELIVERY",
+    "source": "CURRENT_CHAT_PRODUCT_PRIORITY_CORRECTION_2026_09_15"
+  },
+  "preconditions": {
+    "required_main_paths": [
+      "AI",
