diff --git a/.github/workflows/qikvrt_temdd.yml b/.github/workflows/qikvrt_temdd.yml
new file mode 100644
index 0000000000000000000000000000000000000000..a27e1dc7fc7bf87fde5ea5fda83b2a2f2ceb9a47
--- /dev/null
+++ b/.github/workflows/qikvrt_temdd.yml
@@ -0,0 +1,95 @@
+name: QIKVRT TEMDD conformance
+on:
+  pull_request:
+    paths: ['spec/temdd/**','examples/temdd/**','schemas/temdd-*','tools/qikvrt_temdd.py','tools/qikvrt_temdd_conformance.py','tests/test_temdd.py','tests/temdd/**','src/temdd_core.c','include/temdd_core.h','tests/test_temdd_core.c','runtime/temdd/**','runtime/m68000/temdd_transition.s','formalization/TEMDDCore.lean','src/qikvrt_temdd_event_ledger.py','src/qikvrt_effect_ack_http_terminal.py','tests/test_temdd_event_ledger.py','docs/terminal/temdd/**','deploy/universal-terminal/**','Makefile','.github/workflows/qikvrt_temdd.yml']
+  push: {branches: [main]}
+permissions: {contents: read}
+jobs:
+ conformance:
+  runs-on: ubuntu-24.04
+  timeout-minutes: 15
+  steps:
+   - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+     with:
+      ref: ${{ github.event.pull_request.head.sha || github.sha }}
+      persist-credentials: false
+   - uses: actions/setup-python@v6
+     with:
+      python-version: '3.12.13'
+   - uses: actions/setup-node@v6
+     with:
+      node-version: '24.x'
+      package-manager-cache: false
+   - name: Fresh exact-head persistent producer and browser regressions
+     env:
+      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+     shell: bash
+     run: |
+      set -euo pipefail
+      test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD"
+      git diff --exit-code
+      python3 -B tools/qikvrt_tool_cache.py verify
+      python3 --version
+      node --version
+      make temdd-event-ledger-test 2>&1 | tee "$RUNNER_TEMP/temdd-producer-tests.log"
+      git diff --exit-code
+      printf 'HEAD=%s\nTREE=%s\nEVIDENCE_TRANSFER=DENY\nSCOPE=producer-regression-only\nDOD=NOT_PROVEN\n' "$EXPECTED_HEAD" "$(git rev-parse 'HEAD^{tree}')" | tee "$RUNNER_TEMP/temdd-producer-binding.txt"
+   - name: Python parser T01-T12 and corpus
+     run: |
+      python3 -B -m unittest tests.test_temdd
+      python3 -B tools/qikvrt_temdd_conformance.py
+      python3 -B tools/qikvrt_temdd.py tests/temdd/positive/minimal.temdd >/tmp/minimal.json
+      for f in tests/temdd/negative/*.temdd; do if python3 -B tools/qikvrt_temdd.py "$f" >/dev/null 2>&1; then echo "negative corpus admitted: $f"; exit 1; fi; done
+      python3 -B tools/qikvrt_temdd.py examples/temdd/qikvrt_convergence_v0_1.temdd >/tmp/temdd-ir.json
+      python3 - <<'PY'
+      import json
+      x=json.load(open('/tmp/temdd-ir.json'))
+      required={'ZERO_BUGS','ALL_PULL_REQUESTS_REGARDED','ALL_BRANCHES_REGARDED','ALL_PRODUCTIVE_BRANCHES_MERGED','FRESH_EXACT_MAIN_VALIDATION_PASS','FRESH_EFFECT_READBACK'}
+      assert required == set(x['dod']); assert x['subject']['binding']=='exact'
+      PY
+   - name: C90 differential kernel
+     run: cc -std=c90 -pedantic -Wall -Wextra -Werror -Iinclude src/temdd_core.c tests/test_temdd_core.c -o /tmp/temdd-core && /tmp/temdd-core
+   - name: M68000 source admission
+     run: grep -q 'SUCCESSOR_REQUIRED' runtime/m68000/temdd_transition.s
+   - name: Smalltalk source admission
+     run: grep -q 'successorRequired' runtime/temdd/TEMDDRuntime.st
+   - name: Lean obligation source admission
+     run: grep -q 'missing_effect_readback_not_done' formalization/TEMDDCore.lean
+   - name: Materialize bounded integrity candidate without adopting or promoting
+     shell: bash
+     run: |
+      set -euo pipefail
+      python3 -B tools/qikvrt_integrity.py generate
+      python3 -B tools/qikvrt_integrity.py verify
+      python3 - <<'PYCODE'
+      import hashlib, json, os, shutil, subprocess
+      from pathlib import Path
+      def git(*args):
+          return subprocess.check_output(['git', *args], text=True).strip()
+      allow = ['REPOSITORY_FILE_MANIFEST.json', 'REPOSITORY_FILE_MANIFEST.json.sha256', 'SHA256SUMS.txt']
+      changed = git('diff', '--name-only').splitlines()
+      assert set(changed) <= set(allow), changed
+      assert not git('diff', '--cached', '--name-only')
+      out = Path(os.environ['RUNNER_TEMP']) / 'temdd-integrity'
+      out.mkdir()
+      files = {}
+      for name in allow:
+          shutil.copyfile(name, out / name)
+          files[name] = {'sha256': hashlib.sha256(Path(name).read_bytes()).hexdigest(), 'blob': git('hash-object', name)}
+      receipt = {'schema': 'qikvrt_temdd_integrity_candidate_v1', 'repository': os.environ['GITHUB_REPOSITORY'],
+                 'parent_head': git('rev-parse', 'HEAD'), 'parent_tree': git('rev-parse', 'HEAD^{tree}'),
+                 'run_id': os.environ['GITHUB_RUN_ID'], 'allowlist': allow, 'files': files,
+                 'state': 'MATERIALIZED_WORKTREE_ONLY', 'adopted': False, 'p2_pass': False,
+                 'evidence_transfer': 'DENY', 'dod': False}
+      (out / 'receipt.json').write_text(json.dumps(receipt, indent=2, sort_keys=True) + '\n')
+      PYCODE
+   - name: Preserve exact-head focused evidence and bounded integrity candidate
+     if: always()
+     uses: actions/upload-artifact@v4
+     with:
+      name: temdd-producer-${{ github.event.pull_request.head.sha || github.sha }}-${{ github.run_id }}
+      path: |
+       ${{ runner.temp }}/temdd-producer-tests.log
+       ${{ runner.temp }}/temdd-producer-binding.txt
+       ${{ runner.temp }}/temdd-integrity/
+      if-no-files-found: error
diff --git a/Makefile b/Makefile
index 4f3eae3ab9a530e5d4d672de84f5526b8e00e4ac..5272393d39d5a29d29aaa1ee9c21a41d47a63b5f 100644
--- a/Makefile
+++ b/Makefile
@@ -116,3 +116,9 @@ run-api:
 
 clean:
 	rm -rf unit_state e2e_state .qikvrt/runtime .qikvrt/evidence .qikvrt/api .qikvrt/cache .qikvrt/release .qikvrt/interactions .qikvrt/real-mesh logs __pycache__ src/__pycache__ scripts/__pycache__ tests/__pycache__ tools/__pycache__
+
+# Finite producer/replay regression; no scheduling inside the TEMDD kernel.
+.PHONY: temdd-event-ledger-test
+test: temdd-event-ledger-test
+temdd-event-ledger-test:
+	PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 $(PYTHON) -B tests/test_temdd_event_ledger.py
