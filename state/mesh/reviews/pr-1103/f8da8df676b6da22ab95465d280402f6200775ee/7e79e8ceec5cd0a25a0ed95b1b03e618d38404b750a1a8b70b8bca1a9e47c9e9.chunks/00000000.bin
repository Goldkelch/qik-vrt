+    if set(members)!={"v","mode","token","hash"}: raise ValueError("commit requires token and hash")
+    token_bytes=parse_sf_bytes(members["token"])
+    try: token=token_bytes.decode("ascii")
+    except UnicodeDecodeError as exc: raise ValueError("commit token must be ASCII") from exc
+    hash_bytes=parse_sf_bytes(members["hash"])
+    if len(hash_bytes)!=32: raise ValueError("commit hash must contain exactly 32 octets")
+    return {"v":1,"mode":"commit","token":token,"hash":hash_bytes.hex()}
