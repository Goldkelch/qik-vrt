diff --git a/docs/terminal/temdd/index.html b/docs/terminal/temdd/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..d2c306bf5a249aafef9e203c72391c2954bb1dad
--- /dev/null
+++ b/docs/terminal/temdd/index.html
@@ -0,0 +1,44 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>QIK-VRT TEMDD Live Universal Terminal</title><style>body{margin:0;background:#090c10;color:#e8edf2;font:14px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}main{max-width:1280px;margin:auto;padding:18px}.grid{display:grid;grid-template-columns:1fr 2fr;gap:14px}.p{background:#11171e;border:1px solid #303a46;border-radius:12px;padding:16px}.meta{display:grid;grid-template-columns:110px 1fr;gap:6px}.muted{color:#8d9aaa}.ok{color:#68d391}.hold{color:#ecc94b}#tail{height:68vh;overflow:auto;white-space:pre-wrap;background:#070a0d;padding:12px;border-radius:8px}.badge{border:1px solid #43505e;border-radius:99px;padding:2px 8px}button{background:#18212b;color:#e8edf2;border:1px solid #43505e;border-radius:7px;padding:6px 10px}@media(max-width:800px){.grid{grid-template-columns:1fr}#tail{height:55vh}}</style></head><body><main><h1>QIK-VRT · TEMDD LIVE UNIVERSAL TERMINAL <span id="state" class="badge hold">CONNECTING</span></h1><p class="muted">Observer lifetime ≠ execution lifetime · exact-subject evidence · fail-closed · replayable event cursor</p><div class="grid"><section class="p"><h2>Exact checkout subject</h2><div class="meta"><span class="muted">Authority</span><span id="repository">—</span><span class="muted">PR</span><span id="pr">—</span><span class="muted">HEAD</span><span id="head">—</span><span class="muted">TREE</span><span id="tree">—</span><span class="muted">Event ID</span><span id="cursor">—</span><span class="muted">DoD</span><span id="dod" class="hold">NOT PROVEN</span></div><h2>Transport</h2><p id="transport">discovering local native stream…</p><button id="reconnect">RECONNECT</button><p class="muted">Ledger persistence is not validation, review, promotion, or EFFECT_ACK_DONE. A deployed checkout is not a fresh remote PR-head observation.</p></section><section class="p"><h2>tail -f</h2><div id="tail"></div></section></div></main><script>
+'use strict';
+const tail=document.getElementById('tail'),state=document.getElementById('state'),cursorEl=document.getElementById('cursor');
+let es=null,cursor='',exactSubject=null,ledgerId='',cursorKey='',generation=0;
+function line(kind,msg){tail.textContent+=`${new Date().toISOString()}  ${kind.padEnd(10)} ${msg}\n`;tail.scrollTop=tail.scrollHeight;}
+function setState(s,c){state.textContent=s;state.className='badge '+c;}
+function hold(reason){setState('HOLD','hold');document.getElementById('dod').textContent='NOT PROVEN';line('HOLD',reason);}
+function validSubject(s){return s&&Object.keys(s).sort().join(',')==='head,pr,repository,tree'&&typeof s.repository==='string'&&Number.isInteger(s.pr)&&s.pr>0&&/^[0-9a-f]{40}$/.test(s.head)&&/^[0-9a-f]{40}$/.test(s.tree);}
+function sameSubject(a,b){return validSubject(a)&&validSubject(b)&&['repository','pr','head','tree'].every(k=>a[k]===b[k]);}
+function sequence(id){const m=/^([0-9a-f]{32}):([1-9][0-9]{0,18})$/.exec(id);if(!m||m[1]!==ledgerId)throw Error('foreign or malformed ledger cursor');return BigInt(m[2]);}
+async function connect(){
+  const current=++generation;if(es)es.close();es=null;setState('CONNECTING','hold');
+  try{
+    const r=await fetch('/api/temdd/subject',{cache:'no-store'});if(!r.ok)throw Error('exact checkout readback unavailable');
+    const x=await r.json();if(current!==generation)return;
+    if(!validSubject(x.subject)||!/^[0-9a-f]{32}$/.test(x.ledger_id)||x.dod!==false||x.evidence_transfer!=='DENY')throw Error('invalid exact-subject envelope');
+    exactSubject=x.subject;ledgerId=x.ledger_id;
+    cursorKey='qikvrt.temdd.cursor:'+JSON.stringify([ledgerId,exactSubject.repository,exactSubject.pr,exactSubject.head,exactSubject.tree]);
+    cursor=localStorage.getItem(cursorKey)||'';if(cursor)sequence(cursor);
+    for(const key of ['repository','pr','head','tree'])document.getElementById(key).textContent=exactSubject[key];
+    cursorEl.textContent=cursor||'—';line('SUBJECT',JSON.stringify(exactSubject));
+    const url='/api/temdd/events'+(cursor?'?after='+encodeURIComponent(cursor):'');
+    document.getElementById('transport').textContent='SSE '+url;
+    const source=new EventSource(url);es=source;let bound=false;
+    source.onopen=()=>{if(current===generation){bound=false;setState('CONNECTED','hold');}};
+    source.addEventListener('subject',e=>{if(current!==generation)return;try{
+      const s=JSON.parse(e.data);if(!sameSubject(s.subject,exactSubject)||s.ledger_id!==ledgerId||s.dod!==false||s.evidence_transfer!=='DENY')throw Error('stream subject mismatch');
+      bound=true;setState('OBSERVING','ok');line('CONNECT','exact-subject stream bound; DoD remains unproven');
+    }catch(err){source.close();hold(err.message);}});
+    source.onmessage=e=>{if(current!==generation)return;try{
+      const event=JSON.parse(e.data);
+      if(!bound||event.schema!=='qikvrt_temdd_event_v1'||!sameSubject(event.subject,exactSubject)||event.id!==e.lastEventId||event.evidence_transfer!=='DENY'||event.dod!==false)throw Error('unbound or invalid event');
+      const next=sequence(event.id);if(cursor&&next<=sequence(cursor))throw Error('non-monotonic event');
+      if(!/^(OBSERVE|CLASSIFY|ACTION|EFFECT|READBACK|SUCCESSOR|HOLD)$/.test(event.kind)||typeof event.message!=='string')throw Error('invalid event content');
+      line(event.kind,event.message+' · '+event.subject.head+' · '+event.id);
+      localStorage.setItem(cursorKey,event.id);cursor=event.id;cursorEl.textContent=cursor;
+    }catch(err){source.close();hold(err.message);}};
+    source.addEventListener('hold',()=>{if(current===generation){source.close();hold('producer readback unavailable; fresh reconnect required');}});
+    source.onerror=()=>{if(current===generation){bound=false;hold('transport unavailable; native EventSource reconnect retains its cursor; repository execution unchanged');}};
+  }catch(err){if(current===generation)hold(err.message);}
+}
+document.getElementById('reconnect').onclick=connect;connect();
+</script></body></html>
diff --git a/examples/temdd/qikvrt_convergence_v0_1.temdd b/examples/temdd/qikvrt_convergence_v0_1.temdd
new file mode 100644
index 0000000000000000000000000000000000000000..da48c8812b3227758c09d1c0a2d2bedcd7b27242
--- /dev/null
+++ b/examples/temdd/qikvrt_convergence_v0_1.temdd
@@ -0,0 +1,23 @@
+temdd 0.1;
+authority owner = "Goldkelch/qik-vrt";
+subject convergence {
+  repository = "Goldkelch/qik-vrt";
+  binding = exact;
+}
+request finish_qikvrt { target = QIKVRT_DOD; }
+on event {
+  follow exact;
+  classify causal;
+}
+on blocker {
+  learn smallest_sound_successor;
+  execute successor;
+}
+until {
+  ZERO_BUGS
+  && ALL_PULL_REQUESTS_REGARDED
+  && ALL_BRANCHES_REGARDED
+  && ALL_PRODUCTIVE_BRANCHES_MERGED
+  && FRESH_EXACT_MAIN_VALIDATION_PASS
+  && FRESH_EFFECT_READBACK;
+}
diff --git a/formalization/TEMDDCore.lean b/formalization/TEMDDCore.lean
new file mode 100644
index 0000000000000000000000000000000000000000..8277b5c1f5a6aa4dde8751f098090e981bb002b9
--- /dev/null
+++ b/formalization/TEMDDCore.lean
@@ -0,0 +1,19 @@
+namespace QIKVRT.TEMDD
+inductive State where | hold | continue | successorRequired | done deriving DecidableEq
+inductive Event where | unknown | evidence | blocker deriving DecidableEq
+def transition : State -> Event -> State
+| State.done, _ => State.done
+| _, Event.blocker => State.successorRequired
+| _, Event.evidence => State.continue
+| _, Event.unknown => State.hold
+structure DoD where
+ zeroBugs : Bool
+ allPullRequestsRegarded : Bool
+ allBranchesRegarded : Bool
+ allProductiveBranchesMerged : Bool
+ freshExactMainValidationPass : Bool
+ freshEffectReadback : Bool
+def complete (d : DoD) : Bool := d.zeroBugs && d.allPullRequestsRegarded && d.allBranchesRegarded && d.allProductiveBranchesMerged && d.freshExactMainValidationPass && d.freshEffectReadback
+theorem blocker_requires_successor (s : State) (h : s != State.done) : transition s Event.blocker = State.successorRequired := by cases s <;> simp [transition] at h ⊢
+theorem missing_effect_readback_not_done (d : DoD) (h : d.freshEffectReadback = false) : complete d = false := by simp [complete, h]
+end QIKVRT.TEMDD
diff --git a/include/temdd_core.h b/include/temdd_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..79efe5deadd70206ce313b2d0e138d72087e350a
--- /dev/null
+++ b/include/temdd_core.h
@@ -0,0 +1,7 @@
+#ifndef QIKVRT_TEMDD_CORE_H
+#define QIKVRT_TEMDD_CORE_H
+typedef enum { TEMDD_HOLD=0, TEMDD_CONTINUE=1, TEMDD_SUCCESSOR_REQUIRED=2, TEMDD_DONE=3 } temdd_state;
+typedef enum { TEMDD_EVENT_UNKNOWN=0, TEMDD_EVENT_EVIDENCE=1, TEMDD_EVENT_BLOCKER=2 } temdd_event;
+temdd_state temdd_transition(temdd_state state, temdd_event event);
+int temdd_done(const int predicates[6]);
+#endif
diff --git a/runtime/m68000/temdd_transition.s b/runtime/m68000/temdd_transition.s
new file mode 100644
index 0000000000000000000000000000000000000000..989dbc2c93c6835d9c94c85bf4ab854db97cf50f
--- /dev/null
+++ b/runtime/m68000/temdd_transition.s
@@ -0,0 +1,15 @@
+; TEMDD v0.1 fixed-relation transition kernel, Motorola 68000
+; D0 = event: 0 unknown, 1 evidence, 2 blocker
+; returns D0 = state: 0 HOLD, 1 CONTINUE, 2 SUCCESSOR_REQUIRED
+        cmpi.b  #2,d0
+        beq.s   .blocker
+        cmpi.b  #1,d0
+        beq.s   .evidence
+        moveq   #0,d0
+        rts
+.evidence:
+        moveq   #1,d0
+        rts
+.blocker:
+        moveq   #2,d0
+        rts
diff --git a/runtime/temdd/TEMDDRuntime.st b/runtime/temdd/TEMDDRuntime.st
new file mode 100644
index 0000000000000000000000000000000000000000..6a77ac84186aad8b87c5898a4e4cfcd8332c9b22
--- /dev/null
+++ b/runtime/temdd/TEMDDRuntime.st
@@ -0,0 +1,18 @@
+"TEMDD v0.1 live Smalltalk semantic kernel. Source form is intentionally image-independent."
+Object subclass: #TEMDDRuntime
+    instanceVariableNames: ''
+    classVariableNames: ''
+    poolDictionaries: ''
+    category: 'QIKVRT-TEMDD'.
+
+TEMDDRuntime class >> transitionFor: event state: state
+    "Finite event transition. HOLD/CONTINUE are never NOOP."
+    (state = #done) ifTrue: [ ^ #done ].
+    (event = #blocker) ifTrue: [ ^ #successorRequired ].
+    (event = #evidence) ifTrue: [ ^ #continue ].
+    ^ #hold.
+
+TEMDDRuntime class >> doneForPredicates: predicates
+    | required |
+    required := #(ZERO_BUGS ALL_PULL_REQUESTS_REGARDED ALL_BRANCHES_REGARDED ALL_PRODUCTIVE_BRANCHES_MERGED FRESH_EXACT_MAIN_VALIDATION_PASS FRESH_EFFECT_READBACK).
+    ^ required allSatisfy: [ :each | predicates includes: each ].
