-{
-  "publication_id": "qikvrt-temdd-technical-evolution-v1",
-  "claim_count": 7,
-  "claims": [
-    {
-      "claim_id": "TEMDD-DECL-001",
-      "statement": "Ingolf Lohmann declares that he transformed Tested Event Model Driven Development from a development method into an executable language with development, debugging, test, linking and effect-verification runtime, and declares this his decisive technical-evolution step.",
-      "classification": "NORMATIVE",
-      "status": "DECLARED",
-      "boundary": "Author declaration by Ingolf Lohmann; not an independent legal or worldwide priority adjudication.",
-      "proof_refs": [],
-      "sources": []
-    },
-    {
-      "claim_id": "TEMDD-EXEC-001",
-      "statement": "The QIK-VRT repository specifies TEMDD as an executable metaprogramming language with explicit lifecycle, conformance and backend semantics.",
-      "classification": "SOURCE_BOUND",
-      "status": "BOUND",
-      "boundary": "Bound to the exact repository source identified by TEMDD-LANG-SPEC; no broader adoption claim is made.",
-      "proof_refs": [],
-      "sources": [
-        "TEMDD-LANG-SPEC"
-      ]
-    },
-    {
-      "claim_id": "TEMDD-EVIDENCE-001",
-      "statement": "TEMDD separates transport, event, test and effect acknowledgement and requires fresh effect readback for terminal completion.",
-      "classification": "SOURCE_BOUND",
-      "status": "BOUND",
-      "boundary": "Bound to the exact TEMDD specification/declaration sources; no later-stage effect is inferred from an earlier stage.",
-      "proof_refs": [],
-      "sources": [
-        "TEMDD-LANG-SPEC",
-        "TEMDD-DECLARATION"
-      ]
-    },
-    {
-      "claim_id": "TEMDD-HW-001",
-      "statement": "TEMDD can be mapped architecturally to a pipeline of subject binding, authority resolution, execution, test, observation, readback, acceptance and effect-acknowledgement hardware blocks.",
-      "classification": "INTERPRETATIVE",
-      "status": "DECLARED",
-      "boundary": "Architecture interpretation and design proposal; not yet RTL-, FPGA- or ASIC-validated.",
-      "proof_refs": [],
-      "sources": [
-        "TEMDD-HARDWARE-MAP"
-      ]
-    },
-    {
-      "claim_id": "TEMDD-PERF-001",
-      "statement": "Dedicated FPGA or ASIC realization may reduce orchestration overhead and improve latency, throughput or energy efficiency for evidence-bearing state transitions, including artificial-cognition control paths.",
