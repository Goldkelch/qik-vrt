-    },
-    "event_type": {
-      "enum": [
-        "REQUEST",
-        "EXECUTE",
-        "FOLLOW",
-        "LEARN",
-        "OBSERVATION",
-        "VALIDATION",
-        "DECISION",
-        "EFFECT",
-        "READBACK",
-        "SUCCESSOR",
-        "HOLD"
