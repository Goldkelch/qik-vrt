-}
-
-static void put32(unsigned char *p, unsigned int n)
-{
-    p[0] = (unsigned char)(n >> 24U); p[1] = (unsigned char)(n >> 16U);
-    p[2] = (unsigned char)(n >> 8U); p[3] = (unsigned char)n;
