-                        "kind":delivery.kind,"wire_d4":delivery.d4,"session":t.session,"nonce":t.nonce,"message_id":t.message,
-                        "correlation":hex(&t.correlation),"codec":t.codec,"payload_hex":hex(&t.body),"ordinary_release":false}),
