-        }
-        "discover" => output(&Store::open(Path::new(arg(2)?))?.discover(now())),
-        "history" => output(
-            &Store::open(Path::new(arg(2)?))?.history(
-                args.get(3)
-                    .map(|s| s.parse::<u64>())
-                    .transpose()
-                    .map_err(|e| e.to_string())?
-                    .unwrap_or(0),
