@@ -1,80 +0,0 @@
-{
-  "schema": "qik-vrt-cloud-transputer-v1",
-  "architecture": "MC68000",
-  "framework_principle": {
-    "name": "STAY_FAIL_CLOSED_KEEP_FUTURE_OPEN",
-    "statement": "Stay fail closed and keep future open!",
-    "scope": "QIK-VRT Tested Event Model Driven Development",
-    "temdd_cycle": ["REQUEST", "EXECUTE", "FOLLOW", "LEARN", "REPEAT_UNTIL_DONE"],
-    "fail_closed": "Missing, stale, contradictory, unbound, or insufficient evidence never becomes authority, release, completion, or effect.",
-    "future_open": "A fail-closed state preserves every admissible future continuation; it must not erase evidence, obligations, provenance, alternatives, or the possibility of a later freshly evidenced transition.",
-    "eye_in_the_storm": "Every effect-producing path retains an independent reobservation boundary: act without self-certifying the effect; reobserve from the declared evidence boundary before claiming completion.",
-    "return_path_closure": "The reverse path returns the original bound request plus every material descendant, produced artifact, observed effect, failure, repair, successor, and still-open obligation. Returned predecessor evidence remains provenance and is never transferred as proof for a mutated subject.",
-    "terminal_rule": "D.o.D. and EFFECT_ACK_DONE are admissible only after exact post-effect reobservation of every predicate in the declared completion scope.",
-    "invariants": [
-      "TRANSPORT_ACK != EFFECT_ACK",
-      "VERIFIED_IMPLEMENTATION != AUTHORITY_EFFECT",
-      "CAUSALITY != SEQUENCE",
-      "PREDECESSOR_EVIDENCE_TRANSFER=false",
-      "MUTATION_RESETS_DEPENDENT_EVIDENCE=true",
-      "FAIL_CLOSED_DOES_NOT_MEAN_FUTURE_CLOSED",
-      "RETURN_PATH_MUST_PRESERVE_MATERIAL_DESCENDANTS_AND_OPEN_OBLIGATIONS"
-    ]
-  },
-  "boundary_contract": {
-    "d0_width_bits": 2,
-    "d0_mask": 3,
-    "states": ["NOOP", "HOLD", "REOBSERVE", "REQUEST_AUTHORITY"],
-    "decision_codes": {"NOOP": 0, "HOLD": 1, "REOBSERVE": 2, "REQUEST_AUTHORITY": 3},
-    "binary_weights": [1, 2, 4],
-    "composition_rule": "3 = 1 + 2; weight 4 opens the next orthogonal composition dimension without redefining D0[1:0]",
-    "register_binding": {
-      "D0": "low two bits are the invariant QIK-VRT/TEMDD boundary decision",
-      "D1": "channel/session id",
-      "D2": "freshness marker / nonce",
-      "D3": "source-node id / capability context",
-      "D4": "effect-ack protocol state",
-      "A0": "request payload pointer",
-      "A1": "receipt output pointer"
-    }
-  },
-  "effect_ack_protocol": {
-    "states": ["EFFECT_NACK", "EFFECT_ACK_CONTINUE", "EFFECT_ACK_ISOLATE", "EFFECT_ACK_BLOCK", "EFFECT_ACK_DONE"],
-    "state_codes": {"EFFECT_NACK": 0, "EFFECT_ACK_CONTINUE": 1, "EFFECT_ACK_ISOLATE": 2, "EFFECT_ACK_BLOCK": 3, "EFFECT_ACK_DONE": 4},
-    "register": "D4",
-    "ordinary_release": "EFFECT_ACK_DONE only"
-  },
-  "wire_protocol": {
-    "schema": "QIKVRT_WIRE_V1",
-    "version": 1,
-    "byte_order": "big-endian",
-    "header_bytes": 84,
-    "trailer_bytes": 4,
-    "max_payload_bytes": 4096,
-    "directions": {"FORWARD": 0, "REVERSE": 1},
-    "message_types": {"REQUEST": 1, "RESPONSE": 2, "RECEIPT": 3, "REOBSERVATION": 4},
-    "header_fields": ["magic", "version", "direction", "type", "flags", "D0", "D4", "header_size", "session_id", "nonce", "source_node", "virtual_time_hi", "virtual_time_lo", "message_id", "chunk_index", "chunk_count", "payload_length", "payload_sha256", "header_fnv1a32"],
-    "trailer": "frame_fnv1a32 over header plus payload",
-    "payload_integrity": "SHA-256",
-    "chunking": "message_id plus zero-based chunk_index/chunk_count; each frame is independently bounded and verified",
-    "receipt_binding": "reverse RECEIPT repeats session_id, nonce, message_id, chunk_index and chunk_count and carries SHA-256(request_frame) as payload",
-    "release_rule": "a transport roundtrip never implies EFFECT_ACK_DONE; the bounded reference witness emits D4=EFFECT_ACK_DONE only after decode, local state application, contract verification and post-apply byte reobservation",
-    "general_effect_ack_done": false
-  },
-  "function_codes": [
-    {"fc": 1, "domain": "user-data"}, {"fc": 2, "domain": "user-program"}, {"fc": 5, "domain": "supervisor-data"}, {"fc": 6, "domain": "supervisor-program"}, {"fc": 7, "domain": "interrupt-acknowledge"}
-  ],
-  "interrupt_model": {"levels": [1,2,3,4,5,6,7], "autovector": true, "level_7_non_maskable": true},
-  "exception_model": {"supervisor_state": {"S": 1}, "stack_banks": ["USP", "SSP"], "exception_frame_fields": ["SR", "PC"], "return_instruction": "RTE"},
-  "task_frame": {"saved_registers": ["D0","D1","D2","D3","D4","D5","D6","D7","A0","A1","A2","A3","A4","A5","A6","USP","SR","PC"]},
-  "overlay_model": {"banks": 4, "switch_register": "QIKVRT_OVERLAY_CTRL", "fence_required": true, "instruction_prefetch_flush": true, "decision_link": "ordinary release is allowed only from stable EFFECT_ACK_DONE"},
-  "ip_bootstrap": {"subnet": "10.73.0.0/24", "discovery_port": 7331, "server_ip": "10.73.0.1", "client_ip": "10.73.0.2", "file_id": 1, "binary": "QIKVRT_BOOT.BIN", "timeout_seconds": 2, "retries": 3, "chunk_bytes": 128, "checksum": "FNV1A32", "route": ["discover","offer","request","data","done"]},
-  "effect_boundary": {
-    "transport_ack_not_effect_ack": true,
-    "content_ack_signals": ["parse-complete", "checksum-complete", "bounded-range-check-complete"],
-    "semantic_effect_signals": ["requested state transition applied", "contract verification passed", "post-apply state re-observed"],
-    "note": "No protocol label establishes physical correspondence, quantum identity, or empirical model closure."
-  },
-  "logic_0124_source_status": "RECOVERED_FROM_OWNER_MATERIAL",
-  "logic_0124_note": "0 is the unset state; 1,2,4 are orthogonal binary weights. D0[1:0] carries 0..3, with 3 composed as 1+2. Bit weight 4 extends composition context and must not redefine the four D0 boundary meanings."
-}
