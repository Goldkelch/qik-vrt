-<html lang="de"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
-<title>QIK-VRT · Transputer und TEMDD</title>
-<style>
-:root{font:16px system-ui;color:#dce6f1;background:#101a25;color-scheme:dark}body{margin:0 auto;max-width:1160px;padding:36px 24px}h1{font-size:32px;margin-bottom:8px}h2{font-size:19px}p{line-height:1.6;color:#aebed0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}section{background:#182635;padding:22px;border:1px solid #304356;border-radius:12px;margin:22px 0}textarea,pre{font:13px/1.6 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere}textarea{box-sizing:border-box;width:100%;min-height:290px;background:#0e1822;border:1px solid #506479;padding:14px;color:#edf4ff;border-radius:6px}button{background:#83d7ba;color:#09251b;border:0;border-radius:6px;padding:11px 18px;cursor:pointer;margin:12px 8px 0 0;font-weight:600}button:focus-visible,textarea:focus-visible{outline:3px solid #e8bb79}pre{max-height:400px;overflow:auto}#status{color:#83d7ba}small{color:#aebed0}@media(max-width:800px){.grid{display:block}}
-</style>
-<body><small>INGOLF LOHMANN · QIK-VRT ZIELARCHITEKTUR</small>
-<h1>Der Transputer bleibt auffindbar.</h1>
-<p>Identität, Quellstand und Verlauf bleiben erhalten, wenn eine Verbindung abbricht. Ein alter Prüfstand wird dabei als Historie geführt.</p>
-<div id="status" role="status">Verzeichnis wird geladen …</div>
-<section><h2>Komponenten und Wiederanlauf</h2><button id="refresh">Verzeichnis aktualisieren</button><pre id="directory"></pre></section>
-<div class="grid"><section><h2>TEMDD-Quelltext</h2><label for="source">Programm zur Prüfung und IR-Erzeugung</label>
-<textarea id="source" spellcheck="false">temdd 0.1;
-authority owner = "Ingolf Lohmann";
-subject transputer {
-  repository = "ingolf-lohmann/qik-vrt";
-  binding = exact;
-}
-request preserve { target = CONTINUITY; }
-on event { follow exact; classify causal; }
-on blocker {
-  learn smallest_sound_successor;
-  execute successor;
-}
-until { IDENTITY_RETAINED &amp;&amp; HISTORY_RETAINED; }</textarea>
-<button id="compile">Prüfen und IR erzeugen</button><p>Die Prüfung führt keine angeforderten Außenwirkungen aus.</p>
-</section><section><h2>IR und Diagnose</h2><pre id="ir" aria-live="polite">Noch kein Programm geprüft.</pre></section></div>
-<section><h2>Gebundener Ereignisverlauf</h2><pre id="events"></pre><small>Die ersten 128 Einträge. Der vollständige Verlauf ist über den CLI-Replay-Cursor abrufbar.</small></section>
-<script>
-const el=id=>document.getElementById(id);const show=(id,v)=>{el(id).textContent=JSON.stringify(v,null,2)};
-async function request(path,options){const r=await fetch(path,options);const v=await r.json();if(!r.ok)throw new Error(v.reason||r.status);return v}
-async function refresh(){try{const d=await request('/api/directory');show('directory',d);show('events',await request('/api/events'));el('status').textContent=`${d.node_count} bekannte Komponenten · ${d.checkpoint.sequence} dauerhaft gespeicherte Ereignisse`}catch(e){el('status').textContent='Verbindung unterbrochen: '+e.message}}
-el('refresh').onclick=refresh;el('compile').onclick=async()=>{try{show('ir',await request('/api/compile',{method:'POST',headers:{'Content-Type':'text/plain'},body:el('source').value}))}catch(e){el('ir').textContent=e.message}};refresh();
-</script></body></html>
diff --git a/policy/QIKVRT_BINARY_PROGRESS_CLOSURE_V1.json b/policy/QIKVRT_BINARY_PROGRESS_CLOSURE_V1.json
deleted file mode 100644
index b4f94956d4b391477adaa4222d515d7de6b83c22..0000000000000000000000000000000000000000
--- a/policy/QIKVRT_BINARY_PROGRESS_CLOSURE_V1.json
+++ /dev/null
@@ -1,39 +0,0 @@
-{
-  "schema": "QIKVRT_BINARY_PROGRESS_CLOSURE_V1",
-  "purpose": "Make progress total: every observed exact-subject state is either terminal or has exactly one admissible continuation.",
-  "states": {
-    "0": "TERMINAL_NO_WORK",
-    "1": "CONTINUATION_REQUIRED"
-  },
-  "invariants": [
-    "work_remaining => continuation_required",
-    "continuation_required => admissible_action_count == 1",
-    "stale_canonical_integrity => action == CANONICAL_INTEGRITY_CLOSURE",
-    "canonical_integrity_closure => successor_required",
-    "successor_created => fresh_successor_local_validation_required",
-    "fresh_validation_reset_is_transition_not_terminal_state",
-    "external_authority_required => event_subscription_required",
-    "external_authority_required => synthetic_authority_forbidden",
-    "no_predecessor_evidence_transfer"
-  ],
-  "forbidden_states": [
-    "work_remaining && action == NONE",
-    "stale_canonical_integrity && state == HOLD && action == NONE",
-    "successor_created && fresh_validation == NONE",
-    "event_required && subscription == NONE",
-    "reset && terminal"
-  ],
-  "closure": {
-    "technical_gap": "materialize_one_bounded_successor_then_validate_fresh",
-    "authority_gap": "subscribe_to_native_event_then_reobserve_exact_subject",
-    "no_gap": "TERMINAL_NO_WORK"
-  },
-  "fixed_point": "work_remaining == false",
-  "non_claims": [
-    "review approval",
-    "Main integration",
-    "deployment",
-    "publication",
-    "EFFECT_ACK_DONE"
-  ]
-}
diff --git a/policy/QIKVRT_CLOUD_TRANSPUTER_V1.json b/policy/QIKVRT_CLOUD_TRANSPUTER_V1.json
deleted file mode 100644
