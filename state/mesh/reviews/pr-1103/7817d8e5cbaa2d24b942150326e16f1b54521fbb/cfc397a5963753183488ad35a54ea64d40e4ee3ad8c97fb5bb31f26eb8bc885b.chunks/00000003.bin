-#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
-pub struct Program {
-    pub schema: String,
-    pub version: String,
-    pub authority: String,
-    pub subject: SubjectDecl,
-    pub request: RequestDecl,
-    pub handlers: Vec<Handler>,
-    pub dod: Vec<String>,
-}
