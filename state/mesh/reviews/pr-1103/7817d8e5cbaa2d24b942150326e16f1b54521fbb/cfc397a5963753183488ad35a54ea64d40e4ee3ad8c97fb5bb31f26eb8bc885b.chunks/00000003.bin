diff --git a/schemas/temdd-ir-v0.1.schema.json b/schemas/temdd-ir-v0.1.schema.json
index e7654624f586e2e86b9dcafe84b04a77c4c8452a..2b205182c5ebef4f9afe5389c3400c92423f76ad 100644
--- a/schemas/temdd-ir-v0.1.schema.json
+++ b/schemas/temdd-ir-v0.1.schema.json
@@ -1,13 +1,178 @@
 {
- "$schema":"https://json-schema.org/draft/2020-12/schema",
- "$id":"https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v0.1.schema.json",
- "title":"TEMDD canonical IR v0.1","type":"object","additionalProperties":false,
- "required":["schema","version","authority","subject","request","handlers","dod"],
- "properties":{
-  "schema":{"const":"temdd_ir_v0_1"},"version":{"const":"0.1"},"authority":{"type":"string","minLength":1},
-  "subject":{"type":"object","additionalProperties":false,"required":["name","repository","binding"],"properties":{"name":{"type":"string"},"repository":{"type":"string"},"binding":{"const":"exact"}}},
-  "request":{"type":"object","additionalProperties":false,"required":["name","target"],"properties":{"name":{"type":"string"},"target":{"type":"string"}}},
-  "handlers":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["event","statements"],"properties":{"event":{"enum":["event","blocker"]},"statements":{"type":"array","items":{"type":"string"}}}}},
-  "dod":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
+ "$schema": "https://json-schema.org/draft/2020-12/schema",
+ "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v0.1.schema.json",
+ "title": "TEMDD canonical IR v0.1",
+ "type": "object",
+ "additionalProperties": false,
+ "required": [
+  "schema",
+  "version",
+  "authority",
+  "context",
+  "subject",
+  "relations",
+  "request",
+  "handlers",
+  "dod"
+ ],
+ "properties": {
+  "schema": {
+   "const": "temdd_ir_v0_1"
+  },
+  "version": {
+   "const": "0.1"
+  },
+  "authority": {
+   "type": "string",
+   "minLength": 1
+  },
+  "context": {
+   "type": "object",
+   "additionalProperties": false,
+   "required": [
+    "name",
+    "perspective"
+   ],
+   "properties": {
+    "name": {
+     "type": "string",
+     "minLength": 1
+    },
+    "perspective": {
+     "type": "string",
+     "minLength": 1
+    }
+   }
+  },
+  "subject": {
+   "type": "object",
+   "additionalProperties": false,
+   "required": [
+    "name",
+    "repository",
+    "binding"
+   ],
+   "properties": {
+    "name": {
+     "type": "string"
+    },
+    "repository": {
+     "type": "string"
+    },
+    "binding": {
+     "const": "exact"
+    }
+   }
+  },
+  "relations": {
+   "type": "array",
+   "minItems": 1,
+   "items": {
+    "type": "object",
+    "additionalProperties": false,
+    "required": [
+     "name",
+     "source",
+     "predicate",
+     "target",
+     "epistemic",
+     "source_order",
+     "observation_order",
+     "freshness"
+    ],
+    "properties": {
+     "name": {
+      "type": "string",
+      "minLength": 1
+     },
+     "source": {
+      "type": "string",
+      "minLength": 1
+     },
+     "predicate": {
+      "type": "string",
+      "minLength": 1
+     },
+     "target": {
+      "type": "string",
+      "minLength": 1
+     },
+     "epistemic": {
+      "enum": [
+       "TRUE",
+       "FALSE",
+       "UNKNOWN",
+       "CONFLICT",
+       "STALE",
+       "UNOBSERVABLE"
+      ]
+     },
+     "source_order": {
+      "type": "integer",
+      "minimum": 0
+     },
+     "observation_order": {
+      "type": "integer",
+      "minimum": 0
+     },
+     "freshness": {
+      "enum": [
+       "FRESH",
+       "STALE"
+      ]
+     }
+    }
+   }
+  },
+  "request": {
+   "type": "object",
+   "additionalProperties": false,
+   "required": [
+    "name",
+    "target"
+   ],
+   "properties": {
+    "name": {
+     "type": "string"
+    },
+    "target": {
+     "type": "string"
+    }
+   }
+  },
+  "handlers": {
+   "type": "array",
+   "minItems": 1,
+   "items": {
+    "type": "object",
+    "additionalProperties": false,
+    "required": [
+     "event",
+     "statements"
+    ],
+    "properties": {
+     "event": {
+      "enum": [
+       "event",
+       "blocker"
+      ]
+     },
+     "statements": {
+      "type": "array",
+      "items": {
+       "type": "string"
+      }
+     }
+    }
+   }
+  },
+  "dod": {
+   "type": "array",
+   "minItems": 1,
+   "uniqueItems": true,
+   "items": {
+    "type": "string"
+   }
+  }
  }
 }
