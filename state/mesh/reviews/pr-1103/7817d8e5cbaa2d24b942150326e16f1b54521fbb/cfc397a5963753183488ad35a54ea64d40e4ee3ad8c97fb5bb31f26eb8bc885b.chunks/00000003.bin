-        blocks += re.findall(r'^        run: (?!\|)(.+)$', WORKFLOW.read_text(), re.M)
-        self.assertGreaterEqual(len(blocks), 16)
-        for block in blocks:
-            result = subprocess.run(['bash', '-n'], input=textwrap.dedent(block), text=True, capture_output=True)
