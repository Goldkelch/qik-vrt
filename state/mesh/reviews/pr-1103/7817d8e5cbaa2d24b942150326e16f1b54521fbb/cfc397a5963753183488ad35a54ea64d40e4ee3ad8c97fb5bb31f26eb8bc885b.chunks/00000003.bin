-                    let frames = if op == "send" {
-                        serial = serial.checked_add(1).ok_or("PEER_SEQUENCE_EXHAUSTED")?;
-                        exchange::frames(&b, codec, &body, session, serial, serial, false)
-                            .map_err(str::to_owned)?
