-    char *end;
-    int fd, output, rc, length;
-    ssize_t written;
-    time_t deadline;
-    if (argc != 6) {
-        fprintf(stderr, "usage: %s SERVER_IPV4 PORT OUTPUT EXPECTED_SHA256 NONCE\n", argv[0]);
-        return 64;
-    }
-    port = strtoul(argv[2], &end, 10);
