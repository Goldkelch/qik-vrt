diff --git a/docs/terminal/FIREFOX_EFFECT_ACK_TERMINAL_PROXY_V1.md b/docs/terminal/FIREFOX_EFFECT_ACK_TERMINAL_PROXY_V1.md
index a5a53f7fd00d27a963247b1afb27666f768e9cfa..a3d5b4737acbf28b854e15108e1d33dfbe22e582 100644
--- a/docs/terminal/FIREFOX_EFFECT_ACK_TERMINAL_PROXY_V1.md
