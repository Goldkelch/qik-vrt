-static qikvrt_u32 g32(const unsigned char*p){return ((qikvrt_u32)p[0]<<24U)|((qikvrt_u32)p[1]<<16U)|((qikvrt_u32)p[2]<<8U)|(qikvrt_u32)p[3];}
-static void block(qikvrt_u32 s[8],const unsigned char b[64]){
