+++ b/examples/temdd/temdd_self_application_v0_1.temdd
@@ -0,0 +1,17 @@
+temdd 0.1;
+authority owner = "Goldkelch/qik-vrt";
+context language { perspective = "temdd-bootstrap"; }
+subject temdd_language { repository = "Goldkelch/qik-vrt"; binding = exact; }
+relation self_application {
+  source = "TEMDD";
+  predicate = "describes";
+  target = "TEMDD";
+  epistemic = UNKNOWN;
+  source_order = 1;
+  observation_order = 1;
+  freshness = FRESH;
+}
+request validate_temdd { target = TEMDD_BOOTSTRAP_DOD; }
+on event { follow exact; classify causal; }
+on blocker { learn smallest_sound_successor; execute successor; }
+until { T01_T16_EXECUTABLE && IDE_EXECUTABLE_LOCAL_ANALYSIS && DIFFERENTIAL_BACKENDS && LEAN_OBLIGATIONS && DETERMINISTIC_INTEGRITY && FRESH_EFFECT_READBACK; }
