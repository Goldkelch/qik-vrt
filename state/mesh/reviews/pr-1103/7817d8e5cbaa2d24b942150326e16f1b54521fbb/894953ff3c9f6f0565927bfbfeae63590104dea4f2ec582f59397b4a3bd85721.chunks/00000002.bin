+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-conformance-report-v1.schema.json",
+  "title": "TEMDD exact-subject conformance report v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema","temdd_conformance","implementation","suite","language","ir","ide",
+    "event_semantics","ledger","evidence_binding","causality","effect_ack",
+    "formal_invariants","tests","negative_vectors","backends","overall",
+    "predecessor_evidence_transfer","stable_language_claim","main_adoption",
+    "production_effect","effect_ack_done"
+  ],
+  "properties": {
+    "schema":{"const":"temdd_conformance_report_v1"},
+    "temdd_conformance":{"const":"1"},
+    "implementation":{
+      "type":"object","additionalProperties":false,
+      "required":["repository","head","tree","digest"],
+      "properties":{
+        "repository":{"type":"string","minLength":3},
+        "head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
+        "tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},
+        "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
+      }
+    },
+    "suite":{
+      "type":"object","additionalProperties":false,
+      "required":["version","digest","files"],
+      "properties":{
+        "version":{"const":"1"},
+        "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
+        "files":{"type":"array","minItems":1}
+      }
+    },
+    "language":{"const":"PASS"},
+    "ir":{"const":"PASS"},
+    "ide":{"const":"PASS"},
+    "event_semantics":{"const":"PASS"},
+    "ledger":{"const":"PASS"},
+    "evidence_binding":{"const":"PASS"},
+    "causality":{"const":"PASS"},
+    "effect_ack":{"const":"PASS"},
+    "formal_invariants":{"const":"PASS"},
+    "tests":{"const":"PASS"},
+    "negative_vectors":{"const":"PASS"},
+    "backends":{"type":"object","minProperties":4},
+    "overall":{"const":"PASS"},
+    "predecessor_evidence_transfer":{"const":false},
+    "stable_language_claim":{"const":false},
+    "main_adoption":{"const":false},
+    "production_effect":{"const":false},
+    "effect_ack_done":{"const":false}
+  }
+}
diff --git a/schemas/temdd-event-v1.schema.json b/schemas/temdd-event-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..335bf5f3a588f2ef7c4ec3f0fb6a78c9ff5f5a27
--- /dev/null
+++ b/schemas/temdd-event-v1.schema.json
@@ -0,0 +1,36 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-event-v1.schema.json",
+  "title": "TEMDD canonical event IR v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema","event_id","event_type","subject_id","subject_repository","subject_pr",
+    "subject_head","subject_tree","producer","producer_event_id","timestamp","emitted_at",
+    "source_order","observation_order","cause_event_ids","inputs","outputs","evidence_refs",
+    "decision","content_digest","evidence_transfer"
+  ],
+  "properties": {
+    "schema": {"const": "temdd_event_ir_v1"},
+    "event_id": {"type": "string", "pattern": "^[0-9a-f]{32}:[1-9][0-9]{0,18}$"},
+    "event_type": {"enum": ["OBSERVE","CLASSIFY","ACTION","EFFECT","READBACK","SUCCESSOR","HOLD"]},
+    "subject_id": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
+    "subject_repository": {"type":"string","minLength":3},
+    "subject_pr": {"type":"integer","minimum":1},
+    "subject_head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
+    "subject_tree": {"type":"string","pattern":"^[0-9a-f]{40}$"},
+    "producer": {"enum":["repository","transputer"]},
+    "producer_event_id": {"type":"string","minLength":1},
+    "timestamp": {"type":"string","pattern":"Z$"},
+    "emitted_at": {"type":"string","pattern":"Z$"},
+    "source_order": {"type":"integer","minimum":0},
+    "observation_order": {"type":"integer","minimum":1},
+    "cause_event_ids": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
+    "inputs": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
+    "outputs": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
+    "evidence_refs": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
+    "decision": {"type":"string","minLength":1},
+    "content_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
+    "evidence_transfer": {"const":"DENY"}
+  }
+}
diff --git a/schemas/temdd-evidence-v1.schema.json b/schemas/temdd-evidence-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..448bd0e8ea7a48b6f5f9e40e3fe652bff852f5ce
--- /dev/null
+++ b/schemas/temdd-evidence-v1.schema.json
@@ -0,0 +1,43 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-evidence-v1.schema.json",
+  "title": "TEMDD canonical evidence IR v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema","evidence_id","evidence_type","observed_subject","producer_event",
+    "content_digest","freshness","epistemic","provenance","evidence_transfer"
+  ],
+  "properties": {
+    "schema":{"const":"temdd_evidence_ir_v1"},
+    "evidence_id":{"type":"string","minLength":1},
+    "evidence_type":{"type":"string","minLength":1},
+    "observed_subject":{
+      "type":"object","additionalProperties":false,
+      "required":["subject_id","repository","pr","head","tree"],
+      "properties":{
+        "subject_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
+        "repository":{"type":"string","minLength":3},
+        "pr":{"type":"integer","minimum":1},
+        "head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
+        "tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}
+      }
+    },
+    "producer_event":{"type":"string","pattern":"^[0-9a-f]{32}:[1-9][0-9]{0,18}$"},
+    "content_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
+    "freshness":{"enum":["FRESH","STALE"]},
+    "epistemic":{"enum":["TRUE","FALSE","UNKNOWN","CONFLICT","STALE","UNOBSERVABLE"]},
+    "provenance":{
+      "type":"object","additionalProperties":false,
+      "required":["producer","producer_event_id","source_order","observation_order","observed_at"],
+      "properties":{
+        "producer":{"enum":["repository","transputer"]},
+        "producer_event_id":{"type":"string","minLength":1},
+        "source_order":{"type":"integer","minimum":0},
+        "observation_order":{"type":"integer","minimum":1},
+        "observed_at":{"type":"string","pattern":"Z$"}
+      }
+    },
+    "evidence_transfer":{"const":"DENY"}
+  }
+}
diff --git a/schemas/temdd-ir-v0.1.schema.json b/schemas/temdd-ir-v0.1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..2b205182c5ebef4f9afe5389c3400c92423f76ad
--- /dev/null
+++ b/schemas/temdd-ir-v0.1.schema.json
@@ -0,0 +1,178 @@
+{
+ "$schema": "https://json-schema.org/draft/2020-12/schema",
+ "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v0.1.schema.json",
+ "title": "TEMDD canonical IR v0.1",
+ "type": "object",
+ "additionalProperties": false,
+ "required": [
+  "schema",
+  "version",
+  "authority",
+  "context",
+  "subject",
+  "relations",
+  "request",
+  "handlers",
+  "dod"
+ ],
+ "properties": {
+  "schema": {
+   "const": "temdd_ir_v0_1"
+  },
+  "version": {
+   "const": "0.1"
+  },
+  "authority": {
+   "type": "string",
+   "minLength": 1
+  },
+  "context": {
+   "type": "object",
+   "additionalProperties": false,
+   "required": [
+    "name",
+    "perspective"
+   ],
+   "properties": {
+    "name": {
+     "type": "string",
+     "minLength": 1
+    },
+    "perspective": {
+     "type": "string",
+     "minLength": 1
+    }
+   }
+  },
+  "subject": {
+   "type": "object",
+   "additionalProperties": false,
+   "required": [
+    "name",
+    "repository",
+    "binding"
+   ],
+   "properties": {
+    "name": {
+     "type": "string"
+    },
+    "repository": {
+     "type": "string"
+    },
+    "binding": {
+     "const": "exact"
+    }
+   }
+  },
+  "relations": {
+   "type": "array",
+   "minItems": 1,
+   "items": {
+    "type": "object",
+    "additionalProperties": false,
+    "required": [
+     "name",
+     "source",
+     "predicate",
+     "target",
+     "epistemic",
+     "source_order",
+     "observation_order",
+     "freshness"
+    ],
+    "properties": {
+     "name": {
+      "type": "string",
+      "minLength": 1
+     },
+     "source": {
+      "type": "string",
+      "minLength": 1
+     },
+     "predicate": {
+      "type": "string",
+      "minLength": 1
+     },
+     "target": {
+      "type": "string",
+      "minLength": 1
+     },
+     "epistemic": {
+      "enum": [
+       "TRUE",
+       "FALSE",
+       "UNKNOWN",
+       "CONFLICT",
+       "STALE",
+       "UNOBSERVABLE"
+      ]
+     },
+     "source_order": {
+      "type": "integer",
+      "minimum": 0
+     },
+     "observation_order": {
+      "type": "integer",
+      "minimum": 0
+     },
+     "freshness": {
+      "enum": [
+       "FRESH",
+       "STALE"
+      ]
+     }
+    }
+   }
+  },
+  "request": {
+   "type": "object",
+   "additionalProperties": false,
+   "required": [
+    "name",
+    "target"
+   ],
+   "properties": {
+    "name": {
+     "type": "string"
+    },
+    "target": {
+     "type": "string"
+    }
+   }
+  },
+  "handlers": {
+   "type": "array",
+   "minItems": 1,
+   "items": {
+    "type": "object",
+    "additionalProperties": false,
+    "required": [
+     "event",
+     "statements"
+    ],
+    "properties": {
+     "event": {
+      "enum": [
+       "event",
+       "blocker"
+      ]
+     },
+     "statements": {
+      "type": "array",
+      "items": {
+       "type": "string"
+      }
+     }
+    }
+   }
+  },
+  "dod": {
+   "type": "array",
+   "minItems": 1,
+   "uniqueItems": true,
+   "items": {
+    "type": "string"
+   }
+  }
+ }
+}
diff --git a/schemas/temdd-ir-v1.schema.json b/schemas/temdd-ir-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..38350f9340a4719c529f34e9cc9b0cbc966f9886
--- /dev/null
+++ b/schemas/temdd-ir-v1.schema.json
@@ -0,0 +1,22 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v1.schema.json",
+  "title": "TEMDD canonical program IR v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schema","ir_version","language_version","authority","context","subject","relations","request","handlers","dod","semantic_contract","effect_readback_required"],
+  "properties": {
+    "schema":{"const":"temdd_ir_v1"},
+    "ir_version":{"const":"1"},
+    "language_version":{"type":"string","minLength":1},
+    "authority":{"type":"string","minLength":1},
+    "context":{"type":"object","additionalProperties":false,"required":["name","perspective"],"properties":{"name":{"type":"string","minLength":1},"perspective":{"type":"string","minLength":1}}},
+    "subject":{"type":"object","additionalProperties":false,"required":["name","repository","binding"],"properties":{"name":{"type":"string","minLength":1},"repository":{"type":"string","minLength":1},"binding":{"const":"exact"}}},
+    "relations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","source","predicate","target","epistemic","source_order","observation_order","freshness"],"properties":{"name":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"predicate":{"type":"string","minLength":1},"target":{"type":"string","minLength":1},"epistemic":{"enum":["TRUE","FALSE","UNKNOWN","CONFLICT","STALE","UNOBSERVABLE"]},"source_order":{"type":"integer","minimum":0},"observation_order":{"type":"integer","minimum":0},"freshness":{"enum":["FRESH","STALE"]}}}},
+    "request":{"type":"object","additionalProperties":false,"required":["name","target"],"properties":{"name":{"type":"string","minLength":1},"target":{"type":"string","minLength":1}}},
+    "handlers":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["event","statements"],"properties":{"event":{"type":"string","minLength":1},"statements":{"type":"array","items":{"type":"string"}}}}},
+    "dod":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
+    "semantic_contract":{"type":"array","uniqueItems":true,"minItems":4,"maxItems":4,"items":{"enum":["T13_CAUSAL_BINDING","T14_EVIDENCE_NON_TRANSFER","T15_EFFECT_CONSTRUCTION","T16_CONFORMANCE_BINDING"]}},
+    "effect_readback_required":{"type":"boolean"}
+  }
+}
diff --git a/spec/temdd/README.md b/spec/temdd/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..6090d204f6ee53a4337e683a7c350c5ef06220a2
--- /dev/null
+++ b/spec/temdd/README.md
@@ -0,0 +1,22 @@
+# TEMDD
+
+Tested Event Model Driven Development is specified here as an executable QIK-VRT metaprogramming language.
+
+Entry points:
+- `TEMDD_LANGUAGE_SPEC_V0_1.md` — normative bootstrap semantics.
+- `TEMDD_NORMATIVE_T13_T16_V0_1.json` — dual-order, epistemic, context and representation closure.
+- `TEMDD_Syntax_V0_1.ebnf` — grammar.
+- `../../schemas/temdd-ir-v0.1.schema.json` — canonical IR contract.
+- `../../tools/qikvrt_temdd.py` — deterministic reference parser/elaborator.
+- `../../tools/qikvrt_temdd_conformance.py` — executable T01-T16 semantic checks.
+- `../../tests/temdd/` — positive and fail-closed negative corpus.
+- `../../runtime/temdd/TEMDDRuntime.st` — Smalltalk live-object backend bootstrap.
+- `../../src/temdd_core.c` — C90 deterministic backend.
+- `../../runtime/m68000/temdd_transition.s` — fixed-relation M68000 backend bootstrap.
+- `../../formalization/TEMDDCore.lean` — transition/DoD formal obligations.
+- `../../formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/TEMDD/` — completion, typed meta-grammar, T13-T16 and axiom-audit kernels.
+- `../../docs/terminal/temdd/index.html` — editable fail-closed TEMDD IDE in the Universal Terminal.
+- `../../examples/temdd/qikvrt_convergence_v0_1.temdd` — first dogfood production program.
+- `../../examples/temdd/temdd_self_application_v0_1.temdd` — bounded self-description bootstrap; not compiler self-hosting.
+
+Language evolution is itself TEMDD: mutation creates a new exact subject; predecessor validation does not transfer; the successor must pass fresh conformance and deployment readback.
diff --git a/spec/temdd/TEMDD_ARCHITECTURE_V0_1.md b/spec/temdd/TEMDD_ARCHITECTURE_V0_1.md
new file mode 100644
index 0000000000000000000000000000000000000000..31c772a76c1e904e9211b7036570df953698156b
--- /dev/null
+++ b/spec/temdd/TEMDD_ARCHITECTURE_V0_1.md
@@ -0,0 +1,7 @@
+# TEMDD architecture v0.1
+
+TEMDD is the single normative semantic core. Python, Smalltalk, C90, M68000, Lean, GitHub Actions and deployment systems are projections or adapters, not independent control-plane semantics.
+
+The architecture is layered: language source; deterministic frontend; canonical typed IR; semantic conformance; backend projections; transport adapters; effect executors; readback observers. Only the semantic core decides status. Transport layers may deliver events but may not synthesize authority, evidence, DONE or EFFECT_ACK.
+
+This separation permits gradual replacement of duplicated Python/YAML control logic while preserving observable behavior through shared vectors and exact-subject evidence.
