+FROM debian:bookworm-slim AS qikvrt-m68k-builder
+ENV DEBIAN_FRONTEND=noninteractive
 RUN apt-get update && apt-get install -y --no-install-recommends \
-      ca-certificates firefox-esr python3 python3-minimal git zip \
-      xvfb x11vnc novnc websockify dbus-x11 procps curl \
+      binutils-m68k-linux-gnu gcc libc6-dev gcc-m68k-linux-gnu libc6-dev-m68k-cross \
     && rm -rf /var/lib/apt/lists/*
+WORKDIR /src
+COPY deploy/universal-terminal/qikvrt_ip_bootstrap.c /src/qikvrt_ip_bootstrap.c
+COPY src/cloud_transputer/m68k_contract_probe.c /src/m68k_contract_probe.c
+RUN set -eux; \
+    mkdir -p /out/m68k; \
+    gcc -std=c90 -pedantic-errors -Wall -Wextra -Werror -O2 /src/qikvrt_ip_bootstrap.c -o /out/qikvrt-ip-bootstrap; \
+    m68k-linux-gnu-gcc -m68000 -std=c90 -pedantic-errors -Wall -Wextra -Werror -O2 -c /src/qikvrt_ip_bootstrap.c -o /out/m68k/qikvrt_ip_bootstrap.o; \
+    m68k-linux-gnu-gcc -m68000 -static -std=c90 -pedantic-errors -Wall -Wextra -Werror -O2 /src/m68k_contract_probe.c -o /out/qikvrt-m68k-selftest; \
+    m68k-linux-gnu-readelf -h /out/qikvrt-m68k-selftest > /out/m68k/qikvrt-m68k-selftest.readelf.txt; \
+    m68k-linux-gnu-objdump -dr /out/qikvrt-m68k-selftest > /out/m68k/qikvrt-m68k-selftest.objdump.txt; \
+    m68k-linux-gnu-readelf -h /out/m68k/qikvrt_ip_bootstrap.o > /out/m68k/qikvrt_ip_bootstrap.readelf.txt; \
+    sha256sum /out/qikvrt-m68k-selftest | awk '{print $1 "  /usr/local/bin/qikvrt-m68k-selftest"}' > /out/m68k/qikvrt-m68k-selftest.sha256; \
+    (cd /out/m68k && sha256sum qikvrt_ip_bootstrap.o > qikvrt_ip_bootstrap.sha256)
 
+FROM debian:bookworm-slim
+ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99 \
+    QIKVRT_HTTP_HOST=127.0.0.1 QIKVRT_HTTP_PORT=8771 QIKVRT_NOVNC_PORT=6080 \
+    QIKVRT_START_URL=http://qikvrt-gateway:8080/qik-vrt/mesh/v1/ \
+    QIKVRT_PROFILE_DIR=/var/lib/qikvrt/profile QIKVRT_STATE_DIR=/var/lib/qikvrt/state \
+    QIKVRT_RUNTIME_ID=qikvrt-firefox-terminal QIKVRT_SERVICE_MODE=terminal \
+    QIKVRT_MC68000_CC=m68k-linux-gnu-gcc QIKVRT_MC68000_RUNNER=qemu-m68k
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      bind9 binutils-m68k-linux-gnu ca-certificates curl dbus-x11 dnsutils firefox-esr git \
+      gcc-m68k-linux-gnu libc6-dev-m68k-cross make nginx-light novnc openssh-server \
+      postgresql postgresql-client procps python3 python3-minimal qemu-user snmp snmpd \
+      util-linux websockify x11-utils x11vnc xvfb zip \
+    && test -s /usr/share/novnc/vnc.html && test -s /usr/share/novnc/core/rfb.js \
+    && command -v m68k-linux-gnu-gcc && command -v qemu-m68k \
+    && rm -rf /var/lib/apt/lists/*
 WORKDIR /opt/qikvrt
 COPY . /opt/qikvrt
-
+COPY --from=qikvrt-m68k-builder /out/qikvrt-ip-bootstrap /usr/local/bin/qikvrt-ip-bootstrap
+COPY --from=qikvrt-m68k-builder /out/qikvrt-m68k-selftest /usr/local/bin/qikvrt-m68k-selftest
+COPY --from=qikvrt-m68k-builder /out/m68k /opt/qikvrt/runtime/m68k
 RUN mkdir -p /opt/qikvrt/runtime/bootstrap-profile/extensions /opt/qikvrt/runtime/logs \
-    /var/lib/qikvrt/profile /var/lib/qikvrt/state \
-    && cd browser/firefox/qikvrt-terminal \
-    && zip -qr /opt/qikvrt/runtime/bootstrap-profile/extensions/qikvrt-ai-terminal@goldkelch.local.xpi . \
-    && printf '%s\n' \
-      'user_pref("browser.shell.checkDefaultBrowser", false);' \
-      'user_pref("browser.startup.homepage", "https://arxiv.org/");' \
+    /var/lib/qikvrt/profile /var/lib/qikvrt/state /var/lib/qikvrt/smtp /var/lib/qikvrt/ssh \
+    /var/lib/qikvrt/postgres /var/lib/qikvrt/mirror /var/lib/qikvrt/personal-posix \
+    && (cd browser/firefox/qikvrt-terminal && zip -qr /opt/qikvrt/runtime/bootstrap-profile/extensions/qikvrt-ai-terminal@goldkelch.local.xpi .) \
+    && printf '%s\n' 'user_pref("browser.shell.checkDefaultBrowser", false);' \
+      'user_pref("browser.startup.homepage", "http://qikvrt-gateway:8080/qik-vrt/mesh/v1/");' \
       'user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);' \
       'user_pref("datareporting.policy.dataSubmissionEnabled", false);' \
       'user_pref("browser.sessionstore.resume_from_crash", true);' \
       > /opt/qikvrt/runtime/bootstrap-profile/user.js
-
 COPY deploy/universal-terminal/entrypoint.sh /usr/local/bin/qikvrt-universal-terminal
+COPY deploy/universal-terminal/cloud-entrypoint.sh /usr/local/bin/qikvrt-cloud-terminal
 COPY deploy/universal-terminal/runtime-health.sh /usr/local/bin/qikvrt-runtime-health
-RUN chmod +x /usr/local/bin/qikvrt-universal-terminal /usr/local/bin/qikvrt-runtime-health
-
-VOLUME ["/var/lib/qikvrt/profile", "/var/lib/qikvrt/state"]
-EXPOSE 6080
-HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
-  CMD ["/usr/local/bin/qikvrt-runtime-health"]
-
-ENTRYPOINT ["/usr/local/bin/qikvrt-universal-terminal"]
+COPY deploy/universal-terminal/service-entrypoint.sh /usr/local/bin/qikvrt-service-entrypoint
+COPY deploy/universal-terminal/mirror-bootstrap.sh /usr/local/bin/qikvrt-mirror-bootstrap
+COPY deploy/universal-terminal/qikvrt_smtpd.py /usr/local/bin/qikvrt-smtpd
+RUN chmod +x /usr/local/bin/qikvrt-* \
+    && python3 - <<'PY'
+import json
+p=json.load(open('/opt/qikvrt/policy/QIKVRT_CLOUD_TRANSPUTER_V1.json'))
+assert p['architecture']=='MC68000'
+assert p['boundary_contract']['decision_codes']=={'NOOP':0,'HOLD':1,'REOBSERVE':2,'REQUEST_AUTHORITY':3}
+assert p['boundary_contract']['binary_weights']==[1,2,4]
+assert p['effect_ack_protocol']['state_codes']=={'EFFECT_NACK':0,'EFFECT_ACK_CONTINUE':1,'EFFECT_ACK_ISOLATE':2,'EFFECT_ACK_BLOCK':3,'EFFECT_ACK_DONE':4}
+assert p['effect_ack_protocol']['register']=='D4'
+assert p['overlay_model']['banks']==4
+assert p['ip_bootstrap']['subnet']=='10.73.0.0/24'
+PY
+EXPOSE 6080 8080 8771 2222 2525 5353 9418 1161 5432 7331/udp
+HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 CMD ["/usr/local/bin/qikvrt-runtime-health"]
+ENTRYPOINT ["/usr/local/bin/qikvrt-service-entrypoint"]
diff --git a/deploy/universal-terminal/cloud-entrypoint.sh b/deploy/universal-terminal/cloud-entrypoint.sh
new file mode 100755
index 0000000000000000000000000000000000000000..3221caff1312c4a800f1f8b3332722c2500b8ba5
--- /dev/null
+++ b/deploy/universal-terminal/cloud-entrypoint.sh
@@ -0,0 +1,78 @@
+#!/bin/sh
+set -eu
+
+PIDS=""
+cleanup() {
+  for pid in $PIDS; do
+    kill "$pid" 2>/dev/null || true
+  done
+  for pid in $PIDS; do
+    wait "$pid" 2>/dev/null || true
+  done
+}
+trap cleanup EXIT
+trap 'exit 143' TERM
+trap 'exit 130' INT
+
+# A public cloud carrier is one container: keep the Effect-Ack reference
+# backend and noVNC on loopback-facing process ports and expose only nginx
+# on :8080. Firefox opens the canonical Mesh origin in this same namespace.
+export QIKVRT_HTTP_HOST=127.0.0.1
+export QIKVRT_START_URL="${QIKVRT_CLOUD_START_URL:-http://127.0.0.1:8080/qik-vrt/mesh/v1/}"
+
+/usr/local/bin/qikvrt-universal-terminal &
+TERMINAL_PID=$!
+PIDS="$PIDS $TERMINAL_PID"
+
+# nginx runs as Debian's unprivileged nobody account. Materialize every
+# writable path as that account; do not add CAP_CHOWN or other capabilities.
+runuser -u nobody -- mkdir -p \
+  /tmp/nginx-client-body \
+  /tmp/nginx-proxy \
+  /tmp/nginx-fastcgi \
+  /tmp/nginx-uwsgi \
+  /tmp/nginx-scgi
+runuser -u nobody -- nginx \
+  -c /opt/qikvrt/deploy/universal-terminal/nginx.conf \
+  -g 'daemon off;' &
+GATEWAY_PID=$!
+PIDS="$PIDS $GATEWAY_PID"
+
+# Bounded startup contract: both children must stay alive and the canonical
+# HTTP surface plus terminal health must become readable before READY.
+attempt=0
+while :; do
+  kill -0 "$TERMINAL_PID" 2>/dev/null || {
+    echo "BLOCK: cloud terminal child exited during startup" >&2
+    exit 1
+  }
+  kill -0 "$GATEWAY_PID" 2>/dev/null || {
+    echo "BLOCK: cloud gateway child exited during startup" >&2
+    exit 1
+  }
+  if /usr/local/bin/qikvrt-runtime-health >/dev/null 2>&1 \
+    && curl -fsS http://127.0.0.1:8080/qik-vrt/mesh/v1/healthz >/dev/null \
+    && curl -fsS http://127.0.0.1:8080/qik-vrt/mesh/v1/ >/dev/null; then
+    break
+  fi
+  attempt=$((attempt + 1))
+  if [ "$attempt" -ge 60 ]; then
+    echo "BLOCK: cloud Mesh surface did not become ready" >&2
+    exit 1
+  fi
+  sleep 1
+done
+
+printf '%s\n' "QIKVRT cloud universal terminal ready: mesh=0.0.0.0:8080/qik-vrt/mesh/v1/"
+
+while :; do
+  kill -0 "$TERMINAL_PID" 2>/dev/null || {
+    echo "BLOCK: cloud terminal child exited" >&2
+    exit 1
+  }
+  kill -0 "$GATEWAY_PID" 2>/dev/null || {
+    echo "BLOCK: cloud gateway child exited" >&2
+    exit 1
+  }
+  sleep 1
+done
diff --git a/deploy/universal-terminal/compose.yaml b/deploy/universal-terminal/compose.yaml
index 94e1630d758b577a3e945b40f263babf59470f8b..80f27de10b610319cd25aa1a87754d34f97b7d33 100644
--- a/deploy/universal-terminal/compose.yaml
+++ b/deploy/universal-terminal/compose.yaml
@@ -1,40 +1,154 @@
 services:
   qikvrt-universal-terminal:
     build:
-      context: ../..
+      context: ${QIKVRT_REPOSITORY_CONTEXT:-../..}
       dockerfile: deploy/universal-terminal/Dockerfile
-    image: qikvrt/universal-terminal:${QIKVRT_IMAGE_TAG:-trusted-main}
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
     restart: unless-stopped
+    environment:
+      QIKVRT_SERVICE_MODE: terminal
+      QIKVRT_HTTP_HOST: 127.0.0.1
+      QIKVRT_START_URL: ${QIKVRT_START_URL:-http://qikvrt-gateway:8080/qik-vrt/mesh/v1/}
     ports:
       - "127.0.0.1:${QIKVRT_NOVNC_HOST_PORT:-6080}:6080"
-    environment:
-      QIKVRT_START_URL: "${QIKVRT_START_URL:-https://arxiv.org/}"
-      QIKVRT_NOVNC_PORT: "6080"
-      QIKVRT_HTTP_PORT: "8771"
-      QIKVRT_RUNTIME_ID: "${QIKVRT_RUNTIME_ID:-qikvrt-firefox-terminal}"
-      QIKVRT_PROFILE_DIR: /var/lib/qikvrt/profile
-      QIKVRT_STATE_DIR: /var/lib/qikvrt/state
-      QIKVRT_VNC_PASSWORD_FILE: "${QIKVRT_VNC_PASSWORD_FILE:-}"
-    volumes:
-      - qikvrt_firefox_profile:/var/lib/qikvrt/profile
-      - qikvrt_runtime_state:/var/lib/qikvrt/state
-    security_opt:
-      - no-new-privileges:true
-    cap_drop:
-      - ALL
+      - "127.0.0.1:${QIKVRT_MESH_HOST_PORT:-8080}:8080"
+    networks:
+      qikvrt_mesh:
+        ipv4_address: 10.73.0.2
+        aliases: [qikvrt-gateway]
     read_only: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
     tmpfs:
-      - /tmp
-      - /run
-      - /opt/qikvrt/runtime:size=256m,mode=1777
-    shm_size: 512m
-    healthcheck:
-      test: ["CMD", "/usr/local/bin/qikvrt-runtime-health"]
-      interval: 10s
-      timeout: 5s
-      start_period: 20s
-      retries: 6
+      - /tmp:size=128m,mode=1777
+      - /run:size=32m,mode=755
+      - /opt/qikvrt/runtime/logs:size=64m,mode=755
+    volumes:
+      - qikvrt_profile:/var/lib/qikvrt/profile
+      - qikvrt_state:/var/lib/qikvrt/state
+      - qikvrt_personal_posix:/var/lib/qikvrt/personal-posix
+    shm_size: 256m
+
+  qikvrt-gateway:
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
+    environment: {QIKVRT_SERVICE_MODE: gateway}
+    network_mode: service:qikvrt-universal-terminal
+    user: "65534:65534"
+    depends_on: [qikvrt-universal-terminal]
+    read_only: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
+    tmpfs: [/tmp:size=32m,mode=1777, /run:size=16m,mode=755]
+    healthcheck: {disable: true}
+
+  qikvrt-smtpd:
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
+    environment: {QIKVRT_SERVICE_MODE: smtpd}
+    ports: ["127.0.0.1:${QIKVRT_SMTP_HOST_PORT:-2525}:2525"]
+    networks: {qikvrt_mesh: {ipv4_address: 10.73.0.7}}
+    read_only: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
+    tmpfs: [/tmp:size=16m,mode=1777, /run:size=8m,mode=755]
+    volumes: [qikvrt_smtp:/var/lib/qikvrt/smtp]
+    healthcheck: {disable: true}
+
+  qikvrt-snmpd:
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
+    environment: {QIKVRT_SERVICE_MODE: snmpd}
+    ports: ["127.0.0.1:${QIKVRT_SNMP_HOST_PORT:-1161}:1161/udp"]
+    networks: {qikvrt_mesh: {ipv4_address: 10.73.0.9}}
+    read_only: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
+    tmpfs: [/tmp:size=16m,mode=1777, /run:size=8m,mode=755]
+    healthcheck: {disable: true}
+
+  qikvrt-dnsd:
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
+    environment: {QIKVRT_SERVICE_MODE: dnsd, QIKVRT_DNS_PORT: "5353"}
+    ports:
+      - "127.0.0.1:${QIKVRT_DNS_HOST_PORT:-5353}:5353/udp"
+      - "127.0.0.1:${QIKVRT_DNS_HOST_PORT:-5353}:5353/tcp"
+    networks: {qikvrt_mesh: {ipv4_address: 10.73.0.8}}
+    read_only: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
+    tmpfs: [/tmp:size=16m,mode=1777, /run:size=8m,mode=755]
+    healthcheck: {disable: true}
+
+  qikvrt-sshd:
+    image: ${QIKVRT_UNIVERSAL_TERMINAL_IMAGE:-qikvrt/universal-terminal:local}
+    environment:
+      QIKVRT_SERVICE_MODE: sshd
+      QIKVRT_SSH_AUTHORIZED_KEYS: ${QIKVRT_SSH_AUTHORIZED_KEYS:-}
+    ports: ["127.0.0.1:${QIKVRT_SSH_HOST_PORT:-2222}:2222"]
+    networks: {qikvrt_mesh: {ipv4_address: 10.73.0.10}}
