+      "proof_refs": [],
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "Conditional on VTI-005 in each direction, terminating replay and response, distinct identities and complete gates; virtual bidirectionality only.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-006-PAPER"],
+      "statement": "Two finite virtual channels plus a terminating response function compose into a bidirectional virtual dialogue while all generating host events remain forward ordered.",
+      "status": "OPEN"
+    },
+    {
+      "claim_id": "VTI-007",
+      "classification": "SOURCE_BOUND",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "SOURCE_ATTRIBUTED",
+      "scope": "Source attribution to the exact prior finite CTM receipt; it is not a fresh kernel proof of VTI-003 through VTI-009.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/PRIOR_KERNEL_RECEIPT_BINDING.json#VTI-007-CTM-RECEIPT"],
+      "statement": "The prior Canonical Temporal Memory receipt records nine Lean-kernel-verified theorems concerning release gates, counterfactual future relevance, source non-overwrite, identifier binding and reciprocal closure in its finite model.",
+      "status": "BOUND"
+    },
+    {
+      "claim_id": "VTI-008",
+      "classification": "OPEN",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "Conditional paper proof whose complete-mediation premise is a deployment obligation; a bypass violates the premise.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-008-PAPER"],
+      "statement": "If every executor path is completely mediated and ordinary release requires a valid EFFECT_ACK_DONE record, no non-DONE record can trigger ordinary release.",
+      "status": "OPEN"
+    },
+    {
+      "claim_id": "VTI-009",
+      "classification": "OPEN",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "Conditional systems statement under an explicit failure model; EFFECT_ACK alone does not establish exactly-once.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/CONDITIONAL_PROOF_LEDGER.md#VTI-009-PAPER"],
+      "statement": "Exactly-once requires atomic deduplication and effect coupling or an idempotent executor, plus eventual delivery and availability; EFFECT_ACK by itself is insufficient.",
+      "status": "OPEN"
+    },
+    {
+      "claim_id": "VTI-010",
+      "classification": "NORMATIVE",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "NORMATIVE_DECLARATION",
+      "scope": "A methodological declaration; particular applications must specify decoder, context, validity and authorization contracts.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/EVIDENCE_BOUNDARY.md#VTI-010-BOUNDARY"],
+      "statement": "Byte identity, semantic identity, truth and authorized real-world effect shall be treated as separate verification obligations.",
+      "status": "DECLARED"
+    },
+    {
+      "claim_id": "VTI-011",
+      "classification": "OPEN",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "Scope-bound novelty candidate based on the targeted comparison in the manuscript; no world-priority, patent or exhaustive-review claim.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/EVIDENCE_BOUNDARY.md#VTI-011-NOVELTY"],
+      "statement": "Whether the full conjunction of immutable source history, past-targeted branch replay, three orders, bidirectional session correlation and fail-closed effect authorization is globally novel remains under independent review.",
+      "status": "OPEN"
+    },
+    {
+      "claim_id": "VTI-012",
+      "classification": "OPEN",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "No operative mapping from a virtual address to an earlier spacetime event is implemented or evidenced here.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/EVIDENCE_BOUNDARY.md#VTI-012-PHYSICAL-BOUNDARY"],
+      "statement": "A bridge from virtual-time addressing to physical future-to-past signalling is an additional unverified natural hypothesis.",
+      "status": "OPEN"
+    },
+    {
+      "claim_id": "VTI-013",
+      "classification": "OPEN",
+      "evidence_refs": [],
+      "proof_refs": [],
+      "publication_wording": "EXPLICITLY_OPEN",
+      "scope": "Requires preregistration, a later randomized intervention, an earlier sealed measurement, leak controls, quantitative error control and independent replication.",
+      "source_refs": ["docs/publications/2026-08-01-bidirectional-virtual-time-channel/EVIDENCE_BOUNDARY.md#VTI-013-PHYSICAL-TEST"],
+      "statement": "Positive controllable backward physical channel capacity in either direction remains experimentally unestablished by this work.",
+      "status": "OPEN"
+    }
+  ],
