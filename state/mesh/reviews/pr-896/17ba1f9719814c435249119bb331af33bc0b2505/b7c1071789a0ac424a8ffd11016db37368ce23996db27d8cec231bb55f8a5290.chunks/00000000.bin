+    "binary_sha256_required": true,
+    "literal_exact_head_tree_receipt_required": true,
+    "repository_integrity_materialization_required": true
+  },
+  "claim_boundaries": {
+    "m68k_machine_bytes_produced": "PENDING_EXECUTION",
+    "m68k_emulator_execution_observed": "PENDING_EXECUTION",
+    "atari_tos_binary_produced": false,
+    "atari_tos_execution_observed": false,
+    "physical_m68000_execution_observed": false,
+    "physical_megast_execution_observed": false,
+    "borland_turbo_pascal_compiler_executed": false,
+    "embarcadero_delphi_compiler_executed": false,
+    "external_effect": "NONE",
+    "effect_ack_done": false,
+    "pass": false,
+    "final_pass": false
+  },
+  "next_stage": "M68K_ATARI_TOS_CROSS_LINK_AND_HATARI_EMUTOS_REOBSERVATION"
+}
