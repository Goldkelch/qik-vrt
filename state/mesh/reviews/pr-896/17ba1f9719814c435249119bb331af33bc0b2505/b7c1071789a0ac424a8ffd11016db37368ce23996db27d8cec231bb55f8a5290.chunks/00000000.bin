+{
+  "schema": "qikvrt_pascal_m68k_linux_hardware_mapping_v1",
+  "state": "CANDIDATE",
+  "authority_repository": "Goldkelch/qik-vrt",
+  "stack_parent_pr": 895,
+  "stack_parent_head": "6a104554c72f189758944c55ce22f9ce0025e11d",
+  "stack_parent_tree": "5051694c5bc6eacb44214fb2aa3209fd74f2bfbd",
+  "semantic_source": {
+    "path": "pascal/qikvrt_atari_browser_pas.pas",
+    "compiler_wrapper": "pascal/qikvrtataribrowserpas.pas",
+    "test_program": "tests/pascal/test_qikvrt_atari_browser_pas.pas",
+    "shell_program": "runtime/pascal/qikbrow_pas.pas"
+  },
+  "toolchain": {
+    "bootstrap_compiler": "Free Pascal 3.2.2 on x86_64-linux",
+    "cross_compiler_source_repository": "https://gitlab.com/freepascal.org/fpc/source.git",
