+    "da": "DECLARED_M68K_COMPILER_TO_ELF_MACHINE_BYTES_AND_QEMU_REOBSERVATION",
+    "target_isa": "MOTOROLA_68000_FAMILY",
+    "target_abi": "M68K_LINUX_ELF",
+    "round_trip_invariant": "NORMALIZED_PASCAL_TEST_AND_SHELL_OUTPUT"
+  },
+  "acceptance": {
+    "cross_compiler_source_commit_verified": true,
+    "m68k_elf_machine_header_required": true,
+    "tp_mode_cross_compile_required": true,
+    "delphi_mode_cross_compile_required": true,
+    "qemu_execution_required": true,
