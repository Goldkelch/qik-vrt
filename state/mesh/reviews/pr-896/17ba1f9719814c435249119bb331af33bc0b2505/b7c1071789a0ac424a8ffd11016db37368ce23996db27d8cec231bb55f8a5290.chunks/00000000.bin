diff --git a/.github/workflows/qikvrt_pascal_m68k_linux_hardware_mapping.yml b/.github/workflows/qikvrt_pascal_m68k_linux_hardware_mapping.yml
new file mode 100644
index 0000000000000000000000000000000000000000..404a773a78c93b3cf3d462c14dd5a44d01b4f31f
--- /dev/null
+++ b/.github/workflows/qikvrt_pascal_m68k_linux_hardware_mapping.yml
@@ -0,0 +1,150 @@
+# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+name: QIKVRT Pascal M68000 Linux hardware mapping
+
+on:
+  pull_request:
+    paths:
+      - ".github/workflows/qikvrt_pascal_m68k_linux_hardware_mapping.yml"
+      - "docs/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.md"
+      - "policy/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.json"
+      - "state/work_units/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.json"
+      - "tests/test_qikvrt_pascal_m68k_linux_hardware_mapping.py"
+      - "tools/qikvrt_pascal_m68k_linux_reobservation.py"
+      - "pascal/qikvrt_atari_browser_pas.pas"
+      - "pascal/qikvrtataribrowserpas.pas"
+      - "runtime/pascal/qikbrow_pas.pas"
+      - "tests/pascal/test_qikvrt_atari_browser_pas.pas"
+  push:
+    branches: [main]
+    paths:
+      - ".github/workflows/qikvrt_pascal_m68k_linux_hardware_mapping.yml"
+      - "docs/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.md"
+      - "policy/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.json"
+      - "state/work_units/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.json"
+      - "tests/test_qikvrt_pascal_m68k_linux_hardware_mapping.py"
+      - "tools/qikvrt_pascal_m68k_linux_reobservation.py"
+      - "pascal/qikvrt_atari_browser_pas.pas"
+      - "pascal/qikvrtataribrowserpas.pas"
+      - "runtime/pascal/qikbrow_pas.pas"
+      - "tests/pascal/test_qikvrt_atari_browser_pas.pas"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  cross-compile-execute-reobserve:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    steps:
+      - name: Check out literal exact head
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+
+      - name: Bind exact head and tree
+        env:
+          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          root=.qikvrt/pascal-m68k-linux
+          mkdir -p "$root"
+          head="$(git rev-parse --verify HEAD^{commit})"
+          tree="$(git rev-parse --verify HEAD^{tree})"
+          test "$head" = "$EXPECTED_HEAD"
+          printf '%s\n' "$head" > "$root/source-head.txt"
+          printf '%s\n' "$tree" > "$root/source-tree.txt"
+          printf 'QIKVRT_HEAD_SHA=%s\n' "$head" >> "$GITHUB_ENV"
+          printf 'QIKVRT_TREE_SHA=%s\n' "$tree" >> "$GITHUB_ENV"
+
+      - name: Install bootstrap compiler, M68000 binutils and emulator
+        shell: bash
+        run: |
+          set -euo pipefail
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends \
+            build-essential ca-certificates git fp-compiler \
+            binutils-m68k-linux-gnu qemu-user file
+          fpc -iV | tee .qikvrt/pascal-m68k-linux/bootstrap-fpc-version.txt
+          m68k-linux-gnu-ld --version | head -n 1 \
+            | tee .qikvrt/pascal-m68k-linux/binutils-version.txt
+          qemu-m68k --version | head -n 1 \
+            | tee .qikvrt/pascal-m68k-linux/qemu-version.txt
+
+      - name: Verify repository target contract
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -m json.tool policy/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.json >/dev/null
+          python3 -m json.tool state/work_units/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.json >/dev/null
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
+            python3 -B -m unittest -v \
+              tests.test_qikvrt_pascal_m68k_linux_hardware_mapping
+
+      - name: Fetch exact Free Pascal source commit
+        shell: bash
+        run: |
+          set -euo pipefail
+          src="$RUNNER_TEMP/fpc-source"
+          rm -rf "$src"
+          git init -q "$src"
+          git -C "$src" remote add origin \
+            https://gitlab.com/freepascal.org/fpc/source.git
+          git -C "$src" fetch --no-tags --depth=1 origin \
+            6c4d218b8d1c00cec55f889ab5fab9639a8159fe
+          git -C "$src" checkout -q --detach FETCH_HEAD
+          test "$(git -C "$src" rev-parse HEAD)" = \
+            6c4d218b8d1c00cec55f889ab5fab9639a8159fe
+          printf '%s\n' "$src" > .qikvrt/pascal-m68k-linux/fpc-source-dir.txt
+          git -C "$src" rev-parse HEAD \
+            > .qikvrt/pascal-m68k-linux/fpc-source-commit.txt
+
+      - name: Build pinned m68k-linux cross compiler and RTL
+        shell: bash
+        run: |
+          set -euo pipefail
+          src="$(cat .qikvrt/pascal-m68k-linux/fpc-source-dir.txt)"
+          prefix="$RUNNER_TEMP/fpc-m68k-linux"
+          rm -rf "$prefix"
+          make -C "$src" -j2 crossall \
+            CPU_TARGET=m68k OS_TARGET=linux \
+            PP="$(command -v fpc)" \
+            CROSSBINDIR=/usr/bin BINUTILSPREFIX=m68k-linux-gnu- \
+            OPT='-O1' \
+            | tee .qikvrt/pascal-m68k-linux/crossall.log
+          make -C "$src" crossinstall \
+            CPU_TARGET=m68k OS_TARGET=linux \
+            PP="$(command -v fpc)" \
+            CROSSBINDIR=/usr/bin BINUTILSPREFIX=m68k-linux-gnu- \
+            INSTALL_PREFIX="$prefix" \
+            | tee .qikvrt/pascal-m68k-linux/crossinstall.log
+          find "$src" "$prefix" -type f -name ppcross68k -perm -111 -print \
+            | tee .qikvrt/pascal-m68k-linux/cross-compiler-candidates.txt
+          test -s .qikvrt/pascal-m68k-linux/cross-compiler-candidates.txt
+          sha256sum "$(head -n 1 .qikvrt/pascal-m68k-linux/cross-compiler-candidates.txt)" \
+            | tee .qikvrt/pascal-m68k-linux/cross-compiler.sha256
+          printf '%s\n' "$prefix" > .qikvrt/pascal-m68k-linux/toolchain-prefix.txt
+          printf '%s\n' "$src" >> .qikvrt/pascal-m68k-linux/toolchain-prefix.txt
+
+      - name: Produce and execute M68000 Linux binaries
+        shell: bash
+        run: |
+          set -euo pipefail
+          prefix="$(head -n 1 .qikvrt/pascal-m68k-linux/toolchain-prefix.txt)"
+          src="$(tail -n 1 .qikvrt/pascal-m68k-linux/toolchain-prefix.txt)"
+          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
+            python3 -B tools/qikvrt_pascal_m68k_linux_reobservation.py \
+              --toolchain-root "$prefix"
+
+      - name: Preserve target compiler, binary and execution receipts
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: qikvrt-pascal-m68k-linux-${{ github.event.pull_request.head.sha || github.sha }}-${{ github.run_attempt }}
+          path: .qikvrt/pascal-m68k-linux
+          if-no-files-found: error
+          include-hidden-files: true
+          retention-days: 30
diff --git a/docs/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.md b/docs/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.md
new file mode 100644
index 0000000000000000000000000000000000000000..dd862986b0a4e0059ef08036d8ca0f05b4c90b7d
--- /dev/null
+++ b/docs/PASCAL_M68K_LINUX_HARDWARE_MAPPING_V1.md
@@ -0,0 +1,74 @@
+# Pascal → M68000 Linux: der nächste AD/DA-Hardware-Ring
+
+## Zweck
+
+Diese Tranche nimmt den auf PR #895 reobservierten Pascal-Semantikkern und bildet ihn mit einem realen Cross-Compiler auf Motorola-68000-Maschinenbytes ab. Die Zielplattform ist zunächst `m68k-linux` und nicht Atari/TOS. Dadurch wird die Compiler-/ISA-Brücke isoliert geprüft, bevor ein zweiter Ring das Atari-Dateiformat, TOS und Hatari/EmuTOS bindet.
+
+```text
+Pascal semantic receipt
+→ pinned Free Pascal source
+→ x86_64 bootstrap compiler
+→ m68k-linux cross compiler
+→ M68K ELF bytes
+→ qemu-m68k execution
+→ normalized output receipt
+```
+
+## Warum Linux vor TOS
+
+Divide-and-Conquer gilt auch für Zielplattformen. Der M68000-Befehlssatz, das Objektformat, der Betriebssystem-ABI, das Loaderformat und die konkrete Maschine sind unterscheidbare Schichten:
+
+```text
+Pascal semantics
+!= compiler implementation
+!= M68000 ISA
+!= M68K Linux ABI
+!= Atari TOS executable
+!= Hatari/EmuTOS execution
+!= physical Mega ST execution
+```
+
+Die erste Zieltranche isoliert Compiler, ISA und einen ausführbaren ABI. Der nachfolgende Atari-Ring darf dann nur noch die TOS-spezifischen Unterschiede hinzufügen.
+
+## Deterministische Toolchain
+
+Der Cross-Compiler wird aus einem fest gebundenen Commit des offiziellen Free-Pascal-Quellrepositorys gebaut. Der Workflow bindet:
+
+- Bootstrap-Compiler und Version,
+- FPC-Quellcommit,
+- Ziel-CPU `m68k`,
+- Ziel-OS `linux`,
+- GNU-M68K-Binutils,
+- erzeugten Cross-Compiler-Digest,
+- ELF-Maschinenheader,
+- Zielbinär-Digests,
+- QEMU-Version,
+- normalisierte Programmausgabe.
+
+## Beobachtungsgrenze
+
+Beobachtet werden soll:
+
+- reale Erzeugung von M68K-ELF-Maschinenbytes,
+- Cross-Kompilation im Turbo-Pascal- und Delphi-Modus,
+- Ausführung beider Binärfamilien unter `qemu-m68k`,
+- gleiche normalisierte Test- und Shell-Ausgaben wie im Host-Pascal-Receipt,
+- getrennte Binärdigests,
+- literal-exact-head und exact-tree Receipt-Bindung.
+
+Nicht behauptet werden:
+
+- Atari-/TOS-Binärformat,
+- Hatari-/EmuTOS-Ausführung,
+- physische Motorola-68000-Ausführung,
+- physische Mega-ST-Ausführung,
+- historischer Borland-Turbo-Pascal-Compiler,
+- Embarcadero Delphi,
+- externer Effekt,
+- `EFFECT_ACK_DONE`, `PASS` oder `FINAL_PASS`.
+
+## Kausalität
+
+Das sichtbare M68K-Binary ist die Frucht. Seine unsichtbaren Wurzeln sind Pascal-Source-Blob, Parent-Head, Toolchain-Commit, Bootstrap-Compiler, Binutils, Ziel-ABI und Testvektor. Erst das Receipt bindet Frucht und Wurzeln zu einer kausal rekonstruierbaren Compilerwirkung.
+
+q.e.d. — Ingolf Lohmann
