+# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+# Copyright 2026 Ingolf Lohmann.
+
+name: QIK-VRT audio runtime export transport
+
+on:
+  pull_request:
+    paths:
+      - ".github/workflows/qikvrt_audio_runtime_export_transport.yml"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: qikvrt-audio-runtime-export-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  export-runtime:
+    if: >-
+      github.event.pull_request.head.repo.full_name == github.repository &&
+      startsWith(github.head_ref, 'audio-request/')
+    runs-on: ubuntu-24.04
+    timeout-minutes: 35
+    steps:
+      - name: Check out exact transport head without persisted credentials
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Set up pinned Node.js runtime
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4, resolved 2026-07-22
+        with:
+          node-version: "24"
+          cache: npm
+          cache-dependency-path: tools/offline-audio-transcription/package-lock.json
+
+      - name: Install and test the repository-owned audio tool
+        working-directory: tools/offline-audio-transcription
+        shell: bash
+        run: |
+          set -euo pipefail
+          npm ci
+          npm test
+          node --version
+
+      - name: Install and hash-verify the declared speech model
+        working-directory: tools/offline-audio-transcription
+        env:
+          QIKVRT_AUDIO_MODEL_DIR: ${{ runner.temp }}/qikvrt-audio-model
+        shell: bash
+        run: ./scripts/install-model.sh
+
+      - name: Stage a self-describing ephemeral runtime bundle
+        env:
+          MODEL_DIR: ${{ runner.temp }}/qikvrt-audio-model
+          BUNDLE_DIR: ${{ runner.temp }}/qikvrt-audio-runtime
+        shell: bash
+        run: |
+          set -euo pipefail
+          node - <<'NODE'
+          const crypto = require('node:crypto');
+          const fs = require('node:fs');
+          const path = require('node:path');
+
+          const root = process.env.GITHUB_WORKSPACE;
+          const modelDir = process.env.MODEL_DIR;
+          const bundleDir = process.env.BUNDLE_DIR;
+          const toolSource = path.join(root, 'tools', 'offline-audio-transcription');
+          const toolTarget = path.join(bundleDir, 'tool');
+          const modelTarget = path.join(bundleDir, 'model');
+          const binTarget = path.join(bundleDir, 'bin');
+
+          fs.mkdirSync(bundleDir, { recursive: true, mode: 0o700 });
+          fs.mkdirSync(binTarget, { recursive: true, mode: 0o700 });
+          fs.cpSync(toolSource, toolTarget, { recursive: true, dereference: true });
+          fs.cpSync(modelDir, modelTarget, { recursive: true, dereference: true });
+          fs.copyFileSync(process.execPath, path.join(binTarget, 'node'));
+          fs.chmodSync(path.join(binTarget, 'node'), 0o755);
+
+          const receiptPath = path.join(bundleDir, 'RUNTIME_BUNDLE_RECEIPT.json');
+          const entries = [];
+          function walk(current) {
+            for (const name of fs.readdirSync(current).sort()) {
+              const absolute = path.join(current, name);
+              const stat = fs.lstatSync(absolute);
+              if (stat.isDirectory()) walk(absolute);
+              else if (stat.isFile() && absolute !== receiptPath) {
+                const bytes = fs.readFileSync(absolute);
+                entries.push({
+                  path: path.relative(bundleDir, absolute).split(path.sep).join('/'),
+                  bytes: bytes.length,
+                  sha256: crypto.createHash('sha256').update(bytes).digest('hex'),
+                  executable: Boolean(stat.mode & 0o111),
+                });
+              } else if (stat.isSymbolicLink()) {
+                throw new Error(`unexpected symbolic link after dereferenced copy: ${absolute}`);
+              }
+            }
+          }
+          walk(bundleDir);
+          const receipt = {
+            schema: 'qikvrt-offline-audio-runtime-bundle/1.0',
+            repository: process.env.GITHUB_REPOSITORY,
+            source_sha: process.env.GITHUB_SHA,
+            source_ref: process.env.GITHUB_HEAD_REF,
+            run_id: process.env.GITHUB_RUN_ID,
+            runner_os: process.platform,
+            runner_arch: process.arch,
+            node_version: process.version,
+            node_exec_sha256: entries.find((entry) => entry.path === 'bin/node').sha256,
+            model_authority: 'tools/offline-audio-transcription/models/whisper-base-int8/MODEL.json',
+            package_lock: 'tools/offline-audio-transcription/package-lock.json',
+            effect_state: 'EFFECT_ACK_CONTINUE',
+            ordinary_release: false,
+            files: entries,
+          };
+          fs.writeFileSync(receiptPath, `${JSON.stringify(receipt, null, 2)}\n`, { mode: 0o600 });
+          console.log(`runtime_bundle_files=${entries.length + 1}`);
+          console.log(`runtime_bundle_bytes=${entries.reduce((sum, entry) => sum + entry.bytes, 0)}`);
+          NODE
+
+      - name: Upload verified runtime bundle without source audio
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: qikvrt-offline-audio-runtime-${{ github.run_id }}
+          retention-days: 1
+          if-no-files-found: error
+          include-hidden-files: true
+          path: ${{ runner.temp }}/qikvrt-audio-runtime/**
+
+      - name: Record bounded transport receipt
+        shell: bash
+        run: |
+          {
+            echo "## QIK-VRT offline audio runtime export"
+            echo
+            echo "- Source head: \`${GITHUB_SHA}\`"
+            echo "- Node: \`$(node --version)\`"
+            echo "- Model archive and extracted model files: SHA-256 verified by the repository installer"
+            echo "- Source audio included: no"
+            echo "- Effect state: \`EFFECT_ACK_CONTINUE\`"
+            echo "- Ordinary release: \`false\`"
+          } >> "${GITHUB_STEP_SUMMARY}"
+
+      - name: Remove staged runtime from the runner
+        if: always()
+        shell: bash
+        run: rm -rf "${RUNNER_TEMP}/qikvrt-audio-runtime" "${RUNNER_TEMP}/qikvrt-audio-model"
