diff --git a/release/relational-time-monotonic-evidence-sphere-zenodo-v1/CLAIM_BOUNDARY.json b/release/relational-time-monotonic-evidence-sphere-zenodo-v1/CLAIM_BOUNDARY.json
new file mode 100644
index 0000000000000000000000000000000000000000..a34c7f25481ce5b5c4ba06f2097e431cfa88e17b
--- /dev/null
+++ b/release/relational-time-monotonic-evidence-sphere-zenodo-v1/CLAIM_BOUNDARY.json
@@ -0,0 +1,56 @@
+{
+  "schema": "qikvrt_relational_time_evidence_sphere_claim_boundary_v1",
+  "publication_id": "qikvrt-relational-time-monotonic-evidence-sphere-v1",
+  "artifact_sha256": "38b0e62a46214a7cb9943dd3ef08283a70ae7e15ba22a59a9e53506f2945e311",
+  "claims": [
+    {
+      "id": "RTE-001",
+      "statement": "The selected document presents a relation-first model of time, virtual retrocausality, node-local event time, proof rings and a monotonically growing evidence sphere.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED_BY_SELECTED_DOCUMENT"
+    },
+    {
+      "id": "RTE-002",
+      "statement": "Within the defined formal model, future-indexed addressing and reverse reconstruction of fully logged traces are constructively expressible without rewriting sealed predecessor bytes.",
+      "class": "FORMAL_MODEL_RESULT",
+      "status": "SCOPE_BOUND_TO_DEFINITIONS_AND_ASSUMPTIONS"
+    },
+    {
+      "id": "RTE-003",
+      "statement": "A closed proof or audit ring is not thereby a closed physical timelike curve.",
+      "class": "FORMAL_BOUNDARY",
+      "status": "EXPLICIT"
+    },
+    {
+      "id": "RTE-004",
+      "statement": "The evidence sphere grows append-only by adding newly bound evidence; earlier sealed evidence is not silently rewritten.",
+      "class": "ARCHITECTURAL_INVARIANT",
+      "status": "MODEL_AND_REPOSITORY_BOUND"
+    },
+    {
+      "id": "RTE-005",
+      "statement": "The document attributes the relation-first ontology, TEMDD, Round Trip, node-local event time, proof ring, growing sphere and virtual retrocausality conception to Ingolf Lohmann.",
+      "class": "AUTHORSHIP_PROVENANCE",
+      "status": "SOURCE_BOUND"
+    },
+    {
+      "id": "RTE-006",
+      "statement": "The selected document does not by itself report independently replicated positive capacity for a controllable physical future-to-past messaging channel.",
+      "class": "EXTERNAL_EMPIRICAL_BOUNDARY",
+      "status": "NOT_CLAIMED"
+    },
+    {
+      "id": "RTE-007",
+      "statement": "Zenodo publication of the byte-exact artifact would establish a public citable record and byte identity, not peer review, empirical confirmation, scientific consensus, PASS, FINAL_PASS or general EFFECT_ACK_DONE.",
+      "class": "PUBLICATION_EFFECT_BOUNDARY",
+      "status": "EXPLICIT"
+    }
+  ],
+  "status_equations": [
+    "FORMAL_MODEL_PROOF != EMPIRICAL_NATURE_CONFIRMATION",
+    "REPOSITORY_EVIDENCE != PEER_REVIEW",
+    "ZENODO_PUBLICATION != SCIENTIFIC_CONSENSUS",
+    "TRANSPORT_ACK != EFFECT_ACK",
+    "PUBLIC_RECORD != GENERAL_EFFECT_ACK_DONE"
+  ]
+}
