+
+EXTERNAL_LIGHT_SPEED_MEASUREMENT_BYTES = ABSENT
+PHYSICAL_C                            = EMPIRICALLY_UNBOUND
+299792458                             = FINITE_MODEL_CALIBRATION_WITNESS
