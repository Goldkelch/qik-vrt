index 0000000000000000000000000000000000000000..4dd925b59965fad20a956073f238dfbd470feda7
--- /dev/null
+++ b/.github/workflows/qikvrt_io_round_trip.yml
@@ -0,0 +1,72 @@
+name: QIK-VRT I/O Round Trip
+
+on:
+  workflow_dispatch:
+    inputs:
+      envelope_json:
+        description: Canonical JSON I/O envelope
+        required: true
+        type: string
+  repository_dispatch:
+    types: [qikvrt_io_event]
+
+permissions:
+  contents: write
+  pull-requests: write
+
+concurrency:
+  group: qikvrt-io-round-trip-${{ github.run_id }}
+  cancel-in-progress: false
+
+jobs:
+  materialize:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Resolve envelope
+        env:
+          DISPATCH_ENVELOPE: ${{ github.event.client_payload.envelope_json }}
+          MANUAL_ENVELOPE: ${{ inputs.envelope_json }}
+        run: |
+          set -euo pipefail
+          if [ -n "${DISPATCH_ENVELOPE:-}" ]; then
+            printf '%s\n' "$DISPATCH_ENVELOPE" > /tmp/qikvrt-envelope.json
+          else
+            printf '%s\n' "$MANUAL_ENVELOPE" > /tmp/qikvrt-envelope.json
+          fi
+          python3 -m json.tool /tmp/qikvrt-envelope.json >/dev/null
+      - name: Materialize exact payload binding and append-only receipt
+        run: |
+          set -euo pipefail
+          python3 -B tools/qikvrt_io_round_trip.py --envelope /tmp/qikvrt-envelope.json --json | tee /tmp/qikvrt-result.json
+      - name: Run focused regression tests
+        run: |
+          set -euo pipefail
+          python3 -m pytest -q tests/test_io_round_trip_autopublication.py
+      - name: Persist payload and receipt on isolated branch
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          branch="automation/io-round-trip-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
+          git config user.name "qik-vrt-io-round-trip[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git switch -c "$branch"
+          git add --all -- state/io_round_trip
+          if git diff --cached --quiet; then
+            echo "No new payload or receipt bytes to persist" >&2
+            exit 1
+          fi
+          git commit -m "Persist exact I/O payload binding and receipt"
+          git push --set-upstream origin "$branch"
+          gh pr create --draft --base "${{ github.event.repository.default_branch }}" --head "$branch" \
+            --title "Persist automated I/O round-trip event" \
+            --body "Automated exact-payload binding and append-only I/O receipt generated by policy/IO_ROUND_TRIP_AUTOPUBLICATION_V1.json. External publication is not claimed by this PR; any READY route must pass the repository's separately credentialed effect gates and effect reobservation."
+      - name: Expose routing result
+        if: always()
+        run: |
+          if [ -f /tmp/qikvrt-result.json ]; then
+            cat /tmp/qikvrt-result.json >> "$GITHUB_STEP_SUMMARY"
+          fi
