diff --git a/deploy/siemens-horizon/QIKVRT_SIEMENS_HORIZON_ADAPTER_V1.md b/deploy/siemens-horizon/QIKVRT_SIEMENS_HORIZON_ADAPTER_V1.md
new file mode 100644
index 0000000000000000000000000000000000000000..716a99514eeabf91438ce8c69610968a671d0dfe
--- /dev/null
+++ b/deploy/siemens-horizon/QIKVRT_SIEMENS_HORIZON_ADAPTER_V1.md
@@ -0,0 +1,69 @@
+# QIK-VRT Siemens Horizon Adapter Profile V1
+
+## Scope
+
+This profile defines a safe integration path between the QIK-VRT universal terminal pattern and Siemens Horizon / Siemens digital-twin environments.
+
+## Verified external fit
+
+Siemens publicly describes multiple closely related targets that are relevant here:
+
+- **D4R::Horizon Suite** for rail signalling engineering, with modular SDK/plugin architecture, model-based data management, import/export including XML/CSV/RailML, and transport/rail use cases.
+- **Siemens Digital Twin / Executable Digital Twin** environments that connect real systems and virtual representations, ingest live IoT data, support simulation, prediction, monitoring/control, and deployment on edge or cloud.
+- Siemens Xcelerator as the wider integration context for digital-twin packaging/deployment/operation.
+
+This profile does **not** claim that Siemens exposes a generic OCI container runtime inside D4R::Horizon Suite itself. Container deployment must bind to an actually supported Siemens execution surface or adjacent infrastructure.
+
+## QIK-VRT mapping
+
+QIK-VRT terminal semantics map to Siemens integration concepts as follows:
+
+1. `OBSERVE` -> Siemens/Horizon model, SDK, file, event, telemetry or twin-state observation.
+2. `D0 EXACT SUBJECT BINDING` -> exact project/model/entity/version/hash binding.
+3. `PREPARE` -> proposed model/data/configuration change without protected physical effect.
+4. `COMMIT` -> authorized write through the supported Siemens API/SDK/import mechanism.
+5. `EFFECT_ACK` -> post-write readback of the same exact subject proving the intended effect rather than transport success alone.
+6. `HOLD_UNVERIFIED` -> missing/stale identity, unsupported adapter, ambiguous target, failed readback, or safety-boundary violation.
+
+## AD/DA terminal profile
+
+The universal AD/DA terminal is represented as two explicitly separated directions:
+
+- **AD / world-to-model**: sensor, telemetry, rail topology, medical-device or mobility data -> bounded digital state -> exact provenance -> model/twin observation.
+- **DA / model-to-world**: validated model decision -> authorized actuator/configuration interface -> exact effect -> reobservation.
+
+The DA edge MUST remain fail-closed. No physical actuation is inferred from simulation, message delivery, workflow success, or API acceptance.
+
+## Containerization profile
+
+The existing QIK-VRT Firefox + EFFECT_ACK HTTP daemon remains an OCI-compatible Linux userspace implementation profile.
+
+For Siemens environments the preferred deployment order is:
+
+1. package the terminal as OCI image;
+2. deploy only to a Siemens-supported container/edge/cloud execution surface or a customer-controlled POSIX/OCI runtime adjacent to the Siemens environment;
+3. expose a monitor-only HTTPS surface to Horizon/Xcelerator clients;
+4. connect through supported SDK/API/file/telemetry adapters;
+5. keep protected effects behind explicit authority and EFFECT_ACK readback.
+
+## Domain adapters
+
+### Rail / Mobility
+
+Primary candidate: D4R::Horizon Suite SDK and supported interchange formats, including RailML where appropriate. QIK-VRT can act as an exact-subject provenance and effect-readback layer around model/data transitions.
+
+### Digital Twin / Industry
+
+Primary candidate: Siemens executable digital twin / Xcelerator integration. QIK-VRT can wrap the closed feedback loop with explicit distinction between prediction, command transport, physical effect and reobservation.
+
+### Medical / MedTech
+
+Use only as an integration/evidence pattern around validated medical software/device interfaces. No diagnostic, therapeutic or patient-affecting action may be inferred or executed without the applicable regulated safety, authorization and clinical validation layers.
+
+## Integration state machine
+
+`DISCOVER_CAPABILITY -> BIND_EXACT_SUBJECT -> PREPARE -> VALIDATE -> AUTHORITY_COMMIT -> POST_EFFECT_REOBSERVE -> RECEIPT -> SUCCESSOR | HOLD_UNVERIFIED`
+
+## Current status
+
+This document is an implementation/integration profile only. It does not establish Siemens endorsement, production deployment into a Siemens tenant, clinical validation, rail-safety certification, physical actuation, PASS, FINAL_PASS, or EFFECT_ACK_DONE.
diff --git a/deploy/universal-terminal/Dockerfile b/deploy/universal-terminal/Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..55e0c700b14ebc4813c879105bf8524f80a53dbd
--- /dev/null
+++ b/deploy/universal-terminal/Dockerfile
@@ -0,0 +1,34 @@
+FROM debian:bookworm-slim
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    DISPLAY=:99 \
+    QIKVRT_HTTP_PORT=8771 \
+    QIKVRT_NOVNC_PORT=6080 \
+    QIKVRT_START_URL=https://goldkelch.github.io/qik-vrt/
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      ca-certificates firefox-esr python3 python3-minimal git zip \
+      xvfb x11vnc novnc websockify dbus-x11 procps curl \
+    && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /opt/qikvrt
+COPY . /opt/qikvrt
+
+RUN mkdir -p /opt/qikvrt/runtime/profile/extensions /opt/qikvrt/runtime/logs \
+    && cd browser/firefox/qikvrt-terminal \
+    && zip -qr /opt/qikvrt/runtime/profile/extensions/qikvrt-ai-terminal@goldkelch.local.xpi . \
+    && printf '%s\n' \
+      'user_pref("browser.shell.checkDefaultBrowser", false);' \
+      'user_pref("browser.startup.homepage", "https://goldkelch.github.io/qik-vrt/");' \
+      'user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);' \
+      'user_pref("datareporting.policy.dataSubmissionEnabled", false);' \
+      > /opt/qikvrt/runtime/profile/user.js
+
+COPY deploy/universal-terminal/entrypoint.sh /usr/local/bin/qikvrt-universal-terminal
+RUN chmod +x /usr/local/bin/qikvrt-universal-terminal
+
+EXPOSE 6080
+HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
+  CMD curl -fsS http://127.0.0.1:8771/.well-known/effect-ack >/dev/null || exit 1
+
+ENTRYPOINT ["/usr/local/bin/qikvrt-universal-terminal"]
diff --git a/deploy/universal-terminal/compose.yaml b/deploy/universal-terminal/compose.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..12701bd0dae2277b2cb3337ab10664a7d39b1d02
--- /dev/null
+++ b/deploy/universal-terminal/compose.yaml
@@ -0,0 +1,22 @@
+services:
+  qikvrt-universal-terminal:
+    build:
+      context: ../..
+      dockerfile: deploy/universal-terminal/Dockerfile
+    image: qikvrt/universal-terminal:local
+    restart: unless-stopped
+    ports:
+      - "127.0.0.1:6080:6080"
+    environment:
+      QIKVRT_START_URL: "${QIKVRT_START_URL:-https://goldkelch.github.io/qik-vrt/}"
+      QIKVRT_NOVNC_PORT: "6080"
+      QIKVRT_HTTP_PORT: "8771"
+    security_opt:
+      - no-new-privileges:true
+    cap_drop:
+      - ALL
+    read_only: true
+    tmpfs:
+      - /tmp
+      - /run
+      - /opt/qikvrt/runtime:size=256m,mode=1777
diff --git a/deploy/universal-terminal/entrypoint.sh b/deploy/universal-terminal/entrypoint.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2c6da17c6102aa7429ed365b162567ab69531868
--- /dev/null
+++ b/deploy/universal-terminal/entrypoint.sh
@@ -0,0 +1,40 @@
+#!/bin/sh
+set -eu
+
+mkdir -p /opt/qikvrt/runtime/logs /opt/qikvrt/runtime/profile
+
+python3 -B /opt/qikvrt/src/qikvrt_effect_ack_http_terminal.py \
+  --host 127.0.0.1 --port "${QIKVRT_HTTP_PORT:-8771}" \
+  > /opt/qikvrt/runtime/logs/effect-ack-http.log 2>&1 &
+HTTP_PID=$!
+
+Xvfb "${DISPLAY:-:99}" -screen 0 1440x900x24 -nolisten tcp \
+  > /opt/qikvrt/runtime/logs/xvfb.log 2>&1 &
+XVFB_PID=$!
+
+sleep 1
+x11vnc -display "${DISPLAY:-:99}" -forever -shared -nopw -localhost -rfbport 5900 \
+  > /opt/qikvrt/runtime/logs/x11vnc.log 2>&1 &
+VNC_PID=$!
+
+websockify --web=/usr/share/novnc/ "${QIKVRT_NOVNC_PORT:-6080}" localhost:5900 \
+  > /opt/qikvrt/runtime/logs/novnc.log 2>&1 &
+NOVNC_PID=$!
+
+firefox-esr --no-remote --profile /opt/qikvrt/runtime/profile \
+  "${QIKVRT_START_URL:-https://goldkelch.github.io/qik-vrt/}" \
+  > /opt/qikvrt/runtime/logs/firefox.log 2>&1 &
+FIREFOX_PID=$!
+
+cleanup() {
+  kill "$FIREFOX_PID" "$NOVNC_PID" "$VNC_PID" "$XVFB_PID" "$HTTP_PID" 2>/dev/null || true
+}
+trap cleanup INT TERM EXIT
+
+printf '%s\n' "QIKVRT universal terminal ready: noVNC=0.0.0.0:${QIKVRT_NOVNC_PORT:-6080} effect_ack=127.0.0.1:${QIKVRT_HTTP_PORT:-8771}"
+
+while kill -0 "$HTTP_PID" 2>/dev/null && kill -0 "$FIREFOX_PID" 2>/dev/null; do
+  sleep 1
+done
+
+exit 1
diff --git a/deploy/vercel-monitor/api/state.js b/deploy/vercel-monitor/api/state.js
new file mode 100644
index 0000000000000000000000000000000000000000..fc16a6c0fb2f8a6c95acef76b608547ee928e80f
--- /dev/null
+++ b/deploy/vercel-monitor/api/state.js
@@ -0,0 +1,51 @@
+export default async function handler(req, res) {
+  if (req.method !== 'GET') {
+    res.setHeader('Allow', 'GET');
+    return res.status(405).json({error:'MONITOR_ONLY'});
+  }
+  const prUrl = 'https://api.github.com/repos/Goldkelch/qik-vrt/pulls/966';
+  const runUrl = 'https://api.github.com/repos/Goldkelch/qik-vrt/actions/runs?event=pull_request&per_page=30';
+  const headers = {
+    'Accept':'application/vnd.github+json',
+    'User-Agent':'qikvrt-vercel-monitor/1'
+  };
+  try {
+    const [prResp, runsResp] = await Promise.all([fetch(prUrl,{headers}), fetch(runUrl,{headers})]);
+    if (!prResp.ok || !runsResp.ok) {
+      return res.status(502).json({
+        schema:'qikvrt_monitor_projection_v1',
+        role:'MONITOR_ONLY',
+        state:'HOLD_UNVERIFIED',
+        reason:'UPSTREAM_READBACK_UNAVAILABLE'
+      });
+    }
+    const pr = await prResp.json();
+    const runs = await runsResp.json();
+    const exactHead = pr.head?.sha || null;
+    const exactRuns = (runs.workflow_runs || []).filter(r => r.head_sha === exactHead).map(r => ({
+      id:r.id,
+      name:r.name,
+      status:r.status,
+      conclusion:r.conclusion,
+      updated_at:r.updated_at
+    }));
+    res.setHeader('Cache-Control','no-store');
+    res.setHeader('X-QIKVRT-Role','MONITOR_ONLY');
+    return res.status(200).json({
+      schema:'qikvrt_monitor_projection_v1',
+      authority:'Goldkelch/qik-vrt',
+      subject:{kind:'pull_request',number:966,head_sha:exactHead,base_sha:pr.base?.sha || null},
+      projection:{role:'MONITOR_ONLY',terminal:false,write:false,effect_commit:false},
+      workflows:exactRuns,
+      rule:'On projection change, non-authority nodes must request and reobserve the exact change from Goldkelch; this projection is never itself EFFECT_ACK.',
+      observed_at:new Date().toISOString()
+    });
+  } catch (error) {
+    return res.status(502).json({
+      schema:'qikvrt_monitor_projection_v1',
+      role:'MONITOR_ONLY',
+      state:'HOLD_UNVERIFIED',
+      reason:'MONITOR_EXCEPTION'
+    });
+  }
+}
diff --git a/deploy/vercel-monitor/index.html b/deploy/vercel-monitor/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..8f9fe0360caae516203d1894e0870282b4fca183
--- /dev/null
+++ b/deploy/vercel-monitor/index.html
@@ -0,0 +1,24 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8" />
+<meta name="viewport" content="width=device-width,initial-scale=1" />
+<title>Horizon by QIK VRT — Copyright by Ingolf Lohmann</title>
+<style>
+:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#081018;color:#eef6ff}body{margin:0;padding:32px;max-width:1180px;margin-inline:auto}.top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;flex-wrap:wrap}.brand{font-size:clamp(42px,7vw,86px);line-height:.9;margin:0;letter-spacing:-.05em}.tag{font-size:18px;color:#9fb5c9;max-width:720px;margin-top:14px}.pill{padding:7px 12px;border:1px solid #3e5a72;border-radius:999px;color:#b9d8ef}.panel{margin-top:24px;padding:22px;border:1px solid #263d50;border-radius:18px;background:#0d1822}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}.signal{font-size:44px;font-weight:700;letter-spacing:-.03em}.ok{color:#78e7a2}.hold{color:#ffd166}.bad{color:#ff7b7b}.muted{color:#93aabd}.meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:18px}.meta div{padding:14px;background:#0a131b;border-radius:12px}.label{display:block;color:#7f98ad;font-size:12px;text-transform:uppercase;letter-spacing:.12em;margin-bottom:6px}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #1d3140}code{word-break:break-all}button{background:#eef6ff;color:#081018;border:0;border-radius:999px;padding:10px 16px;font-weight:700;cursor:pointer}.foot{margin-top:28px;color:#6f8799;font-size:13px}@media(max-width:780px){.hero{grid-template-columns:1fr}}
+</style>
+</head>
+<body>
+<div class="top"><div><h1 class="brand">Horizon by QIK VRT</h1><div class="tag">Copyright by Ingolf Lohmann.</div></div><div><span class="pill">LIVE AUTHORITY VIEW</span></div></div>
+<div class="hero">
+<div class="panel"><span class="label">Product owner signal</span><div id="signal" class="signal muted">Reading reality…</div><div id="advice" class="tag">Determining whether intervention is required.</div><div class="meta"><div><span class="label">Authority</span><strong>Goldkelch/qik-vrt</strong></div><div><span class="label">Subject</span>PR #966</div><div><span class="label">Exact head</span><code id="head">—</code></div><div><span class="label">Observed</span><span id="time">—</span></div></div></div>
+<div class="panel"><span class="label">What this means</span><p id="state" class="muted">Waiting for exact readback.</p><button id="refresh">Refresh exact state</button><p class="foot">Copyright by Ingolf Lohmann. Horizon by QIK VRT is a read-only orientation surface. It never constitutes Effect Acknowledgement and never executes authority effects.</p></div>
+</div>
+<div class="panel"><h2>What is moving now</h2><table><thead><tr><th>Workflow</th><th>Status</th><th>Conclusion</th><th>Updated</th></tr></thead><tbody id="runs"></tbody></table></div>
+<script>
+function classify(v){const runs=v.workflows||[];const failed=runs.find(x=>x.conclusion==='failure'||x.conclusion==='action_required');const active=runs.some(x=>x.status==='in_progress'||x.status==='queued');if(failed)return ['ATTENTION','Investigate the first exact blocker shown below.','bad'];if(active)return ['RUNNING','No intervention yet. The authority is still working.','hold'];return ['STABLE','No intervention required.','ok'];}
+async function load(){const state=document.getElementById('state');state.textContent='Reading Goldkelch exact state…';state.className='muted';try{const r=await fetch('/api/state',{cache:'no-store'});const v=await r.json();if(!r.ok)throw new Error(v.reason||'readback failed');document.getElementById('head').textContent=v.subject.head_sha||'UNBOUND';document.getElementById('time').textContent=v.observed_at;const [s,a,c]=classify(v);const signal=document.getElementById('signal');signal.textContent=s;signal.className='signal '+c;document.getElementById('advice').textContent=a;const body=document.getElementById('runs');body.innerHTML='';for(const x of v.workflows||[]){const tr=document.createElement('tr');tr.innerHTML=`<td>${x.name}</td><td>${x.status}</td><td>${x.conclusion??'—'}</td><td>${x.updated_at??'—'}</td>`;body.appendChild(tr)}state.textContent='Exact authority projection read successfully.';state.className='ok';}catch(e){document.getElementById('signal').textContent='HOLD_UNVERIFIED';document.getElementById('signal').className='signal hold';document.getElementById('advice').textContent='Do not infer. Authority readback is unavailable.';state.textContent='HOLD_UNVERIFIED: '+e.message;state.className='hold';}}
+document.getElementById('refresh').onclick=load;load();
+</script>
+</body>
+</html>
diff --git a/deploy/vercel-monitor/vercel.json b/deploy/vercel-monitor/vercel.json
new file mode 100644
index 0000000000000000000000000000000000000000..14bf4516771ffe02860d057d1e10eddfb259dee8
--- /dev/null
+++ b/deploy/vercel-monitor/vercel.json
@@ -0,0 +1,15 @@
+{
+  "version": 2,
+  "rewrites": [
+    {"source": "/api/state", "destination": "/api/state.js"}
+  ],
+  "headers": [
+    {
+      "source": "/(.*)",
+      "headers": [
+        {"key": "Cache-Control", "value": "no-store"},
+        {"key": "X-QIKVRT-Role", "value": "MONITOR_ONLY"}
+      ]
+    }
+  ]
+}
diff --git a/docs/po/index.html b/docs/po/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..5289a3d41dee9385ab0f511f1fa3cffb88d83411
--- /dev/null
+++ b/docs/po/index.html
@@ -0,0 +1 @@
+<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QIK-VRT Product Owner Live Cockpit</title><style>:root{font-family:Inter,system-ui,sans-serif;color-scheme:dark;background:#0b1020;color:#eef2ff}body{margin:0;padding:24px;background:radial-gradient(circle at top,#18213d,#090d18 55%)}h1{margin:0 0 6px;font-size:28px}.sub{opacity:.72;margin-bottom:22px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.card{background:#121a2d;border:1px solid #263250;border-radius:16px;padding:16px;box-shadow:0 10px 30px #0006}.k{font-size:12px;text-transform:uppercase;letter-spacing:.08em;opacity:.68}.v{font-size:20px;font-weight:750;margin-top:7px;word-break:break-word}.green{border-color:#1c8f5c;background:#0d2d24}.amber{border-color:#c58b24;background:#30240d}.red{border-color:#ba4554;background:#35131a}.blue{border-color:#3a6fcc;background:#102040}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:8px;background:#7f8aa7}.green .dot{background:#42d392}.amber .dot{background:#ffbf47}.red .dot{background:#ff6577}.blue .dot{background:#62a0ff}.phase{display:flex;gap:7px;flex-wrap:wrap;margin:18px 0}.p{padding:8px 11px;border-radius:999px;background:#1a2238;border:1px solid #2a3655;font-size:13px}.p.active{background:#173d77;border-color:#5c96ed}.p.done{background:#14412e;border-color:#42d392}.p.hold{background:#4a3212;border-color:#ffbf47}.stream{margin-top:16px;background:#080c15;border:1px solid #25304a;border-radius:16px;overflow:hidden}.stream h2{font-size:15px;margin:0;padding:12px 14px;border-bottom:1px solid #25304a}.log{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;line-height:1.55;padding:14px;min-height:250px;max-height:48vh;overflow:auto}.line{white-space:pre-wrap}.ts{color:#7f8aa7}.ok{color:#42d392}.warn{color:#ffbf47}.bad{color:#ff6577}.info{color:#62a0ff}.footer{opacity:.65;font-size:12px;margin-top:14px}.blink{animation:b 1.2s infinite}@keyframes b{50%{opacity:.35}}</style></head><body><h1>QIK-VRT Product Owner Live Cockpit</h1><div class="sub">Authority ↔ Mirror · Universal Terminal Pattern · keine Entwickleroberfläche</div><div class="grid"><div id="transport" class="card red"><div class="k">Live-Verbindung</div><div class="v"><span class="dot blink"></span><span id="transportText">NICHT VERBUNDEN</span></div></div><div class="card blue"><div class="k">Authority</div><div class="v" id="authority">Goldkelch/qik-vrt #966</div></div><div class="card blue"><div class="k">Mirror</div><div class="v" id="mirror">ingolf-lohmann/qik-vrt</div></div><div id="dodCard" class="card amber"><div class="k">Definition of Done</div><div class="v" id="dod">HOLD / UNVERIFIED</div></div></div><div class="phase" id="phases"></div><div class="grid"><div class="card"><div class="k">Aktueller exakter Gegenstand</div><div class="v" id="subject">—</div></div><div class="card"><div class="k">Lean / Lake</div><div class="v" id="lean">—</div></div><div class="card amber" id="blockerCard"><div class="k">Erster kausaler Blocker</div><div class="v" id="blocker">—</div></div><div class="card"><div class="k">Nächster Effekt</div><div class="v" id="next">—</div></div></div><section class="stream"><h2>Live-Ereignisse</h2><div id="log" class="log"></div></section><div class="footer">Diese Ansicht behauptet weder Merge noch Publikation, PASS, FINAL_PASS oder EFFECT_ACK_DONE ohne exakten Readback.</div><script>const P=['P0','P1','P2','P3','P4','P5','P6','P7','EXTERNAL'];const phases=document.getElementById('phases');P.forEach(x=>{const e=document.createElement('div');e.className='p';e.id='phase-'+x;e.textContent=x;phases.appendChild(e)});function line(e){const d=document.createElement('div');d.className='line';const c=e.verb==='HOLD'?'warn':e.verb==='EFFECT'||e.verb==='SUCCESSOR'?'ok':'info';d.innerHTML=`<span class="ts">${e.observed_at||'—'}</span> <span class="${c}">${e.verb||'OBSERVE'}</span> ${escapeHtml(JSON.stringify(e.payload||{}))}`;document.getElementById('log').appendChild(d);document.getElementById('log').scrollTop=1e9}function escapeHtml(s){return s.replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]))}function apply(e){if(e.subject){document.getElementById('subject').textContent=(e.subject.pull_request?'#'+e.subject.pull_request+' · ':'')+(e.subject.head_sha||'—')}if(e.phase){P.forEach(x=>document.getElementById('phase-'+x).classList.toggle('active',x===e.phase))}const p=e.payload||{};if(p.lean_lake)document.getElementById('lean').textContent=p.lean_lake;if(p.first_blocker)document.getElementById('blocker').textContent=p.first_blocker;if(p.next_effect)document.getElementById('next').textContent=p.next_effect;if(p.dod){document.getElementById('dod').textContent=p.dod;const c=document.getElementById('dodCard');c.className='card '+(String(p.dod).includes('DONE')?'green':'amber')}line(e)}const qs=new URLSearchParams(location.search);const stream=qs.get('stream')||localStorage.getItem('qikvrt_stream');if(stream){localStorage.setItem('qikvrt_stream',stream);const es=new EventSource(stream);es.onopen=()=>{const c=document.getElementById('transport');c.className='card green';document.getElementById('transportText').textContent='LIVE'};es.addEventListener('qikvrt',ev=>{try{apply(JSON.parse(ev.data))}catch(_){}});es.onerror=()=>{const c=document.getElementById('transport');c.className='card red';document.getElementById('transportText').textContent='VERBINDUNG UNTERBROCHEN'}}else{document.getElementById('log').innerHTML='<div class="line warn">Kein SSE-Endpunkt verbunden. Öffne diese Seite mit ?stream=https://…/events</div>'}</script></body></html>
