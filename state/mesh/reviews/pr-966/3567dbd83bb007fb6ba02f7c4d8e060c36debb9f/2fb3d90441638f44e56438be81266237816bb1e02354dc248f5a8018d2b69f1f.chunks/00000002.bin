diff --git a/policy/QIKVRT_EXECUTION_PRECEDENCE_V1.json b/policy/QIKVRT_EXECUTION_PRECEDENCE_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..3e568e586cbeb01802f9f38c63ff0cde524bad35
--- /dev/null
+++ b/policy/QIKVRT_EXECUTION_PRECEDENCE_V1.json
@@ -0,0 +1,112 @@
+{
+  "schema": "qikvrt_execution_precedence_v1",
+  "version": "1.0",
+  "authority": {
+    "product_owner": "Ingolf Lohmann",
+    "repository": "Goldkelch/qik-vrt",
+    "directive": "Abarbeitung erfolgt nur entlang expliziter Kausal- und Evidenzvoraussetzungen. Unbestimmte Reihenfolge ist HOLD_UNVERIFIED und darf nicht durch Heuristik ersetzt werden."
+  },
+  "semantics": {
+    "relation_type": "strict_partial_order",
+    "why_not_total_order": "Independent successor edges may execute concurrently only after their common barrier is satisfied.",
+    "edge_meaning": "A -> B means B is inadmissible until A is exact-bound and satisfied on the same current subject required by B.",
+    "unspecified_relation": "HOLD_UNVERIFIED",
+    "predecessor_evidence_transfer": false,
+    "subject_mutation_invalidates_downstream_binding": true
+  },
+  "canonical_spine": [
+    "P0_MANIFEST_LATEST_KNOWLEDGE",
+    "P1_BUILD_ONE_INTEGRATION_HEAD",
+    "P2_VALIDATE_EXACT_INTEGRATION_HEAD",
+    "P3_REVIEW_EXACT_INTEGRATION_HEAD",
+    "P4_REOBSERVE_POST_REVIEW_EXACT_HEAD",
+    "P5_LEGITIMATE_PROMOTION_TO_TRUSTED_MAIN",
+    "P6_REOBSERVE_EXACT_TRUSTED_MAIN_HEAD",
+    "P7_DERIVE_BOUND_EXTERNAL_OBLIGATIONS"
+  ],
+  "phases": {
+    "P0_MANIFEST_LATEST_KNOWLEDGE": {
+      "requires": [],
+      "satisfied_when": "All currently accepted scientific/formal integration material is persisted on the candidate carrier before validation or publication continuation."
+    },
+    "P1_BUILD_ONE_INTEGRATION_HEAD": {
+      "requires": ["P0_MANIFEST_LATEST_KNOWLEDGE"],
+      "satisfied_when": "Exactly one candidate head contains the intended #964 proof-status material, corrected #962 scientific/publication material, #965 delivery contracts, and the current evidence-spiral/fixed-point integration."
+    },
+    "P2_VALIDATE_EXACT_INTEGRATION_HEAD": {
+      "requires": ["P1_BUILD_ONE_INTEGRATION_HEAD"],
+      "satisfied_when": "Candidate-local deterministic validation is fresh on the exact current head; stale/predecessor validation is inadmissible."
+    },
+    "P3_REVIEW_EXACT_INTEGRATION_HEAD": {
+      "requires": ["P2_VALIDATE_EXACT_INTEGRATION_HEAD"],
+      "satisfied_when": "Required review is submitted against the exact validated head. Review on a predecessor head is inadmissible."
+    },
+    "P4_REOBSERVE_POST_REVIEW_EXACT_HEAD": {
+      "requires": ["P3_REVIEW_EXACT_INTEGRATION_HEAD"],
+      "satisfied_when": "The same exact reviewed head is freshly reobserved after review, with no intervening mutation."
+    },
+    "P5_LEGITIMATE_PROMOTION_TO_TRUSTED_MAIN": {
+      "requires": ["P4_REOBSERVE_POST_REVIEW_EXACT_HEAD"],
+      "satisfied_when": "Promotion/merge occurs legitimately from that exact reviewed and reobserved head; merge alone is not delivery."
+    },
+    "P6_REOBSERVE_EXACT_TRUSTED_MAIN_HEAD": {
+      "requires": ["P5_LEGITIMATE_PROMOTION_TO_TRUSTED_MAIN"],
+      "satisfied_when": "The resulting exact Trusted Main SHA is freshly observed and bound."
+    },
+    "P7_DERIVE_BOUND_EXTERNAL_OBLIGATIONS": {
+      "requires": ["P6_REOBSERVE_EXACT_TRUSTED_MAIN_HEAD"],
+      "satisfied_when": "All applicable external requests are regenerated or verified as bound to the exact reobserved Trusted Main SHA."
+    }
+  },
+  "external_fanout": {
+    "barrier": "P7_DERIVE_BOUND_EXTERNAL_OBLIGATIONS",
+    "edges": {
+      "E1_WIKIPEDIA": {
+        "requires": ["P7_DERIVE_BOUND_EXTERNAL_OBLIGATIONS"],
+        "steps": ["EXECUTE_TRANSPARENT_REQUEST", "AUTHORITATIVE_READBACK"]
+      },
+      "E2_ZENODO": {
+        "requires": ["P7_DERIVE_BOUND_EXTERNAL_OBLIGATIONS"],
+        "steps": ["PUBLISH_BOUND_FILESET", "READBACK_PUBLIC_RECORD_DOI_FILE_HASHES"]
+      },
+      "E3_ARXIV": {
+        "requires": ["P7_DERIVE_BOUND_EXTERNAL_OBLIGATIONS"],
+        "steps": ["AUTHENTICATED_SUBMIT", "READBACK_SUBMISSION_ID_STATUS", "LATER_READBACK_PUBLIC_ID_VERSION"]
+      }
+    },
+    "cross_edge_order": "NONE_AFTER_COMMON_BARRIER",
+    "meaning": "Wikipedia, Zenodo and arXiv are independent branches after exact Trusted Main reobservation; no artificial order is inferred between them."
+  },
+  "scheduler_rule": {
+    "eligible": "A node is eligible iff every direct predecessor is SATISFIED on the exact subject binding required by that node.",
+    "selection": "Execute all eligible independent nodes; never execute a node with an UNSATISFIED, FAILED, STALE, UNKNOWN or UNBOUND predecessor.",
+    "unknown_precedence": "HOLD_UNVERIFIED",
+    "new_knowledge_event": "If newly accepted knowledge changes material intended for any not-yet-promoted integration head, return to P0 and invalidate P1-P7 evidence for the superseded head.",
+    "post_promotion_new_knowledge": "After promotion, new knowledge starts a successor spiral stage; it does not rewrite predecessor evidence and does not transfer predecessor validation to the successor."
+  },
+  "forbidden_shortcuts": [
+    "VALIDATE_BEFORE_LATEST_KNOWLEDGE_IS_MATERIALIZED",
+    "REVIEW_BEFORE_EXACT_HEAD_VALIDATION",
+    "PROMOTE_BEFORE_POST_REVIEW_REOBSERVATION",
+    "DELIVER_BEFORE_EXACT_TRUSTED_MAIN_REOBSERVATION",
+    "INFER_ORDER_FROM_FILE_LIST_ORDER",
+    "INFER_ORDER_FROM_TIMESTAMP_ONLY",
+    "INFER_ORDER_FROM_PR_NUMBER_ONLY",
+    "TRANSFER_PREDECESSOR_EVIDENCE",
+    "TREAT_UNSPECIFIED_RELATION_AS_PARALLEL_OR_COMPLETE"
+  ],
+  "current_publication_binding": {
+    "integration_pr": 966,
+    "predecessor_material": [964, 962, 965],
+    "external_obligations": [
+      "LEAN_LAKE_PROOF_STATUS_TO_WIKIPEDIA_V1",
+      "PLANCK_TICK_GAP_LAW_TO_ZENODO_V1",
+      "PLANCK_TICK_GAP_LAW_TO_ARXIV_V1"
+    ]
+  },
+  "completion_claims": {
+    "PASS": false,
+    "FINAL_PASS": false,
+    "EFFECT_ACK_DONE": false
+  }
+}
diff --git a/policy/QIKVRT_GOLDKELCH_MONITOR_TERMINAL_AUTHORITY_V1.json b/policy/QIKVRT_GOLDKELCH_MONITOR_TERMINAL_AUTHORITY_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..63dc91bb97fd7c16ba328b8932755a0a45a6d27c
--- /dev/null
+++ b/policy/QIKVRT_GOLDKELCH_MONITOR_TERMINAL_AUTHORITY_V1.json
@@ -0,0 +1,60 @@
+{
+  "schema": "qikvrt_goldkelch_monitor_terminal_authority_v1",
+  "authority_node": "Goldkelch/qik-vrt",
+  "authority_terminal": {
+    "implementation_profile": "policy/QIKVRT_UNIVERSAL_TERMINAL_VIRTUALIZATION_V1.json",
+    "browser": "Firefox",
+    "effect_ack_http_daemon": "src/qikvrt_effect_ack_http_terminal.py",
+    "runtime": "POSIX-compatible Linux userspace packaged as OCI container",
+    "terminal_use": "GOLDKELCH_NODE_ONLY",
+    "protected_effects_require": [
+      "exact_subject_binding",
+      "prepare",
+      "single_use_commit",
+      "post_effect_reobservation",
+      "authoritative_effect_ack"
+    ]
+  },
+  "vercel_projection": {
+    "role": "PUBLIC_OR_MESH_VISIBLE_MONITOR_ONLY",
+    "terminal_capability": false,
+    "write_capability": false,
+    "effect_commit_capability": false,
+    "purpose": "Project Goldkelch's latest repository-native terminal state, exact subject binding, receipts, successor and HOLD information without exposing the authority terminal itself."
+  },
+  "mesh_node_contract": {
+    "non_authority_nodes": "MONITOR_ONLY",
+    "on_observed_projection_change": [
+      "DO_NOT_INFER_EFFECT_FROM_PROJECTION",
+      "REQUEST_EXACT_CHANGE_FROM_GOLDKELCH_AUTHORITY",
+      "READ_BACK_EXACT_AUTHORITY_SUBJECT_AND_RECEIPT",
+      "INTEGRATE_ONLY_NEW_EXACT_BOUND_EVIDENCE_LOCALLY",
+      "REOBSERVE_LOCAL_EXACT_SUBJECT",
+      "EMIT_LOCAL_RECEIPT_OR_HOLD"
+    ],
+    "predecessor_evidence_transfer": false,
+    "timestamp_order_is_causality": false
+  },
+  "discovery_model": {
+    "analogy": "DNS-like discovery plus repository-native exact-subject effect acknowledgement",
+    "normative_claim": "ENGINEERING_DISCOVERY_AND_ORCHESTRATION_PROFILE",
+    "not_claimed": [
+      "replacement of Internet DNS",
+      "protocol-standard status",
+      "universal deployment",
+      "empirical proof of anticipation or intuition",
+      "PASS",
+      "FINAL_PASS",
+      "EFFECT_ACK_DONE without exact readback"
+    ]
+  },
+  "orchestration_extensions": {
+    "protocol_adapters_may_include": ["SNMP", "HTTP", "DNS", "repository events"],
+    "rule": "Adapters translate observations into bounded exact-subject work units; they do not bypass Effect Acknowledgement semantics."
+  },
+  "identity_boundary": {
+    "biometric_methods_may_include": ["face", "fingerprint", "voice"],
+    "biometric_data_must_not_be_repository_material": true,
+    "authentication_is_external_to_terminal_proof": true
+  }
+}
diff --git a/policy/QIKVRT_REQUIREMENT_DELIVERY_DOD_V1.json b/policy/QIKVRT_REQUIREMENT_DELIVERY_DOD_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..0d99867cbefd859410acf827076f50e0aeb3744c
--- /dev/null
+++ b/policy/QIKVRT_REQUIREMENT_DELIVERY_DOD_V1.json
@@ -0,0 +1,57 @@
+{
+  "schema": "qikvrt_requirement_delivery_dod_v1",
+  "version": "1.1",
+  "authority": {
+    "product_owner": "Ingolf Lohmann",
+    "repository": "Goldkelch/qik-vrt",
+    "directive": "Jegliches Requirement ist erst erledigt, wenn sein kanonisches Deliverable auf Trusted Main liegt, der exakte Main-Head frisch reobserviert wurde und jede daraus folgende Lieferpflicht ohne erneute menschliche Interaktion mit Effect-Readback erfüllt wurde."
+  },
+  "terminal_states": {
+    "DONE": {
+      "requires_all": [
+        "DELIVERABLE_ON_TRUSTED_MAIN",
+        "EXACT_MAIN_HEAD_REOBSERVED",
+        "ALL_DELIVERY_OBLIGATIONS_EFFECT_ACK_DONE"
+      ]
+    },
+    "NOOP": {
+      "meaning": "No currently applicable delivery obligation exists."
+    },
+    "REQUEST_AUTHORITY": {
+      "meaning": "Only a genuinely external authority decision may stop one affected edge; independent machine-owned obligations continue."
+    }
+  },
+  "forbidden_completion_shortcuts": [
+    "PR_CREATED",
+    "CHECKS_STARTED",
+    "CHECKS_SUCCESSFUL_ON_PREDECESSOR",
+    "REVIEW_REQUESTED",
+    "REVIEW_SUBMITTED",
+    "MERGED",
+    "TRANSPORT_ACK",
+    "HTTP_SUCCESS",
+    "UPLOAD_ACCEPTED",
+    "SUBMISSION_FORM_ACCEPTED_WITHOUT_READBACK",
+    "UNSPECIFIED_EXECUTION_ORDER"
+  ],
+  "invariants": {
+    "predecessor_evidence_never_transfers": true,
+    "merge_is_not_delivery": true,
+    "transport_ack_is_not_effect_ack": true,
+    "external_delivery_requires_authoritative_readback": true,
+    "main_mutation_invalidates_previous_main_reobservation": true,
+    "independent_machine_owned_work_continues_while_one_edge_requests_authority": true,
+    "publication_does_not_imply_empirical_confirmation": true,
+    "publication_does_not_imply_pass_or_final_pass": true,
+    "execution_precedence_is_explicit_and_fail_closed": true,
+    "unspecified_precedence_is_hold_unverified": true
+  },
+  "execution_precedence": "policy/QIKVRT_EXECUTION_PRECEDENCE_V1.json",
+  "delivery_ledger": "state/delivery/ACTIVE_DELIVERY_OBLIGATIONS_V1.json",
+  "effect_ack_contract": "policy/QIKVRT_EFFECT_ACK_HTTP_TERMINAL_V1.json",
+  "completion_claims": {
+    "PASS": false,
+    "FINAL_PASS": false,
+    "EFFECT_ACK_DONE": false
+  }
+}
diff --git a/policy/QIKVRT_UNIVERSAL_TERMINAL_DOD_V1.json b/policy/QIKVRT_UNIVERSAL_TERMINAL_DOD_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..84f392d2eeebc4cd0eee545aaed856199ab7793f
--- /dev/null
+++ b/policy/QIKVRT_UNIVERSAL_TERMINAL_DOD_V1.json
@@ -0,0 +1,29 @@
+{
+  "schema": "qikvrt_universal_terminal_dod_v1",
+  "purpose": "Definition of Done / halting condition for a universal QIK-VRT terminal",
+  "required": {
+    "exact_subject_binding": true,
+    "append_only_live_event_receipt": true,
+    "lean_lake_proof_status_materialized": true,
+    "scientific_category_index_materialized": true,
+    "human_navigable_html": true,
+    "machine_readable_index": true,
+    "recursive_terminal_links_materialized": true,
+    "causal_shortcuts_derived_from_explicit_links": true,
+    "formal_empirical_ontological_boundaries_visible": true
+  },
+  "halt": {
+    "when_all_required_true_on_same_exact_subject": "DONE_WITHIN_DECLARED_MODEL_SCOPE",
+    "otherwise": "HOLD_UNVERIFIED",
+    "head_mutation_resets_completion": true,
+    "predecessor_evidence_transfer": false
+  },
+  "fixed_repository_relative_endpoints": {
+    "human": "docs/science/index.html",
+    "machine": "docs/science/index.json",
+    "proof_status": "docs/science/status.json",
+    "terminal_graph": "docs/science/terminals.json",
+    "live_events": "state/live/QIKVRT_LIVE_EVENTS.jsonl"
+  },
+  "boundary": "Formal verification inside declared models is not empirical confirmation of nature and not an ontological proof."
+}
diff --git a/policy/QIKVRT_UNIVERSAL_TERMINAL_VIRTUALIZATION_V1.json b/policy/QIKVRT_UNIVERSAL_TERMINAL_VIRTUALIZATION_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..e6fee37a39f7d5272fa505c652a974775e9b2b7a
--- /dev/null
+++ b/policy/QIKVRT_UNIVERSAL_TERMINAL_VIRTUALIZATION_V1.json
@@ -0,0 +1,43 @@
+{
+  "schema": "qikvrt_universal_terminal_virtualization_v1",
+  "repository": "Goldkelch/qik-vrt",
+  "components": {
+    "browser": "browser/firefox/qikvrt-terminal",
+    "effect_ack_http_daemon": "src/qikvrt_effect_ack_http_terminal.py",
+    "container": "deploy/universal-terminal/Dockerfile",
+    "compose": "deploy/universal-terminal/compose.yaml"
+  },
+  "network_boundary": {
+    "effect_ack_http_daemon": "LOOPBACK_ONLY_INSIDE_TERMINAL_NAMESPACE",
+    "human_view": "NOVNC_LOOPBACK_BY_DEFAULT",
+    "external_exposure_requires_explicit_operator_network_policy": true
+  },
+  "required_semantics": [
+    "DISCOVER_CAPABILITY",
+    "PREPARE_WITHOUT_PROTECTED_EFFECT",
+    "EXACT_BOUND_SINGLE_USE_COMMIT",
+    "POST_EFFECT_REOBSERVATION",
+    "TRANSPORT_ACK_NOT_EQUAL_EFFECT_ACK",
+    "FAIL_CLOSED_ON_STALE_OR_MISMATCHED_BINDING"
+  ],
+  "portability_claim": {
+    "class": "IMPLEMENTATION_PROFILE",
+    "statement": "The terminal pair is packaged as an OCI-compatible Linux userspace image and therefore targets environments capable of running an OCI/container-compatible Linux userspace or an equivalent virtualization layer.",
+    "not_claimed": [
+      "execution on every physical device",
+      "native equivalence on every ISA or operating system",
+      "universal network reachability",
+      "empirical proof that all information systems implement the profile",
+      "PASS",
+      "FINAL_PASS",
+      "EFFECT_ACK_DONE for any external deployment"
+    ]
+  },
+  "definition_of_done": {
+    "container_build": "REQUIRED",
+    "effect_ack_health_readback": "REQUIRED",
+    "firefox_process_readback": "REQUIRED",
+    "browser_visible_terminal_readback": "REQUIRED",
+    "exact_subject_binding": "REQUIRED"
+  }
+}
diff --git a/state/delivery/ACTIVE_DELIVERY_OBLIGATIONS_V1.json b/state/delivery/ACTIVE_DELIVERY_OBLIGATIONS_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..313884ac20d92a362ae200ccec0ffe83d0a788bc
--- /dev/null
+++ b/state/delivery/ACTIVE_DELIVERY_OBLIGATIONS_V1.json
@@ -0,0 +1,93 @@
+{
+  "schema": "qikvrt_active_delivery_obligations_v1",
+  "version": "1.0",
+  "repository": "Goldkelch/qik-vrt",
+  "policy": "policy/QIKVRT_REQUIREMENT_DELIVERY_DOD_V1.json",
+  "obligations": [
+    {
+      "id": "LEAN_LAKE_PROOF_STATUS_TO_WIKIPEDIA_V1",
+      "source_requirement": "Canonical Lean/Lake proof-status and reproduction entrypoint",
+      "source_pr": 964,
+      "required_main_paths": [
+        "docs/LEAN_LAKE_PROOF_STATUS.md"
+      ],
+      "main_reobservation": {
+        "required": true,
+        "binding": "EXACT_MAIN_HEAD"
+      },
+      "delivery": {
+        "platform": "wikipedia",
+        "mode": "TRANSPARENT_COI_EDIT_REQUEST",
+        "adapter": "QIKVRT_FIREFOX_TERMINAL_PROXY_V1",
+        "request": "state/delivery/requests/WIKIPEDIA_LEAN_LAKE_PROOF_STATUS_V1.json",
+        "effect_ack_required": true,
+        "authoritative_readback": [
+          "wikipedia_revision_or_edit_request_id",
+          "page_or_talk_page_title",
+          "timestamp"
+        ]
+      },
+      "completion": "PENDING"
+    },
+    {
+      "id": "PLANCK_TICK_GAP_LAW_TO_ZENODO_V1",
+      "source_requirement": "Planck-Tick Gap Law scientific publication",
+      "source_pr": 962,
+      "required_main_paths": [
+        "docs/research/2026-09-03-planck-tick-gap-law/QIKVRT_Planck_Tick_Gap_Law_2026-09-03.tex",
+        "physics/planck_tick_gap_law_v1.json",
+        "release/planck-tick-gap-law-zenodo-v1/ZENODO_METADATA.json"
