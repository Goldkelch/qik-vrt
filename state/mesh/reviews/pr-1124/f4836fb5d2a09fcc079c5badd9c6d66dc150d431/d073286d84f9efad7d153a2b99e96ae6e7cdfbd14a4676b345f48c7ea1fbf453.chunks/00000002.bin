@@ -0,0 +1,12 @@
+{
+  "schema": "qikvrt-target-entrypoints-v1",
+  "components": [
+    {"id":"universal-transputer","entrypoint":"next/core/include/qikvrt_transputer.h"},
+    {"id":"meta-transistor","entrypoint":"next/core/src/qikvrt_kernel.c"},
+    {"id":"mesh-bus","entrypoint":"next/core/include/qikvrt_bus.h"},
+    {"id":"temdd","entrypoint":"next/crates/qikvrt/src/compiler.rs"},
+    {"id":"repository-memory","entrypoint":"next/crates/qikvrt/src/store.rs"},
+    {"id":"universal-terminal","entrypoint":"next/crates/qikvrt/src/server.rs"}
+  ],
+  "continuity": "Generate an exact HEAD/TREE catalog with tools/carrier.py catalog. Import as successor registrations; retain predecessor versions and their original bytes."
+}
