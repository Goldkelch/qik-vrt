+  "sections": [
+    "3",
+    "4.1",
+    "4.2"
+  ],
+  "scope": "Finite decision snapshots and factored consumer admission; validators are supplied Boolean results, not implementations of cryptography, parsers or external truth.",
+  "flags": [
+    "transport_ack",
+    "input_identifier_available",
+    "input_digest_valid",
+    "origin_checked",
+    "context_checked",
