+  "rejection": "Index 5 is a harness diagnostic for invalid input, never a sixth wire state. INVALID represents the equivalence class of unsupported values.",
+  "core_rule_semantics": "First matching cube; ones/zeros constrain named bit positions, risk/decision constrain enum indices. Missing constraints are wildcards.",
+  "core_rules": [
+    {
+      "risk": [
