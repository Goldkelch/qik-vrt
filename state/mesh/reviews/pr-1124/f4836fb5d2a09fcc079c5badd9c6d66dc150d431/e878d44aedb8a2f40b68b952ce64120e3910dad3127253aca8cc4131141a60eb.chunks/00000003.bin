diff --git a/policy/QIKVRT_GLOBAL_NOOP_EXCLUSION_V1.json b/policy/QIKVRT_GLOBAL_NOOP_EXCLUSION_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..017e47c27d914cea0835d6b0f7f7cfc335551123
--- /dev/null
+++ b/policy/QIKVRT_GLOBAL_NOOP_EXCLUSION_V1.json
@@ -0,0 +1,49 @@
+{
+  "schema": "QIKVRT_GLOBAL_NOOP_EXCLUSION_V1",
+  "owner": "Ingolf Lohmann",
+  "statement": "Solange ein handlungsrelevantes Issue, offener PR, nicht integrierter Arbeitsbranch, Queue-Eintrag oder erforderlicher Successor existiert, ist repositoryweiter NOOP logisch unzulässig. Lokale Idempotenz bleibt zulässig und ist kein Gesamtabschluss.",
+  "repository_noop": {
+    "admissible_iff": {
+      "open_actionable_issues": 0,
+      "open_pull_requests": 0,
+      "unintegrated_work_branches": 0,
+      "pending_queue_or_work_units": 0,
+      "required_successors_or_writers": 0,
+      "exact_main_verification": "PASS"
+    },
+    "otherwise": "NOOP_EXCLUDED",
+    "missing_or_incomplete_observation": "HOLD_UNVERIFIED",
+    "does_not_establish": ["ZERO_BUGS", "EFFECT_ACK_DONE"]
+  },
+  "local_completion": {
+    "may_report": "LOCAL_COMPLETE",
+    "must_not_imply": ["REPOSITORY_NOOP", "ZERO_BUGS", "EFFECT_ACK_DONE"],
+    "idempotent_wire_state": "NOOP",
+    "state_scope": "LOCAL_OPERATION",
+    "unscoped_legacy_noop": "LOCAL_OR_UNKNOWN_NEVER_GLOBAL",
+    "empty_repeat_commit": "FORBIDDEN",
+    "remaining_productive_work": "CONTINUE_ON_NEXT_ADMISSIBLE_CAUSAL_EDGE",
+    "unknown_remaining_work": "REOBSERVE_WITHOUT_COMPLETION_CLAIM"
+  },
+  "evidence_binding": {
+    "identity": ["repository", "actual_checkout_head", "actual_checkout_tree"],
+    "job_executed": true,
+    "validation_passed": true,
+    "worktree_clean": true,
+    "candidate_validation_transferred": false,
+    "event_head_is_checkout_proof": false,
+    "synthetic_merge_counts_as_literal_head": false,
+    "equal_tree_transfers_commit_validation": false,
+    "materialization_success_is_persistence": false,
+    "source_binding_is_validation": false,
+    "missing_or_ambiguous_binding": "HOLD_UNVERIFIED",
+    "green_job_is_full_p2": false,
+    "p2_is_review_main_or_effect": false
+  },
+  "shared_guard": "tools/qikvrt_evidence_scope.py",
+  "regression_test": "tests/test_qikvrt_evidence_scope.py",
+  "scope": ["AI_ENTRYPOINT", "CONTROLLERS", "WORKFLOWS", "RECEIPTS", "TERMINAL", "API", "AUTHORITY", "MIRROR"],
+  "history": "PRESERVE_PREDECESSOR_RECEIPTS_WITHOUT_TRANSFERRING_VALIDITY",
+  "head_mutation": "RESET_P2_PLUS",
+  "proof_marker": "q.e.d. Ingolf Lohmann"
+}
diff --git a/policy/QIKVRT_RECURSIVE_BLOCKER_SEARCH_V1.json b/policy/QIKVRT_RECURSIVE_BLOCKER_SEARCH_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..8dfc75d614a0c264b7530f2aa8e97dbdd186a496
--- /dev/null
+++ b/policy/QIKVRT_RECURSIVE_BLOCKER_SEARCH_V1.json
@@ -0,0 +1,57 @@
+{
+  "schema": "qikvrt_recursive_blocker_search_v1",
+  "version": 1,
+  "purpose": "Find and eliminate repository blockers by recursively combining breadth-first blocker discovery with depth-first causal closure.",
+  "predecessor_evidence_transfer": false,
+  "algorithm": {
+    "outer": "BFS",
+    "outer_scope": [
+      "technical_closure",
+      "integrity",
+      "validation",
+      "review_admission",
+      "native_review",
+      "ruleset_authority",
+      "main_adoption",
+      "deployment",
+      "effect_readback"
+    ],
+    "inner": "DFS",
+    "inner_rule": "For the first actionable blocker, descend to the first deterministic causal closure boundary before mutating anything.",
+    "return_rule": "After closure and fresh validation, return to BFS and reobserve the complete blocker frontier."
+  },
+  "closure_invariant": [
+    "TYPE",
+    "EXPLICIT_CLOSURE_RULE",
+    "BOUNDED_MUTATION",
+    "PERSISTENCE",
+    "EXACT_HEAD_TREE_READBACK",
+    "FRESH_VALIDATION"
+  ],
+  "head_mutation_rule": "Any HEAD/TREE mutation resets validation and all downstream evidence bindings for that subject.",
+  "fail_closed": {
+    "unknown": "HOLD_UNVERIFIED",
+    "stale": "HOLD_UNVERIFIED",
+    "missing_readback": "HOLD_UNVERIFIED",
+    "missing_fresh_validation": "HOLD_UNVERIFIED",
+    "transport_ack_is_effect_ack": false,
+    "workflow_success_is_closure": false,
+    "draft_hold_with_remaining_actionable_work_is_terminal": false
+  },
+  "technical_fixpoint": {
+    "all_required": true,
+    "predicates": [
+      "work_remaining == 0",
+      "no_known_technical_closure_missing",
+      "all_required_evidence_bound_to_current_subject"
+    ]
+  },
+  "separation": {
+    "technical_validation": "does_not_imply_review",
+    "review": "does_not_imply_main",
+    "main": "does_not_imply_deployment",
+    "deployment": "does_not_imply_effect",
+    "effect": "requires_its_own_readback"
+  },
+  "termination": "Stop only when a fresh BFS frontier contains no actionable blocker in the declared target scope and the applicable fixpoint/effect predicates are independently satisfied."
+}
diff --git a/policy/QIKVRT_REPOSITORY_DOD_V1.json b/policy/QIKVRT_REPOSITORY_DOD_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..2d9b40cdfef919809daf7417246799540c3e1b96
--- /dev/null
+++ b/policy/QIKVRT_REPOSITORY_DOD_V1.json
@@ -0,0 +1,65 @@
+{
+  "schema": "qikvrt_repository_dod_v1",
+  "version": "1.1.0",
+  "repository": "Goldkelch/qik-vrt",
+  "composes": [
+    "policy/GLOBAL_SYSTEM_CLOSURE_V1.json",
+    "policy/QIKVRT_EXECUTION_PRECEDENCE_V1.json",
+    "policy/ZERO_BUG_CONTINUOUS_V1.json",
+    "policy/GITHUB_MAIN_RULESET_V1.json",
+    "src/qikvrt_effect_ack.py"
+  ],
+  "exact_conjunction": true,
+  "done_iff_all": [
+    "ZERO_BUGS",
+    "ALL_PULL_REQUESTS_REGARDED",
+    "ALL_BRANCHES_REGARDED",
+    "ALL_PRODUCTIVE_BRANCHES_MERGED",
+    "FRESH_EXACT_MAIN_VALIDATION_PASS",
+    "FRESH_EXACT_MAIN_EFFECT_READBACK"
+  ],
+  "pull_request_dispositions": [
+    "MERGE",
+    "SUPERSEDE",
+    "CLOSE_AS_REDUNDANT",
+    "REJECT_WITH_EVIDENCE"
+  ],
+  "branch_dispositions": [
+    "MERGED",
+    "SUPERSEDED",
+    "REDUNDANT",
+    "HISTORICAL/RETAINED_BY_POLICY",
+    "PRODUCTIVE_CURRENT_CANDIDATE",
+    "PRODUCTIVE_UNMERGED"
+  ],
+  "evidence": {
+    "finite_inventory_required": true,
+    "exact_subject_head_and_tree_required": true,
+    "predecessor_evidence_transfer": false,
+    "unknown_or_incomplete_inventory": "HOLD_UNVERIFIED",
+    "transport_ack_is_effect_ack": false,
+    "green_local_gates_imply_repository_done": false
+  },
+  "separation": {
+    "queue_state_is_dod_conjunct": false,
+    "open_issue_count_is_dod_conjunct": false,
+    "ruleset_current_is_dod_conjunct": false,
+    "ruleset_current_remains_promotion_gate": true,
+    "noop_policy_may_be_stricter_than_dod": true,
+    "main_validation_does_not_imply_effect": true,
+    "effect_does_not_compensate_repository_red": true
+  },
+  "execution": {
+    "event_driven": true,
+    "polling_allowed": false,
+    "scheduler_in_core_allowed": false,
+    "native_event_invalidates_projection": true,
+    "freshness_timer_may_only_mark_stale": true,
+    "first_unsatisfied_causal_node_required": true
+  },
+  "terminal": {
+    "done": "DONE",
+    "otherwise": "CONTINUE_OR_HOLD",
+    "effect_ack_done_required": true
+  }
+}
