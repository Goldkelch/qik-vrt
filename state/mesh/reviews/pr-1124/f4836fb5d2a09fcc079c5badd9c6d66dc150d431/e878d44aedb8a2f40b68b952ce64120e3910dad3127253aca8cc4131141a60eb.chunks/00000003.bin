--- /dev/null
+++ b/runtime/toolchains/pharo-13.lock.json
@@ -0,0 +1,20 @@
+{
+  "schema": "qikvrt_pharo_lock_v1",
+  "version": "13.1-4f7563dfe5-vm80b106bb",
+  "platform": "linux-x86_64",
+  "image": {
+    "url": "https://files.pharo.org/image/130/Pharo13.0-SNAPSHOT.build.745.sha.4f7563dfe5.arch.64bit.zip",
+    "sha256": "897668dd548864f74730065de3fa2b1f4b5d3636d4c7d14f91945f0a5ce22590",
+    "file": "Pharo13.0-SNAPSHOT-64bit-4f7563dfe5.image"
+  },
+  "vm": {
+    "url": "https://files.pharo.org/vm/pharo-spur64-headless/Linux-x86_64/PharoVM-v10.3.9+0.33e04bb-Linux-x86_64-bin.zip",
+    "sha256": "80b106bbfd27f4db997e15831978836157043541c1e2b1e29fe3f10839bf78de",
+    "file": "bin/pharo"
+  },
+  "license": "MIT; bundled libraries retain their upstream licenses",
+  "source_authorities": ["https://pharo.org/download", "https://github.com/pharo-project/pharo", "https://github.com/pharo-project/pharo-vm"],
+  "mutable_url_rule": "The expected SHA256 never follows the URL. An upstream replacement blocks until a separately reviewed lock update.",
+  "failure_recovery": "Install into a fresh temporary directory; delete only failed temporary installation. Never replace a verified cache or mutate a base image in place.",
+  "effects": "Interpreter and pure kernel execution only; no publication or authority implied."
+}
