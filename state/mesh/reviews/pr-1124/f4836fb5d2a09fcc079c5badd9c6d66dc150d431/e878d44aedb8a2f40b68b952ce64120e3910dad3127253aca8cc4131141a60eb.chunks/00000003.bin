+        "Version": "2.0.0+dfsg-6.2+b2",
+        "Filename": "pool/main/g/ghdl/ghdl-mcode_2.0.0+dfsg-6.2+b2_amd64.deb",
+        "SHA256": "03ae598a0ac9d0cfd2e10e1861d546f25e1e10e6bdfeaca9103ce2aaa168e3e8"
+      }
+    ]
+  },
+  "python": {
+    "version_contract": ">=3.11 stdlib only",
+    "purpose": "independent conformance, checkpoint import and replay tests"
+  },
+  "cc": {
