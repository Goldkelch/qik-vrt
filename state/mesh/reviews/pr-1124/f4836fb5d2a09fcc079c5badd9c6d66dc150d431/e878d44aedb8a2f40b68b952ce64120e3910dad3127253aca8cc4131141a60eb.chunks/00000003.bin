@@ -5,6 +5,47 @@
   "policy": "policy/QIKVRT_REQUIREMENT_DELIVERY_DOD_V1.json",
   "obligations": [
     {
+      "id": "AI_PERSONAL_FIREFOX_V1",
+      "source_requirement": "Product Owner prioritizes the personalized intelligent Firefox behind /AI for every visitor, with full EFFECT_ACK and universal terminal behavior.",
+      "priority": "PRIMARY_PRODUCT_OBLIGATION",
+      "required_main_paths": [
+        "AI",
+        "docs/AI/index.html",
+        "browser/firefox/qikvrt-terminal/manifest.json",
+        "browser/firefox/qikvrt-terminal/content.js",
+        "policy/QIKVRT_EFFECT_ACK_HTTP_TERMINAL_V1.json",
+        "docs/terminal/FIREFOX_EFFECT_ACK_TERMINAL_PROXY_V1.md"
+      ],
+      "main_reobservation": {
+        "required": true,
+        "binding": "EXACT_MAIN_HEAD"
+      },
+      "delivery": {
+        "platform": "qikvrt_public_browser",
+        "mode": "PERSONAL_FIREFOX_SESSION_THEN_READBACK",
+        "adapter": "QIKVRT_FIREFOX_TERMINAL_PROXY_V1",
+        "request": "state/delivery/requests/AI_PERSONAL_FIREFOX_V1.json",
+        "effect_ack_required": true,
+        "authoritative_readback": [
+          "entrypoint_route_receipt",
+          "deployed_main_sha",
+          "deployed_image_digest",
+          "firefox_build",
+          "adapter_package_sha256",
+          "supported_extension_distribution_receipt",
+          "distinct_visitor_isolation_receipt",
+          "returning_visitor_profile_receipt",
+          "firefox_chrome_locale_receipt",
+          "terminal_locale_receipt",
+          "effect_ack_conformance_receipt",
+          "universal_terminal_dod_receipt",
+          "post_effect_authoritative_readback",
+          "observed_at"
+        ]
+      },
+      "completion": "PENDING"
+    },
+    {
       "id": "LEAN_LAKE_PROOF_STATUS_TO_WIKIPEDIA_V1",
