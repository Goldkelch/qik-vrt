diff --git a/runtime/m68000/temdd_transition.s b/runtime/m68000/temdd_transition.s
new file mode 100644
index 0000000000000000000000000000000000000000..73f7eb025be3bc6da89e1090c89eccdf090d0d12
--- /dev/null
+++ b/runtime/m68000/temdd_transition.s
@@ -0,0 +1,24 @@
+| TEMDD v0.1 fixed-relation transition kernel, Motorola 68000
+| D0 = event: 0 unknown, 1 evidence, 2 blocker; other values fail closed to HOLD.
+| returns D0 = state: 0 HOLD, 1 CONTINUE, 2 SUCCESSOR_REQUIRED
+        .text
+        .globl  temdd_transition_m68000
+        .globl  temdd_transition_call
+temdd_transition_m68000:
+        cmpi.b  #2,%d0
+        beq.s   .blocker
+        cmpi.b  #1,%d0
+        beq.s   .evidence
+        moveq   #0,%d0
+        rts
+.evidence:
+        moveq   #1,%d0
+        rts
+.blocker:
+        moveq   #2,%d0
+        rts
+
+| C ABI adapter used only by the executable differential test.
+temdd_transition_call:
+        move.l  4(%sp),%d0
+        bra.s   temdd_transition_m68000
diff --git a/runtime/temdd/TEMDDRuntime.st b/runtime/temdd/TEMDDRuntime.st
new file mode 100644
index 0000000000000000000000000000000000000000..73012a78347c49f2b04472be35d271def493e8d7
--- /dev/null
+++ b/runtime/temdd/TEMDDRuntime.st
@@ -0,0 +1,19 @@
+"TEMDD v0.1 live Smalltalk semantic kernel. Source form is image-independent."
+Object subclass: #TEMDDRuntime
+    instanceVariableNames: ''
+    classVariableNames: ''
+    package: 'QIKVRT-TEMDD'!
+
+!TEMDDRuntime class methodsFor: 'semantics'!
+transitionFor: event state: state
+    "Finite event transition. HOLD/CONTINUE are never NOOP."
+    (state = #done) ifTrue: [ ^ #done ].
+    (event = #blocker) ifTrue: [ ^ #successorRequired ].
+    (event = #evidence) ifTrue: [ ^ #continue ].
+    ^ #hold
+!
+doneForPredicates: predicates
+    | required |
+    required := #(ZERO_BUGS ALL_PULL_REQUESTS_REGARDED ALL_BRANCHES_REGARDED ALL_PRODUCTIVE_BRANCHES_MERGED FRESH_EXACT_MAIN_VALIDATION_PASS FRESH_EFFECT_READBACK).
+    ^ required allSatisfy: [ :each | predicates includes: each ]
+! !
