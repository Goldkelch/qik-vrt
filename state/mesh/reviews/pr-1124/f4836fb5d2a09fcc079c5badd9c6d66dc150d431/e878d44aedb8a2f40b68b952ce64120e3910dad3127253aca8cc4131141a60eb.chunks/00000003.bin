+      "properties": {
+        "source": {
+          "type": "string",
+          "minLength": 1
+        },
+        "observed_at": {
+          "type": "string",
+          "format": "date-time"
+        }
+      },
+      "additionalProperties": true
+    },
+    "predecessor_evidence_transfer": {
+      "const": false
+    }
+  }
+}
