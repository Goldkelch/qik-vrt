diff --git a/schemas/temdd-conformance-report-v1.schema.json b/schemas/temdd-conformance-report-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..bbffa44035c0a9c0d7f702f14e8e15db56c4e94c
--- /dev/null
+++ b/schemas/temdd-conformance-report-v1.schema.json
@@ -0,0 +1,175 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-conformance-report-v1.schema.json",
+  "title": "TEMDD conformance report v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "temdd_conformance",
+    "implementation",
+    "suite",
+    "execution_receipt_digest",
+    "language",
+    "ir",
+    "event_semantics",
+    "ledger",
+    "ide",
+    "evidence_binding",
+    "causality",
+    "effect_ack",
+    "execution",
+    "formal_invariants",
+    "tests",
+    "negative_vectors",
+    "overall"
+  ],
+  "properties": {
+    "schema": {
+      "const": "temdd_conformance_report_v1"
+    },
+    "temdd_conformance": {
+      "const": "1"
+    },
+    "implementation": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "repository",
+        "head",
+        "tree",
+        "digest"
+      ],
+      "properties": {
+        "repository": {
+          "type": "string",
+          "minLength": 1
+        },
+        "head": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{40}$"
+        },
+        "tree": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{40}$"
+        },
+        "digest": {
+          "type": "string",
+          "pattern": "^sha256:[0-9a-f]{64}$"
+        }
+      }
+    },
+    "suite": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "version",
+        "digest"
+      ],
+      "properties": {
+        "version": {
+          "const": "1"
+        },
+        "digest": {
+          "type": "string",
+          "pattern": "^sha256:[0-9a-f]{64}$"
+        }
+      }
+    },
+    "execution_receipt_digest": {
+      "type": "string",
+      "pattern": "^sha256:[0-9a-f]{64}$"
+    },
+    "language": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "ir": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "event_semantics": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "ledger": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "ide": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "evidence_binding": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "causality": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "effect_ack": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "execution": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "formal_invariants": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "tests": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "negative_vectors": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "overall": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    }
+  }
+}
diff --git a/schemas/temdd-event-v1.schema.json b/schemas/temdd-event-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..92032c75284338ab41bfbb1f9d734dfd7a60d6e1
--- /dev/null
+++ b/schemas/temdd-event-v1.schema.json
@@ -0,0 +1,102 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-event-v1.schema.json",
+  "title": "TEMDD event v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "event_id",
+    "event_type",
+    "subject_id",
+    "subject_repository",
+    "subject_head",
+    "subject_tree",
+    "producer",
+    "timestamp",
+    "cause_event_ids",
+    "inputs",
+    "outputs",
+    "evidence_refs",
+    "decision"
+  ],
+  "properties": {
+    "schema": {
+      "const": "temdd_event_v1"
+    },
+    "event_id": {
+      "type": "string",
+      "minLength": 1
+    },
+    "event_type": {
+      "enum": [
+        "REQUEST",
+        "EXECUTE",
+        "FOLLOW",
+        "LEARN",
+        "OBSERVATION",
+        "VALIDATION",
+        "DECISION",
+        "EFFECT",
+        "READBACK",
+        "SUCCESSOR",
+        "HOLD"
+      ]
+    },
+    "subject_id": {
+      "type": "string",
+      "minLength": 1
+    },
+    "subject_repository": {
+      "type": "string",
+      "minLength": 1
+    },
+    "subject_head": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{40}$"
+    },
+    "subject_tree": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{40}$"
+    },
+    "producer": {
+      "type": "string",
+      "minLength": 1
+    },
+    "timestamp": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "cause_event_ids": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "minLength": 1
+      }
+    },
+    "inputs": {
+      "type": "array"
+    },
+    "outputs": {
+      "type": "array"
+    },
+    "evidence_refs": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "minLength": 1
+      }
+    },
+    "decision": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "CONTINUE",
+        "HOLD_UNVERIFIED",
+        "NONE"
+      ]
+    }
+  }
+}
diff --git a/schemas/temdd-evidence-v1.schema.json b/schemas/temdd-evidence-v1.schema.json
