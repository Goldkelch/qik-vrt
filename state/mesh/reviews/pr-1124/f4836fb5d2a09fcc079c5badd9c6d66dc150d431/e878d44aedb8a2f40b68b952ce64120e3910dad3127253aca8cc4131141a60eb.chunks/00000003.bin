+    def test_convergence_repository_list_rejects_malformed_or_duplicate_entries(self):
+        for repositories in (
+            ["Goldkelch/qik-vrt", {"repository": "ingolf-lohmann/qik-vrt"}],
+            ["Goldkelch/qik-vrt", "Goldkelch/qik-vrt"],
