diff --git a/schemas/temdd-conformance-report-v1.schema.json b/schemas/temdd-conformance-report-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..bbffa44035c0a9c0d7f702f14e8e15db56c4e94c
--- /dev/null
+++ b/schemas/temdd-conformance-report-v1.schema.json
@@ -0,0 +1,175 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-conformance-report-v1.schema.json",
+  "title": "TEMDD conformance report v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "temdd_conformance",
+    "implementation",
+    "suite",
+    "execution_receipt_digest",
+    "language",
+    "ir",
+    "event_semantics",
+    "ledger",
+    "ide",
+    "evidence_binding",
+    "causality",
+    "effect_ack",
+    "execution",
+    "formal_invariants",
+    "tests",
+    "negative_vectors",
+    "overall"
+  ],
+  "properties": {
+    "schema": {
+      "const": "temdd_conformance_report_v1"
+    },
+    "temdd_conformance": {
+      "const": "1"
+    },
+    "implementation": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "repository",
+        "head",
+        "tree",
+        "digest"
+      ],
+      "properties": {
+        "repository": {
+          "type": "string",
+          "minLength": 1
+        },
+        "head": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{40}$"
+        },
+        "tree": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{40}$"
+        },
+        "digest": {
+          "type": "string",
+          "pattern": "^sha256:[0-9a-f]{64}$"
+        }
+      }
+    },
+    "suite": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "version",
+        "digest"
+      ],
+      "properties": {
+        "version": {
+          "const": "1"
+        },
+        "digest": {
+          "type": "string",
+          "pattern": "^sha256:[0-9a-f]{64}$"
+        }
+      }
+    },
+    "execution_receipt_digest": {
+      "type": "string",
+      "pattern": "^sha256:[0-9a-f]{64}$"
+    },
+    "language": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "ir": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "event_semantics": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "ledger": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "ide": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "evidence_binding": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "causality": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "effect_ack": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "execution": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "formal_invariants": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "tests": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "negative_vectors": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    },
+    "overall": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "HOLD_UNVERIFIED"
+      ]
+    }
+  }
+}
diff --git a/schemas/temdd-event-v1.schema.json b/schemas/temdd-event-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..92032c75284338ab41bfbb1f9d734dfd7a60d6e1
--- /dev/null
+++ b/schemas/temdd-event-v1.schema.json
@@ -0,0 +1,102 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-event-v1.schema.json",
+  "title": "TEMDD event v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "event_id",
+    "event_type",
+    "subject_id",
+    "subject_repository",
+    "subject_head",
+    "subject_tree",
+    "producer",
+    "timestamp",
+    "cause_event_ids",
+    "inputs",
+    "outputs",
+    "evidence_refs",
+    "decision"
+  ],
+  "properties": {
+    "schema": {
+      "const": "temdd_event_v1"
+    },
+    "event_id": {
+      "type": "string",
+      "minLength": 1
+    },
+    "event_type": {
+      "enum": [
+        "REQUEST",
+        "EXECUTE",
+        "FOLLOW",
+        "LEARN",
+        "OBSERVATION",
+        "VALIDATION",
+        "DECISION",
+        "EFFECT",
+        "READBACK",
+        "SUCCESSOR",
+        "HOLD"
+      ]
+    },
+    "subject_id": {
+      "type": "string",
+      "minLength": 1
+    },
+    "subject_repository": {
+      "type": "string",
+      "minLength": 1
+    },
+    "subject_head": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{40}$"
+    },
+    "subject_tree": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{40}$"
+    },
+    "producer": {
+      "type": "string",
+      "minLength": 1
+    },
+    "timestamp": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "cause_event_ids": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "minLength": 1
+      }
+    },
+    "inputs": {
+      "type": "array"
+    },
+    "outputs": {
+      "type": "array"
+    },
+    "evidence_refs": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "minLength": 1
+      }
+    },
+    "decision": {
+      "enum": [
+        "PASS",
+        "FAIL",
+        "CONTINUE",
+        "HOLD_UNVERIFIED",
+        "NONE"
+      ]
+    }
+  }
+}
diff --git a/schemas/temdd-evidence-v1.schema.json b/schemas/temdd-evidence-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..0285e736c46c95642366c2544f2ac43c996863fd
--- /dev/null
+++ b/schemas/temdd-evidence-v1.schema.json
@@ -0,0 +1,95 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-evidence-v1.schema.json",
+  "title": "TEMDD evidence v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "evidence_id",
+    "evidence_type",
+    "observed_subject",
+    "producer_event",
+    "content_digest",
+    "freshness",
+    "provenance",
+    "predecessor_evidence_transfer"
+  ],
+  "properties": {
+    "schema": {
+      "const": "temdd_evidence_v1"
+    },
+    "evidence_id": {
+      "type": "string",
+      "minLength": 1
+    },
+    "evidence_type": {
+      "type": "string",
+      "minLength": 1
+    },
+    "observed_subject": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "subject_id",
+        "repository",
+        "head",
+        "tree"
+      ],
+      "properties": {
+        "subject_id": {
+          "type": "string",
+          "minLength": 1
+        },
+        "repository": {
+          "type": "string",
+          "minLength": 1
+        },
+        "head": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{40}$"
+        },
+        "tree": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{40}$"
+        }
+      }
+    },
+    "producer_event": {
+      "type": "string",
+      "minLength": 1
+    },
+    "content_digest": {
+      "type": "string",
+      "pattern": "^sha256:[0-9a-f]{64}$"
+    },
+    "freshness": {
+      "enum": [
+        "FRESH",
+        "STALE",
+        "UNKNOWN"
+      ]
+    },
+    "provenance": {
+      "type": "object",
+      "required": [
+        "source",
+        "observed_at"
+      ],
+      "properties": {
+        "source": {
+          "type": "string",
+          "minLength": 1
+        },
+        "observed_at": {
+          "type": "string",
+          "format": "date-time"
+        }
+      },
+      "additionalProperties": true
+    },
+    "predecessor_evidence_transfer": {
+      "const": false
+    }
+  }
+}
diff --git a/schemas/temdd-ir-v0.1.schema.json b/schemas/temdd-ir-v0.1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..e7654624f586e2e86b9dcafe84b04a77c4c8452a
--- /dev/null
+++ b/schemas/temdd-ir-v0.1.schema.json
@@ -0,0 +1,13 @@
+{
+ "$schema":"https://json-schema.org/draft/2020-12/schema",
+ "$id":"https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v0.1.schema.json",
+ "title":"TEMDD canonical IR v0.1","type":"object","additionalProperties":false,
+ "required":["schema","version","authority","subject","request","handlers","dod"],
+ "properties":{
+  "schema":{"const":"temdd_ir_v0_1"},"version":{"const":"0.1"},"authority":{"type":"string","minLength":1},
+  "subject":{"type":"object","additionalProperties":false,"required":["name","repository","binding"],"properties":{"name":{"type":"string"},"repository":{"type":"string"},"binding":{"const":"exact"}}},
+  "request":{"type":"object","additionalProperties":false,"required":["name","target"],"properties":{"name":{"type":"string"},"target":{"type":"string"}}},
+  "handlers":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["event","statements"],"properties":{"event":{"enum":["event","blocker"]},"statements":{"type":"array","items":{"type":"string"}}}}},
+  "dod":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
+ }
+}
diff --git a/schemas/temdd-ir-v1.schema.json b/schemas/temdd-ir-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..066d8286b5a8e8ba8cf10bed097a7155fb156810
--- /dev/null
+++ b/schemas/temdd-ir-v1.schema.json
@@ -0,0 +1,121 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v1.schema.json",
+  "title": "TEMDD canonical program IR v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "ir_version",
+    "language_version",
+    "authority",
+    "subject",
+    "request",
+    "handlers",
+    "dod",
+    "semantic_contract"
+  ],
+  "properties": {
+    "schema": {
+      "const": "temdd_ir_v1"
+    },
+    "ir_version": {
+      "const": "1"
+    },
+    "language_version": {
+      "type": "string",
+      "minLength": 1
+    },
+    "authority": {
+      "type": "string",
+      "minLength": 1
+    },
+    "subject": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "name",
+        "repository",
+        "binding"
+      ],
+      "properties": {
+        "name": {
+          "type": "string",
+          "minLength": 1
+        },
+        "repository": {
+          "type": "string",
+          "minLength": 1
+        },
+        "binding": {
+          "const": "exact"
+        }
+      }
+    },
+    "request": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "name",
+        "target"
+      ],
+      "properties": {
+        "name": {
+          "type": "string",
+          "minLength": 1
+        },
+        "target": {
+          "type": "string",
+          "minLength": 1
+        }
+      }
+    },
+    "handlers": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "event",
+          "statements"
+        ],
+        "properties": {
+          "event": {
+            "type": "string",
+            "minLength": 1
+          },
+          "statements": {
+            "type": "array",
+            "items": {
+              "type": "string"
+            }
+          }
+        }
+      }
+    },
+    "dod": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "minLength": 1
+      }
+    },
+    "semantic_contract": {
+      "type": "array",
+      "uniqueItems": true,
+      "minItems": 4,
+      "maxItems": 4,
+      "items": {
+        "enum": [
+          "T13_CAUSAL_BINDING",
+          "T14_EVIDENCE_NON_TRANSFER",
+          "T15_EFFECT_CONSTRUCTION",
+          "T16_CONFORMANCE_BINDING"
+        ]
+      }
+    }
+  }
+}
diff --git a/spec/temdd/README.md b/spec/temdd/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..dfaee7bdb1ab1531db01f839dab8a8618c3469c1
--- /dev/null
+++ b/spec/temdd/README.md
@@ -0,0 +1,18 @@
+# TEMDD
+
+Tested Event Model Driven Development is specified here as an executable QIK-VRT metaprogramming language.
+
+Entry points:
+- `TEMDD_LANGUAGE_SPEC_V0_1.md` — normative bootstrap semantics.
+- `TEMDD_Syntax_V0_1.ebnf` — grammar.
+- `../../schemas/temdd-ir-v0.1.schema.json` — canonical IR contract.
+- `../../tools/qikvrt_temdd.py` — deterministic reference parser/elaborator.
+- `../../tools/qikvrt_temdd_conformance.py` — executable T01-T12 semantic checks.
+- `../../tests/temdd/` — positive and fail-closed negative corpus.
+- `../../runtime/temdd/TEMDDRuntime.st` — Smalltalk live-object backend bootstrap.
+- `../../src/temdd_core.c` — C90 deterministic backend.
+- `../../runtime/m68000/temdd_transition.s` — fixed-relation M68000 backend bootstrap.
+- `../../formalization/TEMDDCore.lean` — formal semantic obligations.
+- `../../examples/temdd/qikvrt_convergence_v0_1.temdd` — first dogfood production program.
+
+Language evolution is itself TEMDD: mutation creates a new exact subject; predecessor validation does not transfer; the successor must pass fresh conformance and deployment readback.
diff --git a/spec/temdd/TEMDD_ARCHITECTURE_V0_1.md b/spec/temdd/TEMDD_ARCHITECTURE_V0_1.md
new file mode 100644
index 0000000000000000000000000000000000000000..31c772a76c1e904e9211b7036570df953698156b
--- /dev/null
+++ b/spec/temdd/TEMDD_ARCHITECTURE_V0_1.md
@@ -0,0 +1,7 @@
+# TEMDD architecture v0.1
+
+TEMDD is the single normative semantic core. Python, Smalltalk, C90, M68000, Lean, GitHub Actions and deployment systems are projections or adapters, not independent control-plane semantics.
+
+The architecture is layered: language source; deterministic frontend; canonical typed IR; semantic conformance; backend projections; transport adapters; effect executors; readback observers. Only the semantic core decides status. Transport layers may deliver events but may not synthesize authority, evidence, DONE or EFFECT_ACK.
+
+This separation permits gradual replacement of duplicated Python/YAML control logic while preserving observable behavior through shared vectors and exact-subject evidence.
