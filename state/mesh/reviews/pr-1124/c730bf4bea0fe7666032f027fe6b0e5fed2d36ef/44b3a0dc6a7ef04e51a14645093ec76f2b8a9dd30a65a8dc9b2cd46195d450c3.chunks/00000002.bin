+        self.assertNotIn(str(self.saved()['id']), selected.stdout.splitlines())
+
+
+
+    def test_workflow_run_serializes_by_pr_not_source_run(self) -> None:
+        text = WORKFLOW.read_text(encoding='utf-8')
