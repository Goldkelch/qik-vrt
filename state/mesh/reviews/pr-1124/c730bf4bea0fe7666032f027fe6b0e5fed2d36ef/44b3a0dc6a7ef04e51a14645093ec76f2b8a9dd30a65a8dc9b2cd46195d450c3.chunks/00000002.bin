+        self.assertEqual(len(self.writes()), 1)
+        self.assertTrue(self.receipt()['duplicate'])
+        self.assertEqual(self.receipt()['source_head'], HEAD)
+
+    def test_workflow_run_and_pr_events_share_the_pr_serialization_key(self) -> None:
