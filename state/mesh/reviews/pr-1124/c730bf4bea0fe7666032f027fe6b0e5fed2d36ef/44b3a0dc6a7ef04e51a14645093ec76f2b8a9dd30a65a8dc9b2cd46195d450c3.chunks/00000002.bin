+
+    def test_duplicate_id_cannot_hide_conflicting_source_payload(self) -> None:
+        first = self.run_event(comments=[self.comment()])
+        self.assertEqual(first.returncode, 0, first.stderr)
+        path = self.root / 'saved.json'
