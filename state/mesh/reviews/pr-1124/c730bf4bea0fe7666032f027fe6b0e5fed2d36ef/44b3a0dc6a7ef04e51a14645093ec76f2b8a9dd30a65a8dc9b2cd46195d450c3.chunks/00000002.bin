index 0000000000000000000000000000000000000000..fbe6412a47d753c74072ad6eceecab783ae84ad5
--- /dev/null
+++ b/docs/terminal/QIKVRT_CLOUD_TRANSPUTER_MATERIALIZATION_V1.md
@@ -0,0 +1,27 @@
+# QIK-VRT Cloud Transputer materialization v1
+
+Recovered sources: PR #1039 (Cloud Transputer v1), PR #1040 (observable Universal Terminal service plane), and Ingolf Lohmann's recovered QIK-VRT boundary description linking the four operational states directly to the Motorola-68000 D0 ABI.
+
+## Executable contract
+
+One OCI image provides Firefox ESR + Xvfb + x11vnc + noVNC, nginx, OpenSSH, bounded SMTP sink, BIND DNS, Net-SNMP, PostgreSQL, Git mirror support, the QIK-VRT terminal/effect HTTP plane, an ISO-C90 IP bootstrap probe, and an MC68000 cross-development/runtime path (`gcc-m68k-linux-gnu` + `qemu-m68k`).
+
+The MC68000-visible boundary contract now separates two concepts that were previously conflated:
+
+- `D0[1:0]` is the invariant four-state QIK-VRT/TEMDD decision ABI: `0=NOOP`, `1=HOLD`, `2=REOBSERVE`, `3=REQUEST_AUTHORITY`.
+- `0-1-2-4` is the binary composition hierarchy: zero/unset plus orthogonal weights `1`, `2`, `4`, ... . The value `3` is not a new primitive weight; it is `1+2`. Weight `4` opens the next independent composition dimension and must not redefine the meanings carried by `D0[1:0]`.
+- The five-state EFFECT_ACK protocol remains `NACK=0`, `CONTINUE=1`, `ISOLATE=2`, `BLOCK=3`, `DONE=4`, but it is a separate semantic state machine and is bound to `D4` in this MC68000 contract. Ordinary release remains permitted only from stable `EFFECT_ACK_DONE`.
+
+A statically linked `-m68000` executable witness is built inside the image and executed with qemu-m68k. It checks both state machines, verifies that D0 rejects bit weight 4 as part of the boundary code, and prints the preserved composition relation `3=1+2` and next orthogonal weight `4`. This is M68000-family machine-code execution in the emulator path, not a claim of physical 68000 hardware execution.
+
+## Infrastructure as Code / IP bootstrap
+
+`deploy/universal-terminal/compose.yaml` materializes a fixed `10.73.0.0/24` Mesh. The terminal occupies `10.73.0.2`, SQL `10.73.0.3`, Authority-connected mirror `10.73.0.4`, and the MC68000 development role `10.73.0.6`; service roles occupy additional fixed addresses. The recovered bootstrap contract uses server `10.73.0.1`, UDP discovery port 7331, client `10.73.0.2`, artifact `QIKVRT_BOOT.BIN`, 128-byte chunks, 2-second timeout, three retries and FNV1a32 over the discover/offer/request/data/done route.
+
+The persistent `/var/lib/qikvrt/personal-posix` volume is the owner source slot. If `build-qikvrt-m68k.sh` exists it is invoked with MC68000 C90 compiler/runner bindings. `QIKVRT_REQUIRE_PERSONAL_POSIX=1` makes absence fail closed rather than silently claiming a complete personal POSIX implementation.
+
+## Boundary and effect semantics
+
+The four operational D0 values answer only: **what may happen next?** They are not the five EFFECT_ACK protocol states. The latter answer a different question about the effect-verification lifecycle. Keeping both machines separate prevents `EFFECT_ACK_DONE=4` from being misread as a fifth D0 boundary decision.
+
+`TRANSPORT_ACK != EFFECT_ACK`. Container build, network reachability, emulator execution, authorization and physical effect remain independently observable facts. A public deployment, physical MC68000 execution, physical effect, or general EFFECT_ACK_DONE requires its own readback.
diff --git a/docs/terminal/temdd/index.html b/docs/terminal/temdd/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..2c32118f30c37d8393ae174b06aedb3ece1fe4c0
--- /dev/null
+++ b/docs/terminal/temdd/index.html
@@ -0,0 +1,97 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>QIK-VRT TEMDD Live Universal Terminal</title><style>body{margin:0;background:#090c10;color:#e8edf2;font:14px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}main{max-width:1280px;margin:auto;padding:18px}.grid{display:grid;grid-template-columns:1fr 2fr;gap:14px}.p{background:#11171e;border:1px solid #303a46;border-radius:12px;padding:16px}.meta{display:grid;grid-template-columns:110px 1fr;gap:6px}.muted{color:#8d9aaa}.ok{color:#68d391}.hold{color:#ecc94b}#tail{height:68vh;overflow:auto;white-space:pre-wrap;background:#070a0d;padding:12px;border-radius:8px}.badge{border:1px solid #43505e;border-radius:99px;padding:2px 8px}button{background:#18212b;color:#e8edf2;border:1px solid #43505e;border-radius:7px;padding:6px 10px}.ide-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:12px}.ide-grid textarea,.ide-grid pre{width:100%;box-sizing:border-box;min-height:320px;background:#070a0d;color:#e8edf2;border:1px solid #303a46;border-radius:8px;padding:10px;font:13px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.ide-actions{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.ide-status{white-space:pre-wrap}.ide-status.ok{color:#68d391}.ide-status.hold{color:#ecc94b}@media(max-width:800px){.grid,.ide-grid{grid-template-columns:1fr}#tail{height:55vh}}</style></head><body><main><h1>QIK-VRT · TEMDD LIVE UNIVERSAL TERMINAL <span id="state" class="badge hold">CONNECTING</span></h1><p class="muted">Observer lifetime ≠ execution lifetime · exact-subject evidence · fail-closed · replayable event cursor</p><div class="grid"><section class="p"><h2>Exact checkout subject</h2><div class="meta"><span class="muted">Authority</span><span id="repository">—</span><span class="muted">PR</span><span id="pr">—</span><span class="muted">HEAD</span><span id="head">—</span><span class="muted">TREE</span><span id="tree">—</span><span class="muted">Event ID</span><span id="cursor">—</span><span class="muted">DoD</span><span id="dod" class="hold">NOT PROVEN</span></div><h2>Transport</h2><p id="transport">discovering local native stream…</p><button id="reconnect">RECONNECT</button><p class="muted">Ledger persistence is not validation, review, promotion, or EFFECT_ACK_DONE. A deployed checkout is not a fresh remote PR-head observation.</p></section><section class="p"><h2>tail -f</h2><div id="tail"></div></section></div>
+<section class="p" id="ide"><h2>TEMDD v0.1 IDE · local analysis only</h2>
+<p class="muted">Editieren und Analysieren ist lokal. Browser-Analyse erzeugt keinen nativen Event, keine Authority und keinen Effect. Ausführung bleibt am repository-nativen/Unix-Ingress mit frischem Readback.</p>
+<div class="ide-actions"><button id="ideExample" type="button">BEISPIEL LADEN</button><button id="ideAnalyze" type="button">ANALYZE → IR</button><button id="ideCopy" type="button">IR KOPIEREN</button></div>
+<div class="ide-grid"><label>TEMDD source<textarea id="ideSource" spellcheck="false" autocomplete="off"></textarea></label><label>Typed diagnostic IR<pre id="ideIr">NO_ANALYSIS</pre></label></div>
+<p id="ideStatus" class="ide-status hold">LOCAL_ONLY · NO EFFECT</p>
+</section></main><script>
+'use strict';
+const TEMDD_DOD=new Set(['ZERO_BUGS','ALL_PULL_REQUESTS_REGARDED','ALL_BRANCHES_REGARDED','ALL_PRODUCTIVE_BRANCHES_MERGED','FRESH_EXACT_MAIN_VALIDATION_PASS','FRESH_EFFECT_READBACK']);
+const TEMDD_EXAMPLE=`temdd 0.1;
+authority owner = "Goldkelch/qik-vrt";
+subject convergence {
+  repository = "Goldkelch/qik-vrt";
+  binding = exact;
+}
+request finish_qikvrt { target = QIKVRT_DOD; }
+on event {
+  follow exact;
+  classify causal;
+}
+on blocker {
+  learn smallest_sound_successor;
+  execute successor;
+}
+until {
+  ZERO_BUGS
+  && ALL_PULL_REQUESTS_REGARDED
+  && ALL_BRANCHES_REGARDED
+  && ALL_PRODUCTIVE_BRANCHES_MERGED
+  && FRESH_EXACT_MAIN_VALIDATION_PASS
+  && FRESH_EFFECT_READBACK;
+}`;
+function ideEl(id){return document.getElementById(id)}
+function temddMatch(re,text,label){const m=text.match(re);if(!m)throw Error('missing '+label);return m}
+function analyzeTemdd(text){
+ const version=temddMatch(/^\s*temdd\s+([0-9.]+)\s*;/s,text,'version')[1];
+ if(version!=='0.1')throw Error('unsupported version');
+ const authority=temddMatch(/authority\s+[A-Za-z][A-Za-z0-9_-]*\s*=\s*"([^"]+)"\s*;/s,text,'authority')[1];
+ const subject=temddMatch(/subject\s+([A-Za-z][A-Za-z0-9_-]*)\s*\{([\s\S]*?)\}/,text,'subject');
+ const repository=temddMatch(/repository\s*=\s*"([^"]+)"\s*;/s,subject[2],'repository')[1];
+ temddMatch(/binding\s*=\s*exact\s*;/s,subject[2],'exact binding');
+ const request=temddMatch(/request\s+([A-Za-z][A-Za-z0-9_-]*)\s*\{\s*target\s*=\s*([A-Za-z][A-Za-z0-9_-]*)\s*;\s*\}/s,text,'request');
+ const handlers=[...text.matchAll(/on\s+(event|blocker)\s*\{([\s\S]*?)\}/g)].map(m=>({event:m[1],statements:m[2].split(';').map(x=>x.trim()).filter(Boolean)}));
+ const until=temddMatch(/until\s*\{([\s\S]*?)\}/,text,'until')[1].trim().replace(/;\s*$/,'');
+ const dod=until.split('&&').map(x=>x.trim()).filter(Boolean);
+ if(!handlers.length||!dod.length)throw Error('handlers and DoD required');
+ if(new Set(dod).size!==dod.length)throw Error('duplicate DoD predicate');
+ if(request[2]==='QIKVRT_DOD'&&(dod.length!==TEMDD_DOD.size||dod.some(x=>!TEMDD_DOD.has(x))))throw Error('QIKVRT_DOD requires complete canonical predicate');
+ return {schema:'temdd_ir_v0_1',version,authority,subject:{name:subject[1],repository,binding:'exact'},request:{name:request[1],target:request[2]},handlers,dod};
+}
+let ideIr=null;
+ideEl('ideExample').onclick=()=>{ideEl('ideSource').value=TEMDD_EXAMPLE;ideEl('ideStatus').textContent='EXAMPLE_LOADED · LOCAL_ONLY · NO EFFECT';ideEl('ideStatus').className='ide-status hold'};
+ideEl('ideAnalyze').onclick=()=>{try{ideIr=analyzeTemdd(ideEl('ideSource').value);ideEl('ideIr').textContent=JSON.stringify(ideIr,null,2);ideEl('ideStatus').textContent='BOOTSTRAP_CONFORMANT_LOCAL_ANALYSIS · NO EFFECT';ideEl('ideStatus').className='ide-status ok'}catch(e){ideIr=null;ideEl('ideIr').textContent='BLOCK '+e.message;ideEl('ideStatus').textContent='HOLD · '+e.message;ideEl('ideStatus').className='ide-status hold'}};
+ideEl('ideCopy').onclick=()=>{if(!ideIr){ideEl('ideStatus').textContent='HOLD · analyze valid TEMDD first';return}navigator.clipboard.writeText(JSON.stringify(ideIr,null,2)).then(()=>{ideEl('ideStatus').textContent='IR_COPIED · TRANSPORT_ACK != EFFECT_ACK'}).catch(e=>{ideEl('ideStatus').textContent='HOLD · copy failed: '+e.message})};
+ideEl('ideSource').value=TEMDD_EXAMPLE;
+const tail=document.getElementById('tail'),state=document.getElementById('state'),cursorEl=document.getElementById('cursor');
+let es=null,cursor='',exactSubject=null,ledgerId='',cursorKey='',generation=0;
+function line(kind,msg){tail.textContent+=`${new Date().toISOString()}  ${kind.padEnd(10)} ${msg}\n`;tail.scrollTop=tail.scrollHeight;}
+function setState(s,c){state.textContent=s;state.className='badge '+c;}
+function hold(reason){setState('HOLD','hold');document.getElementById('dod').textContent='NOT PROVEN';line('HOLD',reason);}
+function validSubject(s){return s&&Object.keys(s).sort().join(',')==='head,pr,repository,tree'&&typeof s.repository==='string'&&Number.isInteger(s.pr)&&s.pr>0&&/^[0-9a-f]{40}$/.test(s.head)&&/^[0-9a-f]{40}$/.test(s.tree);}
+function sameSubject(a,b){return validSubject(a)&&validSubject(b)&&['repository','pr','head','tree'].every(k=>a[k]===b[k]);}
+function sequence(id){const m=/^([0-9a-f]{32}):([1-9][0-9]{0,18})$/.exec(id);if(!m||m[1]!==ledgerId)throw Error('foreign or malformed ledger cursor');return BigInt(m[2]);}
+async function connect(){
+  const current=++generation;if(es)es.close();es=null;setState('CONNECTING','hold');
+  try{
+    const r=await fetch('/api/temdd/subject',{cache:'no-store'});if(!r.ok)throw Error('exact checkout readback unavailable');
+    const x=await r.json();if(current!==generation)return;
+    if(!validSubject(x.subject)||!/^[0-9a-f]{32}$/.test(x.ledger_id)||x.dod!==false||x.evidence_transfer!=='DENY')throw Error('invalid exact-subject envelope');
+    exactSubject=x.subject;ledgerId=x.ledger_id;
+    cursorKey='qikvrt.temdd.cursor:'+JSON.stringify([ledgerId,exactSubject.repository,exactSubject.pr,exactSubject.head,exactSubject.tree]);
+    cursor=localStorage.getItem(cursorKey)||'';if(cursor)sequence(cursor);
+    for(const key of ['repository','pr','head','tree'])document.getElementById(key).textContent=exactSubject[key];
+    cursorEl.textContent=cursor||'—';line('SUBJECT',JSON.stringify(exactSubject));
+    const url='/api/temdd/events'+(cursor?'?after='+encodeURIComponent(cursor):'');
+    document.getElementById('transport').textContent='SSE '+url;
+    const source=new EventSource(url);es=source;let bound=false;
+    source.onopen=()=>{if(current===generation){bound=false;setState('CONNECTED','hold');}};
+    source.addEventListener('subject',e=>{if(current!==generation)return;try{
+      const s=JSON.parse(e.data);if(!sameSubject(s.subject,exactSubject)||s.ledger_id!==ledgerId||s.dod!==false||s.evidence_transfer!=='DENY')throw Error('stream subject mismatch');
+      bound=true;setState('OBSERVING','ok');line('CONNECT','exact-subject stream bound; DoD remains unproven');
+    }catch(err){source.close();hold(err.message);}});
+    source.onmessage=e=>{if(current!==generation)return;try{
+      const event=JSON.parse(e.data);
+      if(!bound||event.schema!=='qikvrt_temdd_event_v1'||!sameSubject(event.subject,exactSubject)||event.id!==e.lastEventId||event.evidence_transfer!=='DENY'||event.dod!==false)throw Error('unbound or invalid event');
+      const next=sequence(event.id);if(cursor&&next<=sequence(cursor))throw Error('non-monotonic event');
+      if(!/^(OBSERVE|CLASSIFY|ACTION|EFFECT|READBACK|SUCCESSOR|HOLD)$/.test(event.kind)||typeof event.message!=='string')throw Error('invalid event content');
+      line(event.kind,event.message+' · '+event.subject.head+' · '+event.id);
+      localStorage.setItem(cursorKey,event.id);cursor=event.id;cursorEl.textContent=cursor;
+    }catch(err){source.close();hold(err.message);}};
+    source.addEventListener('hold',()=>{if(current===generation){source.close();hold('producer readback unavailable; fresh reconnect required');}});
+    source.onerror=()=>{if(current===generation){bound=false;hold('transport unavailable; native EventSource reconnect retains its cursor; repository execution unchanged');}};
+  }catch(err){if(current===generation)hold(err.message);}
+}
+document.getElementById('reconnect').onclick=connect;connect();
+</script></body></html>
diff --git a/examples/temdd/qikvrt_convergence_v0_1.temdd b/examples/temdd/qikvrt_convergence_v0_1.temdd
new file mode 100644
index 0000000000000000000000000000000000000000..da48c8812b3227758c09d1c0a2d2bedcd7b27242
--- /dev/null
+++ b/examples/temdd/qikvrt_convergence_v0_1.temdd
@@ -0,0 +1,23 @@
+temdd 0.1;
+authority owner = "Goldkelch/qik-vrt";
+subject convergence {
+  repository = "Goldkelch/qik-vrt";
+  binding = exact;
+}
+request finish_qikvrt { target = QIKVRT_DOD; }
+on event {
+  follow exact;
+  classify causal;
+}
+on blocker {
+  learn smallest_sound_successor;
+  execute successor;
+}
+until {
+  ZERO_BUGS
+  && ALL_PULL_REQUESTS_REGARDED
+  && ALL_BRANCHES_REGARDED
+  && ALL_PRODUCTIVE_BRANCHES_MERGED
+  && FRESH_EXACT_MAIN_VALIDATION_PASS
+  && FRESH_EFFECT_READBACK;
+}
diff --git a/formalization/TEMDDCore.lean b/formalization/TEMDDCore.lean
new file mode 100644
index 0000000000000000000000000000000000000000..c99e85bcc8cf6e6bf95218151753eb76df4735f4
--- /dev/null
+++ b/formalization/TEMDDCore.lean
@@ -0,0 +1,73 @@
+namespace QIKVRT.TEMDD
+inductive State where | hold | continue | successorRequired | done deriving DecidableEq
+inductive Event where | unknown | evidence | blocker deriving DecidableEq
+def transition : State -> Event -> State
+| State.done, _ => State.done
+| _, Event.blocker => State.successorRequired
+| _, Event.evidence => State.continue
+| _, Event.unknown => State.hold
+structure DoD where
+ zeroBugs : Bool
+ allPullRequestsRegarded : Bool
+ allBranchesRegarded : Bool
+ allProductiveBranchesMerged : Bool
+ freshExactMainValidationPass : Bool
+ freshEffectReadback : Bool
+def complete (d : DoD) : Bool := d.zeroBugs && d.allPullRequestsRegarded && d.allBranchesRegarded && d.allProductiveBranchesMerged && d.freshExactMainValidationPass && d.freshEffectReadback
+theorem blocker_requires_successor (s : State) (h : s != State.done) : transition s Event.blocker = State.successorRequired := by cases s <;> simp [transition] at h ⊢
+theorem missing_effect_readback_not_done (d : DoD) (h : d.freshEffectReadback = false) : complete d = false := by simp [complete, h]
+
+structure BoundSubject where
+ repository : String
+ head : String
+ tree : String
+deriving DecidableEq
+
+structure CausalEvent where
+ eventId : Nat
+ sequence : Nat
+ causeEventIds : List Nat
+deriving DecidableEq
+
+def causalEdge (a b : CausalEvent) : Prop := a.eventId ∈ b.causeEventIds
+
+theorem sequence_does_not_imply_cause :
+    ∃ e1 e2 : CausalEvent, e1.sequence < e2.sequence ∧ ¬ causalEdge e1 e2 := by
+  refine ⟨{ eventId := 1, sequence := 1, causeEventIds := [] },
+          { eventId := 2, sequence := 2, causeEventIds := [] }, ?_, ?_⟩
+  · decide
+  · simp [causalEdge]
+
+structure BoundEvidence where
+ subject : BoundSubject
+ fresh : Bool
+
+def validates (e : BoundEvidence) (s : BoundSubject) : Prop :=
+  e.fresh = true ∧ e.subject = s
+
+theorem evidence_non_transfer (e : BoundEvidence) (s0 s1 : BoundSubject)
+    (hne : s0 ≠ s1) (h0 : validates e s0) : ¬ validates e s1 := by
+  intro h1
+  apply hne
+  exact h0.2.symm.trans h1.2
+
+structure EffectAckWitness where
+ authority : Bool
+ committed : Bool
+ freshReadback : Bool
+ exactSubject : Bool
+ expectedMatchesObserved : Bool
+
+def effectAck (w : EffectAckWitness) : Bool :=
+  w.authority && w.committed && w.freshReadback && w.exactSubject &&
+    w.expectedMatchesObserved
+
+theorem effect_ack_requires_fresh_readback (w : EffectAckWitness)
+    (h : effectAck w = true) : w.freshReadback = true := by
+  cases hfr : w.freshReadback with
+  | false =>
+      simp [effectAck, hfr] at h
+  | true =>
+      rfl
+
+end QIKVRT.TEMDD
diff --git a/hardware/vhdl/qikvrt_metatransistor_pkg.vhd b/hardware/vhdl/qikvrt_metatransistor_pkg.vhd
index f37eac039eaf67bbfb0a227cac1e5cb7bc5daa3e..ef8de1403696a6343bef2c36e53e02568854681d 100644
--- a/hardware/vhdl/qikvrt_metatransistor_pkg.vhd
+++ b/hardware/vhdl/qikvrt_metatransistor_pkg.vhd
@@ -30,10 +30,11 @@ package body qikvrt_metatransistor_pkg is
     drift_detected       : std_logic
   ) return qikvrt_state_t is
   begin
+    -- Only a strong '0' establishes drift freedom; every other value holds.
     if binding_valid /= '1' or
        authority_valid /= '1' or
        parent_child_differ /= '1' or
-       drift_detected = '1' then
+       drift_detected /= '0' then
       return QIKVRT_HOLD;
     end if;
 
diff --git a/hardware/vhdl/tb_qikvrt_metatransistor.vhd b/hardware/vhdl/tb_qikvrt_metatransistor.vhd
index beb58d38b3b300b97ff3dbc5171c44a80921b211..7d068532b9c0a59ff736d415b704117e67d48733 100644
--- a/hardware/vhdl/tb_qikvrt_metatransistor.vhd
+++ b/hardware/vhdl/tb_qikvrt_metatransistor.vhd
@@ -43,7 +43,47 @@ begin
     );
 
   stimulus : process
+    variable requested      : qikvrt_state_t;
+    variable expected       : qikvrt_state_t;
+    variable checked_cases  : natural := 0;
   begin
+    -- Regression for the originally reported fail-open drift input.
+    assert normalize_state(QIKVRT_CONTINUE, '1', '1', '1', 'X') = QIKVRT_HOLD
+      report "Unknown drift must hold rather than continue" severity failure;
+
+    -- Exhaust the function's finite std_logic input domain: 9**6 cases.
+    -- The oracle permits a state only with three strong '1' guards and
+    -- strong '0' drift. Weak, unknown, high-impedance and don't-care values
+    -- are not evidence of a valid guard or drift freedom.
+    for hi in std_logic loop
+      for lo in std_logic loop
+        requested := hi & lo;
+        for b in std_logic loop
+          for a in std_logic loop
+            for p in std_logic loop
+              for d in std_logic loop
+                expected := QIKVRT_HOLD;
+                if b = '1' and a = '1' and p = '1' and d = '0' then
+                  case requested is
+                    when QIKVRT_OBSERVE  => expected := QIKVRT_OBSERVE;
+                    when QIKVRT_CONTINUE => expected := QIKVRT_CONTINUE;
+                    when others          => expected := QIKVRT_HOLD;
+                  end case;
+                end if;
+                assert normalize_state(requested, b, a, p, d) = expected
+                  report "normalize_state mismatch at case " &
+                         natural'image(checked_cases)
+                  severity failure;
+                checked_cases := checked_cases + 1;
+              end loop;
+            end loop;
+          end loop;
+        end loop;
+      end loop;
+    end loop;
+    assert checked_cases = 531441 severity failure;
+    report "QIKVRT_METATRANSISTOR_NORMALIZE_CASES=531441" severity note;
+
     wait for 12 ns;
     reset <= '0';
     enable <= '1';
@@ -61,6 +101,28 @@ begin
     wait for 10 ns;
     assert emitted_state = QIKVRT_HOLD severity failure;
 
+    -- Exercise all drift values through the registered entity as well.
+    -- Drive on the falling edge and inspect after the following rising edge.
+    for d in std_logic loop
+      wait until falling_edge(clk);
+      requested_state <= QIKVRT_CONTINUE;
+      drift_detected <= d;
+      wait until rising_edge(clk);
+      wait for 1 ns;
+      expected := QIKVRT_HOLD;
+      if d = '0' then
+        expected := QIKVRT_CONTINUE;
+      end if;
+      assert emitted_state = expected
+        report "Registered drift mismatch for " & std_logic'image(d)
+        severity failure;
+      assert receipt_valid = '1' severity failure;
+      assert pass_value = '0' severity failure;
+      assert final_pass_value = '0' severity failure;
+      assert effect_done_value = '0' severity failure;
+    end loop;
+    report "QIKVRT_METATRANSISTOR_REGISTERED_DRIFT_CASES=9" severity note;
+
     assert pass_value = '0' severity failure;
     assert final_pass_value = '0' severity failure;
     assert effect_done_value = '0' severity failure;
diff --git a/include/temdd_core.h b/include/temdd_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..79efe5deadd70206ce313b2d0e138d72087e350a
--- /dev/null
+++ b/include/temdd_core.h
@@ -0,0 +1,7 @@
+#ifndef QIKVRT_TEMDD_CORE_H
+#define QIKVRT_TEMDD_CORE_H
+typedef enum { TEMDD_HOLD=0, TEMDD_CONTINUE=1, TEMDD_SUCCESSOR_REQUIRED=2, TEMDD_DONE=3 } temdd_state;
+typedef enum { TEMDD_EVENT_UNKNOWN=0, TEMDD_EVENT_EVIDENCE=1, TEMDD_EVENT_BLOCKER=2 } temdd_event;
+temdd_state temdd_transition(temdd_state state, temdd_event event);
+int temdd_done(const int predicates[6]);
+#endif
diff --git a/policy/QIKVRT_BINARY_PROGRESS_CLOSURE_V1.json b/policy/QIKVRT_BINARY_PROGRESS_CLOSURE_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..b4f94956d4b391477adaa4222d515d7de6b83c22
--- /dev/null
+++ b/policy/QIKVRT_BINARY_PROGRESS_CLOSURE_V1.json
@@ -0,0 +1,39 @@
+{
+  "schema": "QIKVRT_BINARY_PROGRESS_CLOSURE_V1",
+  "purpose": "Make progress total: every observed exact-subject state is either terminal or has exactly one admissible continuation.",
+  "states": {
+    "0": "TERMINAL_NO_WORK",
+    "1": "CONTINUATION_REQUIRED"
+  },
+  "invariants": [
+    "work_remaining => continuation_required",
+    "continuation_required => admissible_action_count == 1",
+    "stale_canonical_integrity => action == CANONICAL_INTEGRITY_CLOSURE",
+    "canonical_integrity_closure => successor_required",
+    "successor_created => fresh_successor_local_validation_required",
+    "fresh_validation_reset_is_transition_not_terminal_state",
+    "external_authority_required => event_subscription_required",
+    "external_authority_required => synthetic_authority_forbidden",
+    "no_predecessor_evidence_transfer"
+  ],
+  "forbidden_states": [
+    "work_remaining && action == NONE",
+    "stale_canonical_integrity && state == HOLD && action == NONE",
+    "successor_created && fresh_validation == NONE",
+    "event_required && subscription == NONE",
+    "reset && terminal"
+  ],
+  "closure": {
+    "technical_gap": "materialize_one_bounded_successor_then_validate_fresh",
+    "authority_gap": "subscribe_to_native_event_then_reobserve_exact_subject",
+    "no_gap": "TERMINAL_NO_WORK"
+  },
+  "fixed_point": "work_remaining == false",
+  "non_claims": [
+    "review approval",
+    "Main integration",
+    "deployment",
+    "publication",
+    "EFFECT_ACK_DONE"
+  ]
+}
diff --git a/policy/QIKVRT_CLOUD_TRANSPUTER_V1.json b/policy/QIKVRT_CLOUD_TRANSPUTER_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..f140c351215e1500e3faa6cb3bcca7fd94426e06
--- /dev/null
+++ b/policy/QIKVRT_CLOUD_TRANSPUTER_V1.json
@@ -0,0 +1,80 @@
+{
+  "schema": "qik-vrt-cloud-transputer-v1",
+  "architecture": "MC68000",
+  "framework_principle": {
+    "name": "STAY_FAIL_CLOSED_KEEP_FUTURE_OPEN",
+    "statement": "Stay fail closed and keep future open!",
+    "scope": "QIK-VRT Tested Event Model Driven Development",
+    "temdd_cycle": ["REQUEST", "EXECUTE", "FOLLOW", "LEARN", "REPEAT_UNTIL_DONE"],
+    "fail_closed": "Missing, stale, contradictory, unbound, or insufficient evidence never becomes authority, release, completion, or effect.",
+    "future_open": "A fail-closed state preserves every admissible future continuation; it must not erase evidence, obligations, provenance, alternatives, or the possibility of a later freshly evidenced transition.",
+    "eye_in_the_storm": "Every effect-producing path retains an independent reobservation boundary: act without self-certifying the effect; reobserve from the declared evidence boundary before claiming completion.",
+    "return_path_closure": "The reverse path returns the original bound request plus every material descendant, produced artifact, observed effect, failure, repair, successor, and still-open obligation. Returned predecessor evidence remains provenance and is never transferred as proof for a mutated subject.",
+    "terminal_rule": "D.o.D. and EFFECT_ACK_DONE are admissible only after exact post-effect reobservation of every predicate in the declared completion scope.",
+    "invariants": [
+      "TRANSPORT_ACK != EFFECT_ACK",
+      "VERIFIED_IMPLEMENTATION != AUTHORITY_EFFECT",
+      "CAUSALITY != SEQUENCE",
+      "PREDECESSOR_EVIDENCE_TRANSFER=false",
+      "MUTATION_RESETS_DEPENDENT_EVIDENCE=true",
+      "FAIL_CLOSED_DOES_NOT_MEAN_FUTURE_CLOSED",
+      "RETURN_PATH_MUST_PRESERVE_MATERIAL_DESCENDANTS_AND_OPEN_OBLIGATIONS"
+    ]
+  },
+  "boundary_contract": {
+    "d0_width_bits": 2,
+    "d0_mask": 3,
+    "states": ["NOOP", "HOLD", "REOBSERVE", "REQUEST_AUTHORITY"],
+    "decision_codes": {"NOOP": 0, "HOLD": 1, "REOBSERVE": 2, "REQUEST_AUTHORITY": 3},
+    "binary_weights": [1, 2, 4],
+    "composition_rule": "3 = 1 + 2; weight 4 opens the next orthogonal composition dimension without redefining D0[1:0]",
+    "register_binding": {
+      "D0": "low two bits are the invariant QIK-VRT/TEMDD boundary decision",
+      "D1": "channel/session id",
+      "D2": "freshness marker / nonce",
+      "D3": "source-node id / capability context",
+      "D4": "effect-ack protocol state",
+      "A0": "request payload pointer",
+      "A1": "receipt output pointer"
+    }
+  },
+  "effect_ack_protocol": {
+    "states": ["EFFECT_NACK", "EFFECT_ACK_CONTINUE", "EFFECT_ACK_ISOLATE", "EFFECT_ACK_BLOCK", "EFFECT_ACK_DONE"],
+    "state_codes": {"EFFECT_NACK": 0, "EFFECT_ACK_CONTINUE": 1, "EFFECT_ACK_ISOLATE": 2, "EFFECT_ACK_BLOCK": 3, "EFFECT_ACK_DONE": 4},
+    "register": "D4",
+    "ordinary_release": "EFFECT_ACK_DONE only"
+  },
+  "wire_protocol": {
+    "schema": "QIKVRT_WIRE_V1",
+    "version": 1,
+    "byte_order": "big-endian",
+    "header_bytes": 84,
+    "trailer_bytes": 4,
+    "max_payload_bytes": 4096,
+    "directions": {"FORWARD": 0, "REVERSE": 1},
+    "message_types": {"REQUEST": 1, "RESPONSE": 2, "RECEIPT": 3, "REOBSERVATION": 4},
+    "header_fields": ["magic", "version", "direction", "type", "flags", "D0", "D4", "header_size", "session_id", "nonce", "source_node", "virtual_time_hi", "virtual_time_lo", "message_id", "chunk_index", "chunk_count", "payload_length", "payload_sha256", "header_fnv1a32"],
+    "trailer": "frame_fnv1a32 over header plus payload",
+    "payload_integrity": "SHA-256",
+    "chunking": "message_id plus zero-based chunk_index/chunk_count; each frame is independently bounded and verified",
+    "receipt_binding": "reverse RECEIPT repeats session_id, nonce, message_id, chunk_index and chunk_count and carries SHA-256(request_frame) as payload",
+    "release_rule": "a transport roundtrip never implies EFFECT_ACK_DONE; the bounded reference witness emits D4=EFFECT_ACK_DONE only after decode, local state application, contract verification and post-apply byte reobservation",
+    "general_effect_ack_done": false
+  },
+  "function_codes": [
+    {"fc": 1, "domain": "user-data"}, {"fc": 2, "domain": "user-program"}, {"fc": 5, "domain": "supervisor-data"}, {"fc": 6, "domain": "supervisor-program"}, {"fc": 7, "domain": "interrupt-acknowledge"}
+  ],
+  "interrupt_model": {"levels": [1,2,3,4,5,6,7], "autovector": true, "level_7_non_maskable": true},
+  "exception_model": {"supervisor_state": {"S": 1}, "stack_banks": ["USP", "SSP"], "exception_frame_fields": ["SR", "PC"], "return_instruction": "RTE"},
+  "task_frame": {"saved_registers": ["D0","D1","D2","D3","D4","D5","D6","D7","A0","A1","A2","A3","A4","A5","A6","USP","SR","PC"]},
+  "overlay_model": {"banks": 4, "switch_register": "QIKVRT_OVERLAY_CTRL", "fence_required": true, "instruction_prefetch_flush": true, "decision_link": "ordinary release is allowed only from stable EFFECT_ACK_DONE"},
+  "ip_bootstrap": {"subnet": "10.73.0.0/24", "discovery_port": 7331, "server_ip": "10.73.0.1", "client_ip": "10.73.0.2", "file_id": 1, "binary": "QIKVRT_BOOT.BIN", "timeout_seconds": 2, "retries": 3, "chunk_bytes": 128, "checksum": "FNV1A32", "route": ["discover","offer","request","data","done"]},
+  "effect_boundary": {
+    "transport_ack_not_effect_ack": true,
+    "content_ack_signals": ["parse-complete", "checksum-complete", "bounded-range-check-complete"],
+    "semantic_effect_signals": ["requested state transition applied", "contract verification passed", "post-apply state re-observed"],
+    "note": "No protocol label establishes physical correspondence, quantum identity, or empirical model closure."
+  },
+  "logic_0124_source_status": "RECOVERED_FROM_OWNER_MATERIAL",
+  "logic_0124_note": "0 is the unset state; 1,2,4 are orthogonal binary weights. D0[1:0] carries 0..3, with 3 composed as 1+2. Bit weight 4 extends composition context and must not redefine the four D0 boundary meanings."
+}
