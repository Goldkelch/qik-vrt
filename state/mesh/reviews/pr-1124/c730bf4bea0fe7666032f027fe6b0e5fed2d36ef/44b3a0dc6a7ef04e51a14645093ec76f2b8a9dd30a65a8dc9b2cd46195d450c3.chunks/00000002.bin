         self.assertEqual(result["eligible"], ["P1_BUILD_ONE_INTEGRATION_HEAD"])
         self.assertNotIn("P2_VALIDATE_EXACT_INTEGRATION_HEAD", result["eligible"])
 
+    def test_convergence_policy_targets_authority_and_mirror_at_zero(self):
