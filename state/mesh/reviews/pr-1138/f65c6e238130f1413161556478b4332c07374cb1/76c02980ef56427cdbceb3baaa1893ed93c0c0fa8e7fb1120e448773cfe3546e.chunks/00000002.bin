+      "boundary": "Lean finite lists; positive width for the bound; no implemented transport or hardware guarantee.",
+      "claim_id": "FC-001",
+      "classification": "FORMAL_PROVED",
+      "proof_refs": [
+        "QIKVRTChallenge.segment_roundtrip",
