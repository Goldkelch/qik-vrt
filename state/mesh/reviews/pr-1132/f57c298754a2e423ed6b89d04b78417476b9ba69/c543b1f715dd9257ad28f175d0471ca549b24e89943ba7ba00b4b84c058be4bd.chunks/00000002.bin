+    def test_github_tagger_date_uses_git_second_precision(self) -> None:
+        self.assertEqual(
+            publish._canonical_github_tagger_date(
+                "2026-09-19T15:14:33.747598+00:00"
+            ),
+            "2026-09-19T15:14:33Z",
+        )
+        self.assertEqual(
+            publish._canonical_github_tagger_date(
+                "2026-09-19T17:14:33.747598+02:00"
+            ),
+            "2026-09-19T15:14:33Z",
+        )
+
