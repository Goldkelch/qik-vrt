diff --git a/deploy/universal-terminal/Dockerfile b/deploy/universal-terminal/Dockerfile
index 589c96ccd01447641fc478606fc18d4a41ff71bb..1b6d6d1a662e5966395e65bc2b00d78af699b73e 100644
--- a/deploy/universal-terminal/Dockerfile
+++ b/deploy/universal-terminal/Dockerfile
@@ -1,41 +1,92 @@
+FROM debian:bookworm-slim AS m68000-builder
+
+ARG DEBIAN_FRONTEND=noninteractive
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      gcc-m68k-linux-gnu=4:12.2.0-5 \
+      binutils-m68k-linux-gnu=2.40-2 \
+      ca-certificates \
+    && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /src
+COPY src/m68000/qikvrt_terminal_bootstrap.c /src/qikvrt_terminal_bootstrap.c
+RUN mkdir -p /out \
+    && m68k-linux-gnu-gcc \
+      -std=c90 -pedantic-errors -Wall -Wextra -Werror -Os -m68000 \
+      -ffreestanding -fno-builtin -fno-pic -fno-stack-protector \
+      -c /src/qikvrt_terminal_bootstrap.c -o /out/qikvrt_terminal_bootstrap.o \
+    && m68k-linux-gnu-objcopy -j .text -O binary \
+      /out/qikvrt_terminal_bootstrap.o /out/qikvrt_terminal_bootstrap.bin \
+    && m68k-linux-gnu-objdump -f -dr /out/qikvrt_terminal_bootstrap.o \
+      > /out/qikvrt_terminal_bootstrap.objdump.txt \
+    && grep -Eiq 'm68k|mc68000' /out/qikvrt_terminal_bootstrap.objdump.txt \
+    && cd /out \
+    && sha256sum qikvrt_terminal_bootstrap.bin > qikvrt_terminal_bootstrap.bin.sha256 \
+    && sha256sum qikvrt_terminal_bootstrap.o > qikvrt_terminal_bootstrap.o.sha256 \
+    && test -s qikvrt_terminal_bootstrap.bin
+
+
 FROM debian:bookworm-slim
 
-ENV DEBIAN_FRONTEND=noninteractive \
-    DISPLAY=:99 \
+ARG DEBIAN_FRONTEND=noninteractive
+ARG QIKVRT_EXACT_SUBJECT_SHA=UNBOUND
+ENV DISPLAY=:99 \
+    HOME=/var/lib/qikvrt/state/home \
     QIKVRT_HTTP_PORT=8771 \
     QIKVRT_NOVNC_PORT=6080 \
-    QIKVRT_START_URL=https://arxiv.org/ \
+    QIKVRT_PROXY_PORT=8080 \
+    QIKVRT_PROXY_HOST=127.0.0.1 \
+    QIKVRT_SMTP_PORT=1025 \
+    QIKVRT_DNS_PORT=1053 \
+    QIKVRT_SNMP_PORT=1161 \
+    QIKVRT_SSH_PORT=2222 \
+    QIKVRT_POSTGRES_PORT=5432 \
+    QIKVRT_GIT_MIRROR_PORT=9418 \
+    QIKVRT_START_URL=https://github.com/Goldkelch/qik-vrt \
     QIKVRT_PROFILE_DIR=/var/lib/qikvrt/profile \
     QIKVRT_STATE_DIR=/var/lib/qikvrt/state \
-    QIKVRT_RUNTIME_ID=qikvrt-firefox-terminal
+    QIKVRT_RUNTIME_ID=qikvrt-cloud-transputer-v1 \
+    QIKVRT_IMAGE_SUBJECT_SHA=${QIKVRT_EXACT_SUBJECT_SHA}
 
 RUN apt-get update && apt-get install -y --no-install-recommends \
       ca-certificates firefox-esr python3 python3-minimal git zip \
       xvfb x11vnc novnc websockify dbus-x11 procps curl \
-    && rm -rf /var/lib/apt/lists/*
+      openbox xterm \
+      dropbear-bin=2022.83-1+deb12u3 \
+      postgresql-15 postgresql-client-15 \
+    && rm -rf /var/lib/apt/lists/* \
+    && useradd --uid 10001 --home-dir /var/lib/qikvrt/state/home \
+         --no-create-home --shell /bin/sh qikvrt
 
 WORKDIR /opt/qikvrt
 COPY . /opt/qikvrt
+COPY --from=m68000-builder /out/ /opt/qikvrt/assets/m68000/
 
-RUN mkdir -p /opt/qikvrt/runtime/bootstrap-profile/extensions /opt/qikvrt/runtime/logs \
-    /var/lib/qikvrt/profile /var/lib/qikvrt/state \
+RUN mkdir -p \
+      /opt/qikvrt/assets/bootstrap-profile/extensions \
+      /var/lib/qikvrt/profile \
+      /var/lib/qikvrt/state \
     && cd browser/firefox/qikvrt-terminal \
-    && zip -qr /opt/qikvrt/runtime/bootstrap-profile/extensions/qikvrt-ai-terminal@goldkelch.local.xpi . \
+    && zip -qr /opt/qikvrt/assets/bootstrap-profile/extensions/qikvrt-ai-terminal@goldkelch.local.xpi . \
     && printf '%s\n' \
       'user_pref("browser.shell.checkDefaultBrowser", false);' \
-      'user_pref("browser.startup.homepage", "https://arxiv.org/");' \
+      'user_pref("browser.startup.homepage", "https://github.com/Goldkelch/qik-vrt");' \
       'user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);' \
       'user_pref("datareporting.policy.dataSubmissionEnabled", false);' \
       'user_pref("browser.sessionstore.resume_from_crash", true);' \
-      > /opt/qikvrt/runtime/bootstrap-profile/user.js
+      > /opt/qikvrt/assets/bootstrap-profile/user.js \
+    && chown -R qikvrt:qikvrt \
+      /opt/qikvrt/assets \
+      /var/lib/qikvrt/profile \
+      /var/lib/qikvrt/state
 
 COPY deploy/universal-terminal/entrypoint.sh /usr/local/bin/qikvrt-universal-terminal
 COPY deploy/universal-terminal/runtime-health.sh /usr/local/bin/qikvrt-runtime-health
 RUN chmod +x /usr/local/bin/qikvrt-universal-terminal /usr/local/bin/qikvrt-runtime-health
 
 VOLUME ["/var/lib/qikvrt/profile", "/var/lib/qikvrt/state"]
-EXPOSE 6080
-HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
+EXPOSE 6080 8080
+HEALTHCHECK --interval=15s --timeout=15s --start-period=60s --retries=8 \
   CMD ["/usr/local/bin/qikvrt-runtime-health"]
 
+USER 10001:10001
 ENTRYPOINT ["/usr/local/bin/qikvrt-universal-terminal"]
diff --git a/deploy/universal-terminal/compose.yaml b/deploy/universal-terminal/compose.yaml
index 94e1630d758b577a3e945b40f263babf59470f8b..097c98e8135fe6458b147e06a80ff12e061983cd 100644
--- a/deploy/universal-terminal/compose.yaml
+++ b/deploy/universal-terminal/compose.yaml
@@ -3,18 +3,24 @@ services:
     build:
       context: ../..
       dockerfile: deploy/universal-terminal/Dockerfile
-    image: qikvrt/universal-terminal:${QIKVRT_IMAGE_TAG:-trusted-main}
+      args:
+        QIKVRT_EXACT_SUBJECT_SHA: "${QIKVRT_EXACT_SUBJECT_SHA:-UNBOUND}"
+    image: qikvrt/universal-terminal:${QIKVRT_IMAGE_TAG:-candidate}
     restart: unless-stopped
     ports:
       - "127.0.0.1:${QIKVRT_NOVNC_HOST_PORT:-6080}:6080"
+      - "127.0.0.1:${QIKVRT_PROXY_HOST_PORT:-8080}:8080"
     environment:
-      QIKVRT_START_URL: "${QIKVRT_START_URL:-https://arxiv.org/}"
-      QIKVRT_NOVNC_PORT: "6080"
-      QIKVRT_HTTP_PORT: "8771"
-      QIKVRT_RUNTIME_ID: "${QIKVRT_RUNTIME_ID:-qikvrt-firefox-terminal}"
+      QIKVRT_START_URL: "${QIKVRT_START_URL:-https://github.com/Goldkelch/qik-vrt}"
+      QIKVRT_PROXY_HOST: "${QIKVRT_PROXY_HOST:-127.0.0.1}"
+      QIKVRT_PROXY_USERNAME: "${QIKVRT_PROXY_USERNAME:-qikvrt}"
+      QIKVRT_PROXY_PASSWORD: "${QIKVRT_PROXY_PASSWORD:-}"
+      QIKVRT_RUNTIME_ID: "${QIKVRT_RUNTIME_ID:-qikvrt-cloud-transputer-v1}"
       QIKVRT_PROFILE_DIR: /var/lib/qikvrt/profile
       QIKVRT_STATE_DIR: /var/lib/qikvrt/state
       QIKVRT_VNC_PASSWORD_FILE: "${QIKVRT_VNC_PASSWORD_FILE:-}"
+      QIKVRT_SSH_AUTHORIZED_KEYS: "${QIKVRT_SSH_AUTHORIZED_KEYS:-}"
+      QIKVRT_EXACT_SUBJECT_SHA: "${QIKVRT_EXACT_SUBJECT_SHA:-UNBOUND}"
     volumes:
       - qikvrt_firefox_profile:/var/lib/qikvrt/profile
       - qikvrt_runtime_state:/var/lib/qikvrt/state
@@ -26,14 +32,13 @@ services:
     tmpfs:
       - /tmp
       - /run
-      - /opt/qikvrt/runtime:size=256m,mode=1777
     shm_size: 512m
     healthcheck:
       test: ["CMD", "/usr/local/bin/qikvrt-runtime-health"]
-      interval: 10s
-      timeout: 5s
-      start_period: 20s
-      retries: 6
+      interval: 15s
+      timeout: 15s
+      start_period: 60s
+      retries: 8
 
 volumes:
   qikvrt_firefox_profile:
diff --git a/deploy/universal-terminal/entrypoint.sh b/deploy/universal-terminal/entrypoint.sh
index 81349289f955b60c63019c5094dc16ba33ceb655..1c9753d3b27401bfb462128da707b09e9bcc1fcc 100755
--- a/deploy/universal-terminal/entrypoint.sh
+++ b/deploy/universal-terminal/entrypoint.sh
@@ -3,82 +3,298 @@ set -eu
 
 PROFILE_DIR="${QIKVRT_PROFILE_DIR:-/var/lib/qikvrt/profile}"
 STATE_DIR="${QIKVRT_STATE_DIR:-/var/lib/qikvrt/state}"
-RUNTIME_ID="${QIKVRT_RUNTIME_ID:-qikvrt-firefox-terminal}"
+RUNTIME_ID="${QIKVRT_RUNTIME_ID:-qikvrt-cloud-transputer-v1}"
 HTTP_PORT="${QIKVRT_HTTP_PORT:-8771}"
 NOVNC_PORT="${QIKVRT_NOVNC_PORT:-6080}"
+PROXY_PORT="${QIKVRT_PROXY_PORT:-${PORT:-8080}}"
+PROXY_HOST="${QIKVRT_PROXY_HOST:-127.0.0.1}"
+SMTP_PORT="${QIKVRT_SMTP_PORT:-1025}"
+DNS_PORT="${QIKVRT_DNS_PORT:-1053}"
+SNMP_PORT="${QIKVRT_SNMP_PORT:-1161}"
+SSH_PORT="${QIKVRT_SSH_PORT:-2222}"
+PGPORT="${QIKVRT_POSTGRES_PORT:-5432}"
+GIT_PORT="${QIKVRT_GIT_MIRROR_PORT:-9418}"
 DISPLAY_VALUE="${DISPLAY:-:99}"
-START_URL="${QIKVRT_START_URL:-https://arxiv.org/}"
+START_URL="${QIKVRT_START_URL:-https://github.com/Goldkelch/qik-vrt}"
+SUBJECT_SHA="${QIKVRT_EXACT_SUBJECT_SHA:-${RAILWAY_GIT_COMMIT_SHA:-${QIKVRT_IMAGE_SUBJECT_SHA:-UNBOUND}}}"
+QIKVRT_HOME="$STATE_DIR/home"
+PGDATA="$STATE_DIR/postgres"
+PGSOCKET="/tmp/qikvrt-postgres"
+SSH_DIR="$STATE_DIR/ssh"
+MIRROR_DIR="$STATE_DIR/repository-mirror.git"
+MIRROR_OBSERVATION="$STATE_DIR/repository-mirror.json"
+LOG_DIR="/tmp/qikvrt-logs"
 
-mkdir -p /opt/qikvrt/runtime/logs "$PROFILE_DIR" "$STATE_DIR"
+# All services run as the dedicated unprivileged image user.  The deployment
+# platform must present writable state/profile mounts to this uid; no runtime
+# privilege-escalation/bootstrap path is permitted.
+if [ "$(id -u)" != 10001 ]; then
+  echo "BLOCK: terminal runtime must execute as uid 10001" >&2
+  exit 2
+fi
+
+mkdir -p \
+  "$LOG_DIR" "$PROFILE_DIR" "$STATE_DIR" "$QIKVRT_HOME/.ssh" \
+  "$PGDATA" "$PGSOCKET" "$SSH_DIR" "$STATE_DIR/mail"
+test -w "$PROFILE_DIR"
+test -w "$STATE_DIR"
 
 if [ ! -f "$PROFILE_DIR/.qikvrt-profile-initialized" ]; then
-  cp -a /opt/qikvrt/runtime/bootstrap-profile/. "$PROFILE_DIR/"
+  cp -a /opt/qikvrt/assets/bootstrap-profile/. "$PROFILE_DIR/"
   : > "$PROFILE_DIR/.qikvrt-profile-initialized"
 fi
 
+if ! printf '%s' "$SUBJECT_SHA" | grep -Eq '^[0-9a-f]{40}$'; then
+  echo "BLOCK: exact subject SHA unavailable" >&2
+  exit 2
+fi
+
 python3 -B /opt/qikvrt/src/qikvrt_effect_ack_http_terminal.py \
-  --host 127.0.0.1 --port "$HTTP_PORT" \
-  > /opt/qikvrt/runtime/logs/effect-ack-http.log 2>&1 &
+  --host 127.0.0.1 --port "$HTTP_PORT" >"$LOG_DIR/effect-ack-http.log" 2>&1 &
 HTTP_PID=$!
 
-Xvfb "$DISPLAY_VALUE" -screen 0 1440x900x24 -nolisten tcp \
-  > /opt/qikvrt/runtime/logs/xvfb.log 2>&1 &
+Xvfb "$DISPLAY_VALUE" -screen 0 1440x900x24 -nolisten tcp >"$LOG_DIR/xvfb.log" 2>&1 &
 XVFB_PID=$!
-
 sleep 1
+openbox >"$LOG_DIR/openbox.log" 2>&1 &
+OPENBOX_PID=$!
+xterm -geometry 112x30+20+520 -title "QIK-VRT POSIX terminal" \
+  -e /bin/sh -lc 'printf "QIK-VRT POSIX terminal\nD0: 0=NOOP 1=HOLD 2=REOBSERVE 3=REQUEST_AUTHORITY\n"; exec /bin/sh' \
+  >"$LOG_DIR/xterm.log" 2>&1 &
+XTERM_PID=$!
+
 VNC_ARGS="-display $DISPLAY_VALUE -forever -shared -localhost -rfbport 5900"
 if [ -n "${QIKVRT_VNC_PASSWORD_FILE:-}" ]; then
   test -r "$QIKVRT_VNC_PASSWORD_FILE"
   VNC_PASSWORD="$(cat "$QIKVRT_VNC_PASSWORD_FILE")"
   test -n "$VNC_PASSWORD"
-  x11vnc -storepasswd "$VNC_PASSWORD" /run/qikvrt-vnc.pass >/dev/null
-  VNC_ARGS="$VNC_ARGS -rfbauth /run/qikvrt-vnc.pass"
+  x11vnc -storepasswd "$VNC_PASSWORD" /tmp/qikvrt-vnc.pass >/dev/null
+  VNC_ARGS="$VNC_ARGS -rfbauth /tmp/qikvrt-vnc.pass"
 else
   VNC_ARGS="$VNC_ARGS -nopw"
 fi
 # shellcheck disable=SC2086
-x11vnc $VNC_ARGS > /opt/qikvrt/runtime/logs/x11vnc.log 2>&1 &
+x11vnc $VNC_ARGS >"$LOG_DIR/x11vnc.log" 2>&1 &
 VNC_PID=$!
 
-websockify --web=/usr/share/novnc/ "$NOVNC_PORT" localhost:5900 \
-  > /opt/qikvrt/runtime/logs/novnc.log 2>&1 &
+websockify --web=/usr/share/novnc/ "$NOVNC_PORT" localhost:5900 >"$LOG_DIR/novnc.log" 2>&1 &
 NOVNC_PID=$!
 
-firefox-esr --no-remote --profile "$PROFILE_DIR" "$START_URL" \
-  > /opt/qikvrt/runtime/logs/firefox.log 2>&1 &
+python3 -B /opt/qikvrt/src/qikvrt_universal_service_plane.py \
+  --state-dir "$STATE_DIR" >"$LOG_DIR/service-plane.log" 2>&1 &
+SERVICE_PID=$!
+
+PG_BINDIR="/usr/lib/postgresql/15/bin"
+test -x "$PG_BINDIR/initdb"
+test -x "$PG_BINDIR/postgres"
+if [ ! -s "$PGDATA/PG_VERSION" ]; then
+  "$PG_BINDIR/initdb" -D "$PGDATA" \
+    --encoding=UTF8 --auth-local=trust --auth-host=trust --no-locale \
+    >"$LOG_DIR/postgres-init.log" 2>&1
+fi
+"$PG_BINDIR/postgres" -D "$PGDATA" \
+  -c "listen_addresses=127.0.0.1" \
+  -c "port=$PGPORT" \
+  -c "unix_socket_directories=$PGSOCKET" \
+  -c "max_connections=32" \
+  >"$LOG_DIR/postgres.log" 2>&1 &
+POSTGRES_PID=$!
+
+i=0
+while ! pg_isready -q -h 127.0.0.1 -p "$PGPORT"; do
+  i=$((i + 1))
+  if [ "$i" -ge 45 ]; then
+    echo "BLOCK: PostgreSQL did not become ready" >&2
+    exit 1
+  fi
+  sleep 1
+done
+
+psql -X -q -h 127.0.0.1 -p "$PGPORT" -d postgres -v ON_ERROR_STOP=1 <<'SQL'
+DO $qikvrt$
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'qikvrt_terminal') THEN
+    CREATE ROLE qikvrt_terminal LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
+  END IF;
+END
+$qikvrt$;
+SELECT 'CREATE DATABASE qikvrt_terminal OWNER qikvrt_terminal'
+WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'qikvrt_terminal')\gexec
+ALTER DATABASE qikvrt_terminal OWNER TO qikvrt_terminal;
+REVOKE TEMPORARY ON DATABASE qikvrt_terminal FROM PUBLIC;
+SQL
+psql -X -q -h 127.0.0.1 -p "$PGPORT" -d qikvrt_terminal -v ON_ERROR_STOP=1 <<'SQL'
+REVOKE CREATE ON SCHEMA public FROM PUBLIC;
+GRANT USAGE, CREATE ON SCHEMA public TO qikvrt_terminal;
+SQL
+
+HOST_KEY="$SSH_DIR/dropbear_ed25519_host_key"
+CLIENT_KEY="$SSH_DIR/qikvrt_local_client_ed25519"
+AUTHORIZED_KEYS="$QIKVRT_HOME/.ssh/authorized_keys"
+if [ ! -s "$HOST_KEY" ]; then
+  dropbearkey -t ed25519 -f "$HOST_KEY" >"$LOG_DIR/dropbear-host-key.log" 2>&1
+fi
+if [ ! -s "$CLIENT_KEY" ]; then
+  dropbearkey -t ed25519 -f "$CLIENT_KEY" >"$LOG_DIR/dropbear-client-key.log" 2>&1
+fi
+umask 077
+dropbearkey -y -f "$CLIENT_KEY" | awk '/^ssh-ed25519 /{print; exit}' >"$AUTHORIZED_KEYS"
+if [ -n "${QIKVRT_SSH_AUTHORIZED_KEYS:-}" ]; then
+  printf '%s\n' "$QIKVRT_SSH_AUTHORIZED_KEYS" >>"$AUTHORIZED_KEYS"
+fi
+chmod 700 "$QIKVRT_HOME/.ssh"
+chmod 600 "$AUTHORIZED_KEYS" "$CLIENT_KEY" "$HOST_KEY"
+
+dropbear -F -E -s -w -j -k -P /tmp/qikvrt-dropbear.pid \
+  -p "127.0.0.1:$SSH_PORT" -r "$HOST_KEY" >"$LOG_DIR/dropbear.log" 2>&1 &
+SSH_PID=$!
+
+if [ ! -d "$MIRROR_DIR" ]; then
+  git init --bare "$MIRROR_DIR" >/dev/null
+fi
+if git --git-dir="$MIRROR_DIR" remote get-url authority >/dev/null 2>&1; then
+  git --git-dir="$MIRROR_DIR" remote set-url authority https://github.com/Goldkelch/qik-vrt.git
+else
+  git --git-dir="$MIRROR_DIR" remote add authority https://github.com/Goldkelch/qik-vrt.git
+fi
+if git --git-dir="$MIRROR_DIR" remote get-url mirror >/dev/null 2>&1; then
+  git --git-dir="$MIRROR_DIR" remote set-url mirror https://github.com/ingolf-lohmann/qik-vrt.git
+else
+  git --git-dir="$MIRROR_DIR" remote add mirror https://github.com/ingolf-lohmann/qik-vrt.git
+fi
+git --git-dir="$MIRROR_DIR" fetch --no-tags --depth=1 authority "$SUBJECT_SHA" \
+  >"$LOG_DIR/git-mirror-authority.log" 2>&1
+git --git-dir="$MIRROR_DIR" update-ref refs/heads/candidate FETCH_HEAD
+git --git-dir="$MIRROR_DIR" symbolic-ref HEAD refs/heads/candidate
+git --git-dir="$MIRROR_DIR" fetch --no-tags --depth=1 authority \
+  main:refs/remotes/authority/main >>"$LOG_DIR/git-mirror-authority.log" 2>&1 || true
+git --git-dir="$MIRROR_DIR" fetch --no-tags --depth=1 mirror \
+  main:refs/remotes/mirror/main >"$LOG_DIR/git-mirror-external.log" 2>&1 || true
+git daemon --reuseaddr --export-all --base-path="$STATE_DIR" \
+  --listen=127.0.0.1 --port="$GIT_PORT" "$MIRROR_DIR" >"$LOG_DIR/git-daemon.log" 2>&1 &
+GIT_PID=$!
+
+python3 -B /opt/qikvrt/src/qikvrt_cloud_mirror_observer.py \
+  --output "$MIRROR_OBSERVATION" \
+  --interval "${QIKVRT_MIRROR_REOBSERVE_SECONDS:-900}" >"$LOG_DIR/authority-mirror.log" 2>&1 &
+MIRROR_PID=$!
+
+env \
+  QIKVRT_STATE_DIR="$STATE_DIR" \
+  QIKVRT_PROXY_HOST="$PROXY_HOST" \
+  QIKVRT_PROXY_PORT="$PROXY_PORT" \
+  QIKVRT_HTTP_PORT="$HTTP_PORT" \
+  QIKVRT_NOVNC_PORT="$NOVNC_PORT" \
+  QIKVRT_POSTGRES_PORT="$PGPORT" \
+  QIKVRT_PROXY_USERNAME="${QIKVRT_PROXY_USERNAME:-qikvrt}" \
+  QIKVRT_PROXY_PASSWORD="${QIKVRT_PROXY_PASSWORD:-}" \
+  QIKVRT_PROXY_PASSWORD_FILE="${QIKVRT_PROXY_PASSWORD_FILE:-}" \
+  python3 -B /opt/qikvrt/src/qikvrt_terminal_proxy_httpd.py >"$LOG_DIR/terminal-proxy.log" 2>&1 &
+PROXY_PID=$!
+
+firefox-esr --no-remote --profile "$PROFILE_DIR" "$START_URL" >"$LOG_DIR/firefox.log" 2>&1 &
 FIREFOX_PID=$!
 
