diff --git a/index.html b/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..c037214ed444439bb357000964e7a304e17d8206
--- /dev/null
+++ b/index.html
@@ -0,0 +1 @@
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QIK-VRT — Public Human Surface</title><style>body{font:17px system-ui;max-width:920px;margin:auto;padding:24px;line-height:1.55;background:#0b1020;color:#edf2ff}main{background:#151d33;padding:24px;border-radius:16px}select{font:inherit;padding:10px}a{color:#9ecbff}code{color:#a5d6ff}.muted{color:#b6c2db}</style></head><body><main><h1>QIK-VRT</h1><p class="muted">Human-first public information surface · Menschen zuerst</p><label for="lang">Language / Sprache / Langue / Idioma / اللغة / भाषा / 言語 / 언어 / 语言</label><br><select id="lang"></select><section id="content"></section><hr><p><code>REQUEST ≠ EXECUTION ≠ SUCCESS ≠ EFFECT</code></p><p id="principle"></p><p><a href="https://github.com/Goldkelch/qik-vrt">GitHub repository</a></p></main><script>const T={de:["Deutsch","QIK-VRT öffentlich verstehen","QIK-VRT macht technische Entscheidungen, Zustände, Evidenz und reale Wirkungen nachvollziehbar. Eine erfolgreiche Verarbeitung ist noch kein Nachweis der gewünschten Wirkung.","Historische Evidenz darf erhalten bleiben. Aktuelle Gültigkeit muss immer wieder frisch verdient werden."],en:["English","Understand QIK-VRT","QIK-VRT makes technical decisions, states, evidence and real-world effects traceable. Successful processing is not yet proof of the intended effect.","Historical evidence may remain. Current validity must be freshly earned."],fr:["Français","Comprendre QIK-VRT","QIK-VRT rend traçables les décisions techniques, les états, les preuves et les effets réels. Un traitement réussi ne prouve pas encore l'effet recherché.","Les preuves historiques peuvent être conservées. La validité actuelle doit être à nouveau démontrée."],es:["Español","Comprender QIK-VRT","QIK-VRT hace trazables las decisiones técnicas, los estados, las evidencias y los efectos reales. Un procesamiento correcto aún no demuestra el efecto deseado.","La evidencia histórica puede conservarse. La validez actual debe demostrarse de nuevo."],pt:["Português","Compreender o QIK-VRT","O QIK-VRT torna rastreáveis decisões técnicas, estados, evidências e efeitos reais. Processamento bem-sucedido ainda não comprova o efeito pretendido.","A evidência histórica pode permanecer. A validade atual precisa ser conquistada novamente."],it:["Italiano","Comprendere QIK-VRT","QIK-VRT rende tracciabili decisioni tecniche, stati, evidenze ed effetti reali. Un'elaborazione riuscita non dimostra ancora l'effetto desiderato.","L'evidenza storica può rimanere. La validità attuale deve essere nuovamente dimostrata."],tr:["Türkçe","QIK-VRT'yi anlayın","QIK-VRT teknik kararları, durumları, kanıtları ve gerçek etkileri izlenebilir kılar. Başarılı işlem, amaçlanan etkinin kanıtı değildir.","Tarihsel kanıt korunabilir. Güncel geçerlilik yeniden doğrulanmalıdır."],ru:["Русский","Понять QIK-VRT","QIK-VRT делает технические решения, состояния, свидетельства и реальные эффекты прослеживаемыми. Успешная обработка ещё не доказывает требуемый эффект.","Исторические свидетельства могут сохраняться. Текущая действительность должна подтверждаться заново."],ar:["العربية","فهم QIK-VRT","يجعل QIK-VRT القرارات والحالات والأدلة والآثار الفعلية قابلة للتتبع. نجاح المعالجة لا يثبت بعد تحقق الأثر المقصود.","يمكن الاحتفاظ بالأدلة التاريخية، أما الصلاحية الحالية فيجب إثباتها من جديد."],hi:["हिन्दी","QIK-VRT को समझें","QIK-VRT तकनीकी निर्णयों, अवस्थाओं, साक्ष्यों और वास्तविक प्रभावों को पता लगाने योग्य बनाता है। सफल प्रसंस्करण अभी इच्छित प्रभाव का प्रमाण नहीं है।","ऐतिहासिक साक्ष्य बने रह सकते हैं। वर्तमान वैधता को नए सिरे से सिद्ध करना होता है।"],id:["Bahasa Indonesia","Memahami QIK-VRT","QIK-VRT membuat keputusan teknis, status, bukti, dan dampak nyata dapat ditelusuri. Pemrosesan yang berhasil belum membuktikan dampak yang dimaksud.","Bukti historis dapat dipertahankan. Validitas saat ini harus dibuktikan kembali."],ko:["한국어","QIK-VRT 이해하기","QIK-VRT는 기술적 결정, 상태, 증거와 실제 효과를 추적 가능하게 합니다. 처리 성공만으로 의도한 효과가 입증되는 것은 아닙니다.","과거의 증거는 보존될 수 있습니다. 현재의 유효성은 새롭게 입증되어야 합니다."],ja:["日本語","QIK-VRTを理解する","QIK-VRTは技術的な判断、状態、証拠、現実の効果を追跡可能にします。処理の成功だけでは、意図した効果の証明にはなりません。","過去の証拠は保持できます。現在の有効性は改めて証明されなければなりません。"],zh:["简体中文","了解 QIK-VRT","QIK-VRT 使技术决策、状态、证据和现实效果可追溯。处理成功并不等于已经证明预期效果。","历史证据可以保留；当前有效性必须重新得到证明。"]};const s=document.querySelector('#lang');Object.entries(T).forEach(([k,v])=>s.add(new Option(v[0],k)));function show(k){const v=T[k]||T.en;document.documentElement.lang=k;document.documentElement.dir=k==='ar'?'rtl':'ltr';document.querySelector('#content').innerHTML='<h2>'+v[1]+'</h2><p>'+v[2]+'</p>';document.querySelector('#principle').textContent=v[3];s.value=k;localStorage.setItem('qikvrt-lang',k)}s.onchange=()=>show(s.value);let k=localStorage.getItem('qikvrt-lang')||(navigator.language||'en').slice(0,2);show(T[k]?k:'en');</script></body></html>
\ No newline at end of file
