+{
+  "schema": "qikvrt_planck_spacetime_unit_claim_matrix_v1",
+  "article": {
+    "path": "docs/publications/2026-08-29-planck-spacetime-unit-quantum-tunnel/QIKVRT_RAUMZEIT_PLANCK_EINHEIT_QUANTENTUNNEL_DE_2026-08-29.md",
+    "sha256": "c85c78d16241cf8266dfc32b1fdeb7844509726f5c6819e37c721f40d941934e",
+    "language": "de",
+    "author_product_owner": "Ingolf Lohmann",
+    "technical_elaboration": "OpenAI Codex",
+    "date": "2026-08-29",
+    "state": "private_repository_publication_candidate"
+  },
+  "classes": [
+    "OWNER_ASSERTION",
+    "SOURCE_BOUND",
+    "FORMAL_PROVED",
+    "DERIVED",
+    "INTERPRETIVE",
+    "OPEN"
+  ],
+  "claims": [
+    {
+      "id": "PSU-001",
+      "statement": "The source audio asks to reconsider metre and second, relate gravity to a duality analogous to electromagnetism, give spacetime a common unit and investigate three Planck-scale vectors and a possible 'quantum tunnel'.",
+      "class": "OWNER_ASSERTION",
+      "status": "SEMANTIC_RECONSTRUCTION_TWO_LOCAL_ASR_PASSES",
+      "source": "audio sha256:2c9512a1ce79c9ea75f669b4e68e748076dcabfad8164d639a424578786b61dd",
+      "boundary": "The audio is not VERBATIM_VERIFIED and does not define the vector space, dynamics or experimental prediction."
+    },
+    {
+      "id": "PSU-002",
+      "statement": "The SI is defined through seven defining constants; the choice of base units is not mathematically unique.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://www.bipm.org/documents/20126/41483022/SI-Brochure-9-EN.pdf",
+      "boundary": "A metrological definition is not a new law of nature."
+    },
+    {
+      "id": "PSU-003",
+      "statement": "The exact SI numerical value of c is 299792458 m/s, so c times one second is 299792458 metres; metre and second remain different dimensions.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://www.bipm.org/documents/20126/41483022/SI-Brochure-9-EN.pdf",
+      "boundary": "The dimensionally invalid statement 1 s equals 299792458 m is not used."
+    },
+    {
+      "id": "PSU-004",
+      "statement": "Using x0 = ct gives all four local spacetime coordinate components a length unit while preserving four components, Lorentz signature and causal structure.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://web.mit.edu/8.286/www/slides20/sl11s-euf20.pdf",
+      "boundary": "A coordinate or unit conversion does not change invariant intervals."
+    },
+    {
+      "id": "PSU-005",
+      "statement": "Planck length, time and mass are defined by lP=sqrt(hbar G/c^3), tP=lP/c and mP=sqrt(hbar c/G).",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://physics.nist.gov/cuu/pdf/JPCRD2022CODATA.pdf",
+      "boundary": "The convention uses hbar and the unreduced Planck mass; other conventions can differ by factors such as sqrt(8 pi)."
+    },
+    {
+      "id": "PSU-006",
+      "statement": "CODATA Planck scales are natural dimensional scales, not experimentally established minimum length, discrete time tick or a completed quantum-gravity theory.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://www.einstein-online.info/en/explandict/planck-length/",
+      "boundary": "Expected relevance to quantum gravity is not empirical confirmation of a particular QIK-VRT dynamics."
+    },
+    {
+      "id": "PSU-007",
+      "statement": "The mechanical dimension vectors d(c)=(0,1,-1), d(hbar)=(1,2,-1) and d(G)=(-1,3,-2) have determinant -2 and therefore form a basis of the M,L,T dimension space.",
+      "class": "DERIVED",
+      "status": "CHECKABLE_LINEAR_ALGEBRA",
+      "source": "dimension calculation shown in the article",
+      "boundary": "These are basis vectors of a three-dimensional dimension/calibration space, not three physical spacetime vectors."
+    },
+    {
+      "id": "PSU-008",
+      "statement": "A typed and version-bound SI-to-Planck-to-SI conversion is algebraically bijective when dimensions, quantity kind, calibration, constants, uncertainty and precision rules are retained.",
+      "class": "DERIVED",
+      "status": "SPECIFIABLE",
+      "source": "article sections 8 and 14",
+      "boundary": "Discarding type, dimension, uncertainty or numeric precision destroys this guarantee."
+    },
+    {
+      "id": "PSU-009",
+      "statement": "The QIK-VRT H5 bundle contains six Lean-kernel-accepted symbolic Planck identities in a bounded model.",
+      "class": "FORMAL_PROVED",
+      "status": "REPOSITORY_ARTIFACT",
+      "source": "docs/publications/2026-08-02-vrtcore-smg-h5/VRTCore_SMG_PlanckBridge.lean",
+      "boundary": "A Lean theorem establishes only its formal statement relative to definitions, axioms and toolchain."
+    },
+    {
+      "id": "PSU-010",
+      "statement": "The QIK-VRT measurement-derived-dimensions module formalizes dimensions from declared calibration actions in a bounded model.",
+      "class": "FORMAL_PROVED",
+      "status": "REPOSITORY_ARTIFACT",
+      "source": "docs/publications/2026-08-07-measurement-derived-dimensions/MeasurementDerivedDimensions.lean",
+      "boundary": "It does not establish that nature uses a particular calibration ontology."
+    },
+    {
+      "id": "PSU-011",
+      "statement": "Source-free Maxwell equations in four dimensions have a global electric-magnetic duality rotation.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1103/PhysRevD.13.1592",
+      "boundary": "Electric sources without matched magnetic sources and local duality angles break this simple symmetry."
+    },
+    {
+      "id": "PSU-012",
+      "statement": "Linearized source-free gravity has an electric-magnetic duality, and the Weyl tensor admits electric/magnetic decompositions in stated scopes.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1103/PhysRevD.71.024018",
+      "boundary": "This is not a general U(1) duality of all nonlinear Einstein gravity."
+    },
+    {
+      "id": "PSU-013",
+      "statement": "Nonlinear interactions obstruct a Maxwell-like U(1) electric-magnetic duality for Einstein gravity in general.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://arxiv.org/abs/2312.02351",
+      "boundary": "Special sectors and linearized theory retain narrower duality statements."
+    },
+    {
+      "id": "PSU-014",
+      "statement": "Gravitational waves have been directly observed, whereas an individual graviton or a complete experimentally confirmed quantum gravity theory has not been directly observed.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED_WITH_SCOPE",
+      "source": "https://doi.org/10.1103/PhysRevLett.116.061102",
+      "boundary": "The observation of classical gravitational waves does not by itself establish a graviton detection."
+    },
+    {
+      "id": "PSU-015",
+      "statement": "In WKB tunnelling, rescaling length, mass, potential and energy into Planck units leaves the dimensionless action exponent and the transmission probability unchanged.",
+      "class": "DERIVED",
+      "status": "CHECKABLE_RESCALE",
+      "source": "https://ocw.mit.edu/courses/8-06-quantum-physics-iii-spring-2016/d7ef4fca98220af90a64670c57eaf046_MIT8_06S16_chap1.pdf",
+      "boundary": "A unit change alone does not add a barrier, Hamiltonian term or transition amplitude."
+    },
+    {
+      "id": "PSU-016",
+      "statement": "Relativistic tunnelling cannot be used for superluminal particle or information transmission outside the future light cone.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://doi.org/10.1103/PhysRevA.107.032209",
+      "boundary": "This result concerns the stated relativistic quantum model; it is not a proof about any undefined future theory."
+    },
+    {
+      "id": "PSU-017",
+      "statement": "The label Quantentunnel is scientifically safe as a Q0 metaphor for a reversible Planck bridge or Q1 computational normal form, while Q2 physical tunnelling remains undefined.",
+      "class": "INTERPRETIVE",
+      "status": "TERMINOLOGY_WITH_LEVELS",
+      "source": "article section 12",
+      "boundary": "The name does not establish a physical tunnel."
+    },
+    {
+      "id": "PSU-018",
+      "statement": "A pure invertible representation change has no new empirical content unless a dimensionless observable remains different after the inverse transformation.",
+      "class": "DERIVED",
+      "status": "EQUIVALENCE_CRITERION",
+      "source": "article section 13",
+      "boundary": "A claimed new effect needs explicit dynamics, a prediction and a falsification condition."
+    },
+    {
+      "id": "PSU-019",
+      "statement": "QIK-VRT can specify canonical, provenance-bound, typed measurement serialization without claiming a new physical effect.",
+      "class": "DERIVED",
+      "status": "IMPLEMENTATION_DESIGN",
+      "source": "article section 14",
+      "boundary": "The candidate serialization format is not yet a completed general hardware implementation."
+    },
+    {
+      "id": "PSU-020",
+      "statement": "Canonical dimension vectors and Planck exponent representations can reduce avoidable conversion work and make dimensional checks hardware-friendly.",
+      "class": "DERIVED",
+      "status": "TECHNICAL_HYPOTHESIS",
+      "source": "article section 15",
+      "boundary": "No end-to-end performance, energy or area measurement is provided."
+    },
+    {
+      "id": "PSU-021",
+      "statement": "No new QIK-VRT Planck-spacetime dynamics, distinct dimensionless prediction, experimental protocol result or independent replication is presently materialized in this bundle.",
+      "class": "OPEN",
+      "status": "NOT_YET_DEFINED_OR_OBSERVED",
+      "source": "article sections 13, 16 and 17",
+      "boundary": "This is the first scientific completion gap, not a successful physical result."
+    },
+    {
+      "id": "PSU-022",
+      "statement": "The current relationship between the QIK-VRT formalism and physical quantum phenomena is physically connectable but not empirically established for this proposal.",
+      "class": "INTERPRETIVE",
+      "status": "PHYSICALLY_CONNECTABLE",
+      "source": "article sections 9, 10 and 17",
+      "boundary": "PHYSICALLY_CONNECTABLE is neither EMPIRICALLY_CONFIRMED nor a general physical EFFECT_ACK."
+    },
+    {
+      "id": "PSU-023",
+      "statement": "The candidate article is repository-bound but not peer reviewed, placed on Zenodo or evaluated for patent claims.",
+      "class": "OPEN",
+      "status": "PREPUBLICATION_HOLD",
+      "source": "README.md and article release boundary",
+      "boundary": "A local commit or hash does not constitute external publication or legal protection."
+    },
+    {
+      "id": "PSU-024",
+      "statement": "A prototype or synthesizable hardware design for the proposed physical hypothesis is not evidenced by this publication candidate.",
+      "class": "OPEN",
+      "status": "NO_HARDWARE_CORRESPONDENCE",
+      "source": "README.md and article release boundary",
+      "boundary": "Software formalization, VHDL simulation or symbolic proof would not alone establish fabricated hardware."
+    },
+    {
+      "id": "PSU-025",
+      "statement": "The proper next completion step is to freeze a typed Planck-spacetime mapping and then define one non-removable dimensionless prediction with falsification protocol.",
+      "class": "DERIVED",
+      "status": "EVIDENCE_CORRECT_NEXT_STEP",
