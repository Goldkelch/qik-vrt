+    "FORMAL_PROVED",
+    "EXECUTED",
+    "SOURCE_BOUND",
+    "DERIVED",
+    "INTERPRETIVE",
+    "PERSONAL_ACCOUNT",
+    "OPEN"
+  ],
+  "claims": [
+    {
+      "id": "QCOMP-001",
+      "statement": "QIK-VRT revision -03 defines exactly five version-1 outcomes and permits ordinary release only for a valid EFFECT_ACK_DONE.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://datatracker.ietf.org/doc/html/draft-lohmann-qikvrt-effect-ack-03",
+      "boundary": "Active individual experimental Internet-Draft; not an RFC or IETF consensus."
+    },
+    {
+      "id": "QCOMP-002",
+      "statement": "The revision -03 CoreDone predicate contains 17 conjunctive conditions, with additional consumer authentication, freshness, schema and chain checks.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://datatracker.ietf.org/doc/html/draft-lohmann-qikvrt-effect-ack-03#section-4.1",
+      "boundary": "A record digest does not establish the truth of external evidence."
+    },
+    {
+      "id": "QCOMP-003",
+      "statement": "RFC 9110 is a June 2022 Standards Track RFC for HTTP Semantics, not an expired Internet-Draft.",
+      "class": "SOURCE_BOUND",
+      "status": "SUPPORTED",
+      "source": "https://www.rfc-editor.org/rfc/rfc9110.html",
+      "boundary": "RFC 9110 does not specify QIK-VRT EFFECT_ACK."
+    },
+    {
+      "id": "QCOMP-004",
+      "statement": "The finite C90 evidence enumerates 2,621,440 valid snapshots, 5,242,880 consumer-admission variants and 7,864,387 checks.",
+      "class": "EXECUTED",
