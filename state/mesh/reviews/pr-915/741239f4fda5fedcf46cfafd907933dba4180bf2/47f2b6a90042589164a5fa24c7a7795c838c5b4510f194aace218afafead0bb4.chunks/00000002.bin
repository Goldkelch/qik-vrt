+{
+  "schema": "qikvrt_quantitative_comparison_claim_matrix_v1",
+  "article": {
+    "path": "docs/publications/2026-08-29-qikvrt-quantitative-comparison/QIKVRT_QUANTITATIVER_VERGLEICHSARTIKEL_DE_2026-08-29.md",
