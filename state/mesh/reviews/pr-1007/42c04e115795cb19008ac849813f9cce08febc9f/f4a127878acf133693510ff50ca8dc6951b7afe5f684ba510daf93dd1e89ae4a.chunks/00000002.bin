+      "SHOW_OPEN_UNCERTAINTY",
+      "SELECT_SMALLEST_SAFE_NEXT_ACTION",
+      "EXECUTE_ONLY_IF_AUTHORIZED",
+      "READ_BACK_EFFECT",
+      "RECLASSIFY_REMAINING_UNCERTAINTY"
+    ]
+  },
+  "uncertainty_rule": {
+    "hidden_ambiguity_forbidden": true,
+    "plausibility_is_not_resolution": true,
+    "every_material_question_must_end_as": [
+      "RESOLVED_BY_EVIDENCE",
+      "OPEN",
+      "HOLD",
+      "REOBSERVE",
+      "REQUEST_AUTHORITY"
+    ],
+    "no_false_certainty": true
+  },
+  "mesh_interoperability": {
+    "must_preserve": [
+      "provenance",
+      "claim_class",
+      "uncertainty",
+      "exact_subject_binding",
+      "authorization_boundary",
+      "effect_readback"
+    ],
+    "adapters_may_extend": true,
+    "adapters_may_weaken_core_semantics": false,
+    "unknown_required_field": "HOLD"
+  },
+  "mandatory_non_equivalences": [
+    "BYTES != MEANING",
+    "SEQUENCE != CAUSALITY",
+    "TRANSPORT_ACK != EFFECT_ACK",
+    "OBSERVATION != TRUTH",
+    "MODEL != REALITY",
+    "FORMAL_VERIFIED != PHYSICAL_CORRESPONDENCE",
+    "REPOSITORY_EVIDENCE != ZENODO_PUBLICATION",
+    "ZENODO_PUBLICATION != EMPIRICAL_CONFIRMATION",
+    "DELIVERY_PREPARATION != DELIVERY_ACCEPTED"
+  ]
+}
diff --git a/policy/PR_HEAD_MUTATION_BOUNDARY_V1.json b/policy/PR_HEAD_MUTATION_BOUNDARY_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..a4f651aca2c58e2d93562af43c0d39515ae71a40
--- /dev/null
+++ b/policy/PR_HEAD_MUTATION_BOUNDARY_V1.json
@@ -0,0 +1,35 @@
+{
+  "schema": "qikvrt_pr_head_mutation_boundary_v1",
+  "version": "1.0.0",
+  "status": "NORMATIVE",
+  "problem": "GitHub may hold pull_request workflow runs at action_required when a synchronize event is caused by github-actions[bot]/GITHUB_TOKEN. A workflow that materializes evidence and pushes that materialization back onto the active PR head can therefore create a self-sustaining approval loop.",
+  "invariant": "PULL_REQUEST_WORKFLOW_MUST_NOT_MUTATE_ITS_OWN_PR_HEAD_WITH_GITHUB_TOKEN",
+  "required_behavior": {
+    "pull_request": [
+      "materialize in workspace",
+      "validate exact subject",
+      "emit check/artifact/readback evidence",
+      "never git commit to active PR head",
+      "never git push to github.head_ref"
+    ],
+    "push_or_explicit_non_pr_writer": [
+      "may persist deterministic materialization only under existing exact-ref drift checks and repository write authority"
+    ]
+  },
+  "forbidden_patterns": [
+    "pull_request + TARGET_REF=github.head_ref + unguarded git commit",
+    "pull_request + TARGET_REF=github.head_ref + unguarded git push origin HEAD:$TARGET_REF"
+  ],
+  "minimum_guard": "if: github.event_name != 'pull_request'",
+  "evidence_boundary": [
+    "PR_READONLY_MATERIALIZATION != REPOSITORY_PERSISTENCE",
+    "WORKFLOW_SUCCESS != REVIEW_APPROVAL",
+    "REPOSITORY_EVIDENCE != EXTERNAL_EFFECT"
+  ],
+  "origin_incident": {
+    "pull_request": 1004,
+    "observed_bot_head": "eabaa467d63a9fc7bc9b8e5f9fd65a5a979aa8d7",
+    "observed_conclusion": "action_required",
+    "jobs_started": false
+  }
+}
diff --git a/policy/REQUEST_OBLIGATION_CLOSURE_V1.json b/policy/REQUEST_OBLIGATION_CLOSURE_V1.json
new file mode 100644
index 0000000000000000000000000000000000000000..1a5b9c965e8fa4870d17cbe97771189ba6916929
--- /dev/null
+++ b/policy/REQUEST_OBLIGATION_CLOSURE_V1.json
@@ -0,0 +1,92 @@
+{
+  "schema": "QIKVRT_REQUEST_OBLIGATION_CLOSURE_V1",
+  "version": 1,
+  "purpose": "Preserve the semantic obligations of the originating request across every intermediate transition until exact effect readback or an irreducible fail-closed hold.",
+  "derivation": {
+    "premises": [
+      "TRANSPORT_ACK != EFFECT_ACK",
+      "EXECUTION != EFFECT",
+      "EFFECT != EFFECT_KNOWLEDGE",
+      "ACTIVITY_REPORT != ACTUAL_END_STATE",
+      "EVIDENCE_IS_SUBJECT_BOUND",
+      "MACHINE_OWNED_WORK_REMAINING_CONTINUE_AUTONOMOUSLY"
+    ],
+    "failure_pattern": "An intermediate transition can satisfy a local subgoal while leaving one or more obligations of the originating request unsatisfied. Treating local success as request completion loses intent across a state boundary.",
+    "repair": "Carry a monotone obligation ledger whose entries can only become SATISFIED after exact readback, or BLOCKED after an irreducibility proof. Intermediate transitions may add derived obligations but may not silently delete originating obligations."
+  },
+  "request_model": {
+    "request_id_required": true,
+    "subject_binding_required": true,
+    "obligations_required": true,
+    "obligation_fields": [
+      "obligation_id",
+      "requested_effect",
+      "exact_subject",
+      "authority_requirement",
+      "completion_predicate",
+      "readback_method",
+      "state"
+    ],
+    "states": ["OPEN", "ACTIVE", "SATISFIED", "BLOCKED"],
+    "initial_state": "OPEN"
+  },
+  "transition_invariant": {
+    "originating_obligation_deletion_allowed": false,
+    "derived_obligations_may_be_added": true,
+    "intermediate_success_implies_completion": false,
+    "head_or_subject_mutation_invalidates_downstream_binding": true,
+    "satisfied_requires_exact_readback": true,
+    "blocked_requires_irreducibility_evidence": true,
+    "retry_without_new_causal_evidence_allowed": false
+  },
+  "return_gate": {
+    "formula": "RETURN_ALLOWED iff ALL(request_obligations.state == SATISFIED) OR EXISTS_IRREDUCIBLE_BLOCK_WITH_NO_AUTHORIZED_SAFE_NEXT_ACTION",
+    "requested_effect_and_readback": "DoD = REQUESTED_EFFECT + EXACT_EFFECT_READBACK",
+    "if_authorized_safe_next_action_exists": "EXECUTE_IN_SAME_RUN",
+    "describe_executable_next_action_instead_of_executing": "FORBIDDEN",
+    "preflight_is_terminal": false,
+    "commit_is_terminal": false,
+    "push_is_terminal": false,
+    "review_is_terminal": false,
+    "merge_is_terminal_unless_merge_is_the_requested_effect": false,
+    "upload_is_terminal_unless_upload_is_the_requested_effect": false,
+    "transport_ack_is_terminal": false
+  },
+  "roundtrip": [
+    "CAPTURE_REQUEST",
+    "DERIVE_OBLIGATIONS",
+    "BIND_EXACT_SUBJECTS",
+    "OBSERVE",
+    "SELECT_AUTHORIZED_SAFE_ACTION",
+    "ACT",
+    "READBACK",
+    "DISCHARGE_OR_REFINE_OBLIGATIONS",
+    "REOBSERVE_REMAINING_OBLIGATIONS",
+    "REPEAT_UNTIL_RETURN_GATE"
+  ],
+  "scale_rule": "The same obligation ledger composes recursively across tool calls, workflows, pull requests, repositories, deployments, publications and physical-effect adapters. A child completion discharges only the parent obligation explicitly bound to that child result.",
+  "hold_proof": {
+    "required": [
+      "exact_unsatisfied_obligation",
+      "last_verified_subject",
+      "failed_boundary",
+      "available_capabilities_examined",
+      "why_each_safe_authorized_action_cannot_advance",
+      "minimal_external_edge_needed"
+    ],
+    "absence_of_attempt": "NOT_A_BLOCK",
+    "missing_assumption_without_capability_search": "NOT_A_BLOCK"
+  },
+  "effect_state_mapping": {
+    "OPEN": "EFFECT_ACK_CONTINUE",
+    "ACTIVE": "EFFECT_ACK_CONTINUE",
+    "SATISFIED": "EFFECT_ACK_DONE_FOR_BOUND_OBLIGATION_ONLY",
+    "BLOCKED": "EFFECT_ACK_BLOCK_FOR_BOUND_OBLIGATION_ONLY"
+  },
+  "non_claims": [
+    "This policy does not grant authority.",
+    "This policy does not bypass safety, review, publication, merge or external-effect gates.",
+    "This policy does not transfer evidence across changed subjects.",
+    "A locally satisfied obligation does not imply repository-wide PASS or global EFFECT_ACK_DONE."
+  ]
+}
