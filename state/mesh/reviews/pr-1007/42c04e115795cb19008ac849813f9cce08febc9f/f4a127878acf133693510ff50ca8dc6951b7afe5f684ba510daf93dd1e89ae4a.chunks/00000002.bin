+{
+  "$schema": "./QIKVRT_INFORMATION_EFFECT_AXIS_V1.schema.json",
+  "id": "QIKVRT_INFORMATION_EFFECT_AXIS_V1",
+  "version": "1.2.0",
+  "status": "PROPOSED_REVIEW_CARRIER",
+  "author": "Ingolf Lohmann",
+  "date": "2026-09-06",
+  "canonical_statement": "QIK-VRT controls the transformation of distinguishable state differences into evidence-bound, authorized effects.",
+  "core_chain": [
+    "PHYSICAL_OR_VIRTUAL_STATE",
+    "DISTINCTION",
+    "MEASUREMENT_OR_OBSERVATION",
+    "REPRESENTATION",
+    "INFORMATION",
+    "EVIDENCE_BINDING",
+    "CAUSALITY_ASSESSMENT",
+    "AUTHORIZATION",
+    "EFFECT",
+    "READBACK"
+  ],
+  "scaling_chain": [
+    "COMPUTE_SCALING",
+    "STATE_SCALING",
+    "EVIDENCE_SCALING",
+    "AUTHORITY_SCALING",
+    "EFFECT_SCALING"
+  ],
+  "boundary_invariant": "NO_TRANSITION_MAY_CLAIM_MORE_THAN_ITS_BOUNDARY_ACTUALLY_CARRIES",
+  "non_equivalences": [
+    "BYTES != MEANING",
+    "SEQUENCE != CAUSALITY",
+    "TRANSPORT_ACK != EFFECT_ACK",
+    "COMMAND != OBSERVED_EFFECT",
+    "OBSERVATION != TRUTH",
+    "MODEL != REALITY",
+    "VERIFIED_IMPLEMENTATION != AUTHORITY_EFFECT",
+    "BOUND != EMPIRICALLY_CONFIRMED",
+    "REPOSITORY_EVIDENCE != ZENODO_PUBLICATION",
+    "ZENODO_PUBLICATION != EMPIRICAL_CONFIRMATION",
+    "FALSIFIABLE_HYPOTHESIS != EMPIRICALLY_CONFIRMED_LAW"
+  ],
+  "measurement_metadata_required": [
+    "value",
+    "time",
+    "uncertainty",
+    "unit",
+    "calibration",
+    "provenance"
+  ],
+  "optional_measurement_metadata": [
+    "sensor_identity",
+    "sampling_rate",
+    "bandwidth",
+    "anti_alias_filter",
+    "quantizer",
+    "scale",
+    "rounding_mode",
+    "transform_version",
+    "content_hash",
+    "signature",
+    "authority"
+  ],
+  "node_contract": {
+    "state": "S",
+    "evidence": "K",
+    "authority": "A",
+    "input_contract": "I",
+    "output_contract": "O",
+    "transition_contract": "T",
+    "readback_contract": "R"
+  },
+  "boundary_contract": {
+    "encoder": "E",
+    "decoder": "D",
+    "schema": "Sigma",
+    "version": "V",
+    "unit_or_scale": "U",
+    "provenance": "P",
+    "temporal_or_causal_validity": "tau"
+  },
+  "singularity_classification": [
+    "MATHEMATICAL_SINGULARITY",
+    "COORDINATE_OR_REPRESENTATION_SINGULARITY",
+    "NUMERICAL_PATHOLOGY_OR_ILL_CONDITIONING",
+    "MODEL_DOMAIN_BOUNDARY",
+    "PHYSICAL_SINGULARITY_DIAGNOSIS"
+  ],
+  "control_states": [
+    "NOOP",
+    "HOLD",
+    "REOBSERVE",
+    "REQUEST_AUTHORITY"
+  ],
+  "fail_closed_rules": [
+    "missing_required_metadata -> HOLD",
+    "unknown_causal_binding -> HOLD_or_REOBSERVE",
+    "effect_without_readback -> not_EFFECT_ACK",
+    "model_presented_as_reality -> BLOCK_or_HOLD",
+    "out_of_domain_transition -> HOLD",
+    "saturated_or_non_observable_measurement -> HOLD_or_REOBSERVE",
+    "repository_validation_without_external_readback -> no_external_effect_claim",
+    "zenodo_publication_without_empirical_measurement -> no_empirical_confirmation_claim"
+  ],
+  "adapter_contract": {
+    "input": "measurement_or_information_object",
+    "output": "evidence_bound_claim_or_control_state",
+    "must_preserve_provenance": true,
+    "must_mark_uncertainty": true,
+    "must_expose_claim_boundary": true,
+    "must_support_readback": true,
+    "must_preserve_publication_vs_empirical_boundary": true,
+    "extensions_allowed": true,
+    "core_semantics_may_be_weakened": false
+  },
+  "historical_bridge": {
+    "transputer": "historical comparison architecture for local compute plus explicit communication; not claimed as QIK-VRT predecessor implementation",
+    "atari_atw": "historical system example separating T800 compute, Motorola 68000 I/O, and expandable transputer farm nodes",
+    "claim_scope": "structural architecture comparison only"
+  },
+  "public_prior_art": {
+    "manifest": "./QIKVRT_ZENODO_PRIOR_ART_V1.json",
+    "inventory_2026_07_22": {
+      "version_records": 14,
+      "concept_lines": 5
+    },
+    "anchors": [
+      "10.5281/zenodo.20712301",
+      "10.5281/zenodo.21267021",
+      "10.5281/zenodo.21482023",
+      "10.5281/zenodo.21488116",
+      "10.5281/zenodo.21498773",
+      "10.5281/zenodo.21498774",
+      "10.5281/zenodo.22283396"
+    ]
+  },
+  "scientific_boundaries": {
+    "shannon": "information/sampling/communication theory connection; not identical to QIK-VRT",
+    "wheeler": "interpretive research program relating information and physics; not treated as experimentally proven ontology",
+    "landauer": "thermodynamic lower bound for logically irreversible erasure under stated assumptions; not a cost assigned to every bit",
+    "transputer": "historical explicit-communication compute architecture; not an evidence or effect-ack system",
+    "qik_vrt": "evidence, causality, authorization and effect-boundary architecture",
+    "zenodo": "public archival/publication evidence and DOI binding; not empirical confirmation",
+    "planck_tick_gap_law": "published falsifiable physical hypothesis at DOI 10.5281/zenodo.22283396; empirical correspondence remains a separate state"
+  }
+}
