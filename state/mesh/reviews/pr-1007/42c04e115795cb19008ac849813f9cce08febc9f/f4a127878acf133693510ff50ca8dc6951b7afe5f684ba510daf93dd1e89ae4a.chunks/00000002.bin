         for token in (
             'source_head="$(git rev-parse --verify HEAD^{commit})"',
             'git ls-remote --heads origin "refs/heads/$TARGET_REF"',
@@ -120,6 +121,10 @@ class AphorismCorpusV2Tests(unittest.TestCase):
