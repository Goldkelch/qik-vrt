 NOVNC_PORT="${QIKVRT_NOVNC_PORT:-6080}"
 DISPLAY_VALUE="${DISPLAY:-:99}"
 START_URL="${QIKVRT_START_URL:-https://arxiv.org/}"
+LIVE_PR="${QIKVRT_LIVE_PR:-1096}"
