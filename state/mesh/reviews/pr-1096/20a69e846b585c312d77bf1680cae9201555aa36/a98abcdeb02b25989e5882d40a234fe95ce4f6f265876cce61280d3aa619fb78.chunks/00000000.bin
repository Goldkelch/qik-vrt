+: > "$LIVE_LOG"
+python3 -u -B /opt/qikvrt/tools/qikvrt_live_tail_stream.py \
+  --repo "${GITHUB_REPOSITORY:-Goldkelch/qik-vrt}" \
+  --pr "$LIVE_PR" \
+  --cursor "$LIVE_CURSOR" \
+  --follow \
+  >> "$LIVE_LOG" 2>&1 &
+TAIL_PID=$!
