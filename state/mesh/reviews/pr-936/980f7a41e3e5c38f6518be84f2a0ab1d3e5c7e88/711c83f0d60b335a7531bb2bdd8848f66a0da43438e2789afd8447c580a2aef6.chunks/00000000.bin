diff --git a/hardware/vhdl/qikvrt_fixed_point_mac.vhd b/hardware/vhdl/qikvrt_fixed_point_mac.vhd
new file mode 100644
index 0000000000000000000000000000000000000000..3ff9f662d0aa7b5b1713a1ce045a276052ebea4c
--- /dev/null
+++ b/hardware/vhdl/qikvrt_fixed_point_mac.vhd
@@ -0,0 +1,62 @@
+-- SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+-- Copyright 2026 Ingolf Lohmann.
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+entity qikvrt_fixed_point_mac is
+  generic (
+    OPERAND_WIDTH : positive := 8;
+    ACC_WIDTH     : positive := 32
+  );
+  port (
+    clk_i       : in  std_logic;
+    reset_i     : in  std_logic;
+    clear_i     : in  std_logic;
+    valid_i     : in  std_logic;
+    left_i      : in  signed(OPERAND_WIDTH - 1 downto 0);
+    right_i     : in  signed(OPERAND_WIDTH - 1 downto 0);
+    accumulator_o : out signed(ACC_WIDTH - 1 downto 0);
+    accepted_o  : out std_logic;
+    overflow_o  : out std_logic
+  );
+end entity;
+
+architecture rtl of qikvrt_fixed_point_mac is
+  signal accumulator_q : signed(ACC_WIDTH - 1 downto 0) := (others => '0');
+  signal accepted_q    : std_logic := '0';
+  signal overflow_q    : std_logic := '0';
+begin
+  assert ACC_WIDTH >= 2 * OPERAND_WIDTH
+    report "ACC_WIDTH must hold one full signed product"
+    severity failure;
+
+  process (clk_i)
+    variable product_v   : signed(2 * OPERAND_WIDTH - 1 downto 0);
+    variable candidate_v : signed(ACC_WIDTH downto 0);
+  begin
+    if rising_edge(clk_i) then
+      accepted_q <= '0';
+      if reset_i = '1' then
+        accumulator_q <= (others => '0');
+        overflow_q    <= '0';
+      elsif clear_i = '1' then
+        accumulator_q <= (others => '0');
+        overflow_q    <= '0';
+      elsif valid_i = '1' and overflow_q = '0' then
+        product_v := left_i * right_i;
+        candidate_v := resize(accumulator_q, ACC_WIDTH + 1) + resize(product_v, ACC_WIDTH + 1);
+        if candidate_v(ACC_WIDTH) /= candidate_v(ACC_WIDTH - 1) then
+          overflow_q <= '1';
+        else
+          accumulator_q <= candidate_v(ACC_WIDTH - 1 downto 0);
+          accepted_q    <= '1';
+        end if;
+      end if;
+    end if;
+  end process;
+
+  accumulator_o <= accumulator_q;
+  accepted_o    <= accepted_q;
+  overflow_o    <= overflow_q;
+end architecture;
diff --git a/hardware/vhdl/tb_qikvrt_fixed_point_mac.vhd b/hardware/vhdl/tb_qikvrt_fixed_point_mac.vhd
new file mode 100644
index 0000000000000000000000000000000000000000..b664aba1679aaa582627d9ba1620f2c052991476
--- /dev/null
+++ b/hardware/vhdl/tb_qikvrt_fixed_point_mac.vhd
@@ -0,0 +1,63 @@
+-- SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+-- Copyright 2026 Ingolf Lohmann.
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+use std.env.all;
+
+entity tb_qikvrt_fixed_point_mac is
+end entity;
+
+architecture test of tb_qikvrt_fixed_point_mac is
+  signal clk         : std_logic := '0';
+  signal reset       : std_logic := '1';
+  signal clear       : std_logic := '0';
+  signal valid       : std_logic := '0';
+  signal left_value  : signed(7 downto 0) := (others => '0');
+  signal right_value : signed(7 downto 0) := (others => '0');
+  signal accumulator : signed(15 downto 0);
+  signal accepted    : std_logic;
+  signal overflow    : std_logic;
+begin
+  clk <= not clk after 5 ns;
+
+  dut : entity work.qikvrt_fixed_point_mac
+    generic map (OPERAND_WIDTH => 8, ACC_WIDTH => 16)
+    port map (
+      clk_i => clk, reset_i => reset, clear_i => clear, valid_i => valid,
+      left_i => left_value, right_i => right_value,
+      accumulator_o => accumulator, accepted_o => accepted, overflow_o => overflow
+    );
+
+  stimulus : process
+  begin
+    wait for 12 ns;
+    reset <= '0';
+    valid <= '1';
+    left_value <= to_signed(3, 8);
+    right_value <= to_signed(4, 8);
+    wait for 10 ns;
+    assert accumulator = to_signed(12, 16) severity failure;
+    assert accepted = '1' and overflow = '0' severity failure;
+
+    left_value <= to_signed(-2, 8);
+    right_value <= to_signed(5, 8);
+    wait for 10 ns;
+    assert accumulator = to_signed(2, 16) severity failure;
+
+    valid <= '0';
+    clear <= '1';
+    wait for 10 ns;
+    clear <= '0';
+    valid <= '1';
+    left_value <= to_signed(127, 8);
+    right_value <= to_signed(127, 8);
+    wait for 20 ns;
+    assert accumulator = to_signed(32258, 16) severity failure;
+    wait for 10 ns;
+    assert accumulator = to_signed(32258, 16) severity failure;
+    assert overflow = '1' and accepted = '0' severity failure;
+    stop;
+    wait;
+  end process;
+end architecture;
diff --git a/schemas/qikvrt_numeric_contract_v1.schema.json b/schemas/qikvrt_numeric_contract_v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..ed7fdcdf0956fd019724ea85484cbe3807961b6a
--- /dev/null
+++ b/schemas/qikvrt_numeric_contract_v1.schema.json
@@ -0,0 +1,71 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/Goldkelch/qik-vrt/schemas/qikvrt_numeric_contract_v1.schema.json",
+  "title": "QIK-VRT numeric contract v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema", "domain", "operations", "absolute_error_limit", "rounding",
+    "overflow", "scale_plan", "accumulation_plan", "metric",
+    "measurement_binding", "claim_boundary", "numeric_contract_digest"
+  ],
+  "properties": {
+    "schema": {"const": "qikvrt.numeric-contract.v1"},
+    "domain": {
+      "type": "object", "additionalProperties": false,
+      "required": ["signed", "operand_width_bits", "minimum_integer", "maximum_integer"],
+      "properties": {
+        "signed": {"const": true},
+        "operand_width_bits": {"type": "integer", "minimum": 2, "maximum": 32},
+        "minimum_integer": {"type": "integer"},
+        "maximum_integer": {"type": "integer"}
+      }
+    },
+    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["multiply", "accumulate"]}},
+    "absolute_error_limit": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
+    "rounding": {"enum": ["nearest_even", "toward_zero"]},
+    "overflow": {"enum": ["trap"]},
+    "scale_plan": {
+      "type": "object", "additionalProperties": false,
+      "required": ["operand_fraction_bits", "accumulator_fraction_bits"],
+      "properties": {
+        "operand_fraction_bits": {"type": "integer", "minimum": 0, "maximum": 31},
+        "accumulator_fraction_bits": {"type": "integer", "minimum": 0, "maximum": 62}
+      }
+    },
+    "accumulation_plan": {
+      "type": "object", "additionalProperties": false,
+      "required": ["accumulator_width_bits", "maximum_terms", "round_once"],
+      "properties": {
+        "accumulator_width_bits": {"type": "integer", "minimum": 4, "maximum": 256},
+        "maximum_terms": {"type": "integer", "minimum": 1},
+        "round_once": {"const": true}
+      }
+    },
+    "metric": {"enum": ["results_per_joule", "results_per_second"]},
+    "measurement_binding": {
+      "type": "object", "additionalProperties": false,
+      "required": ["reference_model_digest", "rtl_or_kernel_digest", "toolchain_and_flags", "target_device", "clock", "test_vector_digest", "raw_measurement_digest"],
+      "properties": {
+        "reference_model_digest": {"type": ["string", "null"]},
+        "rtl_or_kernel_digest": {"type": ["string", "null"]},
+        "toolchain_and_flags": {"type": ["string", "null"]},
+        "target_device": {"type": ["string", "null"]},
+        "clock": {"type": ["string", "null"]},
+        "test_vector_digest": {"type": ["string", "null"]},
+        "raw_measurement_digest": {"type": ["string", "null"]}
+      }
+    },
+    "claim_boundary": {
+      "type": "object", "additionalProperties": false,
+      "required": ["simulation_observed", "synthesis_observed", "physical_hardware_execution_observed", "performance_superiority_observed"],
+      "properties": {
+        "simulation_observed": {"type": "boolean"},
+        "synthesis_observed": {"const": false},
+        "physical_hardware_execution_observed": {"const": false},
+        "performance_superiority_observed": {"const": false}
+      }
+    },
+    "numeric_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
+  }
+}
diff --git a/state/work_units/FIXED_POINT_NUMERIC_CONTRACT_REFERENCE_V1.json b/state/work_units/FIXED_POINT_NUMERIC_CONTRACT_REFERENCE_V1.json
