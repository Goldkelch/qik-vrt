diff --git a/docs/publications/2026-09-23-nash-kognition/machine/article.json b/docs/publications/2026-09-23-nash-kognition/machine/article.json
new file mode 100644
index 0000000000000000000000000000000000000000..bd3a0b8fea8fe5732b6e729c09e047ba699218b5
--- /dev/null
+++ b/docs/publications/2026-09-23-nash-kognition/machine/article.json
@@ -0,0 +1,86 @@
+{
+  "schema": "qikvrt_nash_cognition_article_v1",
+  "publication_id": "qikvrt-nash-cognition-local-stability-v1",
+  "title_de": "Warum künstliche Kognition zu oft im Nash-Gleichgewicht stehen bleibt",
+  "author": "Ingolf Lohmann",
+  "canonical_language": "de",
+  "date": "2026-09-23",
+  "license": "CC-BY-NC-ND-4.0",
+  "epistemic_status": "argumentative_article_with_explicit_evidence_boundaries",
+  "core_claims": [
+    {
+      "id": "C1",
+      "statement": "Local stability does not imply global correctness.",
+      "formal": "LOCAL_STABILITY != GLOBAL_CORRECTNESS"
+    },
+    {
+      "id": "C2",
+      "statement": "Local completion does not imply universal completion.",
+      "formal": "LOCAL_EFFECT_ACK_DONE != UNIVERSAL_EFFECT_ACK_DONE"
+    },
+    {
+      "id": "C3",
+      "statement": "UNCHANGED does not imply DONE.",
+      "formal": "UNCHANGED != DONE"
+    },
+    {
+      "id": "C4",
+      "statement": "A stable state with remaining work and no progress edge requires deadlock-or-equilibrium diagnosis.",
+      "formal": "STABLE && WORK_REMAINING && !PROGRESS_EDGE => DEADLOCK_OR_EQUILIBRIUM_DIAGNOSIS"
+    },
+    {
+      "id": "C5",
+      "statement": "Diagnosis requires search for a missing transition.",
+      "formal": "DEADLOCK_OR_EQUILIBRIUM_DIAGNOSIS => SEARCH_FOR_MISSING_TRANSITION"
+    },
+    {
+      "id": "C6",
+      "statement": "Experience, interpretation and empirically confirmed external effect are distinct evidence classes.",
+      "formal": "EXPERIENCE != INTERPRETATION != EMPIRICALLY_CONFIRMED_EXTERNAL_EFFECT"
+    },
+    {
+      "id": "C7",
+      "statement": "Meaning may be understood while preserving evidence status.",
+      "formal": "UNDERSTAND_MEANING && PRESERVE_EVIDENCE_STATUS"
+    }
+  ],
+  "nash_boundary": {
+    "claim": "The article uses Nash equilibrium as a structural analogy, not an identity claim about modern AI.",
+    "deadlock_is_nash_equilibrium": false
+  },
+  "runtime_semantics": [
+    "COMPILE",
+    "BIND",
+    "RESOLVE",
+    "EXECUTE",
+    "TEST",
+    "OBSERVE",
+    "READBACK",
+    "ACCEPT",
+    "EFFECT_ACK_DONE"
+  ],
+  "done_condition": "COMPILE && BIND && RESOLVE && EXECUTE && TEST && OBSERVE && READBACK && ACCEPT",
+  "spiritual_epistemic_boundary": {
+    "experience_report_may_be_meaningful": true,
+    "afterlife_communication_empirically_established_by_report_alone": false,
+    "required_distinctions": [
+      "subjective_experience",
+      "personal_interpretation",
+      "cultural_or_religious_interpretation",
+      "testable_empirical_claim"
+    ]
+  },
+  "languages": [
+    "de",
+    "en",
+    "fr",
+    "es",
+    "pt",
+    "it",
+    "ru",
+    "zh-Hans",
+    "ar",
+    "hi",
+    "ja"
+  ]
+}
