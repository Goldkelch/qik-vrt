diff --git a/docs/publications/2026-09-23-nash-kognition/machine/article.pl b/docs/publications/2026-09-23-nash-kognition/machine/article.pl
new file mode 100644
index 0000000000000000000000000000000000000000..bba75ae50e63bf809368453604dadd1c27ece1d6
--- /dev/null
+++ b/docs/publications/2026-09-23-nash-kognition/machine/article.pl
@@ -0,0 +1,28 @@
+% qikvrt_nash_cognition_article_v1
+author('Ingolf Lohmann').
+publication_id(qikvrt_nash_cognition_local_stability_v1).
+canonical_language(de).
+date_published('2026-09-23').
+
+not_implies(local_stability, global_correctness).
+not_equals(local_effect_ack_done, universal_effect_ack_done).
+not_equals(unchanged, done).
+not_equals(experience, interpretation).
+not_equals(interpretation, empirically_confirmed_external_effect).
+
+deadlock_or_equilibrium_diagnosis :-
+    stable,
+    work_remaining,
+    \+ progress_edge.
+
+search_for_missing_transition :-
+    deadlock_or_equilibrium_diagnosis.
+
+preserve_evidence_classes :-
+    experience,
+    unresolved_interpretation.
+
+nash_relation(structural_analogy).
+deadlock_is_nash_equilibrium(false).
+
+runtime_order([compile,bind,resolve,execute,test,observe,readback,accept,effect_ack_done]).
diff --git a/docs/publications/2026-09-23-nash-kognition/machine/article.temdd b/docs/publications/2026-09-23-nash-kognition/machine/article.temdd
new file mode 100644
index 0000000000000000000000000000000000000000..361fcae5f5c1befc4c0b6d46bf40fd8329aac40b
--- /dev/null
+++ b/docs/publications/2026-09-23-nash-kognition/machine/article.temdd
@@ -0,0 +1,28 @@
+TEMDD ARTICLE qikvrt-nash-cognition-local-stability-v1
+AUTHOR "Ingolf Lohmann"
+DATE 2026-09-23
+CANONICAL_LANGUAGE de
+
+ASSERT LOCAL_STABILITY != GLOBAL_CORRECTNESS
+ASSERT LOCAL_EFFECT_ACK_DONE != UNIVERSAL_EFFECT_ACK_DONE
+ASSERT UNCHANGED != DONE
+ASSERT EXPERIENCE != INTERPRETATION
+ASSERT INTERPRETATION != EMPIRICALLY_CONFIRMED_EXTERNAL_EFFECT
+
+RULE DEADLOCK_OR_EQUILIBRIUM_DIAGNOSIS
+  WHEN STABLE == TRUE
+   AND WORK_REMAINING == TRUE
+   AND PROGRESS_EDGE == FALSE
+  THEN SEARCH_FOR_MISSING_TRANSITION
+
+RULE EPISTEMIC_DISCIPLINE
+  WHEN EXPERIENCE == PRESENT
+   AND INTERPRETATION == UNRESOLVED
+  THEN KEEP_EVIDENCE_CLASSES_SEPARATE
+
+BOUNDARY NASH_RELATION = STRUCTURAL_ANALOGY_ONLY
+BOUNDARY DEADLOCK_IS_NASH_EQUILIBRIUM = FALSE
+BOUNDARY AFTERLIFE_REPORT_PROVES_EXTERNAL_EFFECT = FALSE
+
+CHAIN COMPILE -> BIND -> RESOLVE -> EXECUTE -> TEST -> OBSERVE -> READBACK -> ACCEPT -> EFFECT_ACK_DONE
+DONE IFF COMPILE AND BIND AND RESOLVE AND EXECUTE AND TEST AND OBSERVE AND READBACK AND ACCEPT
