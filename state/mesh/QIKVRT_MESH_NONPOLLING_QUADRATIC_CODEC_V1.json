{
  "schema": "qikvrt_mesh_nonpolling_quadratic_codec_v1",
  "status": "SPECIFIED_AND_TESTED_REFERENCE",
  "operation_model": "EVENT_DRIVEN_NO_PERIODIC_POLLING",
  "event_sources": ["push", "pull_request", "workflow_run", "workflow_dispatch", "repository_dispatch"],
  "forbidden_sources": ["schedule", "cron", "blind_retry"],
  "quadratic_scaling": {
    "node_count_symbol": "N",
    "lane_count": "N*N",
    "frame_bits": "N*N*WORD_BITS",
    "finite_generic_required": true
  },
  "serial_transport_accounting": {
    "physical_edge_model": "ONE_SERIAL_READY_VALID_BIT_EDGE",
    "payload_handshakes_per_complete_frame": "N*N*WORD_BITS",
    "ideal_no_stall_raw_frame_rate_at_clock_hz": "CLOCK_HZ/(N*N*WORD_BITS)",
    "excluded_from_raw_frame_rate": ["frame_launch", "backpressure", "hashing", "receipt_construction", "ledger_persistence", "deduplication", "fanout", "network_transport"],
    "prohibited_inference": "RAW_FRAME_RATE_IS_NOT_RECEIPT_RATE_OR_COGNITIVE_WORKLOAD_THROUGHPUT"
  },
  "canonical_mapping": {
    "lane_index": "row*N+column",
    "wire_bit_index": "lane_index*WORD_BITS+bit",
    "wire_order": "row_major_lane_order_then_least_significant_bit_first",
    "round_trip": "deserialize(serialize(lanes))=lanes"
  },
  "framing_integrity": {
    "wire_layout_lsb_first": ["SYNC_8", "SESSION_32", "SEQUENCE_16", "PAYLOAD_N*N*WORD_BITS", "CRC16_CCITT_16"],
    "wire_handshakes_per_complete_frame": "N*N*WORD_BITS+72",
    "receiver_release_rule": "ONLY_BINARY_EXACT_SYNC_EXPECTED_SESSION_EXPECTED_SEQUENCE_AND_RECOMPUTED_TAG_MATCH_RELEASE_PAYLOAD",
    "incomplete_or_short_frame": "CONTINUE",
    "sync_mismatch": "HOLD",
    "session_mismatch": "HOLD",
    "session_context_stability": "REQUIRED_ACROSS_ONE_RECEIVED_FRAME",
    "cross_reset_replay_separation": "FRESH_SESSION_I_REQUIRED",
    "sequence_mismatch": "HOLD",
    "sequence_counter_wrap": "DISABLED_FRESH_SESSION_REKEY_REQUIRED",
    "digest_mismatch": "HOLD",
    "insertion_or_reorder_detected": "HOLD_FOR_MODELED_MISMATCHING_FRAME",
    "received_payload_on_failure": "RETAIN_LAST_VERIFIED_PAYLOAD",
    "automatic_resynchronization_after_failure": false,
    "digest_algorithm": "CRC-16/CCITT_ERROR_DETECTION_TAG",
    "fault_handling_claim_scope": "DETERMINISTIC_FOR_EXACT_RECEIVED_FRAMES_AND_MODELED_MISMATCH_CASES_ONLY",
    "crc_collision_or_unmodeled_channel_fault_nonacceptance_proven": false,
    "cryptographic_authenticity_claim": false,
