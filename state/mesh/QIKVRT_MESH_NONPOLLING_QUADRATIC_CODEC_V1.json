    "physical_fault_detection_claim": false,
    "vhdl_testbench_source": "hardware/vhdl/qikvrt_mesh_quadratic_codec_tb.vhd"
  },
  "deterministic_admission": {
    "decision_order": ["FRAME_INCOMPLETE_TO_CONTINUE", "AMBIGUITY_PRESENT_TO_HOLD", "CANONICAL_MATCH_TO_ACCEPT", "OTHER_COMPLETE_INPUT_TO_BLOCK"],
    "uncertainty_representation": "EXPLICIT_INPUT_AND_VISIBLE_HOLD_OR_BLOCK_STATE",
    "forbidden_mechanisms": ["sampling", "random_choice", "implicit_ambiguity_resolution"],
    "std_logic_interface_rule": {
      "accept_only_when": ["FRAME_COMPLETE_EXACT_1", "AMBIGUITY_PRESENT_EXACT_0", "CANONICAL_EQUAL_EXACT_1"],
