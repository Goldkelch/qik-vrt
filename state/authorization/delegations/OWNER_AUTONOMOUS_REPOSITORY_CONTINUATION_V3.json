{
  "schema": "qikvrt_owner_autonomous_repository_continuation_v3",
  "delegation_id": "OWNER-AUTONOMOUS-REPOSITORY-CONTINUATION-V3",
  "owner": {
    "name": "Ingolf Lohmann",
    "type": "NATURAL_PERSON",
    "role": "PRODUCT_OWNER"
  },
  "effective_at": "2026-08-17T12:00:00+02:00",
  "extends_active_controller_delegation": "OWNER-AUTONOMOUS-REPOSITORY-CONTINUATION-V2",
  "source_instruction": "With the repository-native bounded mechanisms in place, the repository shall autonomously perform all uniquely determined repository-internal implementations, tests, verifications, materializations, reviewable successor generation and repository-defined Product-Owner dispositions without requiring repeated Product-Owner interaction. Separately exact-authorized GitHub administration effects may be executed by the bounded admin-effect executor. Human identity-dependent review, empirical observation and separately consequential external effects remain evidence-bound boundaries and may not be fabricated.",
  "authorization_scope": {
    "state": "ACTIVE",
    "repository_internal_continuation": true,
    "continuous_scheduled_observation": true,
    "event_driven_observation": true,
    "deterministic_self_healing": true,
    "bounded_implementation": true,
    "bounded_test_execution": true,
    "bounded_verification": true,
    "repository_native_integrity_materialization": true,
    "reviewable_successor_creation": true,
    "expected_head_bound_promotion": true,
    "product_owner_disposition_projection": true,
    "exact_authorized_github_admin_effect_execution": true,
    "semantic_fingerprint_noop_required": true
  },
  "allowed_without_reinteraction": [
    "read_only_repository_and_public_evidence_observation",
    "ai_runtime_bootloader_execution",
    "deterministic_source_repairs_within_an_exactly_evidenced_work_unit",
    "repository_native_integrity_regeneration",
    "bounded_test_and_gate_execution",
    "semantic_fingerprint_bound_branch_creation",
    "draft_pull_request_creation_for_allowlisted_repository_internal_repairs",
    "trusted_tree_identical_carrier_creation_after_repository_native_materialization_when_required_by_the_existing_trust_contract",
    "expected_head_bound_promotion_when_all_declared_conditions_hold",
    "closing_fully_superseded_execution_only_recovery_or_verification_pull_requests_without_merge",
    "append_only_receipt_status_and_work_unit_projection_creation",
    "history_preserving_authority_or_mirror_port_creation",
    "persisting_evidence_bound_product_owner_dispositions_already_determined_by_this_delegation",
    "issue_lifecycle_triage_execution_clarification_and_evidence_bound_closure",
    "execution_of_a_separately_exact_authorized_github_administration_request_via_the_bounded_admin_effect_executor",
    "post_effect_live_reobservation_and_verified_receipt_materialization"
  ],
  "mandatory_preconditions": [
    "the operation is the smallest uniquely determined continuation of an evidenced blocker or declared work unit",
    "all source and target refs are reobserved immediately before mutation",
    "the operation is reversible append_only or isolated on a review branch unless an exact admin effect request explicitly authorizes the bounded setting mutation",
    "the operation cannot weaken evidence rights security scientific effect or claim boundaries",
    "no source mutation occurs when the semantic fingerprint is unchanged",
    "all applicable exact_head gates remain mandatory",
    "every generated candidate preserves history and remains reviewable before promotion",
    "a promotion is bound to the exact current base head tree diff and terminal applicable gate evidence",
    "a github administration effect is allowed only when an exact repository request binds repository resource identity expected_before desired_after authorization_id and force_false",
    "an administration effect uses compare_and_swap live_get bounded_patch full_put live_get_verified_receipt semantics",
    "a materialized github_actions_bot head may be normalized only by a tree_identical history_preserving trusted carrier under the existing carrier contract",
    "single_writer_or_lease_capacity_is_available",
    "human identity dependent evidence is never synthesized"
  ],
  "automatic_stop_conditions": [
    "no_uniquely_determined_next_action",
    "competing_writer_or_lease_conflict",
    "nonterminal_applicable_gate",
    "exact_base_head_tree_or_scope_drift",
    "missing_required_credential_or_principal_permission",
    "required_independent_code_owner_or_other_human_identity_dependent_review_missing",
    "required_physical_measurement_or_independent_empirical_replication_missing",
    "external_effect_without_separate_exact_authorization",
    "repository_contract_requires_product_owner_choice_between_multiple_non_equivalent_options"
  ],
  "not_authorized": [
    "fabricating_or_impersonating_a_human_code_owner_review",
    "treating_a_bot_review_as_an_independent_human_review",
    "fabricating_measurements_independent_replication_scientific_consensus_credentials_or_external_receipts",
    "force_push_or_history_rewrite",
    "unconditional_automatic_merge_or_unbound_promotion",
    "unbound_branch_protection_or_ruleset_change",
    "github_release_or_tag_creation_without_separate_exact_authorization",
    "deployment_to_an_external_runtime_without_separate_exact_authorization",
    "zenodo_or_ietf_mutation_without_separate_exact_authorization",
    "financial_legal_medical_physical_or_actuator_effects_without_separate_exact_authorization",
    "claiming_repository_wide_PASS_FINAL_PASS_EFFECT_ACK_DONE_synchronization_symmetric_canonicality_independent_empirical_confirmation_or_scientific_consensus_without_corresponding_evidence"
  ],
  "admin_effect_policy": {
    "executor": "tools/qikvrt_github_admin_effect_executor.py",
    "workflow": ".github/workflows/qikvrt_github_admin_effect_executor.yml",
    "request_directory": "state/admin_effects/requests",
    "authorization_requirement": "SEPARATE_EXACT_REQUEST_AUTHORIZATION",
    "unbound_admin_write": false,
    "force": false,
    "post_effect_live_verification_required": true
  },
  "promotion_policy": {
    "unconditional_automatic_merge": "FORBIDDEN",
    "expected_head_bound_promotion": "ALLOWED_ONLY_IF",
    "conditions": [
      "CURRENT_BASE_REOBSERVED",
      "HEAD_UNCHANGED",
      "DIFF_ALLOWLISTED",
      "NO_EXTERNAL_EFFECT",
      "ALL_APPLICABLE_GATES_TERMINAL_GREEN",
      "NO_COMPETING_WRITER"
    ],
    "requires_existing_repository_bound_promotion_contract": true,
    "standing_delegation": true,
    "general_auto_merge_authorization": false,
    "additional_review_evidence_requirement": "ALL_REPOSITORY_REQUIRED_REVIEW_EVIDENCE_PRESENT"
  },
  "human_interaction_policy": {
    "default": "DO_NOT_REASK_PRODUCT_OWNER_FOR_ALREADY_DELEGATED_DETERMINISTIC_CONTINUATION",
    "ask_only_when": [
      "a_required_non_delegable_human_identity_action_is_missing",
      "multiple_non_equivalent_safe_actions_remain_and_repository_policy_does_not_choose_one",
      "a_new_external_effect_requires_separate_exact_authorization"
    ]
  },
  "revocation": {
    "revocable": true,
    "method": "append a later owner decision naming this delegation_id and setting state to REVOKED"
  },
  "completion_claims": {
    "PASS": false,
    "FINAL_PASS": false,
    "EFFECT_ACK_DONE": false,
    "FULL_SYNC": false,
    "SYMMETRIC_CANONICALITY": false,
    "INDEPENDENT_EMPIRICAL_CONFIRMATION": false,
    "SCIENTIFIC_CONSENSUS": false
  }
}
