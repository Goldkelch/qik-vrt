{
  "schema": "qikvrt_effect_ack_http_terminal_v2",
  "version": "2.0",
  "status": "PRODUCT_OWNER_AUTHORIZED_CANDIDATE",
  "authority_repository": "Goldkelch/qik-vrt",
  "base_commit": "836a068d42b30f4df496caf4d712dbe8da45c043",
  "supersedes": "policy/QIKVRT_EFFECT_ACK_HTTP_TERMINAL_V1.json",
  "core_specification": "external/ietf/draft-lohmann-qikvrt-effect-ack-03.xml",
  "http_extension_specification": "external/ietf/draft-lohmann-qikvrt-effect-ack-http-00.xml",
  "invariants": {
    "causality_is_not_sequence": true,
    "message_order_is_not_causal_authorization": true,
    "wall_clock_order_is_not_causal_authorization": true,
    "http_success_is_not_causal_authorization": true,
    "transport_ack_is_not_effect_authorization": true,
    "serialization_is_topological_projection": true,
    "parallel_projection_preserves_causal_edges": true,
    "ordinary_release_only_after_valid_done": true,
    "prepare_never_executes_protected_effect": true,
    "commit_requires_exact_bound_single_use_token": true,
    "post_effect_reobservation_required_when_observable": true,
    "rendering_is_not_authorization": true,
    "imported_proxy_frame_is_display_only": true,
    "imported_proxy_frame_cannot_prepare": true,
    "imported_proxy_frame_cannot_commit": true,
    "audio_capture_requires_explicit_user_gesture": true,
    "video_capture_requires_explicit_user_gesture": true,
    "media_not_transmitted_until_explicit_submit": true,
    "personalization_is_local_by_default": true,
    "proxy_must_preserve_source_and_hash_bindings": true,
    "watchdog_alarm_reinitialized_on_install_startup": true
  },
  "terminal": {
    "mode": "INTERACTIVE_REFLEXIVE_TERMINAL",
    "reference_client": "FIREFOX_WEBEXTENSION_MV3",
    "entrypoint_match": "https://github.com/Goldkelch/qik-vrt/blob/main/AI*",
    "text": true,
    "audio": "EXPLICIT_CAPTURE_AND_SUBMIT",
    "video": "EXPLICIT_PREVIEW_SNAPSHOT_AND_SUBMIT",
    "personalization": ["accent", "font_scale", "density", "panel_position"],
    "counterpart": "QIKVRT_REPOSITORY_BACKEND_ADAPTER",
    "default_external_effect": "NONE"
  },
  "proxy_pattern": {
    "name": "QIKVRT_FIREFOX_TERMINAL_PROXY_V2",
    "purpose": "Render source-bound qikvrt_terminal_frame_v1 observations from repository, backend, agent or other client adapters while keeping all imported frames observation-only and all protected effects on a separate EFFECT_ACK transaction.",
    "input_adapters": ["github_public_read", "http_backend", "local_qikvrt_api_shim", "mcp_agent", "other_client_snapshot", "same_origin_window_frame"],
    "input_message_kind": "QIKVRT_TERMINAL_FRAME",
    "output_schema": "qikvrt_terminal_frame_v1",
    "max_imported_frame_bytes": 262144,
    "may_render_non_done": true,
    "may_release_non_done": false,
    "may_claim_effect_from_http_success_only": false,
    "rendered_frame_can_change_commit_authority": false
  },
  "http": {
    "request_field": "Effect-Ack-Request",
    "response_field": "Effect-Ack",
    "structured_fields_rfc": 9651,
    "structured_type": "Dictionary",
    "link_relation": "effect-ack",
    "html_element": "link",
    "new_html_parser_feature": false,
    "html_discovery_is_advisory": true
  },
  "completion_claims": {"PASS": false, "FINAL_PASS": false, "EFFECT_ACK_DONE": false}
}
