  "canonical_entrypoint": {
    "repository_path": "AI",
    "human_contract": "docs/CANONICAL_ARGUMENTATION_ENTRYPOINT.md",
    "machine_contract": "policy/CANONICAL_ARGUMENTATION_ENTRYPOINT_V1.json",
    "claim_registry": "policy/CANONICAL_ARGUMENTATION_ENTRYPOINT_V1.json#/claims",
    "unregistered_argument_state": "BLOCKED_UNTIL_REGISTERED_CLASSIFIED_AND_BOUND",
    "validator_command": "python3 -B tools/qikvrt_canonical_argumentation_entrypoint.py check",
    "mandatory_before_new_argument": true,
    "rule": "Every new repository-level argument, review conclusion, publication claim, system-test conclusion, or causal explanation MUST begin from this contract and carry its own claim class, scope, source/evidence bindings, guarded inferences, and current-state binding where dynamic state is asserted."
  },
  "authority_snapshot": {
    "repository": "Goldkelch/qik-vrt",
    "ref": "refs/heads/main",
    "commit": "4ea0491a5484075215f17dbcd157a2a5f18ef633",
    "tree": "2f3a9ba1bbc645037a937614700e606ac99ebe58",
    "role": "SOURCE_SNAPSHOT_FOR_THE_BOUND_ARTIFACTS_LISTED_HERE",
    "current_state_rule": "This snapshot identifies the cited source bytes. It is historical source evidence after a ref/head/tree drift and must never be used as a current-state or successor-gate receipt."
  },
  "epistemic_projection": {
    "reuse_source": {
      "path": "tools/qikvrt_round_trip_zenodo_bundle_freeze.py",
      "function": "verify_claim_matrix",
      "rule": "The six existing publication classes and their required status/wording pairs are reused verbatim; this contract creates no competing claim taxonomy."
    },
    "classes": [
      {
        "classification": "FORMAL_PROVED",
        "status": "PROVED",
        "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
        "minimum_binding": ["proof_refs", "pinned_source_bytes", "toolchain", "kernel_or_axiom_receipt"]
      },
      {
        "classification": "EMPIRICALLY_EVIDENCED",
        "status": "EVIDENCED",
        "publication_wording": "EMPIRICALLY_SUPPORTED",
        "minimum_binding": ["measurement_protocol", "units_or_calibration", "bound_data", "uncertainty", "controls", "claimed_range"]
      },
      {
        "classification": "SOURCE_BOUND",
        "status": "BOUND",
        "publication_wording": "SOURCE_ATTRIBUTED",
        "minimum_binding": ["immutable_locator", "file_or_blob_identity", "sha256_or_equivalent", "scope"]
      },
      {
        "classification": "NORMATIVE",
        "status": "DECLARED",
        "publication_wording": "NORMATIVE_DECLARATION",
        "minimum_binding": ["named_authority", "value_premises", "scope"]
      },
      {
        "classification": "INTERPRETATIVE",
        "status": "DECLARED",
        "publication_wording": "INTERPRETATIVE_DECLARATION",
        "minimum_binding": ["premises", "alternative_readings", "scope"]
      },
      {
        "classification": "OPEN",
        "status": "OPEN",
        "publication_wording": "EXPLICITLY_OPEN",
        "minimum_binding": ["missing_evidence", "owner", "closure_condition"]
      }
    ],
    "projection_boundary": "Owner assertions, derived summaries, workflow labels, receipts, and citations are inputs to a classified claim. None raises an evidence class by label alone."
  },
  "dynamic_binding_key": [
    "repository",
    "ref_or_pull_request",
    "base",
    "head",
    "tree",
    "scope_sha256",
    "source_blob_set_sha256",
    "workflow_definition_sha256",
    "workflow_run_id",
    "workflow_job_id",
    "literal_checkout_head",
    "literal_checkout_tree",
    "review_routing_binding"
  ],
  "non_transfer_invariant": {
    "on_any_dynamic_binding_change": {
      "predecessor": "STALE_HISTORICAL_SOURCE_ONLY",
      "successor": "REOBSERVATION_REQUIRED"
    },
    "prohibited_transfers": [
      "predecessor_head_or_tree_receipt_to_successor_head_or_tree",
      "synthetic_merge_checkout_to_literal_head_execution",
      "workflow_transport_or_activity_to_external_effect",
      "transport_ack_to_effect_ack",
      "zenodo_fixity_to_peer_review_consensus_or_measurement_confirmation",
      "formal_model_theorem_to_unbound_empirical_or_physical_conclusion",
      "owner_assertion_to_independent_empirical_confirmation_or_scientific_consensus"
    ],
    "rule": "Historical evidence remains citable as SOURCE_BOUND evidence of its exact artifact, but cannot close a current gate, review, causal claim, publication result, Authority/Mirror state, or effect claim after the binding changes."
  },
  "argument_requirements": {
    "required_fields": [
      "claim_id",
      "classification",
      "status",
      "publication_wording",
      "statement",
      "scope",
      "assumptions",
      "guarded_inferences",
      "proof_refs",
      "evidence_refs",
      "source_refs",
      "argument_kinds",
      "evidence_bindings",
      "binding"
    ],
    "causal_claim": {
      "requires_one_of": ["causal_bridge", "intervention_evidence", "counterfactual_evidence", "equivalent_causal_justification"],
      "forbidden_substitute": "sequence_or_timestamp_alone",
      "failure_code": "CAUSALITY_ONLY_SEQUENCE"
    },
    "reconstruction_claim": {
      "requires": ["complete_manifest", "content_hashes", "explicit_semantic_dependency_order", "conflict_rule"],
      "arrival_order_rule": "Arrival order may differ from semantic order only when the manifest permits deterministic canonical reconstruction; arbitrary arrival order never licenses arbitrary semantic ordering."
    },
    "retrospective_determinism": {
      "requires": ["complete_immutable_provenance", "declared_inverse_or_injectivity_condition"],
      "on_information_loss_or_noninjectivity": "OPEN_OR_AMBIGUOUS"
    },
    "spacetime_or_physical_claim": {
      "requires_for_empirical_class": ["dimension_model", "coordinate_or_unit_mapping", "calibration", "observable_prediction", "measurement_protocol", "uncertainty", "controls_or_replication"],
      "representation_change_rule": "An invertible representation change alone does not establish a new physical effect."
    },
    "claim_kinds": [
      {
        "kind": "CAUSAL_CLAIM",
        "allowed_classifications": ["FORMAL_PROVED", "EMPIRICALLY_EVIDENCED", "SOURCE_BOUND", "OPEN"],
        "evidence_binding": "causal_justification"
      },
      {
        "kind": "RECONSTRUCTION_CLAIM",
        "allowed_classifications": ["FORMAL_PROVED", "EMPIRICALLY_EVIDENCED", "SOURCE_BOUND", "OPEN"],
        "evidence_binding": "reconstruction_requirements"
      },
      {
        "kind": "RETROSPECTIVE_DETERMINISM_CLAIM",
        "allowed_classifications": ["FORMAL_PROVED", "EMPIRICALLY_EVIDENCED", "SOURCE_BOUND", "OPEN"],
        "evidence_binding": "retrospective_determinism_requirements"
      },
      {
        "kind": "OWNER_ASSERTION",
        "allowed_classifications": ["SOURCE_BOUND"],
        "evidence_binding": "owner_attribution"
      },
      {
        "kind": "SPACETIME_DIMENSIONAL_CLAIM",
        "allowed_classifications": ["FORMAL_PROVED", "EMPIRICALLY_EVIDENCED", "SOURCE_BOUND", "OPEN"],
        "evidence_binding": "spacetime_dimensional_requirements"
      },
      {
        "kind": "EMPIRICAL_PHYSICAL_CLAIM",
        "allowed_classifications": ["EMPIRICALLY_EVIDENCED"],
        "evidence_binding": "physical_measurement_evidence",
        "required_measurement_fields": ["dimension_model", "coordinate_or_unit_mapping", "calibration", "observable_prediction", "measurement_protocol", "uncertainty", "controls_or_replication"]
      }
    ]
  },
  "protected_distinctions": [
    "CAUSALITY != SEQUENCE",
    "LATER != BETTER",
    "ACTIVITY != EFFECT",
    "TRANSPORT_ACK != EFFECT_ACK",
    "OWNER_ASSERTED_REALITY_CORRESPONDENCE != INDEPENDENT_EMPIRICAL_CONFIRMATION != SCIENTIFIC_CONSENSUS",
    "FORMAL_PROOF != EMPIRICAL_CONFIRMATION",
    "ZENODO_FIXITY != PEER_REVIEW_OR_EMPIRICAL_CONFIRMATION",
    "RECEIVED != TRUSTED",
    "STORED != EXECUTED",
    "FORWARDED != EFFECT_ACKNOWLEDGED"
  ],
