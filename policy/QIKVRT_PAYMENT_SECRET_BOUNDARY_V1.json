{
  "schema": "qikvrt_payment_secret_boundary_v1",
  "version": "1.0",
  "purpose": "Permit evidence-bound external purchases without persisting payment authentication secrets in repository evidence.",
  "invariant": "EVIDENCE_PERSISTED_AND_SECRETS_PROVIDER_OWNED",
  "secret_classes": [
    "full_payment_card_number",
    "card_security_code_cvv_cvc_cid",
    "payment_account_password",
    "payment_otp_totp",
    "payment_provider_session_secret",
    "bank_authentication_secret"
  ],
  "repository_persistence": {
    "secret_values": "DENY",
    "secret_hashes": "DENY",
    "encrypted_secret_values": "DENY",
    "provider_secret_tokens": "DENY_UNLESS_EXPLICITLY_DOCUMENTED_NON_SECRET_REFERENCE",
    "allowed_non_secret_evidence": [
      "payment_intent_id",
      "provider_name",
      "merchant_name",
      "amount",
      "currency",
      "owner_authorization_reference",
      "provider_payment_method_reference",
      "masked_payment_method",
      "transaction_reference",
      "receipt_reference",
      "effect_timestamp",
      "purchased_resource",
      "authoritative_readback"
    ]
  },
  "execution_contract": [
    "OBSERVE_PURCHASE_REQUIREMENT",
    "BIND_OWNER_AUTHORIZATION",
    "CREATE_OR_REUSE_PROVIDER_OWNED_PAYMENT_METHOD_REFERENCE",
    "PREPARE_EXACT_PURCHASE",
    "COMMIT_PROVIDER_PAYMENT",
    "READBACK_PROVIDER_RECEIPT",
    "READBACK_PURCHASED_RESOURCE",
    "PERSIST_NON_SECRET_EFFECT_EVIDENCE",
    "REVALIDATE_EXACT_EFFECT"
  ],
  "fail_closed": {
    "missing_provider_payment_method": "REQUEST_SECURE_PROVIDER_INPUT",
    "secret_requested_for_repository": "REJECT_SECRET_PERSISTENCE",
    "missing_receipt": "HOLD_UNVERIFIED",
    "resource_not_observed": "HOLD_UNVERIFIED",
    "transport_ack_without_effect_readback": "HOLD_UNVERIFIED"
  },
  "effect_ack": {
    "required": true,
    "transport_ack_is_effect_ack": false,
    "done_requires": [
      "provider_receipt_observed",
      "purchased_resource_observed",
      "non_secret_receipt_persisted",
      "fresh_effect_revalidation"
    ]
  }
}
