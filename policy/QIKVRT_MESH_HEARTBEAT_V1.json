    "implemented": true,
    "eligible_source_event": "SUCCESSFUL_PUSH_RUN_ON_MAIN_ONLY",
    "productive_writer_serialized": true,
    "cancel_in_progress": false,
    "source_cas_before_write": true,
    "source_cas_before_push": true,
    "repository_enforced_ref_protection_required": true,
