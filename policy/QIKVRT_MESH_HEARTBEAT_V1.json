{
  "schema": "QIKVRT_MESH_HEARTBEAT_V1",
  "heartbeat_hz": 1,
  "heartbeat_interval_ns": 1000000000,
  "heartbeat_role": "LIVENESS_AND_LEASE_FRESHNESS_ONLY",
  "heartbeat_may_trigger_semantic_work": false,
  "domain_polling_allowed": false,
  "blind_retry_allowed": false,
  "semantic_work_trigger": "LOCALLY_CONSTRUCTED_CONTENT_BOUND_EVENT_ONLY",
  "external_ingress_authentication_observed": false,
  "work_units_per_event_limit": 1,
