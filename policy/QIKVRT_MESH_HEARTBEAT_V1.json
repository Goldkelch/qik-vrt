    "0",
    "1",
    "ARBEIT",
    "ERGEBNIS",
    "REOBSERVATION",
    "AUTHORITY_EFFEKT",
    "0"
  ],
  "system_test": {
    "network_scope": "LOOPBACK_TCP_ONLY",
    "node_process_count": 4,
    "pair_count": 2,
    "heartbeat_count_per_node": 4,
    "hash_linked_heartbeat_chain_required": true,
    "exact_one_hertz_schedule_required": true,
    "work_event_construction_scope": "LOCAL_SYSTEM_TEST",
    "audit_artifact_required": true
