{
  "schema": "qikvrt_mesh_self_explanation_v1",
  "version": "1.1.0",
  "status": "NORMATIVE_CANDIDATE",
  "owner": "Ingolf Lohmann",
  "purpose": "Make every QIK-VRT Mesh repository rapidly understandable, safely continuable and interoperable for both human cognition and artificial cognition from ordinary entrypoints without collapsing evidence classes.",
  "entrypoint_contract": {
    "human_entrypoint": "/README.md",
    "artificial_cognition_entrypoint": "/AI",
    "machine_discovery_entrypoint": "/.well-known/qik-vrt-self-disclosure.json",
    "canonical_context": "/AI_CONTEXT.json",
    "human_contract": "/docs/MESH_SELF_EXPLANATION_AND_DELIVERY.md",
    "required_progression": [
      "IDENTIFY_SUBJECT_AND_SCOPE",
      "IDENTIFY_CURRENT_EXACT_BINDING",
      "CLASSIFY_CLAIMS",
      "SHOW_SUPPORTING_EVIDENCE",
      "SHOW_NON_EQUIVALENCES",
      "SHOW_OPEN_UNCERTAINTY",
      "SELECT_SMALLEST_SAFE_NEXT_ACTION",
      "EXECUTE_ONLY_IF_AUTHORIZED",
      "READ_BACK_EFFECT",
      "RECLASSIFY_REMAINING_UNCERTAINTY"
    ]
  },
  "dual_cognition_contract": {
    "same_semantics_required": true,
    "single_canonical_truth_model": true,
    "human_surface_must_be_plain_language_first": true,
    "artificial_surface_must_be_deterministic_and_machine_navigable": true,
    "machine_surface_must_be_structured_data": true,
    "one_surface_may_not_silently_override_another": true,
    "semantic_conflict_state": "BLOCK",
    "semantic_drift_state": "BLOCK",
    "minimum_fast_path": {
      "human": [
        "WHAT_IS_THIS",
        "WHAT_CAN_I_TRUST",
        "WHAT_IS_OPEN_OR_BOUNDED",
        "WHERE_DO_I_CONTINUE"
      ],
      "artificial_cognition": [
        "BOOT_CONTRACT",
        "CURRENT_EXACT_BINDING",
        "CAPABILITIES_AND_BOUNDARIES",
        "SMALLEST_SAFE_NEXT_ACTION"
      ]
    }
  },
  "optimization_contract": {
    "continuous": true,
    "fastest_verified_path": true,
    "reuse_before_create": true,
    "minimize_cognitive_hops": true,
    "minimize_redundancy": true,
    "prefer_progressive_disclosure": true,
    "objective_order": [
      "CORRECTNESS",
      "EVIDENCE_AND_AUTHORITY_BOUNDARY_PRESERVATION",
      "TIME_TO_ORIENTATION",
      "COGNITIVE_LOAD",
      "ACCESSIBILITY",
      "INTEROPERABILITY",
      "EXTENSIBILITY",
      "FAULT_TOLERANCE"
    ],
    "optimization_may_weaken_gates": false,
    "optimization_may_invent_evidence": false,
    "optimization_may_self_grant_authority": false,
    "optimization_may_hide_uncertainty": false,
    "perfection_is_a_direction_not_an_unbounded_completion_claim": true
  },
  "maintenance_contract": {
    "normative_policy": "policy/MESH_SELF_EXPLANATION_V1.json",
    "truth_surfaces": [
      "README.md",
      "AI",
      ".well-known/qik-vrt-self-disclosure.json",
      "docs/MESH_SELF_EXPLANATION_AND_DELIVERY.md"
    ],
    "semantic_change_requires_all": [
      "UPDATE_NORMATIVE_POLICY",
      "UPDATE_AFFECTED_HUMAN_SURFACE",
      "UPDATE_AFFECTED_ARTIFICIAL_SURFACE",
      "UPDATE_AFFECTED_MACHINE_DISCOVERY",
      "RUN_SELF_EXPLANATION_REGRESSION",
      "REOBSERVE_EXACT_SUCCESSOR"
    ],
    "partial_update_state": "BLOCK",
    "stale_binding_state": "REOBSERVE",
    "unknown_required_field_state": "HOLD"
  },
  "fault_tolerance": {
    "independent_discovery_surfaces": [
      "README.md",
      "AI",
      ".well-known/qik-vrt-self-disclosure.json"
    ],
    "normative_fallback": "policy/MESH_SELF_EXPLANATION_V1.json",
    "human_fallback": "docs/MESH_SELF_EXPLANATION_AND_DELIVERY.md",
    "machine_fallback": "AI_CONTEXT.json",
    "missing_optional_surface": "DEGRADED_REPAIR_REQUIRED",
    "missing_normative_surface": "BLOCK",
    "unparseable_machine_surface": "BLOCK",
    "broken_reference": "BLOCK"
  },
  "uncertainty_rule": {
    "hidden_ambiguity_forbidden": true,
    "plausibility_is_not_resolution": true,
    "every_material_question_must_end_as": [
      "RESOLVED_BY_EVIDENCE",
      "OPEN",
      "HOLD",
      "REOBSERVE",
      "REQUEST_AUTHORITY"
    ],
    "no_false_certainty": true
  },
  "mesh_interoperability": {
    "all_mesh_components_must_preserve_this_contract": true,
    "must_preserve": [
      "provenance",
      "claim_class",
      "uncertainty",
      "exact_subject_binding",
      "authorization_boundary",
      "effect_readback",
      "human_machine_semantic_parity"
    ],
    "adapters_may_extend": true,
    "adapters_may_weaken_core_semantics": false,
    "unknown_required_field": "HOLD"
  },
  "mandatory_non_equivalences": [
    "BYTES != MEANING",
    "SEQUENCE != CAUSALITY",
    "TRANSPORT_ACK != EFFECT_ACK",
    "OBSERVATION != TRUTH",
    "MODEL != REALITY",
    "FORMAL_VERIFIED != PHYSICAL_CORRESPONDENCE",
    "REPOSITORY_EVIDENCE != ZENODO_PUBLICATION",
    "ZENODO_PUBLICATION != EMPIRICAL_CONFIRMATION",
    "DELIVERY_PREPARATION != DELIVERY_ACCEPTED"
  ]
}
