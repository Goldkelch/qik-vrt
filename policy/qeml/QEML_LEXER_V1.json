{
  "schema": "QEML_LEXER_SPEC_V1",
  "language": "QEML-1",
  "tokens": [
    {
      "name": "COMMENT",
      "pattern": "#[^\\n]*"
    },
    {
      "name": "WHITESPACE",
      "pattern": "[ \\t\\r\\n]+"
    },
    {
      "name": "ARROW",
      "pattern": "->"
    },
    {
      "name": "OP",
      "pattern": "==|!=|<=|>=|<|>"
    },
    {
      "name": "STRING",
      "pattern": "\\\"(?:[^\\\"\\\\]|\\\\.)*\\\""
    },
    {
      "name": "NUMBER",
      "pattern": "[0-9]+"
    },
    {
      "name": "IDENT",
      "pattern": "[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "PUNCT",
      "pattern": "[()=:,|.\\-]"
    }
  ],
  "boundary": {
    "regex_is_lexical_only": true,
    "regex_is_language_semantics": false
  }
}
