    },
    "mirror": {
      "repository": "ingolf-lohmann/qik-vrt",
      "role": "ROLE_LOCAL_MIRROR_ADOPTION"
    },
    "other_nodes": {
      "role": "ROLE_LOCAL_MESH_NODE"
    },
    "authority_mirror_and_node_roles_are_interchangeable": false,
    "role_identity_must_not_collapse": true,
    "whole_tree_copy_transfers_canonical_authority": false,
    "access_and_provenance_requirements_apply_to_every_role": true
