      "CONTRACT_AND_LICENSE",
      "ACCESS_EXPORT_AND_RECONSTRUCTION"
    ],
    "german_basic_law": "OWNER_DECLARED_NORMATIVE_ORIENTATION_NOT_UNIVERSAL_JURISDICTION",
