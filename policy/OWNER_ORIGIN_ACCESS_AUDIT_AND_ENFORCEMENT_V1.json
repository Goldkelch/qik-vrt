  "owner_access_invariant": {
    "created_by_or_for_origin_principal_must_remain": [
      "FINDABLE",
      "OPENABLE",
      "EXPORTABLE",
      "INTEGRITY_VERIFIABLE",
      "PROVENANCE_BOUND",
      "RECONSTRUCTABLE_FROM_OPEN_OR_DOCUMENTED_REPRESENTATION"
    ],
    "required_artifact_fields": [
      "artifact_id",
      "work_unit_id",
      "origin_principal",
      "authority_repository",
      "repository_role",
      "source_sha256",
      "output_sha256",
      "open_representation",
      "access_paths",
      "provenance",
      "license"
    ],
    "single_ephemeral_ui_only": false,
    "single_expiring_actions_artifact_only": false,
    "undocumented_proprietary_format_only": false,
    "closed_pull_request_as_only_locator": false,
    "bot_commit_may_erase_origin_principal": false,
    "third_party_platform_perpetual_availability_guaranteed": false,
    "access_failure_class": "TECHNICAL_ACCESS_DEFECT_TO_REPAIR",
    "access_failure_transfers_rights": false,
    "access_failure_erases_provenance": false,
    "access_failure_requires_content_recreation": false
  },
  "provenance_envelope": {
    "required_fields": [
      "artifact_id",
      "work_unit_id",
      "source_repository",
      "source_ref",
      "source_commit",
      "source_sha256",
      "output_sha256",
      "human_origin_principal",
      "tool_contributions",
      "materialization_path",
      "license_id",
      "created_at"
    ],
    "human_and_tool_contributions_must_remain_separable": true,
    "hash_binding_required": true,
    "silent_origin_reclassification": "FORBIDDEN",
    "correction_method": "NEW_HISTORY_PRESERVING_PROVENANCE_BOUND_COMMIT"
  },
  "independent_audit": {
    "read_only_verification_supported": true,
    "auditor_must_not_need_owner_credentials": true,
    "audit_may_verify": [
      "BYTE_IDENTITY",
      "PROVENANCE_CHAIN",
      "ROLE_LOCAL_IDENTITY",
      "DECLARED_LICENSE",
      "ACCESS_CONTRACT"
    ],
    "audit_proves_unauthorized_use_without_evidence": false,
    "audit_proves_damages_without_causal_and_financial_evidence": false
  },
  "license_evidence_classifier": {
    "states": [
      "NO_BYTE_IDENTITY",
      "PROVENANCE_UNVERIFIED",
      "LICENSE_SCOPE_UNBOUND",
      "LICENSE_COMPATIBLE",
      "POTENTIAL_VIOLATION_UNVERIFIED",
      "EVIDENCED_BREACH_CANDIDATE_INTERNAL_ONLY"
    ],
    "unknown_is_violation": false,
    "absence_of_authorization_record_is_proof_of_violation": false,
    "evidenced_candidate_is_legal_judgment": false
  },
  "automated_actions": {
    "allowed": [
      "OBSERVE_PUBLIC_OR_AUTHORIZED_EVIDENCE",
      "VERIFY_BYTES",
      "VERIFY_PROVENANCE",
      "CLASSIFY_FAIL_CLOSED",
      "PRESERVE_INTERNAL_EVIDENCE_PACKAGE",
      "PREPARE_UNSENT_OWNER_OR_COUNSEL_BRIEF"
    ],
    "forbidden_without_separate_exact_authority": [
      "PUBLIC_ACCUSATION",
      "CEASE_AND_DESIST_NOTICE",
      "PAYMENT_DEMAND",
      "INVOICE",
      "DAMAGES_CALCULATION_AS_FACT",
      "REGULATORY_COMPLAINT",
      "COURT_FILING",
      "RIGHTS_TRANSFER",
      "LICENSE_CHANGE",
      "DISCLOSURE_OF_CREDENTIALS_OR_PRIVATE_DATA"
    ]
  },
  "legal_action_gate": {
    "required_before_external_legal_action": [
      "EXACT_ARTIFACT_BYTE_IDENTITY",
      "EXACT_PROVENANCE_CHAIN",
      "EXACT_LICENSE_OR_CONTRACT_VERSION",
      "IDENTIFIED_ACTOR_AND_RELEVANT_CONDUCT",
      "APPLICABLE_JURISDICTION_AND_LAW",
      "EVIDENCE_OF_AUTHORIZATION_STATUS",
      "CAUSAL_DAMAGE_AND_AMOUNT_EVIDENCE_WHEN_CLAIMED",
      "EXACT_OWNER_OR_AUTHORIZED_COUNSEL_DECISION"
    ],
    "repository_tool_may_satisfy_final_legal_judgment": false,
    "external_legal_action_authorized_by_this_policy": false
  },
  "privacy_and_source_retention": {
    "raw_owner_audio_committed": false,
    "verbatim_owner_transcript_required": false,
    "default_source_retention": "HASH_BOUND_METADATA_AND_SEMANTIC_BINDINGS",
    "secrets_or_credentials_allowed": false,
    "unnecessary_personal_data_allowed": false
