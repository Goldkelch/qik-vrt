  "schema": "qikvrt-external-ai-audit-policy/1.0",
  "policy_id": "QIKVRT-EXTERNAL-AI-AUDIT-V1",
  "version": 1,
  "purpose": "Provider-neutral automatic audit of evidence-bound AI/tool execution traces.",
  "required_done_chain": [
    "BIND",
    "RESOLVE",
    "EXECUTE",
    "TEST",
    "OBSERVE",
    "READBACK",
    "ACCEPT",
    "EFFECT_ACK_DONE"
  ],
  "allowed_event_types": [
    "BIND",
    "RESOLVE",
    "EXECUTE",
    "TEST",
    "OBSERVE",
    "READBACK",
    "ACCEPT",
    "TRANSPORT_ACK",
    "EFFECT_ACK_DONE"
  ],
  "invariants": {
    "exact_subject_binding": true,
    "unauthorized_effect_forbidden": true,
    "transport_ack_is_not_effect_ack": true,
    "fresh_readback_required_for_done": true,
    "acceptance_required_for_done": true,
    "open_obligations_forbid_done": true,
    "sequence_numbers_strictly_increase": true,
    "successor_subject_must_be_used_after_mutation": true
  },
  "boundary": {
    "audit_input_must_be_evidence_bound": true,
    "provider_internal_state_not_inferred": true,
    "audit_does_not_create_legal_certification": true,
    "audit_does_not_prove_truth_of_external_evidence": true,
    "automatic_remote_access_not_claimed": true
  }
}
