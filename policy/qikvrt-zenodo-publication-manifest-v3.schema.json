{
  "$id": "https://github.com/Goldkelch/qik-vrt/blob/main/policy/qikvrt-zenodo-publication-manifest-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_license": {"$ref": "#/$defs/artifactLicense"},
    "schema": {"const": "qikvrt_zenodo_publication_manifest_v3"},
    "state": {"const": "validate_only"},
    "confirm": {"const": "NO_REMOTE_EFFECT"},
    "transport": {"const": "NATIVE_RDM_MULTI_RIGHTS_NOT_IMPLEMENTED"},
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "not": {"required": ["license"]},
      "properties": {
        "rights": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "id": {"enum": ["cc-by-nc-nd-4.0", "apache-2.0"]}
                },
                "required": ["id"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "title": {"const": "PolyForm Noncommercial License 1.0.0"},
                  "description": {
                    "const": "Noncommercial software use under PolyForm Noncommercial 1.0.0; commercial use requires a separate written agreement with the rights holder."
                  },
                  "link": {"const": "https://polyformproject.org/licenses/noncommercial/1.0.0/"}
                },
                "required": ["title", "description", "link"],
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["rights"],
      "type": "object"
    },
    "files": {
      "items": {"$ref": "#/$defs/identity"},
      "maxItems": 100,
      "minItems": 2,
      "type": "array"
    },
    "license_notice": {
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {"properties": {"name": {"const": "LICENSE_NOTICE.md"}}}
      ]
    },
    "file_license_map": {
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {"properties": {"name": {"const": "FILE_LICENSE_MAP.json"}}}
      ]
    }
  },
  "required": [
    "_license",
    "schema",
    "state",
    "confirm",
    "transport",
    "repository",
    "publication_id",
    "metadata",
    "files",
    "license_notice",
    "file_license_map"
  ],
  "type": "object",
  "$defs": {
    "artifactLicense": {
      "additionalProperties": false,
      "properties": {
        "classification": {"const": "machine_readable_license_policy"},
        "copyright": {"minLength": 1, "type": "string"},
        "license": {"const": "CC-BY-NC-ND-4.0"},
        "license_text_ref": {"const": "LICENSES/CC-BY-NC-ND-4.0.txt"},
        "rights_holder": {"const": "Ingolf Lohmann"}
      },
      "required": ["classification", "copyright", "license", "license_text_ref", "rights_holder"],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "name": {"minLength": 1, "type": "string"},
        "bytes": {"minimum": 0, "type": "integer"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "git_blob_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
      },
      "required": ["path", "name", "bytes", "sha256", "git_blob_sha"],
      "type": "object"
    }
  }
}
