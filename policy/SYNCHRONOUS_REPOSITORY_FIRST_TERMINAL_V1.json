    "synchronous": true,
    "repository_first": true,
    "terminal_is_independent_semantic_authority": false,
    "terminal_may_substitute_independent_interpretation": false,
    "terminal_may_substitute_independent_plan": false,
    "terminal_may_substitute_independent_prediction": false,
    "terminal_may_delay_delivery_via_scheduler": false,
    "terminal_may_create_background_watch_without_explicit_request": false,
    "repository_output_required_before_terminal_reflection": true
  },
  "immutability": {
    "in_place_semantic_weakening_forbidden": true,
    "silent_override_forbidden": true,
    "successor_required_for_semantic_change": true,
    "successor_requires_explicit_product_owner_authorization": true,
    "successor_must_preserve_or_strengthen_fail_closed_boundaries": true,
    "history_rewrite_forbidden": true,
    "force_push_forbidden": true
  },
  "fail_closed": {
