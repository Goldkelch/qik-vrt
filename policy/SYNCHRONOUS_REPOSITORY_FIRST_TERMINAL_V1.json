    "mirror_repository": "ingolf-lohmann/qik-vrt",
    "mirror_preserves_role_local_identity": true,
    "whole_tree_convergence_required": false
  },
  "canonical_statement": "INPUT -> QIK-VRT MESH REPOSITORY -> REPOSITORY OUTPUT / EVIDENCE -> OUTPUT"
}
