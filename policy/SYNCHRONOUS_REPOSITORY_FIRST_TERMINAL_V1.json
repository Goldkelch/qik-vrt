    "stale_evidence": "REOBSERVE",
    "invented_pass_forbidden": true,
    "invented_final_pass_forbidden": true,
    "invented_effect_ack_done_forbidden": true,
    "invented_external_effect_forbidden": true,
    "invented_review_authority_forbidden": true
  },
  "role_separation": {
