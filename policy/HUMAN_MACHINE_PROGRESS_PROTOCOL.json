{
  "schema": "qikvrt-human-machine-progress-protocol/1.3",
  "policy_version": "1.4",
  "authority": "docs/HUMAN_MACHINE_PROGRESS_PROTOCOL.md",
  "required_files": {
    "machine_state": "AI_PROGRESS.json",
    "human_projection": "AI_STATUS.md"
  },
  "states": ["IDLE", "RUNNING", "WAITING", "PASS", "BLOCK", "FAIL", "TIMEOUT", "CANCELLED"],
  "step_states": {
    "completed": "✓",
    "running": "⟳",
    "pending": "□",
    "failed": "✗",
    "blocked": "!"
  },
  "mandatory_fields": ["schema", "operation_id", "repository", "ref_name", "source_sha", "state", "percent", "current_action", "completed_steps", "pending_steps", "blockers", "next_action", "updated_at"],
  "communication_rules": {
    "work_before_explanation": true,
    "compact_updates": true,
    "progress_frame_before_every_github_action": true,
    "progress_frame_after_every_github_action": true,
    "progress_frame_on_every_workflow_transition": true,
    "progress_frame_on_every_job_transition": true,
    "progress_frame_on_every_step_transition": true,
    "allow_batched_github_actions_without_intermediate_frame": false,
    "later_summary_compensates_for_missing_frame": false,
    "repeat_unchanged_state": false,
    "claim_pass_without_evidence": false,
    "include_repository_ref_sha": true,
    "include_progress_bar": true,
    "include_concrete_blocker": true,
    "complete_persistence_before_response": true
  },
  "tracked_snapshot": {
    "schema": "qikvrt-ai-progress/3.1",
    "required_fields": [
      "source_semantics",
      "source_evidence",
      "scopes",
      "incomplete_scope_count",
      "repository_effects",
      "projection_owner"
    ],
    "ownerless_state": "IDLE",
    "projection_input_ref_and_sha_are_not_current_remote_state": true,
    "projection_input_must_have_portable_git_object_closure": true,
    "portable_closure_must_recompute_commit_tree_and_blob_git_identities": true,
    "portable_closure_must_traverse_selected_paths_from_commit_root_tree": true,
    "portable_closure_must_reject_missing_or_surplus_objects": true,
    "portable_closure_must_bind_capsule_bytes_sha256_and_git_blob": true,
    "available_local_git_objects_must_match_capsule_bytes": true,
    "portable_closure_does_not_prove_current_ref_history_or_repository_effects": true,
    "scope_specific_release_claims_remain_nested": true,
    "done_scope_requires_repository_ref_sha_checks_and_evidence": true,
    "incomplete_scope_cannot_inherit_pass": true,
    "top_level_continue_or_block_requires_false_release_claims": true,
    "transient_repository_effects_require_fresh_external_evidence": true
  },
  "architecture_rules": {
    "reuse_before_create": true,
    "required_order": ["REUSE", "EXTEND", "PARAMETERIZE", "GENERALIZE", "REFACTOR", "CREATE_NEW"],
    "parallel_component_requires_reuse_evidence": true,
    "repository_is_runtime_authority": true,
    "chat_is_disposable_transport": true,
    "runtime_capabilities_accumulate_in_repository": true,
    "tool_locks_bootstrap_checksums_provenance_tests_and_recovery_are_committed": true,
    "credentials_or_mutable_auth_state_in_cache": false
  },
  "effect_boundary": {
    "transport_ack_is_effect_ack": false,
    "exit_zero_is_final_pass": false,
    "pass_is_scope_bound": true,
    "required_pass_evidence": ["repository", "ref_name", "source_sha", "checks", "evidence"]
  },
  "delivery_closure": {
    "applies_to": "AUTHORIZED_REPOSITORY_MUTATION",
    "completion_state": "REPOSITORY_DELIVERY_VERIFIED",
    "all_applicable_gates_required": true,
    "foundational_model": {
      "additive_identity": "0",
      "multiplicative_identity": "1",
      "operational_start": "DISTINGUISHABILITY",
      "information_flow": [
        "UNTERSCHIED",
        "INFORMATION",
        "RELATION",
        "KAUSALORDNUNG",
        "MODELL",
        "IMPLEMENTIERUNG",
        "TEST",
        "DOKUMENTATION",
        "EVIDENZ",
        "RUECKBEZUG"
      ],
      "formal_empirical_and_normative_claims_remain_separately_bound": true
    },
    "definition_of_ready": [
      "BOUND_SCOPE_AND_CURRENT_SOURCE",
      "OBSERVABLE_ACCEPTANCE_CRITERIA",
      "RISK_AND_EFFECT_CLASSIFICATION",
      "APPLICABLE_TEST_PLAN",
      "DOCUMENTATION_PLAN_OR_DISPOSITION",
      "PROVENANCE_RIGHTS_AND_AUTHORIZATION_BOUNDARIES"
    ],
    "test_first": {
      "required_for_behavior_changes": true,
      "loop": ["RED", "GREEN", "REFACTOR"],
      "positive_negative_security_accessibility_integration_and_end_to_end_tests": "AS_APPLICABLE",
      "existing_exactly_applicable_regressions_remain_binding": true
    },
    "ordered_gates": [
      "SCOPE_AND_IMPLEMENTATION_BOUND",
      "TARGETED_REGRESSION",
      "DOCUMENTATION_DISPOSITION",
      "REPOSITORY_INTEGRITY_MATERIALIZED",
      "EXACT_HEAD_TEST_GATE",
      "REMOTE_REF_REOBSERVED"
    ],
    "documentation": {
      "updated_or_explicitly_not_applicable": true,
      "not_applicable_requires_reason": true
    },
    "browser_interface_when_applicable": {
      "required_checks": [
        "STATIC_SOURCE_AND_SECURITY_CONTRACT",
        "LIVE_PAGE_LOAD",
        "INTENDED_USER_FLOW",
        "DECLARED_CORS_AND_SAME_ORIGIN_READS",
        "FORBIDDEN_INPUT_REJECTION",
        "OPT_IN_VOICE_OR_DEVICE_BEHAVIOR"
      ],
      "microphone_must_not_start_automatically": true,
      "denied_or_unavailable_device_capability_state": ["CONTINUE", "BLOCK"],
      "visual_readback_state_proves_audibility": false,
      "one_browser_observation_proves_cross_browser_or_cross_device_behavior": false
    },
    "remote_evidence_required": [
      "repository",
      "target_ref",
      "head_sha",
      "root_tree",
      "observed_at"
    ],
    "forbidden_inferences": {
      "local_commit_alone_is_delivery": false,
      "push_without_reobservation_is_delivery": false,
      "merge_without_current_ref_evidence_is_delivery": false,
      "missing_gate_may_be_claimed_complete": false
    },
    "incomplete_state": "EFFECT_ACK_CONTINUE_OR_EFFECT_ACK_BLOCK",
    "release_claims": {
      "PASS": false,
      "FINAL_PASS": false,
      "EFFECT_ACK_DONE": false
    }
  }
}
