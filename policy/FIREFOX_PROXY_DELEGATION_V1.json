{
  "schema": "qikvrt_firefox_proxy_delegation_policy_v1",
  "purpose": "Bind local agent-to-Firefox delegation without widening effect authority.",
  "allowed_target_hosts": ["github.com"],
  "required_scheme": "https",
  "secret_values_allowed_in_bridge": false,
  "browser_permission_is_effect_authorization": false,
  "proxy_rendered_done_is_external_effect": false,
  "human_boundary": [
    "authentication",
    "secret_entry",
    "credential creation"
  ],
  "allowed_owner_authenticated_effects": [
    {
      "effect": "review_approve",
      "repository": "Goldkelch/qik-vrt",
      "owner": "Goldkelch",
      "requires_existing_exact_head_product_owner_approve_disposition": true,
      "requires_live_authenticated_principal_match": true,
      "requires_live_pr_head_match": true,
      "requires_live_commit_tree_match": true,
      "allows_secret_transport": false,
      "allows_general_browser_automation": false,
      "post_effect_requirement": "AUTHORITATIVE_REOBSERVATION"
    }
  ],
  "post_boundary_requirement": "AUTHORITATIVE_REOBSERVATION",
  "canonical_ai_semantics_changed": false
}
