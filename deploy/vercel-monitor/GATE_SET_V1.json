    "live_transport": "SERVER_SENT_EVENTS",
    "terminal_transport": "BOUNDED_POST_THEN_EVENT_READBACK",
    "event_source": "github.workflow_run",
    "event_bus": "redis_stream",
    "resume": "LAST_EVENT_ID",
    "heartbeat_is_state_observation": false
