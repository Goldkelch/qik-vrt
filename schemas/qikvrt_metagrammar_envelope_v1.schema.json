{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Goldkelch/qik-vrt/schemas/qikvrt_metagrammar_envelope_v1.schema.json",
  "title": "QIK-VRT Metagrammar Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "binding", "intent", "authority", "evidence", "state", "effect", "proof"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "kind", "rid", "timestamp"],
      "properties": {
        "schema": {"const": "qikvrt_metagrammar_envelope_v1"},
        "version": {"const": "1.0"},
        "kind": {"enum": ["OBSERVE", "DECIDE", "REQUEST", "AUTHORIZE", "ACT", "ACK", "HOLD", "NOOP", "ERROR"]},
        "rid": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "head", "tree"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "ref": {"type": "string", "minLength": 1},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "predecessor_rid": {"type": ["string", "null"]}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "object", "constraints"],
      "properties": {
        "verb": {"enum": ["OBSERVE", "CLASSIFY", "BIND", "DECIDE", "EXECUTE", "TEST", "REOBSERVE", "ACK", "PERSIST", "CREATE", "UPDATE", "CLOSE", "DISPATCH"]},
        "object": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "authorization_id", "scope"],
      "properties": {
        "status": {"enum": ["BOUND", "MISSING", "STALE", "OUT_OF_SCOPE"]},
        "source": {"type": "string", "minLength": 1},
        "authorization_id": {"type": ["string", "null"]},
        "scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value", "sha256"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "value": {},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "blocker", "next_action"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "blocker": {"type": ["string", "null"]},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "productive", "effect_id", "effect_ack"],
      "properties": {
        "state": {"enum": ["NONE", "REQUESTED", "EXECUTED", "OBSERVED", "ACKNOWLEDGED", "REJECTED", "UNKNOWN"]},
        "productive": {"type": "boolean"},
        "effect_id": {"type": ["string", "null"]},
        "effect_ack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "receipt"],
          "properties": {
            "status": {"enum": ["NONE", "PENDING", "ACKNOWLEDGED", "REJECTED"]},
            "receipt": {"type": ["string", "null"]}
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_sha256", "signature"],
      "properties": {
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": ["string", "null"]}
      }
    }
  }
}
