{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-interoperability-proof-v1.schema.json",
  "title": "TEMDD interoperability proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "canonical_profile",
    "evaluation_semantics",
    "vector_set_digest",
    "implementations",
    "vectors",
    "machine_verifiable_standard",
    "canonical_serialization",
    "deterministic_evaluation",
    "conformance_vectors",
    "independent_implementation_execution",
    "identical_expected_decisions",
    "overall",
    "independence_scope",
    "predecessor_evidence_transfer",
    "effect_ack_done"
  ],
  "properties": {
    "schema": {
      "const": "temdd_interoperability_proof_v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "head",
        "tree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "canonical_profile": {
      "const": "temdd_canonical_json_v1"
    },
    "evaluation_semantics": {
      "const": "temdd_decision_v1"
    },
    "vector_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "implementations": {
      "type": "array",
      "minItems": 2
    },
    "vectors": {
      "type": "array",
      "minItems": 1
    },
    "machine_verifiable_standard": {
      "const": "PASS"
    },
    "canonical_serialization": {
      "const": "PASS"
    },
    "deterministic_evaluation": {
      "const": "PASS"
    },
    "conformance_vectors": {
      "const": "PASS"
    },
    "independent_implementation_execution": {
      "const": "PASS"
    },
    "identical_expected_decisions": {
      "const": "PASS"
    },
    "overall": {
      "const": "INTEROPERABILITY_BY_EXECUTABLE_PROOF"
    },
    "independence_scope": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_evidence_transfer": {
      "const": false
    },
    "effect_ack_done": {
      "const": false
    }
  }
}
