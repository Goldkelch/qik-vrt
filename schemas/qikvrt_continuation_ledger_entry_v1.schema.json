{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qikvrt_continuation_ledger_entry_v1.schema.json",
  "title": "QIK-VRT append-only continuation-ledger record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "continuation_key",
    "state",
    "liveness",
    "subject",
    "binding",
    "semantic_input",
    "semantic_fingerprint",
    "first_blocker",
    "next_action",
    "wake_predicates",
    "immutable_source",
    "predecessor_continuation_key",
    "outcome",
    "observation",
    "completion_claims"
  ],
  "properties": {
    "schema": {
      "const": "qikvrt_continuation_ledger_record_v1"
    },
    "record_id": {
      "$ref": "#/$defs/sha256"
    },
    "continuation_key": {
      "$ref": "#/$defs/sha256"
    },
    "state": {
      "enum": [
        "LIVE",
        "REOBSERVE_PENDING",
        "POSTCONDITION_OBSERVED",
        "REBOUND",
        "EXTERNAL_HOLD"
      ]
    },
    "liveness": {
      "const": "INDEFINITE_UNTIL_EVIDENCED_OUTCOME"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "kind",
        "identifier"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "head_sha",
        "tree_sha",
        "base_sha",
        "workflow_path",
        "workflow_blob_sha",
        "workflow_run_id",
        "workflow_run_attempt",
        "job_id",
        "review_id",
        "receipt_sha256",
        "source_event"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "$ref": "#/$defs/sha1OrNull"
        },
        "tree_sha": {
          "$ref": "#/$defs/sha1OrNull"
        },
        "base_sha": {
          "$ref": "#/$defs/sha1OrNull"
        },
        "workflow_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_blob_sha": {
          "$ref": "#/$defs/sha1OrNull"
        },
        "workflow_run_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "workflow_run_attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "job_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "review_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "receipt_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_event": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "semantic_input": {
      "type": "object"
    },
    "semantic_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "first_blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "wake_predicates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "immutable_source": {
      "$ref": "#/$defs/source"
    },
    "predecessor_continuation_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "predecessor_record_id": {
      "$ref": "#/$defs/sha256"
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ]
    },
    "observation": {
      "type": "object",
      "maxProperties": 0
    },
    "completion_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "FINAL_PASS",
        "EFFECT_ACK_DONE",
        "MERGE",
        "SYNCHRONIZATION"
      ],
      "properties": {
        "PASS": {
          "const": false
        },
        "FINAL_PASS": {
          "const": false
        },
        "EFFECT_ACK_DONE": {
          "const": false
        },
        "MERGE": {
          "const": false
        },
        "SYNCHRONIZATION": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha1OrNull": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
