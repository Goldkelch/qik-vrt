  "claims": [
    {
      "claim_id": "K01",
      "statement": "Lohmann formuliert den Impuls stufenweiser Erkenntnis und den Monolithen-Vergleich.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "Zuschreibung des erhaltenen schriftlichen Impulses; keine Validierung sämtlicher darin enthaltener Schlussfolgerungen.",
