      ]
    },
    {
      "claim_id": "K05",
      "statement": "Begründungsart und Geltungsbereich werden offengelegt; die Unterscheidung der Claim-Klassen folgt der gebundenen QIK-VRT-Publikationsrichtlinie.",
      "classification": "NORMATIVE",
      "status": "DECLARED",
      "publication_wording": "NORMATIVE_DECLARATION",
      "scope": "Methodische Regel; formaler Nachweis bleibt voraussetzungsgebunden und physikalische Korrespondenz eigenständig.",
      "proof_refs": [],
