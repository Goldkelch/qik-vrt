      ]
    },
    {
      "claim_id": "K02",
      "statement": "Diese Notiz verwendet Erkenntnisstufen als dokumentierte Präzisierungen, Prüfungen und Revisionen; ein Fortschritt bei jedem Schritt wird nicht vorausgesetzt.",
      "classification": "NORMATIVE",
      "status": "DECLARED",
      "publication_wording": "NORMATIVE_DECLARATION",
      "scope": "Methodische Arbeitsdefinition und vorgeschlagene Praxis, kein psychologisches oder physikalisches Naturgesetz.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": []
    },
    {
      "claim_id": "K03",
      "statement": "Der NASEM-Bericht beschreibt Entdeckung, Bestätigung, Korrektur, gemeinschaftliche Prüfung und abgestufte Sicherheit als Bestandteile wissenschaftlichen Erkenntnisgewinns.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "Paraphrase von Kapitel 2, insbesondere S. 27–32; keine Übertragung einer Beweisautorität auf QIK-VRT.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-09-20-schrittweise-erkenntnis/SOURCE_EVIDENCE_BINDINGS.json#S2"
      ]
    },
    {
      "claim_id": "K04",
      "statement": "Der Monolith wird nach Lohmann als Bild eines Übergangs zu neuen Möglichkeiten des Verstehens, Fragens und Handelns gelesen.",
      "classification": "INTERPRETATIVE",
      "status": "DECLARED",
      "publication_wording": "INTERPRETATIVE_DECLARATION",
      "scope": "Explizite Deutung; weder erklärte Regieabsicht noch empirischer Beweis.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-09-20-schrittweise-erkenntnis/SOURCE_EVIDENCE_BINDINGS.json#S1",
