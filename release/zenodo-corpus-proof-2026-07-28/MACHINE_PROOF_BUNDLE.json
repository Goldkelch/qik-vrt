      "claim_id": "CORPUS-SCOPE-001",
      "statement": "The retrospective corpus receipt binds one index containing 19 subjects.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "The claim is limited to the exact index and receipt bytes in this upload; it is not an assertion about every possible publication by the author.",
