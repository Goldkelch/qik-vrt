      ]
    },
    {
      "claim_id": "CORPUS-CLAIMS-001",
      "statement": "A fresh inventory of the claims lists in the 19 exact byte-bound matrices contains 70,439 nested claim entries.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "The count is recomputed from list entries by this freeze; it is not inherited from the historical receipt and is not proof that every nested statement is true.",
