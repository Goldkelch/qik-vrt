      ]
    },
    {
      "claim_id": "CORPUS-OPEN-001",
      "statement": "The fresh matrix inventory observes 1,262 nested claims explicitly classified as OPEN.",
      "classification": "OPEN",
      "status": "OPEN",
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "OPEN claims remain unresolved and may not be represented as established facts or mathematical theorems.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "release/zenodo-corpus-proof-2026-07-28/CORPUS_CLAIM_MATRIX.json#matrix_explicit_open_claim_count_recomputed"
      ]
    },
    {
      "claim_id": "CORPUS-MATRIX-BINDING-001",
      "statement": "Every one of the 19 byte-bound subject matrices was parsed and inventoried under the finite class and subject-binding checks declared by this freeze.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "This establishes exact byte identity and a fresh inventory; it does not claim that the historical index summaries are all consistent or that nested proofs were recursively revalidated.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "release/zenodo-corpus-proof-2026-07-28/CORPUS_CLAIM_MATRIX.json#all_19_bound_matrices_parsed"
      ]
    },
    {
      "claim_id": "CORPUS-INDEX-DISCREPANCY-001",
      "statement": "For SUBJECT-2581811b342e505d, the historical index declares 39 total claims but summarizes only 8 SOURCE_BOUND and zero in every other epistemic class; the bound matrix freshly inventories 20 EMPIRICALLY_EVIDENCED and 19 SOURCE_BOUND claims.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "This is the one exact recognized historical index/matrix classification-summary discrepancy. The historical index and receipt bytes are disclosed unchanged, and every other such discrepancy blocks the freeze.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "release/zenodo-corpus-proof-2026-07-28/CORPUS_CLAIM_MATRIX.json#HISTORICAL-INDEX-CLASSIFICATION-SUMMARY-SUBJECT-2581811b342e505d"
      ]
    },
    {
      "claim_id": "CORPUS-NESTED-VALIDATION-SCOPE-001",
      "statement": "The 70,439 nested matrix claims are historical dataset content and are not recursively revalidated or promoted by this corpus-level v2 bundle; in particular, its 160 observed FORMAL_PROVED labels across 7 subjects are not asserted here to have kernel-verified proof_refs.",
      "classification": "SOURCE_BOUND",
      "status": "BOUND",
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "The v2 bundle gates apply only to the corpus-level claim projection in this generated matrix. There are zero corpus-level FORMAL_PROVED claims, so formal_claims_have_kernel_receipts does not attest the nested 160 labels.",
      "proof_refs": [],
      "evidence_refs": [],
      "source_refs": [
        "release/zenodo-corpus-proof-2026-07-28/CORPUS_CLAIM_MATRIX.json#nested_formal_proved_labels_not_revalidated"
      ]
    },
    {
      "claim_id": "CORPUS-HISTORY-001",
